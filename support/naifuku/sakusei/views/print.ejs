<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <title>処方箋・病棟配薬指示票 - <%= order.orderNumber %> - <%= order.patientName %></title>
  <style>
    @page {
      size: A4 portrait;
      margin: 8mm 12mm;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; font-family: "Hiragino Kaku Gothic ProN", "Meiryo", "BIZ UDPGothic", sans-serif; }
    body { background: #555; padding: 20px 0; color: #111; }
    .page-container {
      width: 210mm; min-height: 297mm; margin: 0 auto; background: white; padding: 10mm 14mm;
      box-shadow: 0 4px 15px rgba(0,0,0,0.3); position: relative;
    }

    @media print {
      body { background: transparent; padding: 0; }
      .page-container { width: 100%; min-height: auto; margin: 0; padding: 0; box-shadow: none; }
      .no-print { display: none !important; }
    }

    /* 印刷コントロールバー */
    .print-bar {
      position: fixed; top: 12px; right: 20px; z-index: 1000; display: flex; gap: 10px;
    }
    .btn-print-action {
      background: #0284c7; color: white; padding: 10px 18px; border-radius: 6px;
      font-size: 0.9rem; font-weight: bold; border: none; cursor: pointer; box-shadow: 0 2px 8px rgba(0,0,0,0.2);
    }
    .btn-print-action:hover { background: #0369a1; }
    .btn-close-action { background: #64748b; color: white; padding: 10px 14px; border-radius: 6px; text-decoration: none; font-size: 0.9rem; }

    /* セクション共通 */
    .section-box { border: 2px solid #334155; border-radius: 6px; padding: 12px; margin-bottom: 8mm; position: relative; }
    .section-title-wrap { display: flex; justify-content: space-between; align-items: flex-end; border-bottom: 2px solid #0284c7; padding-bottom: 6px; margin-bottom: 8px; }
    .hospital-name { font-size: 0.85rem; color: #475569; font-weight: 600; }
    .doc-main-title { font-size: 1.35rem; font-weight: 800; color: #0f172a; letter-spacing: 0.05em; }
    .order-badge { background: #0284c7; color: white; padding: 3px 8px; border-radius: 4px; font-size: 0.8rem; font-weight: 700; margin-left: 6px; }
    .dispensing-badge { background: #e0f2fe; color: #0369a1; border: 1px solid #7dd3fc; padding: 2px 6px; border-radius: 4px; font-size: 0.75rem; font-weight: 700; }

    /* 患者情報グリッド */
    .patient-grid {
      display: grid; grid-template-columns: 85px 1.2fr 85px 1fr 85px 1fr; border: 1px solid #94a3b8; margin-bottom: 10px; font-size: 0.82rem;
    }
    .grid-label { background: #f8fafc; padding: 5px 8px; font-weight: 700; border-right: 1px solid #94a3b8; border-bottom: 1px solid #94a3b8; color: #334155; }
    .grid-val { padding: 5px 8px; border-right: 1px solid #94a3b8; border-bottom: 1px solid #94a3b8; }
    .grid-val:nth-child(6n) { border-right: none; }

    /* 処方テーブル */
    .rp-table { width: 100%; border-collapse: collapse; margin-bottom: 8px; font-size: 0.85rem; }
    .rp-table th { background: #f1f5f9; border: 1px solid #94a3b8; padding: 6px 8px; text-align: left; font-weight: 700; color: #1e293b; }
    .rp-table td { border: 1px solid #94a3b8; padding: 6px 8px; vertical-align: top; }
    .rp-num-col { width: 45px; text-align: center; font-weight: bold; background: #fafafa; }
    .rp-badge-wrap { display: flex; gap: 4px; margin-top: 4px; }
    .instruction-tag { display: inline-block; font-size: 0.7rem; font-weight: bold; padding: 1px 6px; border-radius: 3px; }
    .tag-onepack { background: #fef3c7; color: #b45309; border: 1px solid #fde68a; }
    .tag-crush { background: #fee2e2; color: #b91c1c; border: 1px solid #fecaca; }

    /* スタンプ・認印欄 */
    .stamp-row { display: flex; justify-content: flex-end; gap: 10px; margin-top: 8px; }
    .stamp-box { width: 65px; height: 65px; border: 1px solid #94a3b8; text-align: center; font-size: 0.72rem; color: #64748b; display: flex; flex-direction: column; justify-content: space-between; padding: 3px; }
    .stamp-box .stamp-label { border-bottom: 1px dashed #cbd5e1; padding-bottom: 2px; }

    /* キリトリ線 */
    .cut-line {
      border-top: 2px dashed #94a3b8; position: relative; margin: 10mm 0 8mm 0; text-align: center;
    }
    .cut-line-text {
      position: absolute; top: -10px; left: 50%; transform: translateX(-50%); background: white; padding: 0 14px;
      font-size: 0.75rem; color: #64748b; font-weight: 600;
    }

    /* 下部: 病棟配薬・服薬管理シート */
    .sheet-box {
      border: 2px solid #0284c7; border-radius: 6px; padding: 12px; background: #fff;
    }
    .sheet-header { display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid #0284c7; padding-bottom: 6px; margin-bottom: 8px; }
    .sheet-title { font-size: 1.15rem; font-weight: 800; color: #0369a1; }
    .time-grid-table { width: 100%; border-collapse: collapse; margin-top: 6px; font-size: 0.8rem; }
    .time-grid-table th { background: #e0f2fe; border: 1px solid #bae6fd; padding: 5px; text-align: center; font-weight: bold; color: #0369a1; }
    .time-grid-table td { border: 1px solid #bae6fd; padding: 6px; text-align: center; height: 26px; }
  </style>
</head>
<body>

  <!-- 印刷用ボタン (印刷時は非表示) -->
  <div class="print-bar no-print">
    <button class="btn-print-action" onclick="window.print()">🖨️ この処方箋を印刷する (Ctrl+P)</button>
    <a href="javascript:window.close()" class="btn-close-action">✕ 閉じる</a>
  </div>

  <div class="page-container">

    <!-- ========================================== -->
    <!-- 上部: 院内処方箋・調剤指示票 (原本/薬局保管用) -->
    <!-- ========================================== -->
    <div class="section-box">
      <div class="section-title-wrap">
        <div>
          <div class="hospital-name">医療法人社団 交雄会 だて病院</div>
          <div class="doc-main-title">💊 院 内 処 方 箋 ・ 調 剤 指 示 票</div>
        </div>
        <div style="text-align: right;">
          <span class="dispensing-badge"><%= order.dispenseType || order.dispensingType || '院内調剤' %></span>
          <span class="order-badge"><%= order.orderClass || order.prescriptionType || '定期処方' %></span>
          <div style="font-size: 0.8rem; font-weight: bold; margin-top: 4px;">処方No. <%= order.orderNumber %></div>
        </div>
      </div>

      <!-- 患者情報 -->
      <div class="patient-grid">
        <div class="grid-label">患者番号</div>
        <div class="grid-val"><strong><%= order.patientId %></strong></div>
        <div class="grid-label">氏名</div>
        <div class="grid-val"><strong style="font-size: 1rem;"><%= order.patientName %></strong> 殿</div>
        <div class="grid-label">生年月日</div>
        <div class="grid-val"><%= patient.birthDate || '-' %> (<%= order.age || '-' %>歳)</div>

        <div class="grid-label">性別 / 病棟</div>
        <div class="grid-val"><%= order.gender || '-' %> / <%= order.ward || '一般病棟' %></div>
        <div class="grid-label">病室 / 病床</div>
        <div class="grid-val"><%= order.roomNo ? order.roomNo + '号室' : '-' %> <%= order.bedNo ? '(' + order.bedNo + ')' : '' %></div>
        <div class="grid-label">処方日</div>
        <div class="grid-val"><%= new Date(order.createdAt).toLocaleDateString('ja-JP') %></div>
      </div>

      <!-- 処方内容一覧 -->
      <table class="rp-table">
        <thead>
          <tr>
            <th style="width: 45px; text-align: center;">番号</th>
            <th style="width: 45%;">薬品名・規格単位</th>
            <th style="width: 15%; text-align: right;">分量</th>
            <th style="width: 25%;">用法・服用タイミング</th>
            <th style="width: 15%; text-align: center;">日数/回数</th>
          </tr>
        </thead>
        <tbody>
          <% if (order.rpList && order.rpList.length > 0) { %>
            <% order.rpList.forEach(rp => { %>
              <% rp.medicines.forEach((med, mIdx) => { %>
                <tr>
                  <% if (mIdx === 0) { %>
                    <td rowspan="<%= rp.medicines.length %>" class="rp-num-col">Rp <%= rp.rpNumber %></td>
                  <% } %>
                  <td>
                    <strong><%= med.name %></strong>
                    <% if (med.spec) { %><span style="color: #64748b; font-size: 0.78rem;">（<%= med.spec %>）</span><% } %>
                    <% if (med.suspensionOk || med.crushOk) { %>
                      <div style="font-size: 0.7rem; color: #0369a1; margin-top: 2px;">
                        <% if (med.suspensionOk) { %>[簡易懸濁: <%= med.suspensionOk %>]<% } %>
                        <% if (med.crushOk) { %> [粉砕: <%= med.crushOk %>]<% } %>
                      </div>
                    <% } %>
                  </td>
                  <td style="text-align: right;">
                    <strong><%= med.dose %></strong> <%= med.unit %>
                  </td>
                  <% if (mIdx === 0) { %>
                    <td rowspan="<%= rp.medicines.length %>">
                      <div style="font-weight: bold; color: #0f172a;"><%= rp.usage %></div>
                      <div class="rp-badge-wrap">
                        <% if (rp.oneDosePackage || rp.isOnePack) { %>
                          <span class="instruction-tag tag-onepack">一包化</span>
                        <% } %>
                        <% if (rp.crushInstruction || rp.isCrushed) { %>
                          <span class="instruction-tag tag-crush">粉砕指示</span>
                        <% } %>
                      </div>
                      <% if (rp.instructionNotes || rp.instruction) { %>
                        <div style="font-size: 0.75rem; color: #64748b; margin-top: 2px;"><%= rp.instructionNotes || rp.instruction %></div>
                      <% } %>
                    </td>
                    <td rowspan="<%= rp.medicines.length %>" style="text-align: center;">
                      <strong style="font-size: 1.05rem; color: #0369a1;"><%= rp.days %></strong> <%= rp.dayUnit || rp.daysUnit || '日分' %>
                    </td>
                  <% } %>
                </tr>
              <% }); %>
            <% }); %>
          <% } else { %>
            <tr><td colspan="5" style="text-align: center; color: #94a3b8; padding: 20px;">処方内容がありません</td></tr>
          <% } %>
        </tbody>
      </table>

      <!-- 備考・特記事項 -->
      <% if (order.remarks || order.doctorComment) { %>
        <div style="border: 1px dashed #94a3b8; background: #fafafa; padding: 6px 10px; font-size: 0.8rem; margin-bottom: 8px;">
          <strong>【医師指示備考】:</strong> <%= order.remarks || order.doctorComment %>
        </div>
      <% } %>

      <!-- 医師認印・調剤印鑑枠 -->
      <div style="display: flex; justify-content: space-between; align-items: flex-end;">
        <div style="font-size: 0.78rem; color: #475569;">
          <div>処方医師: <strong><%= order.orderingDoctor %></strong> 医長 (<%= order.department || '内科' %>)</div>
          <div>発行日時: <%= new Date(order.createdAt).toLocaleString('ja-JP') %></div>
        </div>
        <div class="stamp-row">
          <div class="stamp-box">
            <span class="stamp-label">処方医</span>
            <div style="font-weight: bold; color: #dc2626; margin: auto 0; font-size: 0.8rem;"><%= order.orderingDoctor ? order.orderingDoctor.substring(0, 2) : '印' %></div>
          </div>
          <div class="stamp-box">
            <span class="stamp-label">調剤者</span>
            <div></div>
          </div>
          <div class="stamp-box">
            <span class="stamp-label">鑑査者</span>
            <div></div>
          </div>
          <div class="stamp-box">
            <span class="stamp-label">受領印</span>
            <div></div>
          </div>
        </div>
      </div>
    </div>

    <!-- キリトリ線 -->
    <div class="cut-line">
      <span class="cut-line-text">✂ ここで切り離して病棟配薬カート / 患者手帳へ保管 ✂</span>
    </div>

    <!-- ========================================== -->
    <!-- 下部: 病棟配薬・服薬管理シート (病棟・患者用) -->
    <!-- ========================================== -->
    <div class="sheet-box">
      <div class="sheet-header">
        <div>
          <div style="font-size: 0.8rem; color: #0284c7; font-weight: bold;">医療法人社団 交雄会 だて病院</div>
          <div class="sheet-title">📋 病棟配薬・服薬チェック管理シート</div>
        </div>
        <div style="text-align: right;">
          <div style="font-size: 0.95rem; font-weight: bold;"><%= order.patientName %> 殿 (<%= order.patientId %>)</div>
          <div style="font-size: 0.8rem; color: #475569;"><%= order.ward || '一般病棟' %> <%= order.roomNo ? order.roomNo + '号室' : '' %> | 処方: <%= order.orderNumber %></div>
        </div>
      </div>

      <!-- 服薬タイミング別チェックテーブル -->
      <table class="time-grid-table">
        <thead>
          <tr>
            <th style="width: 25%;">処方内容 (薬品・用量)</th>
            <th style="width: 20%;">用法・指示</th>
            <th style="width: 10%;">朝 (8:00)</th>
            <th style="width: 10%;">昼 (12:00)</th>
            <th style="width: 10%;">夕 (18:00)</th>
            <th style="width: 10%;">寝前 (21:00)</th>
            <th style="width: 15%;">看護師サイン</th>
          </tr>
        </thead>
        <tbody>
          <% if (order.rpList && order.rpList.length > 0) { %>
            <% order.rpList.forEach(rp => { %>
              <tr>
                <td style="text-align: left; padding-left: 8px;">
                  <strong style="color: #0369a1;">[Rp<%= rp.rpNumber %>]</strong>
                  <% rp.medicines.forEach(m => { %>
                    <div><%= m.name %> <%= m.dose %><%= m.unit %></div>
                  <% }); %>
                </td>
                <td style="text-align: left;">
                  <div><%= rp.usage %> (<%= rp.days %><%= rp.dayUnit || rp.daysUnit || '日分' %>)</div>
                  <% if (rp.oneDosePackage || rp.isOnePack) { %><span class="instruction-tag tag-onepack">一包化</span><% } %>
                  <% if (rp.crushInstruction || rp.isCrushed) { %><span class="instruction-tag tag-crush">粉砕</span><% } %>
                </td>
                <td><input type="checkbox" style="transform: scale(1.3);"></td>
                <td><input type="checkbox" style="transform: scale(1.3);"></td>
                <td><input type="checkbox" style="transform: scale(1.3);"></td>
                <td><input type="checkbox" style="transform: scale(1.3);"></td>
                <td></td>
              </tr>
            <% }); %>
          <% } %>
        </tbody>
      </table>

      <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 10px; font-size: 0.75rem; color: #64748b;">
        <div>※ 配薬・与薬時はバーコードまたは患者氏名をフルネームで相互確認してください。</div>
        <div>確認日: 2026年 ____月 ____日 &nbsp;&nbsp;&nbsp;&nbsp; 担当看護師: ____________________ 印</div>
      </div>
    </div>

  </div>

</body>
</html>
