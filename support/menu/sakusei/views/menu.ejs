<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>医療統合ポータル メニュー - 交雄会だて病院</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

  <!-- 全画面共通 最上部1行リボン -->
  <%- include('partials/common-ribbon', { currentScreenTitle: '統合ポータルメニュー' }) %>

  <main class="container">

    <!-- ページ見出し -->
    <div class="page-header">
      <div class="page-title">
        <span>業務システムメニュー</span>
      </div>
      <p class="page-subtitle">
        現在 <strong>「<%= user.department %>」</strong>（<%= user.role === 'admin' ? '管理者権限' : '一般権限' %>）としてログイン中です。パーミッションに応じた機能が表示されています。
      </p>
    </div>

    <!-- カテゴリ別カード表示 -->
    <% 
      const categories = ['臨床・診療', '部門・実施', '医療安全', 'システム管理'];
      categories.forEach(cat => {
        const catMenus = menus.filter(m => m.category === cat);
        if (catMenus.length > 0) {
    %>
      <div class="category-heading">
        <span><%= cat %></span>
      </div>

      <div class="menu-grid">
        <% catMenus.forEach(menu => { %>
          <div class="menu-card <%= menu.canAccess ? 'authorized' : 'unauthorized' %>">
            <div>
              <div class="card-header">
                <div class="card-icon"><%= menu.icon %></div>
                <div class="card-titles">
                  <h3 class="card-title"><%= menu.title %></h3>
                  <p class="card-subtitle"><%= menu.subtitle %></p>
                </div>
              </div>

              <!-- 権限ステータスバー -->
              <div class="card-permission">
                <span class="permission-text"><%= menu.permissionLabel %></span>
                <% if (menu.canAccess) { %>
                  <span class="status-badge accessible">利用可能</span>
                <% } else { %>
                  <span class="status-badge restricted">🔒 権限なし</span>
                <% } %>
              </div>
            </div>

            <!-- アクションボタン -->
            <div class="card-action">
              <% if (menu.canAccess) { %>
                <% if (menu.id === 'emr') { %>
                  <button type="button" class="btn btn-primary" onclick="openPatientSelectModalForCarte()" style="display:flex; align-items:center; justify-content:center; gap:0.4rem; cursor:pointer;" title="カルテを開く対象患者を選択します">
                    🩺 患者を選んでカルテを開く ➔
                  </button>
                <% } else if (menu.id === 'radiology_order') { %>
                  <button type="button" class="btn btn-primary" onclick="launchRadiologyOrder('<%= menu.url %>')" style="display:flex; align-items:center; justify-content:center; gap:0.4rem; cursor:pointer; background: #7c3aed;">
                    🩻 放射線オーダーを発行 ➔
                  </button>
                <% } else if (menu.id === 'naifuku_order') { %>
                  <button type="button" class="btn btn-primary" onclick="launchNaifukuOrder('<%= menu.url %>')" style="display:flex; align-items:center; justify-content:center; gap:0.4rem; cursor:pointer; background: #0284c7;">
                    💊 内服・外用処方を発行 ➔
                  </button>
                <% } else if (menu.id === 'injection_order') { %>
                  <button type="button" class="btn btn-primary" onclick="launchInjectionOrder('<%= menu.url %>')" style="display:flex; align-items:center; justify-content:center; gap:0.4rem; cursor:pointer; background: #059669;">
                    💉 注射・点滴オーダーを発行 ➔
                  </button>
                <% } else if (menu.id === 'rehabili_order') { %>
                  <button type="button" class="btn btn-primary" onclick="launchRehabiliOrder('<%= menu.url %>')" style="display:flex; align-items:center; justify-content:center; gap:0.4rem; cursor:pointer; background: #0d9488;">
                    🤸 リハビリ指示書を発行 ➔
                  </button>
                <% } else if (menu.id === 'radiology_receiver') { %>
                  <a href="<%= menu.url %>" class="btn btn-primary" style="display:flex; align-items:center; justify-content:center; gap:0.4rem; cursor:pointer; background: #0284c7;">
                    📋 指示受け・実施モニターを開く ➔
                  </a>
                <% } else if (menu.id === 'order_sender') { %>
                  <button type="button" class="btn btn-primary" onclick="launchOrderingSender('<%= menu.url %>')" style="display:flex; align-items:center; justify-content:center; gap:0.4rem; cursor:pointer; background: #4f46e5;">
                    📝 オーダー入力画面を開く ➔
                  </button>
                <% } else { %>
                  <a href="<%= menu.url %>" class="btn btn-primary">
                    <%= menu.title %> を開く ➔
                  </a>
                <% } %>
              <% } else { %>
                <button class="btn" disabled>
                  🔒 アクセス権限がありません
                </button>
              <% } %>
            </div>
          </div>
        <% }); %>
      </div>
    <% 
        }
      }); 
    %>

  </main>

  <!-- 🩺 電子カルテ 対象患者選択モーダル -->
  <div id="cartePatientModal" class="modal-overlay" style="display: none;" onclick="handleCarteModalBackdropClick(event)">
    <div class="modal-card" style="max-width: 900px; width: 95%; max-height: 85vh; display: flex; flex-direction: column;" onclick="event.stopPropagation()">
      <div class="modal-header" style="display: flex; justify-content: space-between; align-items: flex-start; padding: 1.25rem 1.5rem; border-bottom: 1px solid var(--slate-200); background: #f8fafc;">
        <div>
          <h3 style="margin: 0; font-size: 1.25rem; font-weight: 800; color: #0f172a; display: flex; align-items: center; gap: 0.5rem;">
            <span>🩺</span> 電子カルテ：対象患者の選択
          </h3>
          <p style="margin: 0.25rem 0 0 0; font-size: 0.82rem; color: #64748b;">
            カルテの閲覧・記事作成・指示オーダーを行う対象患者を選択してください（先に患者を特定してカルテを開きます）。
          </p>
        </div>
        <button type="button" onclick="closeCartePatientModal()" style="background: none; border: none; font-size: 1.3rem; color: #94a3b8; cursor: pointer; padding: 0.2rem 0.5rem;" title="閉じる">
          ✕
        </button>
      </div>

      <!-- フィルター・検索バー -->
      <div style="padding: 1rem 1.5rem; background: white; border-bottom: 1px solid var(--slate-200); display: flex; flex-direction: column; gap: 0.75rem;">
        <div style="position: relative;">
          <input type="text" id="cartePatientSearchInput" placeholder="🔍 患者ID、氏名、カナ、病棟、病室、診療科で絞り込み..." oninput="filterCartePatients()"
                 style="width: 100%; padding: 0.6rem 0.8rem 0.6rem 2.2rem; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 0.9rem; outline: none; box-sizing: border-box;">
          <span style="position: absolute; left: 0.75rem; top: 50%; transform: translateY(-50%); font-size: 0.95rem; color: #94a3b8;">🔍</span>
        </div>
        <div style="display: flex; gap: 0.4rem; flex-wrap: wrap; align-items: center;">
          <span style="font-size: 0.78rem; font-weight: 700; color: #64748b; margin-right: 0.2rem;">病棟絞込:</span>
          <button type="button" class="btn-filter-pill active" onclick="setCarteWardFilter('ALL', this)">すべて</button>
          <button type="button" class="btn-filter-pill" onclick="setCarteWardFilter('2F', this)">2F 医療病棟</button>
          <button type="button" class="btn-filter-pill" onclick="setCarteWardFilter('3F', this)">3F しおかぜ</button>
          <button type="button" class="btn-filter-pill" onclick="setCarteWardFilter('4F', this)">4F うみかぜ</button>
          <button type="button" class="btn-filter-pill" onclick="setCarteWardFilter('外来', this)">外来</button>
          <button type="button" class="btn-filter-pill" onclick="setCarteWardFilter('仮置き', this)">仮置き</button>
        </div>
      </div>

      <!-- 患者テーブルエリア（スクロール可能） -->
      <div style="flex: 1; overflow-y: auto; padding: 0;">
        <table style="width: 100%; border-collapse: collapse; font-size: 0.88rem; text-align: left;">
          <thead style="background: #f1f5f9; position: sticky; top: 0; z-index: 10; border-bottom: 1px solid #e2e8f0;">
            <tr>
              <th style="padding: 0.6rem 1rem; color: #475569; font-weight: 700; width: 100px;">患者ID</th>
              <th style="padding: 0.6rem 1rem; color: #475569; font-weight: 700;">氏名 (フリガナ)</th>
              <th style="padding: 0.6rem 1rem; color: #475569; font-weight: 700; width: 90px;">年齢/性別</th>
              <th style="padding: 0.6rem 1rem; color: #475569; font-weight: 700; width: 130px;">病棟 / 病室</th>
              <th style="padding: 0.6rem 1rem; color: #475569; font-weight: 700; width: 100px;">診療科</th>
              <th style="padding: 0.6rem 1rem; color: #475569; font-weight: 700; text-align: right; width: 130px;">操作</th>
            </tr>
          </thead>
          <tbody id="cartePatientTableBody">
            <% if (typeof patients !== 'undefined' && patients && patients.length > 0) { %>
              <% patients.forEach(p => { %>
                <tr class="carte-patient-row" 
                    data-id="<%= p.patientId %>" 
                    data-name="<%= p.name %>" 
                    data-kana="<%= p.kana || '' %>" 
                    data-ward="<%= p.ward || '' %>" 
                    data-room="<%= p.room || '' %>" 
                    data-dept="<%= p.department || '' %>"
                    onclick="selectPatientAndLaunchCarte('<%= p.patientId %>', '<%= p.name %>', '<%= p.age %>', '<%= p.gender %>', '<%= p.birthDate || '' %>')"
                    style="border-bottom: 1px solid #f1f5f9; cursor: pointer; transition: background 0.15s ease;">
                  <td style="padding: 0.75rem 1rem;">
                    <span style="background: #e2e8f0; color: #0f172a; font-family: monospace; font-weight: 700; padding: 0.15rem 0.45rem; border-radius: 4px; font-size: 0.85rem;">
                      <%= p.patientId %>
                    </span>
                  </td>
                  <td style="padding: 0.75rem 1rem;">
                    <div style="font-weight: 700; color: #0f172a; font-size: 0.95rem;"><%= p.name %> 様</div>
                    <div style="font-size: 0.72rem; color: #64748b;"><%= p.kana || '-' %></div>
                  </td>
                  <td style="padding: 0.75rem 1rem;">
                    <strong><%= p.age !== null ? p.age + '歳' : '-' %></strong>
                    <span style="font-size: 0.75rem; color: #64748b;">(<%= p.gender %>)</span>
                  </td>
                  <td style="padding: 0.75rem 1rem;">
                    <div style="font-weight: 600; color: #0284c7; font-size: 0.85rem;"><%= p.ward || '外来' %></div>
                    <div style="font-size: 0.75rem; color: #64748b;"><%= p.room || '-' %></div>
                  </td>
                  <td style="padding: 0.75rem 1rem;">
                    <span class="dept-pill" style="font-size: 0.72rem; background: #e0f2fe; color: #0369a1; border: 1px solid #bae6fd;">
                      <%= p.department || '一般' %>
                    </span>
                  </td>
                  <td style="padding: 0.75rem 1rem; text-align: right; white-space: nowrap;">
                    <div style="display: flex; gap: 0.4rem; justify-content: flex-end;">
                      <button type="button" class="btn btn-primary" style="padding: 0.35rem 0.65rem; font-size: 0.78rem; border-radius: 6px; background: #0284c7;"
                              onclick="event.stopPropagation(); selectPatientAndLaunchCarte('<%= p.patientId %>', '<%= p.name %>', '<%= p.age %>', '<%= p.gender %>', '<%= p.birthDate || '' %>')"
                              title="<%= p.name %> 様の電子カルテを開く">
                        🩺 カルテ ➔
                      </button>
                      <button type="button" class="btn btn-primary" style="padding: 0.35rem 0.65rem; font-size: 0.78rem; border-radius: 6px; background: #4f46e5;"
                              onclick="event.stopPropagation(); selectPatientAndLaunchOrdering('<%= p.patientId %>', '<%= p.name %>', '<%= p.age %>', '<%= p.gender %>', '<%= p.birthDate || '' %>')"
                              title="<%= p.name %> 様の統合オーダリング画面を開く">
                        📝 オーダリング ➔
                      </button>
                    </div>
                  </td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr id="emptyCarteRow">
                <td colspan="6" style="text-align: center; padding: 2.5rem; color: #64748b;">
                  登録されている患者データがありません。
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>

      <!-- モーダルフッター -->
      <div style="padding: 0.9rem 1.5rem; background: #f8fafc; border-top: 1px solid var(--slate-200); display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem;">
        <div style="display: flex; gap: 0.75rem; align-items: center;">
          <a href="/patients" class="btn btn-outline" style="width: auto; padding: 0.4rem 0.8rem; font-size: 0.8rem; color: #0284c7; border-color: #0284c7;">
            ➕ 患者の新規登録・マスタ管理へ
          </a>
          <a href="/sso/launch?app=articles&redirect=%2Farticles%3Fview%3Dall" class="btn btn-outline" style="width: auto; padding: 0.4rem 0.8rem; font-size: 0.8rem; color: #64748b;" title="全患者の記事一覧（全体閲覧）を開く">
            🌐 全患者の記事一覧（全体閲覧）
          </a>
        </div>
        <button type="button" class="btn btn-outline" onclick="closeCartePatientModal()" style="width: auto; padding: 0.4rem 1rem; font-size: 0.85rem;">
          キャンセル
        </button>
      </div>
    </div>
  </div>

  <style>
    /* モーダル基本スタイル */
    .modal-overlay {
      position: fixed;
      top: 0; left: 0; right: 0; bottom: 0;
      background: rgba(15, 23, 42, 0.6);
      backdrop-filter: blur(4px);
      z-index: 10000;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 1rem;
    }
    .modal-card {
      background: white;
      border-radius: 14px;
      box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.2), 0 10px 10px -5px rgba(0, 0, 0, 0.08);
      overflow: hidden;
      border: 1px solid #cbd5e1;
    }
    .carte-patient-row:hover {
      background-color: #f0fdf4 !important;
    }
    .btn-filter-pill {
      background: #f1f5f9;
      border: 1px solid #cbd5e1;
      color: #475569;
      padding: 0.2rem 0.6rem;
      border-radius: 14px;
      font-size: 0.75rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.15s ease;
    }
    .btn-filter-pill:hover {
      background: #e2e8f0;
      color: #0f172a;
    }
    .btn-filter-pill.active {
      background: #0284c7;
      color: white;
      border-color: #0284c7;
    }
  </style>

  <script>
    // ログアウトクリック時はセッション消滅
    document.querySelectorAll('.btn-logout').forEach(function(btn) {
      btn.addEventListener('click', function() {
        sessionStorage.removeItem('portal_session_active');
      });
    });

    // 🩺 電子カルテ対象患者選択モーダルの開閉
    let currentCarteWardFilter = 'ALL';

    function openPatientSelectModalForCarte() {
      const modal = document.getElementById('cartePatientModal');
      if (modal) {
        modal.style.display = 'flex';
        document.body.style.overflow = 'hidden';
        const searchInput = document.getElementById('cartePatientSearchInput');
        if (searchInput) {
          searchInput.value = '';
          setTimeout(() => searchInput.focus(), 100);
        }
        filterCartePatients();
      }
    }

    function closeCartePatientModal() {
      const modal = document.getElementById('cartePatientModal');
      if (modal) {
        modal.style.display = 'none';
        document.body.style.overflow = '';
      }
    }

    function handleCarteModalBackdropClick(e) {
      if (e.target.id === 'cartePatientModal') {
        closeCartePatientModal();
      }
    }

    // ESCキーでモーダルを閉じる
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') {
        closeCartePatientModal();
      }
    });

    // 患者を選択してカルテ起動
    function selectPatientAndLaunchCarte(patientId, name, age, gender, birthDate) {
      // 共通リボン用 localStorage も更新
      try {
        localStorage.setItem('koyukai_current_patient', JSON.stringify({
          patientId: patientId,
          name: name,
          age: age,
          gender: gender,
          birthDate: birthDate
        }));
      } catch (_) {}

      // SSO Launch 経由で対象患者のカルテ・記事入力画面へ直接遷移！
      window.location.href = '/sso/launch?app=articles&patientId=' + encodeURIComponent(patientId);
    }

    // 患者を選択して統合オーダリング画面起動
    function selectPatientAndLaunchOrdering(patientId, name, age, gender, birthDate) {
      try {
        localStorage.setItem('koyukai_current_patient', JSON.stringify({
          patientId: patientId,
          name: name,
          age: age,
          gender: gender,
          birthDate: birthDate
        }));
      } catch (_) {}

      window.location.href = '/ordering/?patientId=' + encodeURIComponent(patientId);
    }

    // 🩻 放射線科オーダーへのSSO Launch API 連携起動 (リボン選択中の患者を引き継ぐ)
    function launchRadiologyOrder(baseUrl) {
      let targetUrl = baseUrl || '/sso/launch?app=radiology';
      try {
        const stored = localStorage.getItem('koyukai_current_patient');
        if (stored) {
          const p = JSON.parse(stored);
          if (p.patientId) {
            targetUrl += (targetUrl.includes('?') ? '&' : '?') + 'patientId=' + encodeURIComponent(p.patientId);
          }
        }
      } catch (_) {}
      window.location.href = targetUrl;
    }

    // 💊 内服・外用処方オーダーへのSSO Launch API 連携起動 (リボン選択中の患者を引き継ぐ)
    function launchNaifukuOrder(baseUrl) {
      let targetUrl = baseUrl || '/sso/launch?app=naifuku';
      try {
        const stored = localStorage.getItem('koyukai_current_patient');
        if (stored) {
          const p = JSON.parse(stored);
          if (p.patientId) {
            targetUrl += (targetUrl.includes('?') ? '&' : '?') + 'patientId=' + encodeURIComponent(p.patientId);
          }
        }
      } catch (_) {}
      window.location.href = targetUrl;
    }

    // 💉 注射・点滴オーダーへのSSO Launch API 連携起動 (リボン選択中の患者を引き継ぐ)
    function launchInjectionOrder(baseUrl) {
      let targetUrl = baseUrl || '/sso/launch?app=injection';
      try {
        const stored = localStorage.getItem('koyukai_current_patient');
        if (stored) {
          const p = JSON.parse(stored);
          if (p.patientId) {
            targetUrl += (targetUrl.includes('?') ? '&' : '?') + 'patientId=' + encodeURIComponent(p.patientId);
          }
        }
      } catch (_) {}
      window.location.href = targetUrl;
    }

    // 🤸 リハビリテーション指示オーダーへのSSO Launch API 連携起動 (リボン選択中の患者を引き継ぐ)
    function launchRehabiliOrder(baseUrl) {
      let targetUrl = baseUrl || '/sso/launch?app=rehabili';
      try {
        const stored = localStorage.getItem('koyukai_current_patient');
        if (stored) {
          const p = JSON.parse(stored);
          if (p.patientId) {
            targetUrl += (targetUrl.includes('?') ? '&' : '?') + 'patientId=' + encodeURIComponent(p.patientId);
          }
        }
      } catch (_) {}
      window.location.href = targetUrl;
    }

    // 📝 統合オーダリング総合ポータルへのSSO Launch API 連携起動 (リボン選択中の患者を引き継ぐ)
    function launchOrderingSender(baseUrl) {
      let targetUrl = baseUrl || '/sso/launch?app=ordering';
      try {
        const stored = localStorage.getItem('koyukai_current_patient');
        if (stored) {
          const p = JSON.parse(stored);
          if (p.patientId) {
            targetUrl += (targetUrl.includes('?') ? '&' : '?') + 'patientId=' + encodeURIComponent(p.patientId);
          }
        }
      } catch (_) {}
      window.location.href = targetUrl;
    }

    // 病棟フィルター切り替え
    function setCarteWardFilter(ward, btn) {
      currentCarteWardFilter = ward;
      document.querySelectorAll('.btn-filter-pill').forEach(b => b.classList.remove('active'));
      if (btn) btn.classList.add('active');
      filterCartePatients();
    }

    // 患者検索・フィルタリング処理
    function filterCartePatients() {
      const query = (document.getElementById('cartePatientSearchInput')?.value || '').toLowerCase().trim();
      const rows = document.querySelectorAll('.carte-patient-row');
      let visibleCount = 0;

      rows.forEach(row => {
        const id = (row.dataset.id || '').toLowerCase();
        const name = (row.dataset.name || '').toLowerCase();
        const kana = (row.dataset.kana || '').toLowerCase();
        const ward = row.dataset.ward || '';
        const room = (row.dataset.room || '').toLowerCase();
        const dept = (row.dataset.dept || '').toLowerCase();

        // 1. 病棟一致
        let wardMatch = false;
        if (currentCarteWardFilter === 'ALL') {
          wardMatch = true;
        } else if (currentCarteWardFilter === 'しおかぜ') {
          wardMatch = ward.includes('しおかぜ');
        } else if (currentCarteWardFilter === 'うみかぜ') {
          wardMatch = ward.includes('うみかぜ');
        } else if (currentCarteWardFilter === '外来') {
          wardMatch = ward.includes('外来');
        } else if (currentCarteWardFilter === '一時待機') {
          wardMatch = ward.includes('一時待機');
        }

        // 2. 検索テキスト一致
        const textMatch = !query || 
                          id.includes(query) || 
                          name.includes(query) || 
                          kana.includes(query) || 
                          ward.toLowerCase().includes(query) || 
                          room.includes(query) || 
                          dept.includes(query);

        if (wardMatch && textMatch) {
          row.style.display = '';
          visibleCount++;
        } else {
          row.style.display = 'none';
        }
      });
    }
  </script>
</body>
</html>
