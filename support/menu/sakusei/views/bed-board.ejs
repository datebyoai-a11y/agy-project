            <%- renderRoomBox(`${f}26`, '4人部屋', [`${f}26-1`, `${f}26-2`, `${f}26-3`, `${f}26-4`], patients, selectedWard, false, 'right') %>

            <!-- 最下部右端ステータス -->
            <div style="padding:0.25rem 0.5rem; font-size:0.78rem; font-weight:700; color:#64748b;">
              他 0 件
