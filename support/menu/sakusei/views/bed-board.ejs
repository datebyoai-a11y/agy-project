                <%- renderRoomBox(`${f}08`, '個室', [`${f}08-1`], patients, selectedWard, true, 'left') %>
                <%- renderRoomBox(`${f}07`, '個室', [`${f}07-1`], patients, selectedWard, true, 'left') %>
                <%- renderRoomBox(`${f}06`, '個室', [`${f}06-1`], patients, selectedWard, true, 'left') %>
