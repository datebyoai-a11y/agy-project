            <!-- <%= f %>18 (4人部屋) -->
            <%- renderRoomBox(`${f}18`, '4人部屋', [`${f}18-1`, `${f}18-2`, `${f}18-3`, `${f}18-4`], patients, selectedWard, false, 'right') %>

