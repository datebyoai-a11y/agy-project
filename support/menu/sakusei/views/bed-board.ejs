            <span>入床先ベッド:</span>
            <span style="background:#e0f2fe; color:#0369a1; font-weight:800; padding:0.15rem 0.6rem; border-radius:4px; border:1px solid #7dd3fc;" id="assignBedBadge">
              <span id="assignWardDisplay">--</span> <span id="assignRoomDisplay">--</span>
            </span>
          </div>
        </div>
        <div style="display:flex; align-items:center; gap:0.6rem;">
          <!-- ➕ 新規患者登録画面への直接遷移ショートカットボタン -->
          <a href="/patients?action=new" id="btnGoNewPatient" target="_blank" class="btn" style="text-decoration:none; display:inline-flex; align-items:center; gap:0.35rem; padding:0.4rem 0.85rem; font-size:0.85rem; background:#059669; color:white; border-radius:6px; font-weight:800; box-shadow:0 1px 2px rgba(0,0,0,0.1);" title="新規患者登録画面を直接開きます">
            <span>➕</span>
            <span>新規患者登録</span>
          </a>
          <button type="button" onclick="closeAssignModal()" style="background:none; border:none; font-size:1.4rem; cursor:pointer; color:#94a3b8;">&times;</button>
        </div>
      </div>

      <div style="display:flex; gap:0.6rem; margin-bottom:0.75rem; align-items:center; flex-wrap:wrap;">
        <input type="text" id="assignSearchInput" onkeyup="filterAssignPatients()" placeholder="🔍 患者氏名・カナ・ID・診療科・状態で絞り込み..." style="flex:1; min-width:240px; padding:0.5rem 0.8rem; border-radius:6px; border:1px solid #cbd5e1; font-size:0.9rem;">
        
        <label style="font-size:0.85rem; color:#334155; font-weight:700; display:flex; align-items:center; gap:0.35rem; cursor:pointer; background:#f8fafc; border:1px solid #cbd5e1; padding:0.45rem 0.75rem; border-radius:6px; user-select:none;">
          <input type="checkbox" id="filterOnlyUnassigned" onchange="filterAssignPatients()" checked>
          <span>未入床（外来）のみ表示</span>
        </label>

        <a href="/patients" target="_blank" style="font-size:0.82rem; color:#059669; font-weight:800; text-decoration:underline; white-space:nowrap;" title="別タブで患者登録画面を開きます">
          未登録の患者を新規作成 ➔
        </a>
      </div>

      <div style="flex:1; overflow-y:auto; border:1px solid #cbd5e1; border-radius:6px; max-height:480px;">
        <table style="width:100%; border-collapse:collapse; font-size:0.85rem;">
          <thead style="background:#f1f5f9; border-bottom:1.5px solid #cbd5e1; position:sticky; top:0; z-index:2;">
            <tr>
              <th style="padding:0.55rem 0.6rem; text-align:left; width:85px;">ID</th>
              <th style="padding:0.55rem 0.6rem; text-align:left;">氏名 (フリガナ)</th>
              <th style="padding:0.55rem 0.6rem; text-align:center; width:95px;">性別 / 年齢</th>
              <th style="padding:0.55rem 0.6rem; text-align:center; width:75px;">移動区分</th>
              <th style="padding:0.55rem 0.6rem; text-align:left; width:110px;">診療科</th>
              <th style="padding:0.55rem 0.6rem; text-align:left;">現在の所在</th>
              <th style="padding:0.55rem 0.6rem; text-align:center; width:80px;">操作</th>
            </tr>
          </thead>
          <tbody id="assignPatientTableBody">
            <% patients.forEach(p => { %>
              <% 
                const isUnassigned = !p.room || p.room.trim() === '' || p.ward === '外来';
                const isMale = p.gender === '男' || p.gender === '男性';
              %>
              <tr class="assign-patient-row" 
                  data-search="<%= p.patientId %> <%= p.name %> <%= p.kana || '' %> <%= p.department || '' %> <%= p.ward || '' %> <%= p.room || '' %> <%= p.mobility || '' %>"
                  data-unassigned="<%= isUnassigned ? '1' : '0' %>" 
                  style="border-bottom:1px solid #f1f5f9;">
                <td style="padding:0.45rem 0.6rem; font-weight:700; font-family:monospace; color:#334155;"><%= p.patientId %></td>
                <td style="padding:0.45rem 0.6rem;">
                  <span style="font-weight:800; color:#0f172a;"><%= p.name %> 様</span>
                  <% if (p.kana) { %>
                    <span style="font-size:0.75rem; color:#64748b; margin-left:0.3rem;"><%= p.kana %></span>
                  <% } %>
                </td>
                <td style="padding:0.45rem 0.6rem; text-align:center;">
                  <span class="badge-gender <%= isMale ? 'gender-male' : 'gender-female' %>" style="display:inline-block; font-size:0.72rem; padding:0.1rem 0.35rem;">
                    <%= isMale ? '男' : '女' %>
                  </span>
                  <span style="font-weight:600; margin-left:0.25rem;"><%= p.age !== null ? p.age + '歳' : '-' %></span>
                </td>
                <td style="padding:0.45rem 0.6rem; text-align:center;">
                  <span class="badge-mobility <%= p.mobility === '担送' ? 'mobility-tanso' : (p.mobility === '護送' ? 'mobility-goso' : 'mobility-doppo') %>" style="display:inline-block; font-size:0.72rem; padding:0.1rem 0.4rem;">
                    <%= p.mobility || '担送' %>
                  </span>
                </td>
                <td style="padding:0.45rem 0.6rem; color:#475569;"><%= p.department || '内科' %></td>
                <td style="padding:0.45rem 0.6rem;">
                  <% if (p.ward === '一時待機') { %>
                    <span style="background:#fef3c7; color:#92400e; padding:0.15rem 0.45rem; border-radius:4px; font-weight:bold; font-size:0.78rem;">⚠️ 一時待機</span>
                  <% } else if (p.room) { %>
                    <span style="background:#e0f2fe; color:#0369a1; padding:0.15rem 0.45rem; border-radius:4px; font-weight:600; font-size:0.78rem;"><%= p.ward %> <%= p.room %></span>
                  <% } else { %>
                    <span style="color:#64748b; font-size:0.8rem; background:#f1f5f9; padding:0.15rem 0.45rem; border-radius:4px;">外来 (未入床)</span>
                  <% } %>
                </td>
                <td style="padding:0.45rem 0.6rem; text-align:center;">
                  <form action="/api/bed-board/assign" method="POST" style="margin:0;">
                    <input type="hidden" name="currentWard" value="<%= selectedWard %>">
                    <input type="hidden" name="patientId" value="<%= p.patientId %>">
                    <input type="hidden" name="ward" id="assignFormWard_<%= p.patientId %>">
                    <input type="hidden" name="room" id="assignFormRoom_<%= p.patientId %>">
                    <button type="submit" class="btn btn-primary" onclick="setAssignFormData('<%= p.patientId %>')" style="padding:0.3rem 0.75rem; font-size:0.8rem; background:#0284c7; color:white; border:none; border-radius:4px; cursor:pointer; font-weight:bold;" title="この空床に入床させる">
                      入床
                    </button>
                  </form>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>

      <div style="display:flex; justify-content:space-between; align-items:center; margin-top:0.8rem;">
        <div style="font-size:0.82rem; color:#64748b;">
          登録患者数: <strong><%= patients.length %></strong> 名（データベース保持）
        </div>
        <button type="button" onclick="closeAssignModal()" class="btn btn-outline" style="padding:0.4rem 1.4rem; font-weight:700;">閉じる</button>
      </div>
    </div>
  </div>

  <!-- =========================================================
       📦 部屋描画用ヘルパー関数 & 看護統計パネル (EJS内定義)
       ========================================================= -->
  <%
    function renderStatsPanel1(statsData) {
      return renderStatsAndCallHistoryPanel(statsData, '2');
    }

    function renderStatsAndCallHistoryPanel(statsData, currentFloor) {
      const showCallFirst = (currentFloor === '3');
      let sHtml = '<div class="stats-panel-1" id="statsAndCallPanel">';
      sHtml += '<div class="stats-panel-header" style="display:flex; justify-content:space-between; align-items:center; padding:0.15rem 0.25rem 0.35rem 0.25rem;">';
      sHtml += '  <div class="stats-panel-tabs">';
      sHtml += '    <button type="button" id="tabBtnStat" class="stats-panel-tab-btn ' + (!showCallFirst ? 'is-active' : '') + '" onclick="switchStatsTab(\'stat\')">📊 看護統計 1</button>';
      sHtml += '    <button type="button" id="tabBtnCall" class="stats-panel-tab-btn ' + (showCallFirst ? 'is-active' : '') + '" onclick="switchStatsTab(\'call\')">🔔 呼出履歴</button>';
      sHtml += '  </div>';
      sHtml += '  <span style="font-size:0.75rem; color:#64748b; font-weight:800;">' + (currentFloor === '2' ? '2F 医療' : (currentFloor === '3' ? '3F しおかぜ' : '4F うみかぜ')) + '</span>';
      sHtml += '</div>';

      // 1. 看護統計 1 表示
      sHtml += '<div id="statPanelBox" style="' + (showCallFirst ? 'display:none;' : 'display:block;') + '">';
      sHtml += '  <div class="stats-grid-box">';
      
      // 左列
      sHtml += '    <div class="stats-col">';
      sHtml += '      <div class="stats-row"><span class="stats-lbl">入院患者数</span><span class="stats-num">' + statsData.occupiedCount + '</span></div>';
      sHtml += '      <div class="stats-sub-row"><span>男性</span><strong style="color:#0f172a;">' + statsData.maleCount + '</strong></div>';
      sHtml += '      <div class="stats-sub-row" style="border-bottom:1.5px solid #94a3b8;"><span>女性</span><strong style="color:#0f172a;">' + statsData.femaleCount + '</strong></div>';
      sHtml += '      <div class="stats-row"><span class="stats-lbl">空きベッド数</span><span class="stats-num">' + statsData.emptyCount + '</span></div>';
      sHtml += '      <div class="stats-sub-row"><span>男性</span><strong style="color:#0f172a;">' + statsData.emptyMaleCount + '</strong></div>';
      sHtml += '      <div class="stats-sub-row"><span>女性</span><strong style="color:#0f172a;">' + statsData.emptyFemaleCount + '</strong></div>';
      sHtml += '    </div>';

      // 右列
      sHtml += '    <div class="stats-col">';
      sHtml += '      <div class="stats-row"><span class="stats-lbl" style="color:#ea580c;">担送</span><span class="stats-num" style="color:#ea580c;">' + statsData.tansouCount + '</span></div>';
      sHtml += '      <div class="stats-row"><span class="stats-lbl" style="color:#16a34a;">護送</span><span class="stats-num" style="color:#16a34a;">' + statsData.gosouCount + '</span></div>';
      sHtml += '      <div class="stats-row" style="border-bottom:1.5px solid #94a3b8;"><span class="stats-lbl" style="color:#2563eb;">独歩</span><span class="stats-num" style="color:#2563eb;">' + statsData.doppoCount + '</span></div>';
      sHtml += '      <div class="stats-row"><span class="stats-lbl">外出</span><span class="stats-num">' + statsData.gaishutsuCount + '</span></div>';
      sHtml += '      <div class="stats-row"><span class="stats-lbl">外泊</span><span class="stats-num">' + statsData.gaihakuCount + '</span></div>';
      sHtml += '      <div class="stats-row" style="background:#f0f9ff;"><span class="stats-lbl" style="font-weight:900; color:#0369a1;">在院</span><span class="stats-num" style="color:#0369a1; font-size:1.05rem;">' + statsData.zaiinCount + '</span></div>';
      sHtml += '    </div>';

      sHtml += '  </div>';
      sHtml += '</div>';

      // 2. 呼出履歴 表示 (3F実機写真準拠・患者名はプライバシー保護のため非表示)
      sHtml += '<div id="callHistoryBox" style="' + (showCallFirst ? 'display:block;' : 'display:none;') + '">';
      sHtml += '  <div style="max-height:175px; overflow-y:auto; border:1.5px solid #94a3b8; background:white;">';
      sHtml += '    <table style="width:100%; border-collapse:collapse; font-size:0.75rem; text-align:center;">';
      sHtml += '      <thead>';
      sHtml += '        <tr style="background:#f1f5f9; border-bottom:1.5px solid #cbd5e1; color:#334155; position:sticky; top:0;">';
      sHtml += '          <th style="padding:0.22rem 0.3rem;">日付</th>';
      sHtml += '          <th style="padding:0.22rem 0.3rem;">呼出時刻</th>';
      sHtml += '          <th style="padding:0.22rem 0.3rem;">種別</th>';
      sHtml += '          <th style="padding:0.22rem 0.3rem;">ベッド番号</th>';
      sHtml += '          <th style="padding:0.22rem 0.3rem;">患者名</th>';
      sHtml += '        </tr>';
      sHtml += '      </thead>';
      sHtml += '      <tbody>';

      const callLogs = (currentFloor === '3') ? [
        { date: '10/02', time: '10:13:46', type: '01', bed: '303-4', name: '--' },
        { date: '10/02', time: '10:07:53', type: 'TC', bed: 'WC6',   name: '--' },
        { date: '10/02', time: '10:07:22', type: '01', bed: '303-4', name: '--' },
        { date: '10/02', time: '10:02:18', type: 'TC', bed: 'WC2',   name: '--' },
        { date: '10/02', time: '09:59:25', type: 'NC', bed: '326-1', name: '--' },
        { date: '10/02', time: '09:59:08', type: 'TC', bed: 'WC6',   name: '--' }
      ] : [
        { date: '10/02', time: '09:42:15', type: '01', bed: `${currentFloor}13-1`, name: '--' },
        { date: '10/02', time: '09:30:11', type: 'TC', bed: 'WC1', name: '--' },
        { date: '10/02', time: '09:15:02', type: 'NC', bed: `${currentFloor}20-2`, name: '--' },
        { date: '10/02', time: '08:58:40', type: '01', bed: `${currentFloor}03-2`, name: '--' }
      ];

      callLogs.forEach((log, idx) => {
        sHtml += '<tr style="border-bottom:1px solid #e2e8f0; background:' + (idx % 2 === 0 ? '#ffffff' : '#f8fafc') + ';">';
        sHtml += '  <td style="padding:0.22rem 0.3rem; color:#64748b;">' + log.date + '</td>';
        sHtml += '  <td style="padding:0.22rem 0.3rem; font-weight:bold; color:#0f172a;">' + log.time + '</td>';
        sHtml += '  <td style="padding:0.22rem 0.3rem;"><span style="background:#e0f2fe; color:#0369a1; padding:0.05rem 0.3rem; border-radius:3px; font-weight:800; font-size:0.7rem;">' + log.type + '</span></td>';
        sHtml += '  <td style="padding:0.22rem 0.3rem; font-weight:800; color:#1e293b;">' + log.bed + '</td>';
        sHtml += '  <td style="padding:0.22rem 0.3rem; color:#94a3b8; font-weight:600;">' + log.name + '</td>';
        sHtml += '</tr>';
      });

      sHtml += '      </tbody>';
      sHtml += '    </table>';
      sHtml += '  </div>';
      sHtml += '</div>';

      sHtml += '</div>';
      return sHtml;
    }

    function renderStagingSlots(stagingList, currentWard) {
      const list = (typeof stagingList !== 'undefined' && stagingList) ? stagingList : [];
      let html = '<div class="staging-area-box" id="stagingAreaBox">';
      html += '  <div class="staging-header">';
      html += '    <div class="staging-title">';
      html += '      <span>🪑</span>';
      html += '      <span>移動待機・仮置きスロット (ベッド外一時待機)</span>';
      html += '    </div>';
      html += '    <span style="font-size:0.75rem; color:#64748b; font-weight:700;">※ベッド番号を持たない待機枠 (計5人分)</span>';
      html += '  </div>';
      html += '  <div class="staging-slots-grid">';

      const totalSlots = 5;
      for (let i = 0; i < totalSlots; i++) {
        const sp = list[i] || null;
        if (sp) {
          const isMale = sp.gender === '男' || sp.gender === '男性';
          const mobClass = sp.mobility === '担送' ? 'mobility-tanso' : (sp.mobility === '護送' ? 'mobility-goso' : 'mobility-doppo');
          const mobChar = sp.mobility ? sp.mobility.slice(0, 1) : '担';

          html += '<div class="staging-slot-cell occupied" onclick=\'selectPatientFromBoard(' + JSON.stringify(sp) + ')\' style="cursor:pointer;" title="クリックで患者選択">';
          html += '  <div style="display:flex; justify-content:space-between; align-items:center;">';
          html += '    <span style="font-weight:800; font-size:0.8rem; color:#b45309;">🪑 仮置き ' + (i + 1) + '</span>';
          html += '    <div style="display:flex; gap:0.25rem; align-items:center;">';
          html += '      <span class="badge-gender ' + (isMale ? 'gender-male' : 'gender-female') + '" style="font-size:0.65rem; padding:0.1rem 0.3rem;">' + (isMale ? '男' : '女') + '</span>';
          html += '      <span class="badge-mobility ' + mobClass + '" style="font-size:0.65rem; padding:0.1rem 0.3rem;">' + mobChar + '</span>';
          html += '    </div>';
          html += '  </div>';
          html += '  <div style="font-weight:800; font-size:0.92rem; color:#1e293b; margin:0.25rem 0;">' + sp.name + ' 様</div>';
          html += '  <div style="display:flex; gap:0.3rem; margin-top:0.2rem;">';
          html += '    <button type="button" onclick="event.stopPropagation(); openMoveModal(\'' + sp.patientId + '\', \'' + sp.name + '\', \'' + (sp.age !== null ? sp.age : '') + '\', \'' + currentWard + '\', \'\')" class="btn" style="flex:1; padding:0.2rem 0.4rem; font-size:0.75rem; background:#0284c7; color:white; border:none; border-radius:4px; font-weight:700; cursor:pointer;" title="空床ベッドへ移動">🔀 ベッドへ</button>';
          html += '    <button type="button" onclick="event.stopPropagation(); dischargePatientFromBoard(\'' + sp.patientId + '\', \'' + sp.name + '\')" class="btn" style="padding:0.2rem 0.4rem; font-size:0.75rem; background:#dc2626; color:white; border:none; border-radius:4px; font-weight:700; cursor:pointer;" title="退床して外来へ戻す">🚪 退床</button>';
          html += '  </div>';
          html += '</div>';
        } else {
          html += '<div class="staging-slot-cell empty">';
          html += '  <div style="display:flex; justify-content:space-between; align-items:center;">';
          html += '    <span style="font-weight:700; font-size:0.8rem; color:#94a3b8;">🪑 仮置き ' + (i + 1) + '</span>';
          html += '    <span style="font-size:0.68rem; color:#cbd5e1; font-weight:700;">（空き）</span>';
          html += '  </div>';
          html += '  <div style="text-align:center; font-size:0.75rem; color:#94a3b8; margin:0.5rem 0;">移動・待機枠</div>';
          html += '</div>';
        }
      }

      html += '  </div>';
      html += '</div>';
      return html;
    }

    function renderRoomBox(roomNo, roomType, beds, allPatients, currentWard, isPrivate, layoutType) {
      let html = '<div class="map-room" id="room_' + roomNo + '">';
      html += '<div class="room-header-bar">';
      html += '<span class="room-num-badge">' + (isPrivate ? '🚻 ' : '🚪 ') + roomNo + '</span>';
      html += '<span style="font-size:0.7rem; color:#475569; font-weight:600;">' + (isPrivate ? roomNo + 'トイレ' : roomType) + '</span>';
      html += '</div>';

      if (beds.length === 1) {
        html += '<div class="room-beds-1">';
      } else if (beds.length === 2) {
        html += '<div class="room-beds-2">';
      } else {
        html += '<div class="room-beds-4">';
      }

      // 4人部屋の表示順序を写真実機に合わせる (左側病室: 上段[2, 1], 下段[3, 4] / 右側病室: 上段[4, 3], 下段[1, 2])
      let renderOrder = [];
      for (let i = 0; i < beds.length; i++) renderOrder.push(i);

      if (beds.length === 4) {
        if (layoutType === 'left') {
          renderOrder = [1, 0, 2, 3]; // [2番ベッド, 1番ベッド, 3番ベッド, 4番ベッド]
        } else if (layoutType === 'right') {
          renderOrder = [3, 2, 0, 1]; // [4番ベッド, 3番ベッド, 1番ベッド, 2番ベッド]
        }
      }

      renderOrder.forEach(idx => {
        if (idx >= beds.length) return;
        const bedId = beds[idx];
        
        // ベッド表示番号 (201-1 ➔ 1, 401-A ➔ A, 301-A ➔ A)
        let bedNum = (beds.length === 4 && bedId.includes('-') && !isNaN(bedId.split('-')[1]))
                     ? (idx + 1)
                     : (bedId.includes('-') ? bedId.split('-')[1] : bedId);

        // ベッドにいる患者を検索 (全病棟対応)
        const occupant = allPatients.find(p => {
          if (!p.ward) return false;
          const wardMatch = (p.ward === currentWard) ||
                            (currentWard === '2F医療病棟' && p.ward.startsWith('2F')) ||
                            (p.ward.includes(currentWard.slice(0, 4)));
          if (!wardMatch) return false;
          return p.room === bedId || p.room === `${roomNo}-${bedId}` || p.room === `${roomNo}-${idx + 1}`;
        });

        if (occupant) {
          const isMale = occupant.gender === '男' || occupant.gender === '男性';
          const mobClass = occupant.mobility === '担送' ? 'mobility-tanso' : (occupant.mobility === '護送' ? 'mobility-goso' : 'mobility-doppo');
          const mobChar = occupant.mobility ? occupant.mobility.slice(0, 1) : '担';

          html += '<div class="map-bed-cell ' + (isMale ? 'bed-male' : 'bed-female') + '" data-patient-id="' + occupant.patientId + '" onclick=\'selectPatientFromBoard(' + JSON.stringify(occupant) + ')\' title="クリックで対象患者選択">';
          html += '<div class="bed-top-row">';
          html += '<span class="bed-index-num">' + bedNum + '</span>';
          html += '<div class="bed-badges">';
          html += '<span class="badge-gender ' + (isMale ? 'gender-male' : 'gender-female') + '">' + (isMale ? '男' : '女') + '</span>';
          html += '<span class="badge-mobility ' + mobClass + '">' + mobChar + '</span>';
          if (occupant.sensor) {
            html += '<span class="badge-sensor">センサ</span>';
          }
          html += '</div></div>';
          html += '<div class="bed-patient-name-text">' + occupant.name + '</div>';
          html += '</div>';
        } else {
          // 空床
          html += '<div class="map-bed-cell bed-empty-slot" onclick="openAssignModal(\'' + currentWard + '\', \'' + bedId + '\')" title="空床: クリックして患者を入床">';
          html += '<div class="bed-top-row">';
          html += '<span class="bed-index-num">' + bedNum + '</span>';
          html += '<span style="font-size:0.65rem; color:#94a3b8; font-weight:800;">空床</span>';
          html += '</div>';
          html += '<div class="bed-empty-text">＋ 空床</div>';
          html += '</div>';
        }
      });

      html += '</div></div>';
      return html;
    }

    function renderMinimapRoom(roomNo, roomType, beds, allPatients, currentWard, isPrivate) {
      let html = '<div class="minimap-room-chip" onclick="scrollToRoom(\'' + roomNo + '\')" title="' + roomNo + '号室 (' + (isPrivate ? '個室' : roomType) + ') - クリックでジャンプ">';
      html += '<div class="minimap-room-header">';
      html += '<span class="minimap-room-badge">' + (isPrivate ? '🚻' : '🚪') + roomNo + '</span>';
      html += '<span class="minimap-room-type">' + (isPrivate ? '個室' : roomType) + '</span>';
      html += '</div>';

      const bedGridClass = beds.length === 1 ? 'm-beds-1' : (beds.length === 2 ? 'm-beds-2' : 'm-beds-4');
      html += '<div class="minimap-beds-grid ' + bedGridClass + '">';

      for (let i = 0; i < beds.length; i++) {
        const bedId = beds[i];
        let bedNum = (beds.length === 4 && bedId.includes('-') && !isNaN(bedId.split('-')[1]))
                     ? (i + 1)
                     : (bedId.includes('-') ? bedId.split('-')[1] : bedId);

        const occupant = allPatients.find(p => {
          if (!p.ward) return false;
          if (p.room === '仮置き' || p.room === '一時待機') return false;
          const wardMatch = (p.ward === currentWard) ||
                            (currentWard === '2F医療病棟' && (p.ward === '2F' || (p.ward && p.ward.startsWith('2F')))) ||
                            (currentWard === '3Fしおかぜ' && (p.ward === '3F' || (p.ward && p.ward.startsWith('3F')) || (p.ward && p.ward.includes('しおかぜ')) || p.ward === '3F介護医療院')) ||
                            (currentWard === '4Fうみかぜ' && (p.ward === '4F' || (p.ward && p.ward.startsWith('4F')) || (p.ward && p.ward.includes('うみかぜ')) || p.ward === '4F介護医療院'));
          if (!wardMatch) return false;
          return p.room === bedId || p.room === `${roomNo}-${bedId}` || p.room === `${roomNo}-${i + 1}`;
        });

        if (occupant) {
          const isMale = occupant.gender === '男' || occupant.gender === '男性';
          const shortName = occupant.name ? occupant.name.split(' ')[0] : '入床';
          html += '<div class="m-bed-cell ' + (isMale ? 'm-male' : 'm-female') + '" title="' + bedNum + '番ベッド: ' + occupant.name + ' 様 (' + occupant.gender + ')">';
          html += '<span class="m-bed-num">' + bedNum + '</span>';
          html += '<span class="m-bed-name">' + shortName + '</span>';
          html += '</div>';
        } else {
          html += '<div class="m-bed-cell m-empty" title="' + bedNum + '番ベッド: 空床">';
          html += '<span class="m-bed-num">' + bedNum + '</span>';
          html += '<span class="m-bed-empty-txt">空</span>';
          html += '</div>';
        }
      }

      html += '</div></div>';
      return html;
    }

    function renderMinimapOverview(currentWard, allPatients, stagingList, statsData) {
      let f = '2';
      if (currentWard === '3Fしおかぜ' || currentWard === '3F介護医療院' || currentWard === 'しおかぜ病棟' || (currentWard && (currentWard.startsWith('3F') || currentWard.includes('しおかぜ')))) {
        f = '3';
      } else if (currentWard === '4Fうみかぜ' || currentWard === '4F介護医療院' || currentWard === 'うみかぜ病棟' || (currentWard && (currentWard.startsWith('4F') || currentWard.includes('うみかぜ')))) {
        f = '4';
      }

      let html = '<div class="minimap-grid">';
      
      // ◀ 左翼 (全9行・スクロールなし超コンパクト)
      html += '<div class="m-wing m-wing-left">';
      html += '<div class="minimap-wing-label">◀ 西病室群 (左)</div>';
      html += renderMinimapRoom(`${f}15`, '個室', [`${f}15-1`], allPatients, currentWard, true);
      html += renderMinimapRoom(`${f}13`, '4人', [`${f}13-1`, `${f}13-2`, `${f}13-3`, `${f}13-4`], allPatients, currentWard, false);
      html += renderMinimapRoom(`${f}12`, '4人', [`${f}12-1`, `${f}12-2`, `${f}12-3`, `${f}12-4`], allPatients, currentWard, false);
      if (f === '2') {
        html += renderMinimapRoom(`${f}11`, '4人', [`${f}11-1`, `${f}11-2`, `${f}11-3`, `${f}11-4`], allPatients, currentWard, false);
        html += '<div style="display:grid; grid-template-columns:1fr 1fr 1fr; gap:1.5px;">';
        html += renderMinimapRoom(`${f}08`, '個室', [`${f}08-1`], allPatients, currentWard, true);
        html += renderMinimapRoom(`${f}07`, '個室', [`${f}07-1`], allPatients, currentWard, true);
        html += renderMinimapRoom(`${f}06`, '個室', [`${f}06-1`], allPatients, currentWard, true);
        html += '</div>';
      } else {
        html += '<div style="display:grid; grid-template-columns:repeat(5, 1fr); gap:1.5px;">';
        html += renderMinimapRoom(`${f}11`, '個室', [`${f}11-1`], allPatients, currentWard, true);
        html += renderMinimapRoom(`${f}10`, '個室', [`${f}10-1`], allPatients, currentWard, true);
        html += renderMinimapRoom(`${f}08`, '個室', [`${f}08-1`], allPatients, currentWard, true);
        html += renderMinimapRoom(`${f}07`, '個室', [`${f}07-1`], allPatients, currentWard, true);
        html += renderMinimapRoom(`${f}06`, '個室', [`${f}06-1`], allPatients, currentWard, true);
        html += '</div>';
      }
      html += renderMinimapRoom(`${f}05`, '4人', [`${f}05-1`, `${f}05-2`, `${f}05-3`, `${f}05-4`], allPatients, currentWard, false);
      html += renderMinimapRoom(`${f}03`, '4人', [`${f}03-1`, `${f}03-2`, `${f}03-3`, `${f}03-4`], allPatients, currentWard, false);
      html += renderMinimapRoom(`${f}02`, '4人', [`${f}02-1`, `${f}02-2`, `${f}02-3`, `${f}02-4`], allPatients, currentWard, false);
      html += renderMinimapRoom(`${f}01`, '4人', [`${f}01-1`, `${f}01-2`, `${f}01-3`, `${f}01-4`], allPatients, currentWard, false);
      html += '</div>';

      // ■ 中央 (全9行相当の高さ・スクロールなし)
      html += '<div class="m-wing m-wing-center">';
      html += '<div class="minimap-wing-label">■ 中央コア</div>';
      html += '<div style="display:grid; grid-template-columns:1fr 1fr; gap:1.5px;">';
      html += renderMinimapRoom(`${f}16`, '個室', [`${f}16-1`], allPatients, currentWard, true);
      html += renderMinimapRoom(`${f}17`, '個室', [`${f}17-1`], allPatients, currentWard, true);
      html += '</div>';
      html += '<div class="minimap-station-chip" onclick="scrollToStaffStation()">👩‍⚕️ ' + f + 'F スタッフステーション</div>';
      
      // 病棟ごとの仮置き待機枠
      html += '<div class="minimap-staging-chip" onclick="scrollToStaging()" title="クリックで仮置きスロットへ">';
      html += '<div style="display:flex; justify-content:space-between; align-items:center;">';
      html += '<span style="font-weight:800; font-size:0.68rem; color:#b45309;">🪑 仮置きスロット</span>';
      html += '<span style="font-size:0.6rem; font-weight:800; background:#fef3c7; color:#92400e; padding:1px 4px; border-radius:3px;">' + stagingList.length + ' / 5</span>';
      html += '</div>';
      for (let i = 0; i < 5; i++) {
        const sp = stagingList[i] || null;
        html += '<div class="m-stage-item ' + (sp ? 'occupied' : 'empty') + '">';
        html += '<span style="font-size:0.58rem;">#' + (i + 1) + '</span>';
        html += '<span style="font-size:0.6rem; font-weight:700; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; max-width:85px;">' + (sp ? sp.name : '（空き）') + '</span>';
        html += '</div>';
      }
      html += '</div>';
      html += '</div>';

      // ▶ 右翼 (全9行・スクロールなし超コンパクト)
      html += '<div class="m-wing m-wing-right">';
      html += '<div class="minimap-wing-label">東病室群 (右) ▶</div>';
      html += '<div style="display:flex; gap:2px; font-size:0.6rem; background:#f1f5f9; padding:2px; border-radius:3px; color:#475569; justify-content:center; height:20px; align-items:center; box-sizing:border-box;">📦 倉庫 / ⚙️ 機械室</div>';
      html += renderMinimapRoom(`${f}18`, '4人', [`${f}18-1`, `${f}18-2`, `${f}18-3`, `${f}18-4`], allPatients, currentWard, false);
      html += renderMinimapRoom(`${f}20`, '4人', [`${f}20-1`, `${f}20-2`, `${f}20-3`, `${f}20-4`], allPatients, currentWard, false);
      html += renderMinimapRoom(`${f}21`, '4人', [`${f}21-1`, `${f}21-2`, `${f}21-3`, `${f}21-4`], allPatients, currentWard, false);
      html += renderMinimapRoom(`${f}22`, '4人', [`${f}22-1`, `${f}22-2`, `${f}22-3`, `${f}22-4`], allPatients, currentWard, false);
      html += '<div style="background:#fef3c7; border:1px solid #fcd34d; border-radius:3px; padding:2px; font-size:0.6rem; font-weight:800; color:#92400e; text-align:center; height:22px; display:flex; align-items:center; justify-content:center; box-sizing:border-box;">♿ 食堂兼談話室 (' + f + 'F デイルーム)</div>';
      html += renderMinimapRoom(`${f}23`, '4人', [`${f}23-1`, `${f}23-2`, `${f}23-3`, `${f}23-4`], allPatients, currentWard, false);
      html += renderMinimapRoom(`${f}25`, '4人', [`${f}25-1`, `${f}25-2`, `${f}25-3`, `${f}25-4`], allPatients, currentWard, false);
      html += renderMinimapRoom(`${f}26`, '4人', [`${f}26-1`, `${f}26-2`, `${f}26-3`, `${f}26-4`], allPatients, currentWard, false);
      html += '</div>';

      html += '</div>';
      return html;
    }
  %>

  <!-- =========================================================
       📜 JavaScript クライアントロジック
       ========================================================= -->
  <script>
    const BED_MASTER_DATA = <%- JSON.stringify(bedMaster) %>;
    const CURRENT_WARD = '<%= selectedWard %>';

    // 🕒 リアルタイム時計更新 (写真実機フォーマット: 10月 1日 木曜日 13:24)
    function updateClock() {
      const el = document.getElementById('realtimeClockDisplay');
      if (!el) return;
      const now = new Date();
      const month = now.getMonth() + 1;
      const day = now.getDate();
      const days = ['日曜日', '月曜日', '火曜日', '水曜日', '木曜日', '金曜日', '土曜日'];
      const weekDay = days[now.getDay()];
      const hour = ('0' + now.getHours()).slice(-2);
      const min = ('0' + now.getMinutes()).slice(-2);
      el.textContent = `${month}月 ${day}日 ${weekDay} ${hour}:${min}`;
    }
    setInterval(updateClock, 1000);
    updateClock();

    // 📊 看護統計 1 / 🔔 呼出履歴 タブ切替 (3F/4F 実機写真準拠)
    function switchStatsTab(tabName) {
      const statBox = document.getElementById('statPanelBox');
      const callBox = document.getElementById('callHistoryBox');
      const btnStat = document.getElementById('tabBtnStat');
      const btnCall = document.getElementById('tabBtnCall');

      if (tabName === 'stat') {
        if (statBox) statBox.style.display = 'block';
        if (callBox) callBox.style.display = 'none';
        if (btnStat) btnStat.classList.add('is-active');
        if (btnCall) btnCall.classList.remove('is-active');
      } else {
        if (statBox) statBox.style.display = 'none';
        if (callBox) callBox.style.display = 'block';
        if (btnStat) btnStat.classList.remove('is-active');
        if (btnCall) btnCall.classList.add('is-active');
      }
    }

    // ⚙️ 業務システムドロップダウン開閉制御
    function toggleBizDropdown(event) {
      if (event) {
        event.stopPropagation();
        event.preventDefault();
      }
      const menu = document.getElementById('bizDropdownMenu');
      if (menu) {
        menu.classList.toggle('show');
      }
    }

    // 外部クリックでドロップダウンを閉じる
    window.addEventListener('click', function(e) {
      const dropdown = document.getElementById('bizNavDropdown');
      const menu = document.getElementById('bizDropdownMenu');
      if (dropdown && menu && !dropdown.contains(e.target)) {
        menu.classList.remove('show');
      }
    });

    // 画面切替 (フロアマップ / 一覧)
    let isMapView = true;
    function toggleMapView() {
      const grid = document.getElementById('floorMapGrid');
      const text = document.getElementById('viewModeText');
      if (!grid) return;
      isMapView = !isMapView;
      if (isMapView) {
        grid.style.display = 'grid';
        if (text) text.textContent = '一覧切替';
      } else {
        grid.style.display = 'flex';
        grid.style.flexWrap = 'wrap';
        if (text) text.textContent = 'マップ切替';
      }
    }

    // 📌 ベッドボードで患者をクリックした時の選択＆トースト通知
    function selectPatientFromBoard(patient) {
      if (!patient || !patient.patientId) return;

      const patientData = {
        patientId: patient.patientId,
        name: patient.name,
        dob: patient.birthDate || '',
        age: patient.age !== null ? patient.age : '',
        ward: patient.ward || '',
        room: patient.room || ''
      };

      try {
        localStorage.setItem('koyukai_current_patient', JSON.stringify(patientData));
      } catch (_) {}

      if (typeof applyRibbonPatient === 'function') {
        applyRibbonPatient(patientData);
      }

      highlightSelectedPatient(patient.patientId);
      showPatientActionToast(patient);
      openPatientOrderModal(patient);
    }

    // 🎯 0. 患者選択・統合オーダリング＆アクション ポップアップモーダル
    let currentSelectedPatientForModal = null;

    function openPatientOrderModal(patient) {
      if (!patient) return;
      currentSelectedPatientForModal = patient;
      const modal = document.getElementById('patientOrderModal');
      if (!modal) return;

      const pName = document.getElementById('pomPatientName');
      const pMeta = document.getElementById('pomPatientMeta');
      const pLoc = document.getElementById('pomPatientLocation');

      if (pName) pName.textContent = `[${patient.patientId}] ${patient.name} 様`;
      if (pMeta) pMeta.textContent = `(${patient.gender || '性別未定'} / ${patient.age !== null && patient.age !== undefined && patient.age !== '' ? patient.age + '歳' : '年齢未定'})`;
      if (pLoc) pLoc.textContent = `${patient.ward || ''} ${patient.room || ''}`;

      const pId = encodeURIComponent(patient.patientId);
      const linkOrdering = document.getElementById('pomLinkOrdering');
      const linkRadiology = document.getElementById('pomLinkRadiology');
      const linkNaifuku = document.getElementById('pomLinkNaifuku');
      const linkInjection = document.getElementById('pomLinkInjection');
      const linkRehabili = document.getElementById('pomLinkRehabili');
      const linkCarte = document.getElementById('pomLinkCarte');

      if (linkOrdering) linkOrdering.href = `/ordering/?patientId=${pId}`;
      if (linkRadiology) linkRadiology.href = `/sso/launch?app=radiology&patientId=${pId}`;
      if (linkNaifuku) linkNaifuku.href = `/sso/launch?app=naifuku&patientId=${pId}`;
      if (linkInjection) linkInjection.href = `/sso/launch?app=injection&patientId=${pId}`;
      if (linkRehabili) linkRehabili.href = `/sso/launch?app=rehabili&patientId=${pId}`;
      if (linkCarte) linkCarte.href = `/sso/launch?app=articles&patientId=${pId}`;

      const btnMove = document.getElementById('pomBtnMove');
      const btnStage = document.getElementById('pomBtnStage');
      const btnDischarge = document.getElementById('pomBtnDischarge');

      if (btnMove) {
        btnMove.onclick = () => {
          closePatientOrderModal();
          openMoveModal(patient.patientId, patient.name, patient.age || '', patient.ward || '', patient.room || '');
        };
      }
      if (btnStage) {
        btnStage.onclick = () => {
          closePatientOrderModal();
          stagePatientFromBoard(patient.patientId, patient.name);
        };
      }
      if (btnDischarge) {
        btnDischarge.onclick = () => {
          closePatientOrderModal();
          dischargePatientFromBoard(patient.patientId, patient.name);
        };
      }

      modal.style.display = 'flex';
    }

    function closePatientOrderModal() {
      const modal = document.getElementById('patientOrderModal');
      if (modal) modal.style.display = 'none';
    }

    function handleOrderModalBackdropClick(e) {
      if (e.target && e.target.id === 'patientOrderModal') {
        closePatientOrderModal();
      }
    }

    function highlightSelectedPatient(patientId) {
      document.querySelectorAll('.map-bed-cell').forEach(el => {
        el.classList.remove('selected-patient-active');
      });
      if (!patientId) return;
      document.querySelectorAll(`[data-patient-id="${patientId}"]`).forEach(el => {
        el.classList.add('selected-patient-active');
      });
    }

    function showPatientActionToast(patient) {
      const existing = document.getElementById('boardPatientToast');
      if (existing) existing.remove();

      const toast = document.createElement('div');
      toast.id = 'boardPatientToast';
      toast.className = 'toast-notification';
      toast.innerHTML = `
        <div style="font-size: 1.4rem;">📌</div>
        <div style="flex: 1;">
          <div style="font-size: 0.76rem; color: #94a3b8;">対象患者を選択中（上部リボン同期済）</div>
          <div style="font-weight: 800; font-size: 1rem; color: #ffffff;">
            [${patient.patientId}] ${patient.name} 様 
            <span style="font-size: 0.8rem; font-weight: normal; color: #38bdf8;">(${patient.room || patient.ward || ''})</span>
          </div>
        </div>
        <div style="display: flex; gap: 0.35rem; align-items: center; flex-wrap: wrap;">
          <button type="button" onclick="openPatientOrderModal(JSON.parse('${encodeURIComponent(JSON.stringify(patient))}'))"
                  class="btn" style="padding:0.35rem 0.65rem; font-size:0.78rem; background:#4f46e5; color:white; border:none; border-radius:4px; cursor:pointer; font-weight:bold;"
                  title="統合オーダリングメニュー ポップアップを表示">
            📝 オーダー
          </button>
          <button type="button" onclick="openMoveModal('${patient.patientId}', '${patient.name}', '${patient.age || ''}', '${patient.ward || ''}', '${patient.room || ''}')"
                  class="btn btn-primary" style="padding:0.35rem 0.65rem; font-size:0.78rem; background:#0284c7; border:none; border-radius:4px; cursor:pointer; font-weight:bold;">
            🔀 移動
          </button>
          <button type="button" onclick="stagePatientFromBoard('${patient.patientId}', '${patient.name}')"
                  class="btn" style="padding:0.35rem 0.65rem; font-size:0.78rem; background:#d97706; color:white; border:none; border-radius:4px; cursor:pointer; font-weight:bold;" title="ベッドから一時的に仮置きスロットへ退避させます">
            🪑 仮置き
          </button>
          <button type="button" onclick="dischargePatientFromBoard('${patient.patientId}', '${patient.name}')"
                  class="btn" style="padding:0.35rem 0.65rem; font-size:0.78rem; background:#dc2626; color:white; border:none; border-radius:4px; cursor:pointer; font-weight:bold;" title="ベッドから退床させて空床にします">
            🚪 退床
          </button>
          <a href="/sso/launch?app=articles&patientId=${encodeURIComponent(patient.patientId)}" 
             class="btn btn-primary" 
             style="padding: 0.35rem 0.65rem; font-size: 0.78rem; text-decoration: none; border-radius: 4px; background: #059669;"
             title="この患者のカルテ・記事作成画面を開く">
            🩺 カルテ
          </a>
          <button type="button" onclick="this.closest('#boardPatientToast').remove()" style="background: none; border: none; color: #94a3b8; font-size: 1.2rem; cursor: pointer; padding: 0.2rem 0.4rem;">✕</button>
        </div>
      `;
      document.body.appendChild(toast);

      setTimeout(() => {
        if (toast && toast.parentNode) {
          toast.remove();
        }
      }, 12000);
    }

    // 🪑 仮置きスロットへ退避
    function stagePatientFromBoard(patientId, patientName) {
      if (!confirm(`患者「${patientName}」様を移動待機・仮置きスロットへ退避させますか？\n（ベッドは空床化され、中央列の仮置きスロットに待機表示されます）`)) {
        return;
      }
      const form = document.createElement('form');
      form.method = 'POST';
      form.action = '/api/bed-board/assign';
      form.innerHTML = `
        <input type="hidden" name="currentWard" value="${CURRENT_WARD}">
        <input type="hidden" name="patientId" value="${patientId}">
        <input type="hidden" name="action" value="stage">
      `;
      document.body.appendChild(form);
      form.submit();
    }

    // 🚪 ベッドから退床（空床化）処理
    function dischargePatientFromBoard(patientId, patientName) {
      if (!confirm(`患者「${patientName}」様のベッド割り当てを解除（退床）し、空床に戻しますか？\n（※患者データ自体は削除されません）`)) {
        return;
      }
      const form = document.createElement('form');
      form.method = 'POST';
      form.action = '/api/bed-board/assign';
      form.innerHTML = `
        <input type="hidden" name="currentWard" value="${CURRENT_WARD}">
        <input type="hidden" name="patientId" value="${patientId}">
        <input type="hidden" name="action" value="discharge">
      `;
      document.body.appendChild(form);
      form.submit();
    }

    // 🎯 該当病室へスクロール＆ハイライト
    function scrollToRoom(roomNo) {
      const el = document.getElementById('room_' + roomNo);
      if (el) {
        el.scrollIntoView({ behavior: 'smooth', block: 'center' });
        el.classList.remove('room-highlight-flash');
        void el.offsetWidth;
        el.classList.add('room-highlight-flash');
      }
    }

    // 🎯 スタッフステーションへスクロール
    function scrollToStaffStation() {
      const el = document.querySelector('.staff-station-minimal') || document.querySelector('.staff-station-box');
      if (el) {
        el.scrollIntoView({ behavior: 'smooth', block: 'center' });
        el.classList.remove('room-highlight-flash');
        void el.offsetWidth;
        el.classList.add('room-highlight-flash');
      }
    }

    // 🎯 仮置きエリアへスクロール
    function scrollToStaging() {
      const el = document.getElementById('stagingAreaBox');
      if (el) {
        el.scrollIntoView({ behavior: 'smooth', block: 'center' });
        el.classList.remove('room-highlight-flash');
        void el.offsetWidth;
        el.classList.add('room-highlight-flash');
      }
    }

    // 🗺️ 全体見渡しナビゲーションウィンドウのホバー＆固定制御
    (function initNavMinimap() {
      const container = document.getElementById('navMinimapContainer');
      const trigger = document.getElementById('navMinimapTrigger');
      const popover = document.getElementById('navMinimapPopover');
      const btnPin = document.getElementById('minimapPinBtn');
      const btnClose = document.getElementById('minimapCloseBtn');
      if (!container || !popover) return;

      let isPinned = false;
      let closeTimer = null;

      function showPopover() {
        if (closeTimer) {
          clearTimeout(closeTimer);
          closeTimer = null;
        }
        popover.style.display = 'flex';
        container.classList.add('is-active');
      }

      function hidePopover() {
        if (isPinned) return;
        closeTimer = setTimeout(() => {
          popover.style.display = 'none';
          container.classList.remove('is-active');
        }, 280);
      }

      container.addEventListener('mouseenter', showPopover);
      container.addEventListener('mouseleave', hidePopover);

      if (trigger) {
        trigger.addEventListener('click', (e) => {
          e.stopPropagation();
          isPinned = !isPinned;
          updatePinState();
        });
      }

      if (btnPin) {
        btnPin.addEventListener('click', (e) => {
          e.stopPropagation();
          isPinned = !isPinned;
          updatePinState();
        });
      }

      if (btnClose) {
        btnClose.addEventListener('click', (e) => {
          e.stopPropagation();
          isPinned = false;
          updatePinState();
          popover.style.display = 'none';
          container.classList.remove('is-active');
        });
      }

      function updatePinState() {
        if (btnPin) {
          btnPin.style.background = isPinned ? '#f59e0b' : 'rgba(255,255,255,0.15)';
          btnPin.style.color = isPinned ? '#ffffff' : '#e2e8f0';
          btnPin.textContent = isPinned ? '📌 固定中' : '📌 固定';
          btnPin.title = isPinned ? '固定表示中 (クリックで解除)' : '固定表示 (ピン留め)';
        }
        if (isPinned) {
          popover.style.display = 'flex';
          container.classList.add('is-active');
        }
      }

      // ポップオーバー外クリックでピン留め解除
      document.addEventListener('click', (e) => {
        if (isPinned && !container.contains(e.target)) {
          isPinned = false;
          updatePinState();
          popover.style.display = 'none';
          container.classList.remove('is-active');
        }
      });
    })();

    // 🔀 部屋移動モーダル制御
    function openMoveModal(patientId, name, age, currentWard, currentRoom) {
      document.getElementById('movePatientId').value = patientId;
      document.getElementById('movePatientDisplay').textContent = `[${patientId}] ${name} 様 (${age ? age + '歳' : ''})`;
      document.getElementById('moveCurrentLocation').textContent = (currentWard || '未定') + ' ' + (currentRoom || '未入床');

      const wardSelect = document.getElementById('moveTargetWard');
      if (wardSelect) {
        wardSelect.value = CURRENT_WARD;
      }
      updateMoveRoomOptions();

      document.getElementById('moveModal').style.display = 'flex';
    }

    function closeMoveModal() {
      document.getElementById('moveModal').style.display = 'none';
    }

    function updateMoveRoomOptions() {
      const wardKey = document.getElementById('moveTargetWard').value;
      const roomSelect = document.getElementById('moveTargetRoom');
      roomSelect.innerHTML = '';

      if (wardKey === '一時待機') {
        roomSelect.innerHTML = '<option value="一時待機">⚠️ 一時待機エリア（ベッド外退避）</option>';
        return;
      }
      if (wardKey === '外来') {
        roomSelect.innerHTML = '<option value="外来">外来（退院・病室解放）</option>';
        return;
      }

      const master = BED_MASTER_DATA[wardKey];
      if (!master || !master.rooms) {
        roomSelect.innerHTML = '<option value="">病室がありません</option>';
        return;
      }

      // 各病棟の仮置きスロットへの移動オプション
      const optStage = document.createElement('option');
      optStage.value = '仮置き';
      optStage.textContent = `🪑 [${master.name}] 仮置きスロット (ベッド外待機)`;
      optStage.style.fontWeight = 'bold';
      optStage.style.color = '#b45309';
      roomSelect.appendChild(optStage);

      master.rooms.forEach(r => {
        r.beds.forEach(bedId => {
          const opt = document.createElement('option');
          opt.value = bedId;
          opt.textContent = `${r.roomNo}号室 - ベッド ${bedId} (${r.type})`;
          roomSelect.appendChild(opt);
        });
      });
    }

    // 🛏️ 空床割当モーダル制御
    let targetAssignWard = '';
    let targetAssignRoom = '';

    function openAssignModal(ward, room) {
      targetAssignWard = ward;
      targetAssignRoom = room;
      document.getElementById('assignWardDisplay').textContent = ward;
      document.getElementById('assignRoomDisplay').textContent = room;
      const btnNew = document.getElementById('btnGoNewPatient');
      if (btnNew) {
        btnNew.href = `/patients?action=new&ward=${encodeURIComponent(ward)}&room=${encodeURIComponent(room)}`;
      }
      document.getElementById('assignModal').style.display = 'flex';
      filterAssignPatients();
      const input = document.getElementById('assignSearchInput');
      if (input) {
        input.value = '';
        input.focus();
      }
    }

    function closeAssignModal() {
      document.getElementById('assignModal').style.display = 'none';
    }

    function setAssignFormData(patientId) {
      document.getElementById(`assignFormWard_${patientId}`).value = targetAssignWard;
      document.getElementById(`assignFormRoom_${patientId}`).value = targetAssignRoom;
    }

    function filterAssignPatients() {
      const q = (document.getElementById('assignSearchInput').value || '').toLowerCase().trim();
      const onlyUnassigned = document.getElementById('filterOnlyUnassigned') ? document.getElementById('filterOnlyUnassigned').checked : false;

      document.querySelectorAll('.assign-patient-row').forEach(row => {
        const text = (row.getAttribute('data-search') || '').toLowerCase();
        const isUnassigned = row.getAttribute('data-unassigned') === '1';

        const matchesQuery = !q || text.includes(q);
        const matchesFilter = !onlyUnassigned || isUnassigned;

        row.style.display = (matchesQuery && matchesFilter) ? '' : 'none';
      });
    }


    // 初期化
    document.addEventListener('DOMContentLoaded', function() {
      try {
        const saved = localStorage.getItem('koyukai_current_patient');
        if (saved) {
          const p = JSON.parse(saved);
          if (p && p.patientId) {
            highlightSelectedPatient(p.patientId);
          }
        }
      } catch (_) {}
    });

    // キーボード ESC キーでモーダルを閉じる
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') {
        closePatientOrderModal();
        closeMoveModal();
        closeAssignModal();
      }
    });
  </script>
</body>
</html>
