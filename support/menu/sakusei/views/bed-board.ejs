<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>病棟・ベッドボード管理 - 交雄会だて病院</title>
  <link rel="stylesheet" href="/css/style.css">
  <style>
    .board-container {
      max-width: 1400px;
      margin: 1.5rem auto;
      padding: 0 1rem;
    }

    /* 上部統計カード */
    .board-stats {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: 1rem;
      margin-bottom: 1.5rem;
    }
    .board-stat-card {
      background: white;
      border-radius: 12px;
      padding: 1rem 1.25rem;
      border: 1px solid var(--slate-200);
      box-shadow: var(--shadow-sm);
      display: flex;
      align-items: center;
      gap: 1rem;
    }
    .board-stat-icon {
      font-size: 2rem;
      width: 52px;
      height: 52px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 10px;
    }
    .board-stat-num {
      font-size: 1.7rem;
      font-weight: 800;
      color: var(--slate-900);
      line-height: 1.2;
    }
    .board-stat-label {
      font-size: 0.8rem;
      color: var(--slate-500);
      font-weight: 600;
    }

    /* 病棟切り替えタブ */
    .ward-tabs {
      display: flex;
      gap: 0.5rem;
      margin-bottom: 1.5rem;
      border-bottom: 2px solid var(--slate-200);
      padding-bottom: 0.5rem;
    }
    .ward-tab-btn {
      padding: 0.65rem 1.4rem;
      border-radius: 8px 8px 0 0;
      font-weight: 700;
      font-size: 0.95rem;
      text-decoration: none;
      color: var(--slate-600);
      background: var(--slate-100);
      border: 1px solid var(--slate-200);
      border-bottom: none;
      transition: all 0.15s ease;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }
    .ward-tab-btn.active {
      background: #0284c7;
      color: white;
      border-color: #0284c7;
      box-shadow: 0 -2px 6px rgba(2, 132, 199, 0.2);
    }

    /* 部屋・ベッドグリッド */
    .rooms-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
      gap: 1.25rem;
    }
    .room-card {
      background: white;
      border-radius: 12px;
      border: 1px solid var(--slate-200);
      box-shadow: var(--shadow-sm);
      overflow: hidden;
      display: flex;
      flex-direction: column;
    }
    .room-header {
      background: #f8fafc;
      border-bottom: 1px solid var(--slate-200);
      padding: 0.6rem 1rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .room-number {
      font-size: 1.05rem;
      font-weight: 800;
      color: #0f172a;
      display: flex;
      align-items: center;
      gap: 0.35rem;
    }
    .room-badge {
      font-size: 0.72rem;
      padding: 0.15rem 0.45rem;
      border-radius: 4px;
      background: #e2e8f0;
      color: #475569;
      font-weight: 600;
    }

    /* ベッドスロット */
    .bed-slot-list {
      padding: 0.75rem;
      display: flex;
      flex-direction: column;
      gap: 0.65rem;
      flex: 1;
    }
    .bed-slot {
      border-radius: 8px;
      padding: 0.65rem 0.85rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      border: 1px solid var(--slate-200);
      transition: transform 0.15s ease, box-shadow 0.15s ease;
    }
    .bed-slot:hover {
      box-shadow: var(--shadow-sm);
    }
    
    /* 入床中のベッド */
    .bed-occupied {
      background: #f0fdf4;
      border-color: #86efac;
    }
    .bed-info-main {
      display: flex;
      flex-direction: column;
      gap: 0.15rem;
    }
    .bed-label {
      font-size: 0.76rem;
      font-weight: 800;
      color: #0f766e;
      display: flex;
      align-items: center;
      gap: 0.35rem;
    }
    .bed-patient-name {
      font-size: 0.95rem;
      font-weight: 800;
      color: #0f172a;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      padding: 0.15rem 0.35rem;
      margin: -0.15rem -0.35rem;
      border-radius: 6px;
      transition: all 0.18s ease;
      user-select: none;
    }
    .bed-patient-name:hover {
      color: #0284c7;
      background: #e0f2fe;
      text-decoration: underline;
    }
    .bed-slot.selected-patient-active {
      border: 2px solid #0284c7 !important;
      background: #f0f9ff !important;
      box-shadow: 0 0 0 3px rgba(2, 132, 199, 0.25) !important;
    }
    .staging-card.selected-patient-active {
      border: 2px solid #0284c7 !important;
      background: #f0f9ff !important;
      box-shadow: 0 0 0 3px rgba(2, 132, 199, 0.25) !important;
    }
    .select-badge-tag {
      font-size: 0.65rem;
      background: #0284c7;
      color: white;
      padding: 0.1rem 0.35rem;
      border-radius: 4px;
      font-weight: 700;
      letter-spacing: 0.02em;
    }
    .toast-notification {
      position: fixed;
      bottom: 24px;
      right: 24px;
      background: #0f172a;
      color: white;
      padding: 0.85rem 1.25rem;
      border-radius: 10px;
      box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.3), 0 4px 6px -2px rgba(0, 0, 0, 0.15);
      display: flex;
      align-items: center;
      gap: 0.75rem;
      z-index: 999999;
      animation: toastSlideUp 0.25s ease-out;
      border-left: 4px solid #0284c7;
      max-width: 600px;
    }
    @keyframes toastSlideUp {
      from { transform: translateY(100%); opacity: 0; }
      to { transform: translateY(0); opacity: 1; }
    }

    /* 空床のベッド */
    .bed-empty {
      background: #f8fafc;
      border: 1px dashed #cbd5e1;
    }
    .bed-empty:hover {
      background: #f1f5f9;
      border-color: #0284c7;
    }
    .bed-empty-label {
      font-size: 0.85rem;
      font-weight: 700;
      color: #94a3b8;
      display: flex;
      align-items: center;
      gap: 0.4rem;
    }

    /* モーダル */
    .modal-overlay {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.5);
      z-index: 100000;
      padding: 2rem;
      overflow-y: auto;
    }
    .modal-box {
      background: white;
      max-width: 500px;
      margin: 2rem auto;
      border-radius: 14px;
      padding: 1.75rem;
      box-shadow: var(--shadow-lg);
    }
    .assign-patient-row:hover {
      background-color: #f0fdf4 !important;
    }
    .assign-filter-pill {
      background: #f1f5f9;
      border: 1px solid #cbd5e1;
      color: #475569;
      padding: 0.25rem 0.65rem;
      border-radius: 14px;
      font-size: 0.75rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.15s ease;
    }
    .assign-filter-pill:hover {
      background: #e2e8f0;
      color: #0f172a;
    }
    .assign-filter-pill.active {
      background: #0d9488;
      color: white;
      border-color: #0d9488;
    }
  </style>
</head>
<body>

  <!-- 全画面共通 最上部1行リボン -->
  <%- include('partials/common-ribbon', { currentScreenTitle: '病棟・ベッドボード管理' }) %>

  <!-- ナビゲーションバー -->
  <header class="navbar">
    <a href="/menu" class="nav-brand">
      <div class="brand-icon">🛏️</div>
      <div class="brand-text">
        <h1>交雄会だて病院 医療統合ポータル</h1>
        <p>病棟・病床稼働マップ (ベッドボード)</p>
      </div>
    </a>
    <div class="nav-user">
      <div class="user-badge">
        <span class="dept-pill"><%= user.department %></span>
        <span class="user-name"><%= user.userName %> 職員</span>
      </div>
      <a href="/patients" class="btn btn-outline" style="width: auto; padding: 0.35rem 0.8rem; font-size: 0.82rem;">
        🏥 患者情報一覧
      </a>
      <a href="/menu" class="btn btn-outline" style="width: auto; padding: 0.35rem 0.8rem; font-size: 0.82rem;">
        🏠 メニューへ戻る
      </a>
    </div>
  </header>

  <main class="board-container">

    <% if (success) { %>
      <div class="alert alert-success" style="margin-bottom: 1rem; padding: 0.75rem 1rem; background: #dcfce7; color: #166534; border-radius: 8px;">
        ✅ <%= success %>
      </div>
    <% } %>
    <% if (error) { %>
      <div class="alert alert-danger" style="margin-bottom: 1rem; padding: 0.75rem 1rem; background: #fee2e2; color: #991b1b; border-radius: 8px;">
        ⚠️ <%= error %>
      </div>
    <% } %>

    <!-- 1. 病棟統計サマリー -->
    <div class="board-stats">
      <div class="board-stat-card">
        <div class="board-stat-icon" style="background:#e0f2fe; color:#0369a1;">🛏️</div>
        <div>
          <div class="board-stat-num"><%= stats.totalBeds %> <span style="font-size:0.9rem; font-weight:normal;">床</span></div>
          <div class="board-stat-label">病棟総病床数</div>
        </div>
      </div>
      <div class="board-stat-card">
        <div class="board-stat-icon" style="background:#dcfce7; color:#15803d;">👤</div>
        <div>
          <div class="board-stat-num" style="color:#15803d;"><%= stats.occupiedCount %> <span style="font-size:0.9rem; font-weight:normal;">名</span></div>
          <div class="board-stat-label">現在入床患者</div>
        </div>
      </div>
      <div class="board-stat-card">
        <div class="board-stat-icon" style="background:#fef3c7; color:#b45309;">✨</div>
        <div>
          <div class="board-stat-num" style="color:#b45309;"><%= stats.emptyCount %> <span style="font-size:0.9rem; font-weight:normal;">床</span></div>
          <div class="board-stat-label">空床数（受入可能）</div>
        </div>
      </div>
      <div class="board-stat-card">
        <div class="board-stat-icon" style="background:#f3e8ff; color:#7e22ce;">📊</div>
        <div>
          <div class="board-stat-num" style="color:#7e22ce;"><%= stats.occupancyRate %> <span style="font-size:0.9rem; font-weight:normal;">%</span></div>
          <div class="board-stat-label">病床稼働率</div>
        </div>
      </div>
    </div>

    <!-- ⚠️ ベッド外・一時待機エリア (ステージングトレイ) -->
    <% const stList = typeof stagingPatients !== 'undefined' ? stagingPatients : []; %>
    <div id="stagingAreaCard" style="background: <%= stList.length > 0 ? '#fffbeb' : '#f8fafc' %>; border: 2px <%= stList.length > 0 ? 'solid #f59e0b' : 'dashed var(--slate-300)' %>; border-radius: 14px; padding: 1.25rem 1.5rem; margin-bottom: 1.5rem; box-shadow: <%= stList.length > 0 ? '0 4px 12px rgba(245, 158, 11, 0.15)' : 'none' %>;">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem; flex-wrap: wrap; gap: 0.5rem;">
        <div style="display: flex; align-items: center; gap: 0.6rem;">
          <span style="font-size: 1.4rem;"><%= stList.length > 0 ? '🚨' : '🛏️' %></span>
          <div>
            <h3 style="margin: 0; font-size: 1.05rem; font-weight: 800; color: <%= stList.length > 0 ? '#92400e' : 'var(--slate-700)' %>;">
              ベッド外・一時待機エリア（ベッド移動・配置待機トレイ）
            </h3>
            <p style="margin: 0.15rem 0 0 0; font-size: 0.78rem; color: <%= stList.length > 0 ? '#b45309' : 'var(--slate-500)' %>;">
              <% if (stList.length > 0) { %>
                <strong style="color: #b91c1c;">⚠️ 現在 <%= stList.length %> 名がベッド外に一時待機しています。すべての待機患者をベッドまたは外来へ配置するまで画面遷移はロックされます。</strong>
              <% } else { %>
                ベッド移動や入替え時、一時的にベッド外へ退避させた患者がここに待機します（現在待機患者はいません）。
              <% } %>
            </p>
          </div>
        </div>

        <div>
          <% if (stList.length > 0) { %>
            <span style="background: #b91c1c; color: white; padding: 0.35rem 0.85rem; border-radius: 9999px; font-weight: 800; font-size: 0.82rem; display: inline-flex; align-items: center; gap: 0.35rem;">
              🔒 画面遷移ロック中 (<%= stList.length %>名待機)
            </span>
          <% } else { %>
            <span style="background: #e2e8f0; color: #475569; padding: 0.25rem 0.6rem; border-radius: 9999px; font-size: 0.75rem;">
              待機者なし（通常状態）
            </span>
          <% } %>
        </div>
      </div>

      <% if (stList.length > 0) { %>
        <!-- 待機中患者カード一覧 -->
        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 0.75rem; margin-top: 0.85rem;">
          <% stList.forEach(sp => { %>
            <div class="staging-card" data-patient-id="<%= sp.patientId %>" style="background: white; border: 1px solid #fcd34d; border-radius: 10px; padding: 0.85rem 1rem; box-shadow: var(--shadow-sm); display: flex; justify-content: space-between; align-items: center; transition: all 0.2s ease;">
              <div>
                <div class="bed-patient-name" 
                     onclick='selectPatientFromBoard(<%= JSON.stringify(sp) %>)' 
                     title="クリックして対象患者に選択（共通リボン連動・カルテ連携）">
                  <span>👤</span>
                  <span class="patient-name-text">[<%= sp.patientId %>] <%= sp.name %> 様</span>
                  <span class="select-badge-tag" style="display: none;">📌 選択中</span>
                </div>
                <div style="font-size: 0.75rem; color: var(--slate-500); margin-top: 0.2rem;">
                  <%= sp.age !== null ? sp.age + '歳' : '' %> (<%= sp.gender %>) ・ <%= sp.department || '内科' %>
                </div>
              </div>
              <div style="display: flex; gap: 0.35rem;">
                <button type="button" onclick="openMoveModal('<%= sp.patientId %>', '<%= sp.name %>', '<%= sp.age !== null ? sp.age : '' %>', '<%= selectedWard %>', '')" class="btn btn-primary" style="padding: 0.35rem 0.75rem; font-size: 0.78rem; background: #0284c7;" title="この患者を病室ベッドへ配置">
                  🛏️ ベッド配置
                </button>
                <form action="/api/bed-board/assign" method="POST" onsubmit="return confirm('患者 [<%= sp.name %>] を外来へ移動（待機解除）しますか？');" style="margin: 0;">
                  <input type="hidden" name="patientId" value="<%= sp.patientId %>">
                  <input type="hidden" name="action" value="discharge">
                  <input type="hidden" name="currentWard" value="<%= selectedWard %>">
                  <button type="submit" class="btn btn-outline" style="padding: 0.35rem 0.5rem; font-size: 0.75rem; color: #64748b;" title="外来へ移動">
                    外来
                  </button>
                </form>
              </div>
            </div>
          <% }); %>
        </div>
      <% } %>
    </div>

    <!-- 2. 病棟切り替えタブ -->
    <div class="ward-tabs">
      <% Object.keys(bedMaster).forEach(wKey => { %>
        <a href="/bed-board?ward=<%= encodeURIComponent(wKey) %>" class="ward-tab-btn <%= selectedWard === wKey ? 'active' : '' %>">
          <span><%= wKey.includes('しおかぜ') ? '🌊' : '🌲' %></span>
          <span><%= bedMaster[wKey].name %></span>
        </a>
      <% }); %>
    </div>

    <!-- 3. 病室・ベッド一覧グリッド -->
    <div class="rooms-grid">
      <% currentWardMaster.rooms.forEach(room => { %>
        <div class="room-card">
          <div class="room-header">
            <div class="room-number">
              <span>🚪</span> <%= room.roomNo %> 号室
            </div>
            <span class="room-badge"><%= room.type %> (<%= room.beds.length %>床)</span>
          </div>

          <div class="bed-slot-list">
            <% room.beds.forEach(bedId => { %>
              <% 
                // この病室・ベッドに割り当てられている患者を検索
                const occupant = patients.find(p => p.ward && p.ward.includes(currentWardMaster.wardKey.slice(0, 4)) && p.room === bedId);
              %>
              <% if (occupant) { %>
                <!-- 入床中スロット -->
                <div class="bed-slot bed-occupied" data-patient-id="<%= occupant.patientId %>">
                  <div class="bed-info-main">
                    <div class="bed-label">
                      <span>🛏️ <%= bedId %></span>
                      <span class="dept-pill" style="font-size:0.68rem; padding:0.1rem 0.35rem;"><%= occupant.department || '内科' %></span>
                    </div>
                    <div class="bed-patient-name" 
                         onclick='selectPatientFromBoard(<%= JSON.stringify(occupant) %>)' 
                         title="クリックして対象患者に選択（共通リボン連動・カルテ連携）">
                      <span>👤</span>
                      <span class="patient-name-text">[<%= occupant.patientId %>] <%= occupant.name %> 様</span>
                      <span class="select-badge-tag" style="display: none;">📌 選択中</span>
                    </div>
                    <div class="bed-patient-sub">
                      <span><%= occupant.age !== null ? occupant.age + '歳' : '' %> (<%= occupant.gender %>)</span>
                      <span>・ ADL: <%= occupant.mobility || '徒歩' %></span>
                      <% if (occupant.infection && occupant.infection !== '無') { %>
                        <span style="color:#b91c1c; font-weight:bold;">⚠️ <%= occupant.infection %></span>
                      <% } %>
                    </div>
                  </div>

                  <div style="display:flex; flex-direction:column; gap:0.25rem;">
                    <button type="button" 
                            onclick="openMoveModal('<%= occupant.patientId %>', '<%= occupant.name %>', '<%= occupant.age !== null ? occupant.age : '' %>', '<%= occupant.ward || currentWardMaster.wardKey %>', '<%= bedId %>')" 
                            class="btn btn-outline" style="padding:0.25rem 0.5rem; font-size:0.75rem; border-color:#0284c7; color:#0284c7;">
                      🔀 部屋変更
                    </button>
                    <form action="/api/bed-board/assign" method="POST" onsubmit="return confirm('患者 [<%= occupant.name %>] を一時退避エリア（ベッド外）へ退避しますか？\n（ベッドが空床になり、他の患者を配置できるようになります。待機患者がいる間は画面遷移が制限されます）');" style="margin:0;">
                      <input type="hidden" name="patientId" value="<%= occupant.patientId %>">
                      <input type="hidden" name="action" value="stage">
                      <input type="hidden" name="currentWard" value="<%= selectedWard %>">
                      <button type="submit" class="btn" style="background:#fef3c7; color:#b45309; padding:0.22rem 0.45rem; font-size:0.71rem; border:1px solid #fde68a; border-radius:4px; cursor:pointer; width:100%;" title="ベッド入替え作業のために一時的にベッド外へ退避">
                        ⚠️ 一時退避
                      </button>
                    </form>
                    <form action="/api/bed-board/assign" method="POST" onsubmit="return confirm('患者 [<%= occupant.name %>] をベッドから退室（外来へ移動）させますか？');" style="margin:0;">
                      <input type="hidden" name="patientId" value="<%= occupant.patientId %>">
                      <input type="hidden" name="action" value="discharge">
                      <input type="hidden" name="currentWard" value="<%= selectedWard %>">
                      <button type="submit" class="btn" style="background:#fee2e2; color:#991b1b; padding:0.22rem 0.45rem; font-size:0.71rem; border:none; border-radius:4px; cursor:pointer; width:100%;">
                        🚪 退室
                      </button>
                    </form>
                  </div>
                </div>
              <% } else { %>
                <!-- 空床スロット -->
                <div class="bed-slot bed-empty">
                  <div class="bed-empty-label">
                    <span>🛏️ <%= bedId %></span>
                    <span style="font-size:0.75rem; color:#10b981; font-weight:bold;">（空床）</span>
                  </div>
                  <button type="button" onclick="openAssignModal('<%= currentWardMaster.wardKey %>', '<%= bedId %>')" 
                          class="btn btn-primary" style="padding:0.3rem 0.7rem; font-size:0.75rem; background:#0d9488;">
                    ＋ 患者を割当
                  </button>
                </div>
              <% } %>
            <% }); %>
          </div>
        </div>
      <% }); %>
    </div>

  </main>

  <!-- 🔀 1. 部屋変更・病床移動モーダル（病棟・病室を選択する画面） -->
  <div id="moveModal" class="modal-overlay">
    <div class="modal-box" style="max-width: 520px;">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
        <h3 style="font-size:1.2rem; font-weight:800; color:#0f172a; margin:0; display:flex; align-items:center; gap:0.4rem;">
          <span>🔀</span> 患者の部屋変更・病床移動
        </h3>
        <button type="button" onclick="closeMoveModal()" style="background:none; border:none; font-size:1.4rem; cursor:pointer; color:var(--slate-400);">&times;</button>
      </div>

      <form action="/api/bed-board/assign" method="POST">
        <input type="hidden" name="currentWard" value="<%= selectedWard %>">
        <input type="hidden" name="patientId" id="movePatientId">

        <!-- 対象患者カード（変更不可・固定） -->
        <div style="background:#f1f5f9; border-radius:10px; padding:0.85rem 1rem; margin-bottom:1.25rem; border:1px solid #cbd5e1;">
          <div style="font-size:0.72rem; color:var(--slate-500); font-weight:700;">移動対象患者</div>
          <div style="font-size:1.05rem; font-weight:800; color:#0f172a; margin:0.25rem 0;" id="movePatientDisplay">
            --
          </div>
          <div style="font-size:0.8rem; color:#0284c7; display:flex; align-items:center; gap:0.35rem;">
            <span>📍 現在の病室:</span>
            <strong id="moveCurrentLocation" style="color:#0f172a;">--</strong>
          </div>
        </div>

        <!-- 移動先病棟の選択 -->
        <div class="form-group" style="margin-bottom:1rem;">
          <label class="form-label" style="font-weight:bold; font-size:0.85rem; color:#334155;">
            移動先病棟を選択 *
          </label>
          <select id="moveTargetWard" name="ward" class="form-input" required onchange="updateMoveRoomOptions()" style="font-size:0.9rem;">
            <% Object.keys(bedMaster).forEach(wKey => { %>
              <option value="<%= wKey %>" <%= selectedWard === wKey ? 'selected' : '' %>>
                <%= bedMaster[wKey].name %>
              </option>
            <% }); %>
            <option value="医療療養病棟">4F 医療療養病棟</option>
            <option value="プライム病棟">5F プライム病棟</option>
            <option value="集中治療室">集中治療室 (ICU)</option>
            <option value="一時待機">⚠️ 一時待機エリア（ベッド外退避・入替え）</option>
            <option value="外来">外来（退院・病室解放）</option>
          </select>
        </div>

        <!-- 移動先病室・ベッドの選択 -->
        <div class="form-group" style="margin-bottom:1.5rem;">
          <label class="form-label" style="font-weight:bold; font-size:0.85rem; color:#334155;">
            移動先病室・ベッドを選択 *
          </label>
          <select id="moveTargetRoom" name="room" class="form-input" required style="font-size:0.9rem;">
            <!-- JSで動的に空床・病室ベッドを生成 -->
          </select>
          <small style="color:var(--slate-500); font-size:0.75rem; display:block; margin-top:0.35rem;">
            ※ 【空床】と表示されているベッドを選択するとスムーズに移動できます。
          </small>
        </div>

        <div style="display:flex; justify-content:flex-end; gap:0.75rem;">
          <button type="button" onclick="closeMoveModal()" class="btn btn-outline" style="width:auto; padding:0.5rem 1.25rem;">
            キャンセル
          </button>
          <button type="submit" class="btn btn-primary" style="width:auto; padding:0.5rem 1.5rem; background:#0284c7; font-weight:bold;">
            💾 この部屋・ベッドへ移動する
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- 🛏️ 2. 空床への新規患者割当モーダル（患者一覧テーブルから選択） -->
  <div id="assignModal" class="modal-overlay" style="display: none;" onclick="handleAssignModalBackdropClick(event)">
    <div class="modal-card" style="max-width: 940px; width: 95%; max-height: 88vh; display: flex; flex-direction: column; border-radius: 14px; background: white; box-shadow: var(--shadow-lg); overflow: hidden; border: 1px solid #cbd5e1;" onclick="event.stopPropagation()">
      
      <!-- モーダルヘッダー -->
      <div style="display: flex; justify-content: space-between; align-items: flex-start; padding: 1.15rem 1.5rem; border-bottom: 1px solid var(--slate-200); background: #f8fafc;">
        <div>
          <div style="display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap;">
            <h3 style="font-size: 1.2rem; font-weight: 800; color: #0f172a; margin: 0; display: flex; align-items: center; gap: 0.4rem;">
              <span>🛏️</span> 空床への患者入床・割り当て
            </h3>
            <span style="background: #ccfbf1; color: #0f766e; border: 1px solid #99f6e4; font-weight: 800; font-size: 0.85rem; padding: 0.2rem 0.65rem; border-radius: 6px; display: inline-flex; align-items: center; gap: 0.3rem;">
              📍 割当先: <span id="assignTargetWardDisplay">--</span> / <strong id="assignTargetRoomDisplay" style="color: #0d9488;">--</strong>
            </span>
          </div>
          <p style="margin: 0.25rem 0 0 0; font-size: 0.8rem; color: #64748b;">
            入床させる患者を一覧から選択してください。行または「この患者を入床」ボタンを押すとベッドへ配置されます。
          </p>
        </div>
        <button type="button" onclick="closeAssignModal()" style="background: none; border: none; font-size: 1.4rem; cursor: pointer; color: var(--slate-400); padding: 0.1rem 0.4rem;" title="閉じる">&times;</button>
      </div>

      <!-- フィルター・検索バー -->
      <div style="padding: 0.85rem 1.5rem; background: white; border-bottom: 1px solid var(--slate-200); display: flex; flex-direction: column; gap: 0.65rem;">
        <div style="position: relative;">
          <input type="text" id="assignPatientSearchInput" placeholder="🔍 患者ID、氏名、カナ、現在の病室・所在、診療科で絞り込み..." oninput="filterAssignPatients()"
                 style="width: 100%; padding: 0.55rem 0.8rem 0.55rem 2.2rem; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 0.9rem; outline: none; box-sizing: border-box;">
          <span style="position: absolute; left: 0.75rem; top: 50%; transform: translateY(-50%); font-size: 0.95rem; color: #94a3b8;">🔍</span>
        </div>
        <div style="display: flex; gap: 0.4rem; flex-wrap: wrap; align-items: center;">
          <span style="font-size: 0.78rem; font-weight: 700; color: #64748b; margin-right: 0.2rem;">絞り込み:</span>
          <button type="button" class="assign-filter-pill active" data-filter="ALL" onclick="setAssignFilter('ALL', this)">すべて</button>
          <% if (stList.length > 0) { %>
            <button type="button" class="assign-filter-pill" data-filter="STAGING" onclick="setAssignFilter('STAGING', this)" style="border-color: #f59e0b; color: #b45309; font-weight: bold;">
              🚨 一時待機中 (<%= stList.length %>名)
            </button>
          <% } %>
          <button type="button" class="assign-filter-pill" data-filter="OUTPATIENT" onclick="setAssignFilter('OUTPATIENT', this)">外来（未入床）</button>
          <button type="button" class="assign-filter-pill" data-filter="INPATIENT" onclick="setAssignFilter('INPATIENT', this)">他病棟（転棟）</button>
        </div>
      </div>

      <!-- 隠し送信フォーム -->
      <form id="assignPatientForm" action="/api/bed-board/assign" method="POST" style="display: none;">
        <input type="hidden" name="currentWard" value="<%= selectedWard %>">
        <input type="hidden" name="ward" id="assignFormWard">
        <input type="hidden" name="room" id="assignFormRoom">
        <input type="hidden" name="patientId" id="assignFormPatientId">
      </form>

      <!-- 患者テーブルエリア（スクロール可能） -->
      <div style="flex: 1; overflow-y: auto; padding: 0;">
        <table style="width: 100%; border-collapse: collapse; font-size: 0.88rem; text-align: left;">
          <thead style="background: #f1f5f9; position: sticky; top: 0; z-index: 10; border-bottom: 1px solid #e2e8f0;">
            <tr>
              <th style="padding: 0.6rem 1rem; color: #475569; font-weight: 700; width: 95px;">患者ID</th>
              <th style="padding: 0.6rem 1rem; color: #475569; font-weight: 700;">氏名 (フリガナ)</th>
              <th style="padding: 0.6rem 1rem; color: #475569; font-weight: 700; width: 90px;">年齢/性別</th>
              <th style="padding: 0.6rem 1rem; color: #475569; font-weight: 700; width: 170px;">現在の所在・配置</th>
              <th style="padding: 0.6rem 1rem; color: #475569; font-weight: 700; width: 110px;">診療科</th>
              <th style="padding: 0.6rem 1rem; color: #475569; font-weight: 700; text-align: right; width: 150px;">割当操作</th>
            </tr>
          </thead>
          <tbody id="assignPatientTableBody">
            <% 
              // 一時待機中の患者を最優先で上にソート
              const sortedPatients = [...patients].sort((a, b) => {
                const aStaging = (a.ward === '一時待機') ? 1 : 0;
                const bStaging = (b.ward === '一時待機') ? 1 : 0;
                if (aStaging !== bStaging) return bStaging - aStaging;
                const aOut = (!a.room || a.ward === '外来') ? 1 : 0;
                const bOut = (!b.room || b.ward === '外来') ? 1 : 0;
                if (aOut !== bOut) return bOut - aOut;
                return (a.patientId || '').localeCompare(b.patientId || '');
              });
            %>
            <% sortedPatients.forEach(p => { %>
              <% 
                const isStaging = (p.ward === '一時待機');
                const isOutpatient = (!p.room || p.ward === '外来');
                let statusType = 'INPATIENT';
                if (isStaging) statusType = 'STAGING';
                else if (isOutpatient) statusType = 'OUTPATIENT';
              %>
              <tr class="assign-patient-row <%= isStaging ? 'row-staging-priority' : '' %>"
                  data-id="<%= p.patientId %>"
                  data-name="<%= p.name %>"
                  data-kana="<%= p.kana || '' %>"
                  data-ward="<%= p.ward || '' %>"
                  data-room="<%= p.room || '' %>"
                  data-dept="<%= p.department || '' %>"
                  data-status="<%= statusType %>"
                  onclick="submitAssignPatient('<%= p.patientId %>', '<%= p.name %>')"
                  style="border-bottom: 1px solid #f1f5f9; cursor: pointer; transition: background 0.15s ease; <%= isStaging ? 'background: #fffbeb;' : '' %>">
                <td style="padding: 0.75rem 1rem;">
                  <span style="background: #e2e8f0; color: #0f172a; font-family: monospace; font-weight: 700; padding: 0.15rem 0.45rem; border-radius: 4px; font-size: 0.85rem;">
                    <%= p.patientId %>
                  </span>
                </td>
                <td style="padding: 0.75rem 1rem;">
                  <div style="font-weight: 800; color: #0f172a; font-size: 0.95rem;">
                    <%= p.name %> 様
                    <% if (isStaging) { %>
                      <span style="font-size: 0.68rem; background: #b91c1c; color: white; padding: 0.1rem 0.35rem; border-radius: 4px; margin-left: 0.3rem;">⚠️ 一時待機中</span>
                    <% } %>
                  </div>
                  <div style="font-size: 0.72rem; color: #64748b;"><%= p.kana || '-' %></div>
                </td>
                <td style="padding: 0.75rem 1rem;">
                  <strong><%= p.age !== null ? p.age + '歳' : '-' %></strong>
                  <span style="font-size: 0.75rem; color: #64748b;">(<%= p.gender %>)</span>
                </td>
                <td style="padding: 0.75rem 1rem;">
                  <% if (isStaging) { %>
                    <span style="color: #b45309; font-weight: 800; font-size: 0.85rem;">
                      🚨 ベッド外一時待機
                    </span>
                  <% } else if (isOutpatient) { %>
                    <span style="color: #475569; font-weight: 600; font-size: 0.85rem;">
                      🏥 外来（未入床）
                    </span>
                  <% } else { %>
                    <span style="color: #0284c7; font-weight: 600; font-size: 0.82rem;">
                      🛏️ <%= p.ward %> <%= p.room %>
                    </span>
                  <% } %>
                </td>
                <td style="padding: 0.75rem 1rem;">
                  <span class="dept-pill" style="font-size: 0.72rem; background: #e0f2fe; color: #0369a1; border: 1px solid #bae6fd;">
                    <%= p.department || '一般' %>
                  </span>
                </td>
                <td style="padding: 0.75rem 1rem; text-align: right;">
                  <button type="button" class="btn btn-primary" 
                          onclick="event.stopPropagation(); submitAssignPatient('<%= p.patientId %>', '<%= p.name %>')"
                          style="padding: 0.35rem 0.75rem; font-size: 0.78rem; border-radius: 6px; background: #0d9488; display: inline-flex; align-items: center; gap: 0.3rem;"
                          title="この患者を選択したベッドに入床させます">
                    🛏️ 入床させる ➔
                  </button>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>

      <!-- モーダルフッター -->
      <div style="padding: 0.85rem 1.5rem; background: #f8fafc; border-top: 1px solid var(--slate-200); display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem;">
        <div style="display: flex; gap: 0.75rem; align-items: center;">
          <a href="/patients" class="btn btn-outline" style="width: auto; padding: 0.35rem 0.75rem; font-size: 0.8rem; color: #0284c7; border-color: #0284c7;">
            ➕ 患者の新規登録画面へ
          </a>
          <span style="font-size: 0.8rem; color: #64748b;" id="assignVisibleCount">
            表示中: <%= patients.length %> 名
          </span>
        </div>
        <button type="button" class="btn btn-outline" onclick="closeAssignModal()" style="width: auto; padding: 0.4rem 1.25rem; font-size: 0.85rem;">
          キャンセル
        </button>
      </div>

    </div>
  </div>

  <script>
    const BED_MASTER_DATA = <%- JSON.stringify(bedMaster) %>;
    const ALL_PATIENTS = <%- JSON.stringify(patients) %>;
    const STAGING_PATIENTS = <%- JSON.stringify(stList) %>;

    // 🔀 部屋変更モーダルを開く（患者固定、移動先病棟・病室を選択）
    function openMoveModal(patientId, name, age, currentWard, currentRoom) {
      document.getElementById('movePatientId').value = patientId;
      document.getElementById('movePatientDisplay').innerText = `[${patientId}] ${name} 様 ${age ? '(' + age + '歳)' : ''}`;
      document.getElementById('moveCurrentLocation').innerText = `${currentWard || '外来'} ${currentRoom || '未入床'}`;

      // 現在の病棟を初期選択
      const wardSelect = document.getElementById('moveTargetWard');
      if (currentWard && BED_MASTER_DATA[currentWard]) {
        wardSelect.value = currentWard;
      } else if (currentWard === '一時待機') {
        wardSelect.value = '<%= selectedWard %>'; // 待機患者は現在の表示病棟を初期選択
      }
      
      // 病室リストを生成
      updateMoveRoomOptions();

      document.getElementById('moveModal').style.display = 'block';
    }

    function closeMoveModal() {
      document.getElementById('moveModal').style.display = 'none';
    }

    // 移動先病棟が変更された時に、病室・ベッド選択肢を動的更新
    function updateMoveRoomOptions() {
      const wardSelect = document.getElementById('moveTargetWard');
      const roomSelect = document.getElementById('moveTargetRoom');
      const targetWard = wardSelect.value;
      const currentPatientId = document.getElementById('movePatientId').value;

      roomSelect.innerHTML = '';

      if (targetWard === '一時待機') {
        const opt = document.createElement('option');
        opt.value = '';
        opt.textContent = '⚠️ 一時待機エリア（ベッド外へ退避・入替え待機）';
        roomSelect.appendChild(opt);
        roomSelect.required = false;
        return;
      }

      if (targetWard === '外来') {
        const opt = document.createElement('option');
        opt.value = '';
        opt.textContent = '-- 外来（病室割り当てなし・退室）--';
        roomSelect.appendChild(opt);
        roomSelect.required = false;
        return;
      }

      roomSelect.required = true;
      const wardMaster = BED_MASTER_DATA[targetWard];
      
      if (!wardMaster || !wardMaster.rooms) {
        // マスタ未定義病棟の場合は自由テキスト入力または汎用選択肢
        const rooms = ['101', '102', '103', '201', '202', '301', '302', '401', '402'];
        rooms.forEach(r => {
          const opt = document.createElement('option');
          opt.value = r + '号室';
          opt.textContent = `🚪 ${r}号室`;
          roomSelect.appendChild(opt);
        });
        return;
      }

      const emptyGroup = document.createElement('optgroup');
      emptyGroup.label = '✨ 空床ベッド（推奨・即時移動可能）';

      const occupiedGroup = document.createElement('optgroup');
      occupiedGroup.label = '⚠️ 現在入床中ベッド（入床中患者は外来へ退避）';

      let hasEmpty = false;
      let hasOccupied = false;

      wardMaster.rooms.forEach(room => {
        room.beds.forEach(bedId => {
          const occ = ALL_PATIENTS.find(p => p.ward && p.ward.includes(targetWard.slice(0, 4)) && p.room === bedId);
          const opt = document.createElement('option');
          opt.value = bedId;

          if (!occ) {
            opt.textContent = `🛏️ ${bedId} 【空床】 (${room.roomNo}号室 ${room.type})`;
            emptyGroup.appendChild(opt);
            hasEmpty = true;
          } else if (occ.patientId === currentPatientId) {
            opt.textContent = `🛏️ ${bedId} 【現在のベッド】 (${room.roomNo}号室)`;
            opt.selected = true;
            emptyGroup.appendChild(opt);
            hasEmpty = true;
          } else {
            opt.textContent = `🛏️ ${bedId} (入床中: [${occ.patientId}] ${occ.name} 様)`;
            occupiedGroup.appendChild(opt);
            hasOccupied = true;
          }
        });
      });

      if (hasEmpty) roomSelect.appendChild(emptyGroup);
      if (hasOccupied) roomSelect.appendChild(occupiedGroup);
    }

    // 🛏️ 空床への割当モーダル（患者一覧テーブルから選択）
    let currentAssignFilter = 'ALL';

    function openAssignModal(ward, room) {
      document.getElementById('assignFormWard').value = ward;
      document.getElementById('assignFormRoom').value = room;
      document.getElementById('assignTargetWardDisplay').textContent = ward;
      document.getElementById('assignTargetRoomDisplay').textContent = room;
      
      const searchInput = document.getElementById('assignPatientSearchInput');
      if (searchInput) searchInput.value = '';
      currentAssignFilter = 'ALL';
      document.querySelectorAll('.assign-filter-pill').forEach(b => b.classList.remove('active'));
      const allPill = document.querySelector('.assign-filter-pill[data-filter="ALL"]');
      if (allPill) allPill.classList.add('active');

      filterAssignPatients();
      
      const modal = document.getElementById('assignModal');
      if (modal) {
        modal.style.display = 'flex';
        document.body.style.overflow = 'hidden';
      }
      if (searchInput) setTimeout(() => searchInput.focus(), 100);
    }

    function closeAssignModal() {
      const modal = document.getElementById('assignModal');
      if (modal) {
        modal.style.display = 'none';
        document.body.style.overflow = '';
      }
    }

    function handleAssignModalBackdropClick(e) {
      if (e.target.id === 'assignModal') {
        closeAssignModal();
      }
    }

    function setAssignFilter(filter, btn) {
      currentAssignFilter = filter;
      document.querySelectorAll('.assign-filter-pill').forEach(b => b.classList.remove('active'));
      if (btn) btn.classList.add('active');
      filterAssignPatients();
    }

    function filterAssignPatients() {
      const query = (document.getElementById('assignPatientSearchInput')?.value || '').toLowerCase().trim();
      const rows = document.querySelectorAll('.assign-patient-row');
      let visibleCount = 0;

      rows.forEach(row => {
        const id = (row.dataset.id || '').toLowerCase();
        const name = (row.dataset.name || '').toLowerCase();
        const kana = (row.dataset.kana || '').toLowerCase();
        const ward = (row.dataset.ward || '').toLowerCase();
        const room = (row.dataset.room || '').toLowerCase();
        const dept = (row.dataset.dept || '').toLowerCase();
        const status = row.dataset.status || '';

        // 1. 状態フィルター
        let statusMatch = false;
        if (currentAssignFilter === 'ALL') {
          statusMatch = true;
        } else if (currentAssignFilter === 'STAGING') {
          statusMatch = (status === 'STAGING');
        } else if (currentAssignFilter === 'OUTPATIENT') {
          statusMatch = (status === 'OUTPATIENT');
        } else if (currentAssignFilter === 'INPATIENT') {
          statusMatch = (status === 'INPATIENT');
        }

        // 2. 検索テキスト
        const textMatch = !query || 
                          id.includes(query) || 
                          name.includes(query) || 
                          kana.includes(query) || 
                          ward.includes(query) || 
                          room.includes(query) || 
                          dept.includes(query);

        if (statusMatch && textMatch) {
          row.style.display = '';
          visibleCount++;
        } else {
          row.style.display = 'none';
        }
      });

      const countEl = document.getElementById('assignVisibleCount');
      if (countEl) countEl.textContent = `表示中: ${visibleCount} 名`;
    }

    function submitAssignPatient(patientId, patientName) {
      const targetWard = document.getElementById('assignTargetWardDisplay').textContent;
      const targetRoom = document.getElementById('assignTargetRoomDisplay').textContent;
      
      if (!confirm(`患者 [${patientName} (${patientId})] を\n【${targetWard} / ${targetRoom}】に入床・割り当てしますか？`)) {
        return;
      }

      document.getElementById('assignFormPatientId').value = patientId;
      document.getElementById('assignPatientForm').submit();
    }

    window.onclick = function(event) {
      const moveModal = document.getElementById('moveModal');
      const assignModal = document.getElementById('assignModal');
      if (event.target === moveModal) moveModal.style.display = 'none';
      if (event.target === assignModal) assignModal.style.display = 'none';
    };

    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') {
        closeMoveModal();
        closeAssignModal();
      }
    });

    // 🔒 ベッド外一時待機中の画面遷移禁止ロック機能
    const hasStagingPatients = <%= (typeof stList !== 'undefined' && stList.length > 0) ? 'true' : 'false' %>;

    // 1. ブラウザの閉じる/戻る/リロード操作をブロック
    window.addEventListener('beforeunload', function(e) {
      if (hasStagingPatients) {
        e.preventDefault();
        e.returnValue = 'ベッド外に一時待機中の患者がいます。すべての待機患者をベッドまたは外来へ配置完了するまで移動できません。';
        return e.returnValue;
      }
    });

    // 2. ページ内のすべてのリンク（メニュー、他病棟タブ、リボンなど）のクリックをインターセプト
    if (hasStagingPatients) {
      document.addEventListener('click', function(e) {
        const link = e.target.closest('a');
        if (link) {
          const href = link.getAttribute('href');
          if (href && href !== '#' && !href.startsWith('javascript:')) {
            e.preventDefault();
            e.stopPropagation();
            alert('🚨 【画面遷移ロック中】\n\nベッド外（一時待機エリア）に患者が待機しています。\n患者の安全確保のため、すべての待機患者をベッドまたは外来へ配置完了するまで他の画面へ移動することはできません。\n\n一時待機エリアの「🛏️ ベッド配置」ボタンから空床へ割り当ててください。');
          }
        }
      }, true);
    }

    // 📌 ベッドボードの名前クリックで患者を選択する機能
    function selectPatientFromBoard(patient) {
      if (!patient || !patient.patientId) return;

      const patientData = {
        patientId: patient.patientId,
        name: patient.name,
        dob: patient.birthDate || '',
        age: patient.age !== null ? patient.age : '',
        ward: patient.ward || '',
        room: patient.room || ''
      };

      // 1. localStorage に保存 (全画面共通リボン用)
      try {
        localStorage.setItem('koyukai_current_patient', JSON.stringify(patientData));
      } catch (_) {}

      // 2. 共通リボンに即時反映
      if (typeof applyRibbonPatient === 'function') {
        applyRibbonPatient(patientData);
      }

      // 3. ベッドボード上の該当患者ベッド/カードをハイライト
      highlightSelectedPatientOnBoard(patient.patientId);

      // 4. トースト通知を表示（カルテを開くボタン付き）
      showPatientSelectedToast(patientData);
    }

    function highlightSelectedPatientOnBoard(patientId) {
      document.querySelectorAll('.bed-slot, .staging-card').forEach(el => {
        el.classList.remove('selected-patient-active');
        const tag = el.querySelector('.select-badge-tag');
        if (tag) tag.style.display = 'none';
      });

      if (!patientId) return;

      document.querySelectorAll(`[data-patient-id="${patientId}"]`).forEach(el => {
        el.classList.add('selected-patient-active');
        const tag = el.querySelector('.select-badge-tag');
        if (tag) tag.style.display = 'inline-block';
      });
    }

    function showPatientSelectedToast(patient) {
      const existing = document.getElementById('boardPatientToast');
      if (existing) existing.remove();

      const toast = document.createElement('div');
      toast.id = 'boardPatientToast';
      toast.className = 'toast-notification';
      toast.innerHTML = `
        <div style="font-size: 1.3rem;">📌</div>
        <div style="flex: 1;">
          <div style="font-size: 0.78rem; color: #94a3b8;">対象患者を選択しました（上部リボン連動中）</div>
          <div style="font-weight: 800; font-size: 0.95rem; color: #ffffff;">
            [${patient.patientId}] ${patient.name} 様 
            <span style="font-size: 0.8rem; font-weight: normal; color: #38bdf8;">(${patient.room || patient.ward || ''})</span>
          </div>
        </div>
        <div style="display: flex; gap: 0.4rem; align-items: center; flex-wrap: wrap;">
          <a href="/ordering/?patientId=${encodeURIComponent(patient.patientId)}" 
             class="btn btn-primary" 
             style="padding: 0.35rem 0.75rem; font-size: 0.78rem; text-decoration: none; border-radius: 6px; white-space: nowrap; background: #4f46e5; display: inline-flex; align-items: center; gap: 0.3rem;"
             title="この患者のオーダリング画面（放射線・処方・指示）を開く">
            📝 オーダリング
          </a>
          <a href="/sso/launch?app=articles&patientId=${encodeURIComponent(patient.patientId)}" 
             class="btn btn-primary" 
             style="padding: 0.35rem 0.75rem; font-size: 0.78rem; text-decoration: none; border-radius: 6px; white-space: nowrap; background: #0284c7; display: inline-flex; align-items: center; gap: 0.3rem;"
             title="この患者の電子カルテ記事を開く">
            🩺 カルテ
          </a>
          <a href="/sso/launch?app=radiology&patientId=${encodeURIComponent(patient.patientId)}" 
             class="btn btn-primary" 
             style="padding: 0.35rem 0.75rem; font-size: 0.78rem; text-decoration: none; border-radius: 6px; white-space: nowrap; background: #7c3aed; display: inline-flex; align-items: center; gap: 0.3rem;"
             title="放射線科オーダー発行（CT・透視・照射録）を開く">
            🩻 放射線
          </a>
          <button type="button" onclick="this.closest('#boardPatientToast').remove()" style="background: none; border: none; color: #94a3b8; font-size: 1.1rem; cursor: pointer; padding: 0.2rem 0.4rem;" title="閉じる">✕</button>
        </div>
      `;
      document.body.appendChild(toast);

      setTimeout(() => {
        if (toast && toast.parentNode) {
          toast.style.transition = 'opacity 0.4s ease, transform 0.4s ease';
          toast.style.opacity = '0';
          toast.style.transform = 'translateY(20px)';
          setTimeout(() => toast.remove(), 400);
        }
      }, 10000);
    }

    // 画面初期表示時に選択中患者があればハイライトを復元
    document.addEventListener('DOMContentLoaded', function() {
      try {
        const saved = localStorage.getItem('koyukai_current_patient');
        if (saved) {
          const p = JSON.parse(saved);
          if (p && p.patientId) {
            highlightSelectedPatientOnBoard(p.patientId);
          }
        }
      } catch (_) {}
    });
  </script>
</body>
</html>
