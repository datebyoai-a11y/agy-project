            <!-- <%= f %>22 (4人部屋) -->
            <%- renderRoomBox(`${f}22`, '4人部屋', [`${f}22-1`, `${f}22-2`, `${f}22-3`, `${f}22-4`], patients, selectedWard, false, 'right') %>

            <!-- 食堂兼談話室 (デイルーム) -->
            <div style="background:#fef3c7; border:1.5px solid #f59e0b; border-radius:6px; padding:0.4rem 0.6rem; display:flex; align-items:center; justify-content:space-between;">
              <div style="font-size:0.85rem; font-weight:800; color:#92400e; display:flex; align-items:center; gap:0.35rem;">
                <span>♿</span>
                <span>食堂兼談話室</span>
              </div>
              <span style="font-size:0.75rem; color:#b45309; font-weight:700;"><%= f %>F デイルーム</span>
            </div>

            <!-- <%= f %>23 (4人部屋) -->
            <%- renderRoomBox(`${f}23`, '4人部屋', [`${f}23-1`, `${f}23-2`, `${f}23-3`, `${f}23-4`], patients, selectedWard, false, 'right') %>

