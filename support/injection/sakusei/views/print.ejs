<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <title>注射指示箋 ＆ 輸液ラベル - <%= order.orderNumber %> - <%= order.patientName %></title>
  <style>
    @page {
      size: A4 portrait;
      margin: 10mm 15mm;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; font-family: "Hiragino Kaku Gothic ProN", "Meiryo", "BIZ UDPGothic", sans-serif; }
    body { background: #555; padding: 20px 0; color: #111; }
    .page-container {
      width: 210mm; min-height: 297mm; margin: 0 auto; background: white; padding: 12mm 15mm;
      box-shadow: 0 4px 15px rgba(0,0,0,0.3); position: relative;
    }

    @media print {
      body { background: transparent; padding: 0; }
      .page-container { width: 100%; min-height: auto; margin: 0; padding: 0; box-shadow: none; }
      .no-print { display: none !important; }
    }

    /* 印刷コントロールバー */
    .print-bar {
      position: fixed; top: 12px; right: 20px; z-index: 1000; display: flex; gap: 10px;
    }
    .btn-print-action {
      background: #059669; color: white; padding: 10px 18px; border-radius: 6px;
      font-size: 0.9rem; font-weight: bold; border: none; cursor: pointer; box-shadow: 0 2px 8px rgba(0,0,0,0.2);
    }
    .btn-print-action:hover { background: #047857; }
    .btn-close-action { background: #64748b; color: white; padding: 10px 14px; border-radius: 6px; text-decoration: none; font-size: 0.9rem; }

    /* セクション共通 */
    .section-box { border: 2px solid #334155; border-radius: 6px; padding: 14px; margin-bottom: 12mm; position: relative; }
    .section-title-wrap { display: flex; justify-content: space-between; align-items: flex-end; border-bottom: 2px solid #059669; padding-bottom: 6px; margin-bottom: 10px; }
    .hospital-name { font-size: 0.85rem; color: #475569; font-weight: 600; }
    .doc-main-title { font-size: 1.35rem; font-weight: 800; color: #0f172a; letter-spacing: 0.05em; }
    .order-badge { background: #059669; color: white; padding: 3px 8px; border-radius: 4px; font-size: 0.8rem; font-weight: 700; }

    /* 患者情報グリッド */
    .patient-grid {
      display: grid; grid-template-columns: 100px 1fr 100px 1fr; border: 1px solid #94a3b8; margin-bottom: 12px; font-size: 0.85rem;
    }
    .grid-label { background: #f1f5f9; padding: 6px 10px; font-weight: 700; border-right: 1px solid #94a3b8; border-bottom: 1px solid #94a3b8; color: #334155; }
    .grid-val { padding: 6px 10px; border-right: 1px solid #94a3b8; border-bottom: 1px solid #94a3b8; }
    .grid-val:last-child { border-right: none; }

    /* 処方・指示内容テーブル */
    .order-table { width: 100%; border-collapse: collapse; margin-bottom: 12px; font-size: 0.9rem; }
    .order-table th { background: #f8fafc; border: 1px solid #94a3b8; padding: 8px 10px; text-align: left; font-weight: 700; }
    .order-table td { border: 1px solid #94a3b8; padding: 10px; vertical-align: top; }

    /* スタンプ欄 */
    .stamp-row { display: flex; justify-content: flex-end; gap: 12px; margin-top: 10px; }
    .stamp-box { width: 70px; height: 70px; border: 1px solid #94a3b8; text-align: center; font-size: 0.75rem; color: #64748b; display: flex; flex-direction: column; justify-content: space-between; padding: 4px; }
    .stamp-box .stamp-label { border-bottom: 1px dashed #cbd5e1; padding-bottom: 2px; }

    /* キリトリ線 */
    .cut-line {
      border-top: 2px dashed #94a3b8; position: relative; margin: 16mm 0 14mm 0; text-align: center;
    }
    .cut-line-text {
      position: absolute; top: -10px; left: 50%; transform: translateX(-50%); background: white; padding: 0 14px;
      font-size: 0.75rem; color: #64748b; font-weight: 600;
    }

    /* ボトル貼付ラベル */
    .label-box {
      border: 3px double #059669; border-radius: 8px; padding: 14px; background: #fff;
    }
    .label-header { display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid #059669; padding-bottom: 6px; margin-bottom: 10px; }
    .label-title { font-size: 1.15rem; font-weight: 800; color: #047857; }
    .label-alert { font-size: 0.75rem; background: #fef2f2; color: #b91c1c; border: 1px solid #f87171; padding: 2px 8px; border-radius: 4px; font-weight: bold; }
  </style>
</head>
<body>

  <!-- 印刷用ボタン (印刷時は非表示) -->
  <div class="print-bar no-print">
    <button class="btn-print-action" onclick="window.print()">🖨️ この伝票を印刷する (Ctrl+P)</button>
    <a href="javascript:window.close()" class="btn-close-action">✕ 閉じる</a>
  </div>

  <div class="page-container">

    <!-- ========================================== -->
    <!-- 上部: 注射指示箋 (医師指示確認・カルテ保管用) -->
    <!-- ========================================== -->
    <div class="section-box">
      <div class="section-title-wrap">
        <div>
          <div class="hospital-name">医療法人社団 交雄会 だて病院</div>
          <div class="doc-main-title">💉 注 射 指 示 票 (カルテ原本)</div>
        </div>
        <div style="text-align: right;">
          <span class="order-badge"><%= order.orderType %></span>
          <div style="font-size: 0.8rem; font-weight: bold; margin-top: 4px;">No. <%= order.orderNumber %></div>
        </div>
      </div>

      <!-- 患者情報 -->
      <div class="patient-grid">
        <div class="grid-label">患者番号</div>
        <div class="grid-val"><strong><%= order.patientId %></strong></div>
        <div class="grid-label">氏名</div>
        <div class="grid-val"><strong style="font-size: 1.05rem;"><%= order.patientName %></strong> 殿</div>

        <div class="grid-label">病棟 / 病室</div>
        <div class="grid-val"><%= order.ward || '一般病棟' %> <%= order.roomNo ? order.roomNo + '号室' : '' %> <%= order.bedNo ? '(' + order.bedNo + ')' : '' %></div>
        <div class="grid-label">性別 / 年齢</div>
        <div class="grid-val"><%= order.gender || '-' %> / <%= order.age || '-' %></div>

        <div class="grid-label">指示医師</div>
        <div class="grid-val">Dr. <%= order.orderingDoctor %> (<%= order.department %>)</div>
        <div class="grid-label">指示日時</div>
        <div class="grid-val"><%= new Date(order.createdAt).toLocaleString('ja-JP') %></div>
      </div>

      <!-- 薬剤・投与内容 -->
      <table class="order-table">
        <thead>
          <tr>
            <th style="width: 55%;">薬品名・規格</th>
            <th style="width: 15%;">数量・用量</th>
            <th style="width: 30%;">用法・投与速度・タイミング</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>
              <strong style="font-size: 1rem; color: #047857;">[主輸液] <%= order.mainMedicine %></strong>
              <% if (order.mixedMedicines && order.mixedMedicines.length > 0) { %>
                <div style="margin-top: 8px; padding-left: 8px; border-left: 3px solid #f59e0b;">
                  <strong style="font-size: 0.85rem; color: #b45309;">【混注・側管薬剤】</strong><br>
                  <% order.mixedMedicines.forEach(m => { %>
                    <div style="font-size: 0.85rem;">・<%= m.medicineName %> (<%= m.dose || '規定量' %>) [<%= m.timing || '混注' %>]</div>
                  <% }); %>
                </div>
              <% } %>
            </td>
            <td>
              <strong><%= order.dose %></strong>
            </td>
            <td>
              <div><strong>投与経路:</strong> <%= order.orderType %></div>
              <div style="margin-top: 4px;"><strong>速度:</strong> <%= order.rate %></div>
              <div style="margin-top: 4px;"><strong>開始予定:</strong> <%= new Date(order.scheduledAt).toLocaleString('ja-JP', {month:'2-digit', day:'2-digit', hour:'2-digit', minute:'2-digit'}) %></div>
            </td>
          </tr>
          <% if (order.remarks) { %>
            <tr>
              <td colspan="3" style="background: #fefce8; font-size: 0.85rem;">
                <strong>⚠️ 特記事項・看護指示:</strong> <%= order.remarks %>
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>

      <!-- 署名・スタンプ欄 -->
      <div class="stamp-row">
        <div class="stamp-box">
          <div class="stamp-label">指示医師</div>
          <div style="font-weight: bold; font-size: 0.75rem; margin-top: 14px;"><%= order.orderingDoctor %></div>
        </div>
        <div class="stamp-box">
          <div class="stamp-label">調剤確認</div>
          <div></div>
        </div>
        <div class="stamp-box">
          <div class="stamp-label">実施看護師</div>
          <div></div>
        </div>
      </div>
    </div>

    <!-- キリトリ線 -->
    <div class="cut-line">
      <span class="cut-line-text">✂️ キリトリ線（輸液ボトル・シリンジ貼付用ラベル） ✂️</span>
    </div>

    <!-- ========================================== -->
    <!-- 下部: 輸液ボトル・シリンジ貼付用ラベル (ベッドサイド照合用) -->
    <!-- ========================================== -->
    <div class="label-box">
      <div class="label-header">
        <div>
          <span class="label-title">🏷️ 輸液・点滴ボトル貼付ラベル</span>
          <span style="font-size: 0.8rem; color: #64748b; margin-left: 10px;">だて病院 病棟看護部</span>
        </div>
        <div>
          <span class="label-alert">⚠️ 三点照合必須 (患者・薬品・時間)</span>
        </div>
      </div>

      <!-- ラベル患者情報 -->
      <div style="display: flex; justify-content: space-between; background: #ecfdf5; border: 1px solid #a7f3d0; padding: 8px 12px; border-radius: 6px; margin-bottom: 10px;">
        <div>
          <span style="font-size: 0.75rem; color: #047857;">診察券番号:</span>
          <strong style="font-size: 1.1rem; margin-right: 12px;"><%= order.patientId %></strong>
          <span style="font-size: 0.75rem; color: #047857;">患者氏名:</span>
          <strong style="font-size: 1.3rem;"><%= order.patientName %></strong> 殿
        </div>
        <div style="text-align: right; font-size: 0.9rem; font-weight: bold;">
          <%= order.ward || '病棟' %> <%= order.roomNo ? order.roomNo + '号室' : '' %>
        </div>
      </div>

      <!-- 輸液内容 -->
      <table class="order-table" style="margin-bottom: 8px;">
        <tbody>
          <tr>
            <td style="width: 65%;">
              <div style="font-size: 1.15rem; font-weight: 800; color: #065f46;">
                <%= order.mainMedicine %> (<%= order.dose %>)
              </div>
              <% if (order.mixedMedicines && order.mixedMedicines.length > 0) { %>
                <div style="margin-top: 4px; font-size: 0.85rem; color: #b45309; font-weight: bold;">
                  【混注薬】: <%= order.mixedMedicines.map(m => m.medicineName + ' ' + (m.dose||'')).join(', ') %>
                </div>
              <% } %>
            </td>
            <td style="width: 35%;">
              <div style="font-size: 0.95rem;"><strong>速度:</strong> <%= order.rate %></div>
              <div style="font-size: 0.85rem; margin-top: 4px;"><strong>開始予定:</strong> <%= new Date(order.scheduledAt).toLocaleString('ja-JP', {month:'2-digit', day:'2-digit', hour:'2-digit', minute:'2-digit'}) %></div>
            </td>
          </tr>
        </tbody>
      </table>

      <!-- ベッドサイド照合スタンプ欄 -->
      <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 6px;">
        <div style="font-size: 0.75rem; color: #64748b;">
          指示No: <%= order.orderNumber %> | 指示医: <%= order.orderingDoctor %>
        </div>
        <div style="display: flex; gap: 8px;">
          <div class="stamp-box" style="width: 60px; height: 55px;">
            <div class="stamp-label" style="font-size: 0.65rem;">ミキシング</div>
          </div>
          <div class="stamp-box" style="width: 60px; height: 55px;">
            <div class="stamp-label" style="font-size: 0.65rem;">投与開始</div>
          </div>
          <div class="stamp-box" style="width: 60px; height: 55px;">
            <div class="stamp-label" style="font-size: 0.65rem;">ダブルチェック</div>
          </div>
        </div>
      </div>
    </div>

  </div>

</body>
</html>
