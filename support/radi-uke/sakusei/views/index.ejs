<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>放射線科 指示受け・実施モニター | 交雄会だて病院</title>
  <link rel="stylesheet" href="<%= prefix %>/css/style.css">
  <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220%22%20%220%22%20100%20100><text y=%22.9em%22 font-size=%2290%22>🩻</text></svg>">
</head>
<body>

  <!-- 1. 全システム共通 最上部1行リボンヘッダー -->
  <%- include('partials/common-ribbon', { 
        user: user, 
        currentScreenTitle: '🩻 放射線科 指示受け・実施モニター' 
      }) %>

  <!-- 2. 統計・操作バー (タイトル画面は撤廃し、業務バーのみコンパクト配置) -->
  <header class="main-header" style="padding:0.4rem 1.25rem;">
    <!-- 統計サマリー -->
    <div class="stats-summary">
      <div class="stat-pill stat-ordered" title="未受付オーダー件数">
        <span>🟡 未受付:</span>
        <span class="stat-num" id="statOrdered">0</span>
      </div>
      <div class="stat-pill stat-accepted" title="受付済・待機中件数">
        <span>🔵 受付済:</span>
        <span class="stat-num" id="statAccepted">0</span>
      </div>
      <div class="stat-pill stat-completed" title="実施済件数">
        <span>🟢 実施済:</span>
        <span class="stat-num" id="statCompleted">0</span>
      </div>
      <div class="stat-pill stat-portable" title="ポータブル撮影件数">
        <span>🚨 ポータブル:</span>
        <span class="stat-num" id="statPortable">0</span>
      </div>
    </div>

    <!-- アクションボタン -->
    <div class="header-actions">
      <button type="button" class="btn btn-outline" onclick="openLogModal()" style="background:#f8fafc; border-color:#94a3b8; color:#334155;" title="操作監査ログの閲覧およびDB再構築ツールを開く">
        📜 操作・監査ログ
      </button>
      <a href="/radiology/" class="btn btn-outline" title="放射線科オーダー入力・正控え帳票印刷を開く">
        📝 オーダー発行・印刷 ➔
      </a>
    </div>
  </header>

  <!-- 3. コントロールバー (フィルター / 検索 / 表示切替 / 更新) -->
  <div class="control-bar">
    <!-- 絞り込みフィルター -->
    <div class="filter-group">
      <button class="filter-btn active" data-filter="ACTIVE">⏳ 実施待ち (未受付+受付済)</button>
      <button class="filter-btn" data-filter="ALL">📑 すべて表示 (一覧)</button>
      <button class="filter-btn" data-filter="ORDERED">🟡 未受付のみ</button>
      <button class="filter-btn" data-filter="COMPLETED">✅ 実施済のみ</button>
    </div>

    <!-- 検索ボックス -->
    <div class="search-box">
      <span>🔍</span>
      <input type="text" id="searchInput" placeholder="患者名・ID・部位・病棟で絞込...">
    </div>

    <!-- 更新ステータス -->
    <div class="header-actions">
      <div class="polling-indicator">
        <span class="pulse-dot"></span>
        <span>自動更新中 (4秒)</span>
      </div>
      <button id="refreshBtn" class="btn btn-refresh" title="手動で今すぐ更新">
        🔄 今すぐ更新
      </button>
    </div>
  </div>

  <!-- 4.1 モダリティ別 縦3列 (Kanban) コンテナ -->
  <main class="kanban-container" id="kanbanContainer">
    
    <!-- 📷 列1: 一般撮影・X線 -->
    <section class="kanban-column" id="colXray">
      <div class="col-header col-header-xray">
        <div class="col-title-area">
          <span class="col-icon">📷</span>
          <div>
            <div class="col-title">一般撮影 (X-Ray)</div>
            <div class="col-subtitle">単純撮影 / ポータブル / 診療照射録</div>
          </div>
        </div>
        <div class="col-badges">
          <span class="badge-count col-count-badge" id="badgeXrayCount" title="下にある情報の件数">0件</span>
        </div>
      </div>
      <div class="col-body" id="xrayCardList">
        <!-- 動的カード挿入 -->
      </div>
    </section>

    <!-- 🌀 列2: CT検査 -->
    <section class="kanban-column" id="colCt">
      <div class="col-header col-header-ct">
        <div class="col-title-area">
          <span class="col-icon">🌀</span>
          <div>
            <div class="col-title">CT検査 (CT)</div>
            <div class="col-subtitle">単純CT / 造影CT / ダイナミック</div>
          </div>
        </div>
        <div class="col-badges">
          <span class="badge-count col-count-badge" id="badgeCtCount" title="下にある情報の件数">0件</span>
        </div>
      </div>
      <div class="col-body" id="ctCardList">
        <!-- 動的カード挿入 -->
      </div>
    </section>

    <!-- 📺 列3: X線透視 -->
    <section class="kanban-column" id="colFluoro">
      <div class="col-header col-header-fluoro">
        <div class="col-title-area">
          <span class="col-icon">📺</span>
          <div>
            <div class="col-title">X線透視 (Fluoroscopy)</div>
            <div class="col-subtitle">TV透視 / 嚥下造影 / PEG交換 / 整復</div>
          </div>
        </div>
        <div class="col-badges">
          <span class="badge-count col-count-badge" id="badgeFluoroCount" title="下にある情報の件数">0件</span>
        </div>
      </div>
      <div class="col-body" id="fluoroCardList">
        <!-- 動的カード挿入 -->
      </div>
    </section>

  </main>

  <!-- 4.2 一覧形式 (テーブルビュー) コンテナ (「すべて表示」選択時に自動表示) -->
  <div class="list-view-container" id="listViewContainer" style="display: none;">
    <div class="table-card">
      <div class="table-header-info">
        <div class="table-title">
          <span>📋</span>
          <span>放射線オーダー 一覧テーブル</span>
          <span id="tableCountBadge" class="brand-badge" style="background:#0284c7;">0件</span>
          <span id="currentSortBadge" class="sort-status-badge" style="font-size: 0.78rem; color: #475569; background: #f1f5f9; border: 1px solid #cbd5e1; padding: 2px 8px; border-radius: 4px; margin-left: 10px;">
            🔽 指示日時 (新しい順)
          </span>
          <button id="btnResetSort" class="btn-reset-sort" title="ソートを初期状態(新着順)に戻す" style="display: none; font-size: 0.75rem; background: #ffffff; border: 1px solid #cbd5e1; border-radius: 4px; padding: 2px 8px; cursor: pointer; color: #64748b; margin-left: 6px;">
            🔄 初期順に戻す
          </button>
        </div>
        <div style="font-size: 0.8rem; color: var(--text-muted);">
          ※項目名をクリックすると昇順・降順で並び替えできます。
        </div>
      </div>
      <div class="table-wrapper">
        <table class="orders-table">
          <thead>
            <tr>
              <th class="th-sortable" data-sort="status" style="width: 85px;" title="クリックで状態順に並び替え">状態 <span class="sort-icon">↕️</span></th>
              <th class="th-sortable" data-sort="modality" style="width: 95px;" title="クリックで区分順に並び替え">区分 <span class="sort-icon">↕️</span></th>
              <th class="th-sortable sorted-desc" data-sort="date" style="width: 155px;" title="クリックで指示日時順に並び替え">オーダー番号 / 時刻 <span class="sort-icon">▼</span></th>
              <th class="th-sortable" data-sort="patient" style="width: 180px;" title="クリックで患者名順に並び替え">患者情報 <span class="sort-icon">↕️</span></th>
              <th class="th-sortable" data-sort="exam" title="クリックで検査種別・部位順に並び替え">検査種別 / 部位 / 条件 <span class="sort-icon">↕️</span></th>
              <th class="th-sortable" data-sort="purpose" title="クリックで目的順に並び替え">検査目的・臨床所見 <span class="sort-icon">↕️</span></th>
              <th class="th-sortable" data-sort="doctor" style="width: 120px;" title="クリックで依頼医師順に並び替え">依頼医師 <span class="sort-icon">↕️</span></th>
              <th class="th-sortable" data-sort="operator" style="width: 150px;" title="クリックで対応技師順に並び替え">対応技師 / 日時 <span class="sort-icon">↕️</span></th>
              <th style="width: 160px; text-align: center;">操作</th>
            </tr>
          </thead>
          <tbody id="ordersTableBody">
            <!-- 動的一覧行挿入 -->
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- 📜 操作・監査ログ & DB再構築モーダル -->
  <div id="logModal" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(15,23,42,0.75); z-index:9999; justify-content:center; align-items:center; backdrop-filter:blur(2px);">
    <div style="background:white; width:92%; max-width:1050px; height:85vh; border-radius:12px; display:flex; flex-direction:column; box-shadow:0 25px 50px -12px rgba(0,0,0,0.5); overflow:hidden;">
      <div style="padding:1rem 1.5rem; background:#0f172a; color:white; display:flex; justify-content:space-between; align-items:center;">
        <div style="display:flex; align-items:center; gap:10px;">
          <span style="font-size:1.4rem;">📜</span>
          <div>
            <div style="font-weight:bold; font-size:1.1rem;">操作監査ログ・データベース再構築コンソール</div>
            <div style="font-size:0.75rem; color:#94a3b8;">各操作の可読ログ生成 ＆ ログからの完全データベース復元 (Rebuild/Restore)</div>
          </div>
        </div>
        <div style="display:flex; align-items:center; gap:8px;">
          <button type="button" onclick="loadReadableLog()" style="background:#334155; color:white; border:none; padding:5px 12px; cursor:pointer; border-radius:4px; font-size:0.8rem; font-weight:bold;">🔄 ログ再読込</button>
          <button type="button" onclick="closeLogModal()" style="background:none; border:none; color:#cbd5e1; font-size:1.6rem; cursor:pointer; line-height:1;">&times;</button>
        </div>
      </div>
      
      <!-- ツールバー: 再構築実行ボタン & ローテーション -->
      <div style="padding:0.75rem 1.5rem; background:#f8fafc; border-bottom:1px solid #e2e8f0; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:8px;">
        <div style="display:flex; align-items:center; gap:8px;">
          <span style="font-size:0.82rem; color:#475569;">📦 ログ切替:</span>
          <select id="selLogArchive" onchange="switchLogView(this.value)" style="padding:4px 8px; border-radius:4px; border:1px solid #cbd5e1; font-size:0.8rem; background:white; color:#1e293b;">
            <option value="CURRENT">🟢 本日の最新ログ (リアルタイム)</option>
          </select>
          <button type="button" onclick="triggerLogRotate()" style="background:#f1f5f9; border:1px solid #94a3b8; color:#334155; padding:4px 10px; border-radius:4px; font-size:0.78rem; cursor:pointer;" title="前日以前のログを即時 .gz 圧縮">
            🗜️ 日次ローテート (.gz圧縮)
          </button>
        </div>
        <div style="display:flex; gap:8px;">
          <button type="button" onclick="triggerDbRebuild(true)" style="background:#0284c7; color:white; border:none; padding:6px 14px; border-radius:6px; font-size:0.82rem; font-weight:bold; cursor:pointer;" title="DBには書き込まずログの解析検証のみ実行">
            🔍 再構築シミュレーション (Dry-Run)
          </button>
          <button type="button" onclick="triggerDbRebuild(false)" style="background:#059669; color:white; border:none; padding:6px 14px; border-radius:6px; font-size:0.82rem; font-weight:bold; cursor:pointer;" title="ログからDBへ実際にリストア・同期">
            🔄 ログからDB再構築を実行
          </button>
        </div>
      </div>

      <!-- ログ本文表示エリア -->
      <div style="flex:1; padding:1.2rem 1.5rem; overflow-y:auto; background:#0f172a; color:#f8fafc;">
        <pre id="logContentArea" style="margin:0; font-family:'Fira Code', Consolas, Monaco, monospace; font-size:0.82rem; line-height:1.5; white-space:pre-wrap; word-break:break-all; color:#e2e8f0;">ログを読み込んでいます...</pre>
      </div>

      <div style="padding:0.6rem 1.5rem; background:#f1f5f9; border-top:1px solid #e2e8f0; display:flex; justify-content:space-between; align-items:center; font-size:0.75rem; color:#64748b;">
        <span>※CLIコマンド: <code>./scripts/rebuild-db.sh</code> (または <code>/home/a/script/rebuild-db.sh</code>) でも実行可能です。</span>
        <button type="button" onclick="closeLogModal()" style="padding:4px 14px; background:#64748b; color:white; border:none; border-radius:4px; cursor:pointer;">閉じる</button>
      </div>
    </div>
  </div>

  <!-- トースト通知コンテナ -->
  <div id="toastContainer"></div>

  <!-- クライアント設定 & スクリプト -->
  <script>
    window.APP_PREFIX = '<%= prefix %>';
    window.CURRENT_USER_NAME = '<%= user ? (user.userName || user.name || "放射線技師") : "放射線技師" %>';
  </script>
  <script src="<%= prefix %>/js/app.js"></script>
</body>
</html>
