  <!-- 💻 スクリプト処理 (原本伝票連動 & データ同期) -->
  <!-- ===================================================================== -->
  <script>
    // 様式切り替え (CT, FLUORO, XRAY)
    function switchFormType(type) {
      document.getElementById('inputFormType').value = type;

      // タブボタンのアクティブ状態
      document.querySelectorAll('.form-tab-btn').forEach(btn => btn.classList.remove('active'));
      const activeBtn = document.getElementById('tabBtn_' + type);
      if (activeBtn) activeBtn.classList.add('active');

      // 伝票用紙の表示切り替え
      document.getElementById('paper_CT').style.display = (type === 'CT') ? 'block' : 'none';
      document.getElementById('paper_FLUORO').style.display = (type === 'FLUORO') ? 'block' : 'none';
      document.getElementById('paper_XRAY').style.display = (type === 'XRAY') ? 'block' : 'none';

      // プリセットチップの表示切り替え
      document.getElementById('presets_CT').style.display = (type === 'CT') ? 'flex' : 'none';
      document.getElementById('presets_FLUORO').style.display = (type === 'FLUORO') ? 'flex' : 'none';
      document.getElementById('presets_XRAY').style.display = (type === 'XRAY') ? 'flex' : 'none';
    }

    // カスタムチェックボックスのUIトグル
    function toggleCustomChk(chk, boxId) {
      const box = document.getElementById(boxId);
      if (box) {
        if (chk.checked) box.classList.add('checked');
        else box.classList.remove('checked');
      }
    }

    // 丸囲み選択肢の制御
    function setGender(g) {
      document.getElementById('inputGender').value = g;
      ['ct', 'fl', 'xr'].forEach(prefix => {
        const m = document.getElementById(`${prefix}_gender_M`);
        const f = document.getElementById(`${prefix}_gender_F`);
        if (m && f) {
          m.classList.toggle('selected', g === '男');
          f.classList.toggle('selected', g === '女');
        }
      });
    }

    function setWard(w) {
      document.getElementById('inputWard').value = w;
      ['ct', 'fl', 'xr'].forEach(prefix => {
        const out = document.getElementById(`${prefix}_ward_out`);
        const ward = document.getElementById(`${prefix}_ward_ward`);
        const med = document.getElementById(`${prefix}_ward_med`);
        const shio = document.getElementById(`${prefix}_ward_shio`);
        const umi = document.getElementById(`${prefix}_ward_umi`);
        if (out) out.classList.toggle('selected', w === '外来');
        if (ward) ward.classList.toggle('selected', w === '病棟');
        if (med) med.classList.toggle('selected', w === '医療');
        if (shio) shio.classList.toggle('selected', w.includes('しおかぜ'));
        if (umi) umi.classList.toggle('selected', w.includes('うみかぜ'));
      });
    }

    function setMobility(m) {
      document.getElementById('inputMobility').value = m;
      ['ct', 'fl', 'xr'].forEach(prefix => {
        const walk = document.getElementById(`${prefix}_mob_walk`);
        const wheel = document.getElementById(`${prefix}_mob_wheel`);
        const bed = document.getElementById(`${prefix}_mob_bed`);
        const stret = document.getElementById(`${prefix}_mob_stret`);
        if (walk) walk.classList.toggle('selected', m === '徒歩');
        if (wheel) wheel.classList.toggle('selected', m === '車椅子');
        if (bed) bed.classList.toggle('selected', m === 'ベッド');
        if (stret) stret.classList.toggle('selected', m === 'ストレッチャー');
      });
    }

    function setInfection(inf) {
      document.getElementById('inputInfection').value = inf;
      const isNone = (!inf || inf === '無');
      ['ct', 'fl', 'xr'].forEach(prefix => {
        const no = document.getElementById(`${prefix}_inf_no`);
        const yes = document.getElementById(`${prefix}_inf_yes`);
        const note = document.getElementById(`${prefix}_infection_note`);
        if (no) no.classList.toggle('selected', isNone);
        if (yes) yes.classList.toggle('selected', !isNone);
        if (note && isNone) note.value = '';
      });
    }

    function setCtContrast(c) {
      document.getElementById('inputCtContrast').value = c;
      const s = document.getElementById('opt_ct_simple');
      const ct = document.getElementById('opt_ct_contrast');
      if (s) s.classList.toggle('selected', c === '単純');
      if (ct) ct.classList.toggle('selected', c === '造影');
      if (c === '造影') {
        const med = document.getElementById('ctMedications');
        if (med && !med.value) med.value = 'イオパミロン注300 (100mL)、生理食塩水';
        document.getElementById('chk_ct_2p').checked = true;
      }
    }

    function setXrayDvd(dvd) {
      document.getElementById('inputXrayDvd').value = dvd;
      const no = document.getElementById('opt_dvd_no');
      const yes = document.getElementById('opt_dvd_yes');
      if (no) no.classList.toggle('selected', dvd === '未');
      if (yes) yes.classList.toggle('selected', dvd === '済');
    }

    // 患者情報の各伝票間双方向同期
    function syncPatientInputs(field, val) {
      if (field === 'id') {
        ['ct', 'fl', 'xr'].forEach(p => { const el = document.getElementById(`${p}_patientId`); if (el) el.value = val; });
      } else if (field === 'name') {
        ['ct', 'fl', 'xr'].forEach(p => { const el = document.getElementById(`${p}_patientName`); if (el) el.value = val; });
      } else if (field === 'kana') {
        ['ct', 'fl', 'xr'].forEach(p => { const el = document.getElementById(`${p}_patientKana`); if (el) el.value = val; });
      } else if (field === 'birth') {
        ['ct', 'fl', 'xr'].forEach(p => { const el = document.getElementById(`${p}_birthDate`); if (el) el.value = val; });
      } else if (field === 'room') {
        ['ct', 'fl', 'xr'].forEach(p => { const el = document.getElementById(`${p}_room`); if (el) el.value = val; });
      } else if (field === 'doc') {
        ['ct', 'fl', 'xr'].forEach(p => { const el = document.getElementById(`${p}_doctorName`); if (el) el.value = val; });
      }
    }

    // 日時ピッカー同期
    function syncDateTime() {
      const activeType = document.getElementById('inputFormType').value;
      const prefix = (activeType === 'CT') ? 'ct' : (activeType === 'FLUORO' ? 'fl' : 'xr');
      const d = document.getElementById(`${prefix}_date_picker`)?.value;
      const t = document.getElementById(`${prefix}_time_picker`)?.value;
      if (d && t) {
        document.getElementById('inputScheduledDate').value = `${d}T${t}`;
      } else if (d) {
        document.getElementById('inputScheduledDate').value = `${d}T09:00`;
      }
      // 他の用紙の日時も揃える
      ['ct', 'fl', 'xr'].forEach(p => {
        if (p !== prefix) {
          const dp = document.getElementById(`${p}_date_picker`);
          const tp = document.getElementById(`${p}_time_picker`);
          if (dp && d) dp.value = d;
          if (tp && t) tp.value = t;
        }
      });
    }

    // 患者選択ドロップダウン連動
    function onPatientSelectChange(patientId) {
      if (!patientId) {
        clearAllPatientFields();
        return;
      }
      const select = document.getElementById('patientSelectDropdown');
      const opt = select.options[select.selectedIndex];
      if (!opt) return;

      const pData = {
        patientId: opt.dataset.id || '',
        name: opt.dataset.name || '',
        kana: opt.dataset.kana || '',
        age: opt.dataset.age || '',
        gender: opt.dataset.gender || '男',
        birthDate: opt.dataset.birth || '',
        ward: opt.dataset.ward || '外来',
        room: opt.dataset.room || '',
        department: opt.dataset.dept || '内科',
        mobility: opt.dataset.mobility || '徒歩',
        infection: opt.dataset.infection || '無'
      };

      // 伝票上の入力欄へ流し込み
      syncPatientInputs('id', pData.patientId);
      syncPatientInputs('name', pData.name);
      syncPatientInputs('kana', pData.kana);
      syncPatientInputs('birth', pData.birthDate);
      syncPatientInputs('room', pData.room);
      document.getElementById('inputAge').value = pData.age;
      document.getElementById('ct_requestDept').value = pData.department;

      setGender(pData.gender);
      setWard(pData.ward);
      setMobility(pData.mobility);
      setInfection(pData.infection);

      // 日時が未設定なら現在日時をセット
      setNowIfDateEmpty();
    }

    function clearAllPatientFields() {
      syncPatientInputs('id', '');
      syncPatientInputs('name', '');
      syncPatientInputs('kana', '');
      syncPatientInputs('birth', '');
      syncPatientInputs('room', '');
      document.getElementById('inputAge').value = '';
      setGender('男');
      setWard('外来');
      setMobility('徒歩');
      setInfection('無');
    }

    function setNowIfDateEmpty() {
      const activeType = document.getElementById('inputFormType').value;
      const prefix = (activeType === 'CT') ? 'ct' : (activeType === 'FLUORO' ? 'fl' : 'xr');
      const dp = document.getElementById(`${prefix}_date_picker`);
      const tp = document.getElementById(`${prefix}_time_picker`);
      if (dp && !dp.value) {
        const now = new Date();
        const yyyy = now.getFullYear();
        const mm = String(now.getMonth() + 1).padStart(2, '0');
        const dd = String(now.getDate()).padStart(2, '0');
        const hh = String(now.getHours()).padStart(2, '0');
        const min = String(now.getMinutes()).padStart(2, '0');
        dp.value = `${yyyy}-${mm}-${dd}`;
        if (tp) tp.value = `${hh}:${min}`;
        syncDateTime();
      }
    }

    // プリセット適用
    function applyCtPreset(preset) {
      switchFormType('CT');
      setNowIfDateEmpty();
      if (preset === 'chest') {
        setCtContrast('単純');
        checkPart('胸部 (肺・横隔)', 'chk_box_ct_chest');
        document.getElementById('ctPurpose').value = '発熱・咳嗽持続のため肺炎疑い、胸部精査';
      } else if (preset === 'abdo') {
        setCtContrast('造影');
        checkPart('腹部 (肝・胆・膵・腎)', 'chk_box_ct_abdo');
        checkPart('骨盤腔', 'chk_box_ct_pelvis');
        document.getElementById('ctPurpose').value = '腹痛・肝胆膵病変精査のため腹部骨盤造影CT';
      } else if (preset === 'head') {
        setCtContrast('単純');
        checkPart('頭部', 'chk_box_ct_head');
        document.getElementById('ctPurpose').value = '転倒・頭部打撲後の頭蓋内出血否定、精査';
      }
    }

    function applyFluoroPreset(preset) {
      switchFormType('FLUORO');
      setNowIfDateEmpty();
      if (preset === 'peg') {
        checkFluoroExam('PEG交換', 'chk_box_fl_peg');
        checkFluoroMed('ガストログラフィン 20ml', 'chk_box_fl_gastro');
        checkFluoroMed('キシロカインゼリー2% 10ml', 'chk_box_fl_xylo');
        document.getElementById('fluoroMaterials').value = 'ガストロボタン 24Fr 3.5cm、交換用シリンジ、滅菌ガーゼ';
        document.getElementById('fluoroPurpose').value = '定期PEGチューブ交換、瘻孔部および胃内留置位置の造影確認';
      } else if (preset === 'vf') {
        checkFluoroExam('VF検査', 'chk_box_fl_vf');
        checkFluoroMed('硫酸バリウム散98.8%ホリイ 300g', 'chk_box_fl_ba');
        document.getElementById('fluoroMaterials').value = '嚥下食、トロミ水、バリウム液';
        document.getElementById('fluoroPurpose').value = '誤嚥・嚥下障害の評価、嚥下機能造影検査(VF)';
      }
    }

    function applyXrayPreset(preset) {
      switchFormType('XRAY');
      setNowIfDateEmpty();
      if (preset === 'chest') {
        checkXrayPart('① 胸部 (立位 PA / 側面 R-L)', 'chk_box_xr_1');
        document.getElementById('xrayPurpose').value = '術後・定期経過観察、胸水・気胸・心拡大の有無確認';
      } else if (preset === 'abdo') {
        checkXrayPart('② 腹部 (立位 / 臥位)', 'chk_box_xr_2');
        document.getElementById('xrayPurpose').value = '腹痛・イレウス疑い、ニボー像・フリーエア確認';
      } else if (preset === 'lumbar') {
        checkXrayPart('③ 腰椎 (正面 / 側面)', 'chk_box_xr_3');
        document.getElementById('xrayPurpose').value = '腰痛精査、圧迫骨折・変形性脊椎症の確認';
      }
    }

    function checkPart(val, boxId) {
      const chk = document.querySelector(`input[name="ctParts"][value="${val}"]`);
      if (chk) {
        chk.checked = true;
        toggleCustomChk(chk, boxId);
      }
    }
    function checkFluoroExam(val, boxId) {
      const chk = document.querySelector(`input[name="fluoroExam"][value="${val}"]`);
      if (chk) {
        chk.checked = true;
        toggleCustomChk(chk, boxId);
      }
    }
    function checkFluoroMed(val, boxId) {
      const chk = document.querySelector(`input[name="fluoroMed"][value="${val}"]`);
      if (chk) {
        chk.checked = true;
        toggleCustomChk(chk, boxId);
      }
    }
    function checkXrayPart(val, boxId) {
      const chk = document.querySelector(`input[name="xrayParts"][value="${val}"]`);
      if (chk) {
        chk.checked = true;
        toggleCustomChk(chk, boxId);
      }
    }

    // フォーム送信
    function submitOrderForm(autoPrintVal) {
      document.getElementById('inputAutoPrint').value = autoPrintVal;
      const formType = document.getElementById('inputFormType').value;
      const prefix = (formType === 'CT') ? 'ct' : (formType === 'FLUORO' ? 'fl' : 'xr');

      // 共通隠しフィールドに同期
      const pid = document.getElementById(`${prefix}_patientId`)?.value;
      const pname = document.getElementById(`${prefix}_patientName`)?.value;
      const pkana = document.getElementById(`${prefix}_patientKana`)?.value;
      const doc = document.getElementById(`${prefix}_doctorName`)?.value;

      if (!pid) {
        alert('⚠️ 患者IDが入力されていません。対象患者を選択するかIDを入力してください。');
        document.getElementById(`${prefix}_patientId`)?.focus();
        return;
      }
      if (!pname) {
        alert('⚠️ 患者氏名が入力されていません。');
        document.getElementById(`${prefix}_patientName`)?.focus();
        return;
      }

      // 日時が未設定なら今すぐ設定
      syncDateTime();
      if (!document.getElementById('inputScheduledDate').value) {
        setNowIfDateEmpty();
      }

      // 送信用にCT以外の用紙の場合も input に値を流し込む
      if (formType !== 'CT') {
        const pbirth = document.getElementById(`${prefix}_birthDate`)?.value;
        const proom = document.getElementById(`${prefix}_room`)?.value;

        document.getElementById('ct_patientId').value = pid;
        document.getElementById('ct_patientName').value = pname;
        document.getElementById('ct_patientKana').value = pkana || '';
        document.getElementById('ct_doctorName').value = doc || '担当医師';
        if (pbirth) document.getElementById('ct_birthDate').value = pbirth;
        if (proom) document.getElementById('ct_room').value = proom;
      }

      document.getElementById('radiologyOrderForm').submit();
    }

    // フォームのネイティブ submit 時の安全インターセプト
    document.getElementById('radiologyOrderForm').addEventListener('submit', (e) => {
      const formType = document.getElementById('inputFormType').value;
      const prefix = (formType === 'CT') ? 'ct' : (formType === 'FLUORO' ? 'fl' : 'xr');
      const pid = document.getElementById(`${prefix}_patientId`)?.value;
      const pname = document.getElementById(`${prefix}_patientName`)?.value;

      if (!pid) {
        e.preventDefault();
        alert('⚠️ 患者IDが入力されていません。対象患者を選択するかIDを入力してください。');
        document.getElementById(`${prefix}_patientId`)?.focus();
        return false;
      }
      if (!pname) {
        e.preventDefault();
        alert('⚠️ 患者氏名が入力されていません。');
        document.getElementById(`${prefix}_patientName`)?.focus();
        return false;
      }
      syncDateTime();
    });

    function resetForm() {
      if (confirm('入力内容をすべてリセットしますか？')) {
        document.getElementById('radiologyOrderForm').reset();
        document.querySelectorAll('.chk-box-custom').forEach(b => b.classList.remove('checked'));
        clearAllPatientFields();
        const sel = document.getElementById('patientSelectDropdown');
        if (sel) sel.value = '';
      }
    }

    // 初期化
    window.addEventListener('DOMContentLoaded', () => {
      // URLに ?patientId= があれば反映
      const urlParams = new URLSearchParams(window.location.search);
      const queryPid = urlParams.get('patientId');
      if (queryPid) {
        const select = document.getElementById('patientSelectDropdown');
        if (select) {
          select.value = queryPid;
          onPatientSelectChange(queryPid);
        }
      }
      // 日時初期値
      setNowIfDateEmpty();
    });
  </script>
</body>
</html>
