<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>電子カルテ入力 - インシデント管理システム</title>
  <!-- 🔒 多重起動防止・単一タブ排他制御 (1枚のみ起動可能) -->
  <script>
  (function() {
    window.name = 'app_carte_articles';
    const SYSTEM_KEY = 'carte_articles';
    const SYSTEM_TITLE = '電子カルテ入力画面 (Port 3000)';
    const ACCENT_COLOR = '#0284c7';

    const myInstanceId = 'inst_' + Math.random().toString(36).substring(2, 9) + '_' + Date.now();
    const LOCK_KEY = '__single_tab_lock_' + SYSTEM_KEY;
    const CHANNEL_NAME = '__single_tab_channel_' + SYSTEM_KEY;

    let isLeader = false;
    let heartbeatTimer = null;
    let channel = null;
    let leaderResponded = false;

    try {
      if (typeof BroadcastChannel !== 'undefined') {
        channel = new BroadcastChannel(CHANNEL_NAME);
      }
    } catch (e) {
      console.warn('BroadcastChannel not supported', e);
    }

    function getStoredLeader() {
      try {
        const val = localStorage.getItem(LOCK_KEY);
        return val ? JSON.parse(val) : null;
      } catch (e) {
        return null;
      }
    }

    function setStoredLeader(id) {
      try {
        localStorage.setItem(LOCK_KEY, JSON.stringify({ id: id, time: Date.now() }));
      } catch (e) {}
    }

    function clearStoredLeader() {
      try {
        const cur = getStoredLeader();
        if (cur && cur.id === myInstanceId) {
          localStorage.removeItem(LOCK_KEY);
        }
      } catch (e) {}
    }

    function startHeartbeat() {
      if (heartbeatTimer) clearInterval(heartbeatTimer);
      setStoredLeader(myInstanceId);
      heartbeatTimer = setInterval(function() {
        if (isLeader) {
          setStoredLeader(myInstanceId);
        } else {
          clearInterval(heartbeatTimer);
        }
      }, 1000);
    }

    function claimLeadership() {
      isLeader = true;
      leaderResponded = true;
      startHeartbeat();
      hideDuplicateModal();
      if (channel) {
        channel.postMessage({ type: 'NEW_LEADER_ELECTED', leaderId: myInstanceId });
      }
    }

    function createOrUpdateModal(reason) {
      if (!document.body) {
        document.addEventListener('DOMContentLoaded', function() {
          createOrUpdateModal(reason);
        });
        return;
      }

      let modal = document.getElementById('singleTabEnforceModal_' + SYSTEM_KEY);
      if (!modal) {
        modal = document.createElement('div');
        modal.id = 'singleTabEnforceModal_' + SYSTEM_KEY;
        modal.style.cssText = [
          'position: fixed',
          'inset: 0',
          'z-index: 2147483647',
          'background: rgba(15, 23, 42, 0.88)',
          'backdrop-filter: blur(8px)',
          '-webkit-backdrop-filter: blur(8px)',
          'display: flex',
          'align-items: center',
          'justify-content: center',
          'padding: 20px',
          'box-sizing: border-box',
          'font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Hiragino Kaku Gothic ProN", Meiryo, sans-serif'
        ].join(';');

        const card = document.createElement('div');
        card.style.cssText = [
          'background: #ffffff',
          'color: #1e293b',
          'border-radius: 16px',
          'max-width: 520px',
          'width: 100%',
          'padding: 30px 24px',
          'box-shadow: 0 25px 50px -12px rgba(0,0,0,0.6)',
          'border: 1px solid #e2e8f0',
          'text-align: center',
          'box-sizing: border-box'
        ].join(';');

        card.innerHTML = `
          <div style="font-size: 3rem; margin-bottom: 10px; line-height: 1;">⚠️</div>
          <div style="display: inline-block; background: #fef3c7; color: #b45309; border: 1px solid #fcd34d; font-size: 0.78rem; font-weight: 700; padding: 2px 10px; border-radius: 9999px; margin-bottom: 12px; letter-spacing: 0.05em;">
            単一画面排他保護・多重起動防止
          </div>
          <h2 id="singleTabTitle_${SYSTEM_KEY}" style="font-size: 1.25rem; font-weight: 800; color: #0f172a; margin: 0 0 12px; line-height: 1.4;">
            「${SYSTEM_TITLE}」は既に別のタブで開かれています
          </h2>
          <p id="singleTabMsg_${SYSTEM_KEY}" style="font-size: 0.9rem; color: #475569; line-height: 1.6; margin: 0 0 18px; text-align: left; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 12px 14px;">
            電子カルテ・オーダリング業務における入力内容の二重登録やデータの不整合を防止するため、当システムは<strong>同時に1枚（1つのタブ）のみ</strong>起動できるよう制御されています。
          </p>
          <div style="display: flex; flex-direction: column; gap: 10px; margin-top: 14px;">
            <button id="singleTabBtnClose_${SYSTEM_KEY}" type="button" style="background: #ef4444; color: white; border: none; padding: 12px 20px; font-size: 0.98rem; font-weight: 700; border-radius: 8px; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 8px; box-shadow: 0 2px 4px rgba(239,68,68,0.3); transition: background 0.15s;">
              <span>✕</span> この重複タブを閉じる（推奨）
            </button>
            <button id="singleTabBtnTakeover_${SYSTEM_KEY}" type="button" style="background: ${ACCENT_COLOR}; color: white; border: none; padding: 10px 18px; font-size: 0.9rem; font-weight: 600; border-radius: 8px; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 8px; transition: opacity 0.15s;">
              <span>🔄</span> このタブで開き直す（既存のタブを休止）
            </button>
          </div>
          <div id="singleTabCloseHelp_${SYSTEM_KEY}" style="font-size: 0.78rem; color: #94a3b8; margin-top: 12px; display: none; line-height: 1.4;">
            ※ブラウザ制限により自動で閉じられない場合は、ブラウザ上部の［×］ボタンで直接閉じてください。
          </div>
        `;

        modal.appendChild(card);
        document.body.appendChild(modal);

        const btnClose = modal.querySelector('#singleTabBtnClose_' + SYSTEM_KEY);
        const btnTakeover = modal.querySelector('#singleTabBtnTakeover_' + SYSTEM_KEY);
        const closeHelp = modal.querySelector('#singleTabCloseHelp_' + SYSTEM_KEY);

        btnClose.addEventListener('click', function() {
          window.close();
          setTimeout(function() {
            if (!window.closed && closeHelp) {
              closeHelp.style.display = 'block';
            }
          }, 300);
        });

        btnTakeover.addEventListener('click', function() {
          if (channel) {
            channel.postMessage({ type: 'FORCE_TAKEOVER', newLeaderId: myInstanceId });
          }
          claimLeadership();
        });
      }

      if (reason === 'takeover') {
        const titleEl = modal.querySelector('#singleTabTitle_' + SYSTEM_KEY);
        const msgEl = modal.querySelector('#singleTabMsg_' + SYSTEM_KEY);
        if (titleEl) titleEl.textContent = `「${SYSTEM_TITLE}」は別のタブで新しく開かれました`;
        if (msgEl) msgEl.innerHTML = `別のタブで新しく画面が開かれたため、二重入力防止のためこのタブの操作は<strong>安全に休止</strong>されました。<br>このタブで再び作業を続けたい場合は、下記の「このタブで開き直す」を押してください。`;
      }

      modal.style.display = 'flex';
    }

    function showDuplicateModal(reason) {
      isLeader = false;
      if (heartbeatTimer) clearInterval(heartbeatTimer);
      createOrUpdateModal(reason);
    }

    function hideDuplicateModal() {
      const modal = document.getElementById('singleTabEnforceModal_' + SYSTEM_KEY);
      if (modal) {
        modal.style.display = 'none';
      }
    }

    if (channel) {
      channel.onmessage = function(e) {
        const data = e.data;
        if (!data) return;

        if (data.type === 'PING') {
          if (isLeader) {
            channel.postMessage({ type: 'PONG', leaderId: myInstanceId });
            setStoredLeader(myInstanceId);
          }
        } else if (data.type === 'PONG') {
          if (!isLeader && data.leaderId !== myInstanceId) {
            leaderResponded = true;
            showDuplicateModal('duplicate');
          }
        } else if (data.type === 'FORCE_TAKEOVER') {
          if (isLeader && data.newLeaderId !== myInstanceId) {
            showDuplicateModal('takeover');
          }
        } else if (data.type === 'NEW_LEADER_ELECTED') {
          if (isLeader && data.leaderId !== myInstanceId) {
            showDuplicateModal('takeover');
          }
        }
      };
    }

    window.addEventListener('storage', function(e) {
      if (e.key === LOCK_KEY && e.newValue) {
        try {
          const l = JSON.parse(e.newValue);
          if (isLeader && l.id !== myInstanceId) {
            showDuplicateModal('takeover');
          }
        } catch (err) {}
      }
    });

    window.addEventListener('beforeunload', function() {
      if (isLeader) {
        sessionStorage.setItem('__single_tab_reloading_' + SYSTEM_KEY, Date.now().toString());
        clearStoredLeader();
        if (channel) {
          channel.postMessage({ type: 'LEADER_UNLOAD', leaderId: myInstanceId });
        }
      }
    });

    window.addEventListener('pagehide', function() {
      if (isLeader) {
        clearStoredLeader();
        if (channel) {
          channel.postMessage({ type: 'LEADER_UNLOAD', leaderId: myInstanceId });
        }
      }
    });

    function initSingleTab() {
      const reloadTime = sessionStorage.getItem('__single_tab_reloading_' + SYSTEM_KEY);
      sessionStorage.removeItem('__single_tab_reloading_' + SYSTEM_KEY);
      const isQuickReload = reloadTime && (Date.now() - parseInt(reloadTime, 10) < 3000);

      const existing = getStoredLeader();
      const now = Date.now();

      if (!isQuickReload && existing && existing.id && existing.id !== myInstanceId && (now - existing.time) < 2500) {
        if (channel) {
          channel.postMessage({ type: 'PING', senderId: myInstanceId });
        }
        showDuplicateModal('duplicate');

        setTimeout(function() {
          if (!leaderResponded) {
            const check = getStoredLeader();
            if (!check || (Date.now() - check.time) > 2500) {
              claimLeadership();
            }
          }
        }, 350);
      } else {
        claimLeadership();
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initSingleTab);
    } else {
      initSingleTab();
    }
  })();
  </script>
  <style>
    :root {
      --primary: #0284c7;
      --primary-hover: #0369a1;
      --bg-color: #f8fafc;
      --card-bg: #ffffff;
      --text-main: #1e293b;
      --text-muted: #64748b;
      --border-color: #e2e8f0;
    }
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
      background-color: var(--bg-color);
      color: var(--text-main);
      margin: 0;
      padding: 0 0 42px 0;
    }

    /* 📌 スクロール時も常時最上部に固定されるヘッダーエリア */
    .sticky-top-header {
      position: sticky;
      top: 0;
      z-index: 1000;
      box-shadow: 0 2px 8px rgba(0,0,0,0.15);
    }

    header {
      background: #1e293b;
      color: white;
      padding: 0.5rem 1.5rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 0.5rem;
    }
    header h1 { margin: 0; font-size: 1.1rem; }
    
    .top-status-bar {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      font-size: 0.85rem;
    }
    .status-chip {
      background: rgba(255,255,255,0.15);
      padding: 0.2rem 0.6rem;
      border-radius: 20px;
      border: 1px solid rgba(255,255,255,0.25);
      display: flex;
      align-items: center;
      gap: 0.4rem;
    }
    .status-chip strong { color: #38bdf8; }

    .target-filter-select {
      background: #0f172a;
      color: #38bdf8;
      border: 1px solid #38bdf8;
      border-radius: 12px;
      padding: 0.2rem 0.6rem;
      font-size: 0.85rem;
      font-weight: bold;
      cursor: pointer;
      outline: none;
    }

    .btn-logout {
      background: #ef4444; color: white; border: none; padding: 0.25rem 0.6rem; border-radius: 4px;
      text-decoration: none; font-size: 0.8rem; transition: background 0.2s;
    }
    .btn-logout:hover { background: #dc2626; }

    /* ⚙️ 歯車印メニュー */
    .gear-menu-container {
      position: relative;
      display: inline-block;
    }
    .btn-gear {
      background: rgba(255, 255, 255, 0.15);
      border: 1px solid rgba(255, 255, 255, 0.3);
      color: white;
      padding: 0.3rem 0.75rem;
      border-radius: 6px;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 0.4rem;
      font-size: 0.88rem;
      font-weight: bold;
      transition: all 0.2s;
    }
    .btn-gear:hover, .btn-gear.active {
      background: rgba(255, 255, 255, 0.3);
      border-color: rgba(255, 255, 255, 0.5);
    }
    .btn-gear .gear-icon {
      font-size: 1.15rem;
      display: inline-block;
      transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    .btn-gear:hover .gear-icon, .btn-gear.active .gear-icon {
      transform: rotate(60deg);
    }
    .gear-dropdown {
      display: none;
      position: absolute;
      top: calc(100% + 8px);
      right: 0;
      width: 300px;
      max-height: 85vh;
      overflow-y: auto;
      background: #ffffff;
      border: 1px solid #cbd5e1;
      border-radius: 10px;
      box-shadow: 0 12px 28px -5px rgba(0, 0, 0, 0.25), 0 8px 10px -6px rgba(0, 0, 0, 0.1);
      z-index: 2500;
      padding: 0.5rem 0;
      color: #1e293b;
      animation: gearSlideDown 0.18s ease-out;
    }
    .gear-dropdown.show {
      display: block;
    }
    @keyframes gearSlideDown {
      from { opacity: 0; transform: translateY(-8px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .gear-dropdown-header {
      padding: 0.5rem 1rem 0.4rem;
      font-size: 0.78rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: #64748b;
      border-bottom: 1px solid #f1f5f9;
      margin-bottom: 0.3rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .gear-section-label {
      padding: 0.45rem 1rem 0.2rem;
      font-size: 0.72rem;
      font-weight: 700;
      color: #94a3b8;
      letter-spacing: 0.03em;
    }
    .gear-dropdown-item {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      padding: 0.55rem 1rem;
      color: #1e293b;
      text-decoration: none;
      font-size: 0.86rem;
      transition: background 0.15s, color 0.15s;
    }
    .gear-dropdown-item:hover {
      background: #f1f5f9;
      color: #0284c7;
    }
    .gear-dropdown-item.active {
      background: #e0f2fe;
      color: #0369a1;
      font-weight: bold;
      border-left: 3px solid #0284c7;
    }
    .gear-dropdown-item .item-icon {
      font-size: 1.15rem;
      width: 22px;
      text-align: center;
      flex-shrink: 0;
    }
    .gear-dropdown-item .item-info {
      flex: 1;
      min-width: 0;
    }
    .gear-dropdown-item .item-title {
      font-weight: 600;
      line-height: 1.3;
    }
    .gear-dropdown-item .item-desc {
      font-size: 0.72rem;
      color: #64748b;
      line-height: 1.2;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .gear-divider {
      height: 1px;
      background: #e2e8f0;
      margin: 0.4rem 0;
    }
    
    .nav-tabs {
      background: #093152;
      padding: 0 1.5rem;
      display: flex;
      gap: 0.5rem;
      border-top: 1px solid rgba(255,255,255,0.08);
    }
    .nav-tab {
      color: #94a3b8;
      padding: 0.35rem 0.8rem;
      text-decoration: none;
      font-weight: bold;
      font-size: 0.8rem;
      border-bottom: 3px solid transparent;
    }
    .nav-tab:hover { color: white; }
    .nav-tab.active {
      color: white;
      border-bottom-color: #38bdf8;
    }

    .container {
      max-width: 100%;
      margin: 0;
      padding: 0.35rem 0.5rem;
      box-sizing: border-box;
    }

    /* 📌 電子カルテ 3ペイン分割レイアウト (境界をドラッグして幅を自在に変更可能) */
    .carte-layout-3col {
      display: flex;
      flex-direction: row;
      align-items: stretch;
      gap: 0;
      height: calc(100vh - 90px);
      min-height: 600px;
      width: 100%;
      overflow: hidden;
      position: relative;
    }

    /* 各ペイン基本構造 */
    .carte-pane-left {
      width: 290px;
      min-width: 150px;
      max-width: 800px;
      flex: 0 0 290px;
      display: flex;
      flex-direction: column;
      height: 100%;
      background: #f8fafc;
      border: 1px solid #cbd5e1;
      border-radius: 4px;
      overflow: hidden;
    }

    .carte-pane-center {
      flex: 1 1 auto;
      min-width: 200px;
      display: flex;
      flex-direction: column;
      height: 100%;
      background: #ffffff;
      border: 1px solid #cbd5e1;
      border-radius: 4px;
      overflow: hidden;
    }

    .carte-pane-right {
      width: 480px;
      min-width: 280px;
      max-width: 950px;
      flex: 0 0 480px;
      display: flex;
      flex-direction: column;
      height: 100%;
      background: #ffffff;
      border: 1px solid #cbd5e1;
      border-radius: 4px;
      overflow: hidden;
      position: relative;
    }

    /* ↔️ 列境界リサイザー (スプリッター) */
    .carte-resizer {
      width: 10px;
      margin: 0 -1px;
      cursor: col-resize;
      background: #cbd5e1;
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      z-index: 30;
      user-select: none;
      touch-action: none;
      transition: background 0.15s ease;
      border-radius: 3px;
    }
    .carte-resizer::after {
      content: '';
      width: 2px;
      height: 36px;
      border-left: 1px dotted #475569;
      border-right: 1px dotted #475569;
      transition: all 0.15s ease;
      pointer-events: none;
    }
    .carte-resizer:hover, .carte-resizer.resizing {
      background: #0284c7 !important;
    }
    .carte-resizer:hover::after, .carte-resizer.resizing::after {
      border-color: #ffffff !important;
      height: 60px;
    }

    @media (max-width: 768px) {
      .carte-layout-3col {
        flex-direction: column;
        height: auto;
      }
      .carte-resizer {
        display: none !important;
      }
      .carte-pane-left, .carte-pane-center, .carte-pane-right {
        width: 100% !important;
        max-width: 100% !important;
        min-width: 100% !important;
        height: auto !important;
        overflow-y: visible !important;
        margin-bottom: 0.75rem;
      }
    }

    /* 電子カルテ専用ヘッダー・バー */
    .carte-top-header {
      background: #0f4871;
      color: #ffffff;
      padding: 0.3rem 0.75rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      box-shadow: 0 1px 4px rgba(0,0,0,0.15);
      user-select: none;
    }

    .patient-header-badge {
      background: #18588f;
      border: 1px solid rgba(255,255,255,0.25);
      border-radius: 6px;
      padding: 0.25rem 0.8rem;
      display: flex;
      align-items: center;
      gap: 0.75rem;
      color: #ffffff;
    }

    .patient-header-badge .p-id {
      font-size: 0.78rem;
      color: #bae6fd;
      font-family: monospace;
    }

    .patient-header-badge .p-name {
      font-size: 1.05rem;
      font-weight: bold;
      letter-spacing: 0.5px;
    }

    .patient-header-badge .p-kana {
      font-size: 0.72rem;
      color: #cbd5e1;
      margin-left: 0.3rem;
    }

    .patient-header-badge .p-age {
      background: #0284c7;
      color: #ffffff;
      font-size: 0.75rem;
      font-weight: bold;
      border-radius: 12px;
      padding: 0.1rem 0.45rem;
      margin-left: 0.4rem;
    }

    .patient-header-badge .p-birth {
      font-size: 0.75rem;
      color: #e2e8f0;
      margin-left: 0.4rem;
    }

    /* ペインタブ */
    .pane-tabs {
      display: flex;
      background: #e2e8f0;
      border-bottom: 1px solid #cbd5e1;
    }

    .pane-tab {
      padding: 0.35rem 0.75rem;
      font-size: 0.78rem;
      font-weight: bold;
      color: #475569;
      cursor: pointer;
      border: none;
      background: transparent;
      border-bottom: 2px solid transparent;
    }

    .pane-tab.active {
      background: #ffffff;
      color: #0369a1;
      border-bottom: 2px solid #0284c7;
    }

    /* 🎀 右ペイン 2段リボンUI (上段: 部署選択 / 下段: 部署別メニュー) */
    .ribbon-container {
      display: flex;
      flex-direction: column;
      border-bottom: 2px solid #0284c7;
      background: #f8fafc;
      flex-shrink: 0;
    }

    /* 上段: 部署選択リボン (見切れる場合は2段に自動折り返し) */
    .ribbon-tier1 {
      display: flex;
      align-items: center;
      background: #0f172a;
      padding: 0.35rem 0.5rem;
      gap: 0.25rem;
      flex-wrap: wrap;
    }
    .ribbon-tier1-title {
      font-size: 0.72rem;
      color: #94a3b8;
      font-weight: bold;
      display: flex;
      align-items: center;
      gap: 0.2rem;
      margin-right: 0.2rem;
      white-space: nowrap;
    }
    .ribbon-dept-btn {
      background: #1e293b;
      border: 1px solid #334155;
      color: #cbd5e1;
      padding: 0.22rem 0.5rem;
      border-radius: 4px;
      font-size: 0.75rem;
