          ${order.content ? `
            <div style="background:#f8fafc; border:1px solid #e2e8f0; border-radius:4px; padding:0.45rem 0.6rem; font-size:0.8rem; line-height:1.55; color:#1e293b; white-space:pre-wrap; word-break:break-word; font-family:inherit;">${escapeHtml(order.content)}</div>
