    // 🌐 送信先ホストとの接続疎通テスト（テスト指示は記事保存せずスキップして捨てる）
    async function testHostConnection(type = 'iv') {
      let inputId = 'remoteHostUrlIv';
      let endpoint = '/api/iv-orders/test-connection';
      if (type === 'meal') {
        inputId = 'remoteHostUrlMeal';
        endpoint = '/api/meal-orders/test-connection';
      } else if (type === 'rad') {
        inputId = 'remoteHostUrlRad';
        endpoint = '/api/radiology-orders/test-connection';
      }
      const targetUrl = document.getElementById(inputId).value;

      if (!targetUrl) {
        alert('送信先ホストのURLを入力してください。');
        return;
      }

      try {
        const res = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ targetUrl })
        });
        const data = await res.json();
        if (data.success) {
          alert('✅ ' + data.message);
        } else {
          alert('❌ ' + data.message);
        }
      } catch (err) {
        alert('❌ 疎通テスト失敗: ' + err.message);
      }
    }

    // フォーム送信前にリモートURLと開始日時を自動補完・同期
