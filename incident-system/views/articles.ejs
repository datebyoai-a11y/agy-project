    // 処方サブカテゴリ絞り込み
    function filterMedSubCategory(category, btn) {
      const subtabs = document.querySelectorAll('.carte-pane-right .btn-subtab');
      subtabs.forEach(b => {
        b.style.background = '#ffffff';
        b.style.color = '#334155';
        b.style.borderColor = '#cbd5e1';
        b.style.fontWeight = 'normal';
      });
      if (btn) {
        btn.style.background = '#0284c7';
        btn.style.color = '#ffffff';
        btn.style.borderColor = '#0284c7';
        btn.style.fontWeight = 'bold';
      }

      const items = document.querySelectorAll('#paletteItemList .palette-item');
      items.forEach(item => {
        const labelEl = item.querySelector('.palette-category-label');
        const label = labelEl ? labelEl.textContent : '';
        if (category === 'ALL') {
          item.style.display = '';
        } else if (category === '点滴') {
          item.style.display = (label.includes('点滴') || label.includes('注') || label.includes('輸液') || label.includes('抗菌') || label.includes('制吐') || item.getAttribute('data-subcat') === '点滴') ? '' : 'none';
        } else if (category === '内科') {
          item.style.display = (label.includes('心臓') || label.includes('てんかん') || label.includes('利尿') || label.includes('咳')) ? '' : 'none';
        } else if (category === '感冒') {
          item.style.display = (label.includes('感冒') || label.includes('インフル') || label.includes('喘息')) ? '' : 'none';
        } else if (category === '消化器') {
          item.style.display = (label.includes('下痢') || label.includes('便秘') || label.includes('嘔気')) ? '' : 'none';
        } else if (category === '外用') {
          item.style.display = (label.includes('外用') || label.includes('吸入')) ? '' : 'none';
        } else {
          item.style.display = '';
        }
      });
    }

