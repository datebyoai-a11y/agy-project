      font-size: 1.05rem;
      display: flex;
      align-items: center;
      gap: 0.5rem;
      color: #f8fafc;
    }
    .pgp-modal-close {
      background: none;
      border: none;
      color: #94a3b8;
      font-size: 1.4rem;
      cursor: pointer;
      padding: 0;
      line-height: 1;
    }
    .pgp-modal-close:hover { color: #ffffff; }
    .pgp-modal-body {
      padding: 1.25rem;
      overflow-y: auto;
      font-size: 0.88rem;
    }
