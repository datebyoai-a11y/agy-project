        'nurse_care': 'tabContentNurseCare',
        'nurse_iv': 'tabContentNurseIv',
        'nurse_obs': 'tabContentNurseObs',
        'nurse_alert': 'tabContentNurseAlert',
        // 薬剤部
        'pharm_audit': 'tabContentPharmAudit',
        'pharm_guidance': 'tabContentPharmGuidance',
        'pharm_inquiry': 'tabContentPharmInquiry',
        'pharm_tdm': 'tabContentPharmTdm',
        // 放射線科
        'rad_exec': 'tabContentRadExec',
        'rad_portable': 'tabContentRadPortable',
        'rad_safety': 'tabContentRadSafety',
        // リハビリ科
        'rehab_pt': 'tabContentRehabPt',
        'rehab_ot': 'tabContentRehabOt',
        'rehab_st': 'tabContentRehabSt',
        'rehab_eval': 'tabContentRehabEval',
        // 介護
        'care_bath': 'tabContentCareBath',
        'care_meal': 'tabContentCareMeal',
        'care_excretion': 'tabContentCareExcretion',
        'care_position': 'tabContentCarePosition',
        // 栄養科
        'nutr_meal': 'tabContentNutrMeal',
        'nutr_assess': 'tabContentNutrAssess',
        'nutr_guidance': 'tabContentNutrGuidance',
        // 医療安全
        'safety_risk': 'tabContentSafetyRisk',
        'safety_incident': 'tabContentSafetyIncident',
        'safety_audit': 'tabContentSafetyAudit',
        // 医事・事務
