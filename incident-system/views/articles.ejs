  <script>
    // ↔️ 縦3列の境界ドラッグ＆リサイズ制御 (左・中央・右の幅を自在に変更)
    function initPaneResizers() {
      const leftPane = document.querySelector('.carte-pane-left');
      const centerPane = document.querySelector('.carte-pane-center');
      const rightPane = document.querySelector('.carte-pane-right');
      const resizerLeft = document.getElementById('resizerLeft');
      const resizerRight = document.getElementById('resizerRight');
      const container = document.querySelector('.carte-layout-3col');

      if (!leftPane || !centerPane || !rightPane || !resizerLeft || !resizerRight || !container) return;

      const DEFAULT_LEFT_WIDTH = 290;
      const DEFAULT_RIGHT_WIDTH = 350;
      const MIN_LEFT_WIDTH = 180;
      const MAX_LEFT_WIDTH = 650;
      const MIN_RIGHT_WIDTH = 240;
      const MAX_RIGHT_WIDTH = 750;
      const MIN_CENTER_WIDTH = 300;

      // 保存された幅の復元 (localStorage)
      try {
        const savedLeft = localStorage.getItem('carte_pane_left_width');
        if (savedLeft) {
          const w = parseInt(savedLeft, 10);
          if (!isNaN(w) && w >= MIN_LEFT_WIDTH && w <= MAX_LEFT_WIDTH) {
            leftPane.style.width = `${w}px`;
          }
        }
        const savedRight = localStorage.getItem('carte_pane_right_width');
        if (savedRight) {
          const w = parseInt(savedRight, 10);
          if (!isNaN(w) && w >= MIN_RIGHT_WIDTH && w <= MAX_RIGHT_WIDTH) {
            rightPane.style.width = `${w}px`;
          }
        }
      } catch (e) {}

      let isDraggingLeft = false;
      let startXLeft = 0;
      let startWidthLeft = 0;

      let isDraggingRight = false;
      let startXRight = 0;
      let startWidthRight = 0;

      // --- 左スプリッター (左ペインと中央ペインの境界) ---
      function onMouseDownLeft(e) {
        if (window.innerWidth <= 992) return;
        isDraggingLeft = true;
        startXLeft = e.clientX || (e.touches && e.touches[0].clientX);
        startWidthLeft = leftPane.getBoundingClientRect().width;
        resizerLeft.classList.add('resizing');
        document.body.style.cursor = 'col-resize';
        document.body.style.userSelect = 'none';
        if (e.cancelable && e.type !== 'touchstart') e.preventDefault();
      }

      // --- 右スプリッター (中央ペインと右ペインの境界) ---
      function onMouseDownRight(e) {
        if (window.innerWidth <= 992) return;
        isDraggingRight = true;
        startXRight = e.clientX || (e.touches && e.touches[0].clientX);
        startWidthRight = rightPane.getBoundingClientRect().width;
        resizerRight.classList.add('resizing');
        document.body.style.cursor = 'col-resize';
        document.body.style.userSelect = 'none';
        if (e.cancelable && e.type !== 'touchstart') e.preventDefault();
      }

      function onMouseMove(e) {
        if (!isDraggingLeft && !isDraggingRight) return;

        const clientX = e.clientX || (e.touches && e.touches[0].clientX);
        if (clientX === undefined) return;

        const containerRect = container.getBoundingClientRect();
        const resizersTotalWidth = 20; // 8px * 2 + margins

        if (isDraggingLeft) {
          const deltaX = clientX - startXLeft;
          let newWidth = startWidthLeft + deltaX;

          const currentRightWidth = rightPane.getBoundingClientRect().width;
          const maxAllowed = containerRect.width - currentRightWidth - MIN_CENTER_WIDTH - resizersTotalWidth;
          const actualMax = Math.min(MAX_LEFT_WIDTH, maxAllowed);

          if (newWidth < MIN_LEFT_WIDTH) newWidth = MIN_LEFT_WIDTH;
          if (newWidth > actualMax) newWidth = actualMax;

          leftPane.style.width = `${Math.round(newWidth)}px`;
        } else if (isDraggingRight) {
          const deltaX = clientX - startXRight;
          let newWidth = startWidthRight - deltaX;

          const currentLeftWidth = leftPane.getBoundingClientRect().width;
          const maxAllowed = containerRect.width - currentLeftWidth - MIN_CENTER_WIDTH - resizersTotalWidth;
          const actualMax = Math.min(MAX_RIGHT_WIDTH, maxAllowed);

          if (newWidth < MIN_RIGHT_WIDTH) newWidth = MIN_RIGHT_WIDTH;
          if (newWidth > actualMax) newWidth = actualMax;

          rightPane.style.width = `${Math.round(newWidth)}px`;
        }
      }

      function onMouseUp() {
        if (isDraggingLeft) {
          isDraggingLeft = false;
          resizerLeft.classList.remove('resizing');
          document.body.style.cursor = '';
          document.body.style.userSelect = '';
          try {
            localStorage.setItem('carte_pane_left_width', Math.round(leftPane.getBoundingClientRect().width));
          } catch (e) {}
        }
        if (isDraggingRight) {
          isDraggingRight = false;
          resizerRight.classList.remove('resizing');
          document.body.style.cursor = '';
          document.body.style.userSelect = '';
          try {
            localStorage.setItem('carte_pane_right_width', Math.round(rightPane.getBoundingClientRect().width));
          } catch (e) {}
        }
      }

      // ダブルクリックでデフォルト幅にリセット
      resizerLeft.addEventListener('dblclick', () => {
        leftPane.style.width = `${DEFAULT_LEFT_WIDTH}px`;
        try { localStorage.setItem('carte_pane_left_width', DEFAULT_LEFT_WIDTH); } catch (e) {}
      });

      resizerRight.addEventListener('dblclick', () => {
        rightPane.style.width = `${DEFAULT_RIGHT_WIDTH}px`;
        try { localStorage.setItem('carte_pane_right_width', DEFAULT_RIGHT_WIDTH); } catch (e) {}
      });

      // イベントリスナーの登録
      resizerLeft.addEventListener('mousedown', onMouseDownLeft);
      resizerLeft.addEventListener('touchstart', onMouseDownLeft, { passive: true });

      resizerRight.addEventListener('mousedown', onMouseDownRight);
      resizerRight.addEventListener('touchstart', onMouseDownRight, { passive: true });

      window.addEventListener('mousemove', onMouseMove);
      window.addEventListener('touchmove', onMouseMove, { passive: true });

      window.addEventListener('mouseup', onMouseUp);
      window.addEventListener('touchend', onMouseUp);
    }

    // 1. 患者選択切り替え時のヘッダー情報更新
    async function onCarteTargetSelect(targetId) {
      const prevTargetId = currentSelectedTargetId;

      // 以前の患者の入力内容があれば一時保存
      if (typeof saveCarteDraft === 'function' && prevTargetId && prevTargetId !== 'ALL' && prevTargetId !== 'NONE') {
        saveCarteDraft(false);
      }

      currentSelectedTargetId = targetId;
      const select = document.getElementById('headerTargetFilter');
      const selectedOption = select.options[select.selectedIndex];
      
      const formTarget = document.getElementById('formTargetPersonSelect');
      if (formTarget) {
        formTarget.value = (targetId === 'ALL' || targetId === 'NONE') ? '' : targetId;
      }

      if (targetId !== 'ALL' && selectedOption) {
        const customId = selectedOption.getAttribute('data-custom-id') || '0000000001';
        const name = selectedOption.getAttribute('data-name') || '未選択';
        
        document.getElementById('cartePatientId').textContent = customId;
        document.getElementById('cartePatientName').textContent = name;
        document.getElementById('cartePatientKana').textContent = '';
      }

      // 🌟 患者切り替え時に一時的オーバーライドを自動終了
      const headerOverrideBadge = document.getElementById('headerOverrideBadge');
      const isOverriding = headerOverrideBadge && headerOverrideBadge.style.display !== 'none';
      if (isOverriding && prevTargetId && prevTargetId !== targetId) {
        try {
          const res = await fetch('/api/revert-override', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' }
          });
          const data = await res.json();
          if (res.ok && data.success && data.user) {
            const selectEl = document.getElementById('headerAuthorSelect');
            if (selectEl) {
              selectEl.value = data.user.id;
              selectEl.setAttribute('data-current-id', data.user.id);
            }
            applyAuthorChange(data.user.id, data.user.userName, data.user.department, 'complete', null);
            showToastNotification(`🔄 患者が切り替わったため、代行入力を終了し <strong>${escapeHtml(data.user.userName)} 様</strong> に自動復帰しました`);
          }
        } catch (e) {
          console.warn('患者切り替え時の代行自動解除エラー:', e);
        }
      }

      applyArticleFilters();
      loadStagedOrdersFromStorage();

      // 🌟 切り替え先患者の下書きカルテを自動復帰
      const restored = loadCarteDraftFromStorage(targetId);
      if (!restored) {
        const textarea = document.getElementById('articleContentInput');
        if (textarea && prevTargetId && prevTargetId !== targetId) {
          textarea.value = '';
        }
        const banner = document.getElementById('draftNoticeBanner');
        if (banner) banner.style.display = 'none';
      }
    }

    // 2. 左ペインタブ切り替え（過去カルテ / 患者サマリー）
    function switchLeftTab(tab) {
      const tabPast = document.getElementById('tabPastCarte');
      const tabSum = document.getElementById('tabSummary');
      if (tab === 'carte') {
        tabPast.classList.add('active');
        tabSum.classList.remove('active');
      } else {
        tabSum.classList.add('active');
        tabPast.classList.remove('active');
      }
    }

    // 3. 🎀 右ペイン 2段リボン制御 (上段: 部署選択 / 下段: 部署別メニュー)
    function getDeptKeyFromDeptName(deptName) {
      if (!deptName) return 'doctor';
      const name = String(deptName).toLowerCase();
      if (name.includes('医局') || name.includes('医師')) return 'doctor';
      if (name.includes('看護') || name.includes('病棟') || name.includes('外来')) return 'nurse';
      if (name.includes('薬')) return 'pharmacy';
      if (name.includes('放射線') || name.includes('レントゲン')) return 'radiology';
      if (name.includes('リハビリ') || name.includes('pt') || name.includes('ot') || name.includes('st')) return 'rehab';
      if (name.includes('介護') || name.includes('ケア')) return 'care';
      if (name.includes('栄養')) return 'nutrition';
      if (name.includes('安全')) return 'safety';
      if (name.includes('事務') || name.includes('医事')) return 'admin';
      return 'doctor';
    }

    // 上段リボン: 部署の切り替え (初期値は入力者の部署)
    function selectRibbonDept(deptKey) {
      // 1. 上段リボンボタンのアクティブ切り替え
      const deptBtns = document.querySelectorAll('.ribbon-dept-btn');
      deptBtns.forEach(btn => btn.classList.remove('active'));
      const targetBtn = document.getElementById(`deptBtn_${deptKey}`);
      if (targetBtn) {
        targetBtn.classList.add('active');
