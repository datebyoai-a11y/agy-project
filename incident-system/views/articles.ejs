    // 🩺 入力者切り替えモーダルの起動
    function promptSwitchAuthor(selectEl) {
      if (!selectEl) return;
      const targetAuthorId = selectEl.value;
      const currentAuthorId = selectEl.getAttribute('data-current-id') || '';

      // 同じユーザーが選択された場合は何もしない
      if (targetAuthorId && targetAuthorId === currentAuthorId) return;

      const selectedOpt = selectEl.selectedOptions ? selectEl.selectedOptions[0] : null;
      if (!selectedOpt) return;

      const authorName = selectedOpt.getAttribute('data-name') || selectedOpt.text;
      const authorDept = selectedOpt.getAttribute('data-dept') || '';
      const authorLoginId = selectedOpt.getAttribute('data-loginid') || '';

      const modal = document.getElementById('switchAuthorModal');
      const targetIdInput = document.getElementById('switchTargetAuthorId');
      const targetNameEl = document.getElementById('switchTargetAuthorName');
      const targetDeptEl = document.getElementById('switchTargetAuthorDept');
      const targetLoginEl = document.getElementById('switchTargetAuthorLoginId');
      const passwordInput = document.getElementById('switchAuthorPassword');
      const errorEl = document.getElementById('switchAuthorError');

      if (!modal) {
        console.warn('switchAuthorModal が見つかりません。');
        return;
      }

      targetIdInput.value = targetAuthorId;
      if (targetNameEl) targetNameEl.textContent = authorName + ' 様';
      if (targetDeptEl) targetDeptEl.textContent = authorDept || '一般';
      if (targetLoginEl) targetLoginEl.textContent = authorLoginId ? `ログインID: ${authorLoginId}` : '';
      if (passwordInput) passwordInput.value = '';
      if (errorEl) {
        errorEl.style.display = 'none';
        errorEl.textContent = '';
      }

      // モーダル表示
      modal.style.display = 'flex';
      setTimeout(() => {
        if (passwordInput) passwordInput.focus();
      }, 100);
    }

    // ✕ 入力者切り替えモーダルのキャンセル
    function cancelSwitchAuthorModal(event) {
      if (event && event.target && event.target !== event.currentTarget && !event.target.classList.contains('pgp-modal-close') && event.target.tagName !== 'BUTTON') {
        return;
      }
      const modal = document.getElementById('switchAuthorModal');
      if (modal) modal.style.display = 'none';

      // セレクトボックスの選択を以前の値に戻す
      const selectEl = document.getElementById('headerAuthorSelect');
      if (selectEl) {
        const currentAuthorId = selectEl.getAttribute('data-current-id');
        if (currentAuthorId) {
          selectEl.value = currentAuthorId;
        }
      }
    }

    // 🔑 入力者切り替えの実行（パスワード認証 & モード適用）
    async function handleSwitchAuthorSubmit(event) {
      if (event) event.preventDefault();
      const targetIdInput = document.getElementById('switchTargetAuthorId');
      const authorId = targetIdInput ? targetIdInput.value : '';
      const passwordInput = document.getElementById('switchAuthorPassword');
      const password = passwordInput ? passwordInput.value : '';
      const modeRadio = document.querySelector('input[name="switchMode"]:checked');
      const mode = modeRadio ? modeRadio.value : 'override';
      const errorEl = document.getElementById('switchAuthorError');
      const submitBtn = document.getElementById('switchAuthorSubmitBtn');

      if (!authorId) {
        if (errorEl) {
          errorEl.textContent = '切り替え先ユーザーが指定されていません。';
          errorEl.style.display = 'block';
        }
        return;
      }
      if (!password) {
        if (errorEl) {
          errorEl.textContent = 'パスワードを入力してください。';
          errorEl.style.display = 'block';
        }
        if (passwordInput) passwordInput.focus();
        return;
      }

      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.innerHTML = '<span>🔄 認証中...</span>';
      }
      if (errorEl) {
        errorEl.style.display = 'none';
        errorEl.textContent = '';
      }

      try {
        const res = await fetch('/api/switch-author', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify({ authorId, password, mode })
        });

        const data = await res.json();
        if (!res.ok || !data.success) {
          throw new Error(data.error || 'パスワード認証に失敗しました。');
        }

        // 成功時の画面反映
        const selectEl = document.getElementById('headerAuthorSelect');
        const selectedOpt = selectEl ? selectEl.querySelector(`option[value="${authorId}"]`) : null;
        const authorName = data.user ? data.user.userName : (selectedOpt ? selectedOpt.getAttribute('data-name') : '');
        const authorDept = data.user ? data.user.department : (selectedOpt ? selectedOpt.getAttribute('data-dept') : '');
        const origUser = data.originalUser || null;

        if (selectEl) {
          selectEl.value = authorId;
          selectEl.setAttribute('data-current-id', authorId);
        }

        applyAuthorChange(authorId, authorName, authorDept, data.mode, origUser);

        // モーダルを閉じる
        const modal = document.getElementById('switchAuthorModal');
        if (modal) modal.style.display = 'none';

        if (data.mode === 'override') {
          showToastNotification(`🩺 <strong>${escapeHtml(authorName)} 様</strong> として代行入力モードに切り替えました`);
        } else {
          showToastNotification(`👤 担当者を <strong>${escapeHtml(authorName)} 様</strong> に完全切り替えしました`);
        }
      } catch (err) {
        if (errorEl) {
          errorEl.textContent = err.message;
          errorEl.style.display = 'block';
        }
        if (passwordInput) {
          passwordInput.select();
        }
      } finally {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.innerHTML = '<span>🔑 認証して切り替える</span>';
        }
      }
    }

    // UI上の入力者情報・バナー反映
    function applyAuthorChange(authorId, authorName, authorDept, mode, originalUser) {
      // 隠しフィールドの更新
      const formAuthorInput = document.getElementById('formAuthorId');
      if (formAuthorInput) formAuthorInput.value = authorId;

      // SOAPヘッダーの記録者バッジ更新（元の入力者とオーバーライド中の入力者の両方を表示）
      const indicator = document.getElementById('carteAuthorIndicator');
      const origName = originalUser ? (originalUser.name || originalUser.userName || originalUser.id || '') : '';

      if (indicator) {
        if (mode === 'override') {
          indicator.style.background = '#f0fdf4';
          indicator.style.color = '#166534';
          indicator.style.borderColor = '#86efac';
          indicator.innerHTML = `🩺 記録者: ${escapeHtml(authorName)} 様 (${escapeHtml(authorDept || '一般')})${origName ? ` <span style="color:#2563eb; font-weight:normal; margin-left:0.3rem;">[代行入力: ${escapeHtml(origName)} 様]</span>` : ''}`;
        } else {
          indicator.style.background = '#e0f2fe';
          indicator.style.color = '#0369a1';
          indicator.style.borderColor = '#bae6fd';
          indicator.innerHTML = `🩺 記録者: ${escapeHtml(authorName)} 様 (${escapeHtml(authorDept || '一般')})`;
        }
      }

      // バナー & ヘッダーバッジの表示制御
      const banner = document.getElementById('overrideNoticeBanner');
      const headerBadge = document.getElementById('headerOverrideBadge');
      const noticeText = document.getElementById('overrideNoticeText');

      if (mode === 'override') {
        if (banner) banner.style.display = 'flex';
        if (headerBadge) headerBadge.style.display = 'inline-block';
        if (noticeText) {
          noticeText.innerHTML = `現在、<strong>${escapeHtml(authorName)}</strong> 様として一時的に代行入力中です${origName ? `（元のログイン: ${escapeHtml(origName)} 様）` : ''}`;
        }
      } else {
        if (banner) banner.style.display = 'none';
        if (headerBadge) headerBadge.style.display = 'none';
      }

      // 仮置きオーダーの著者タグも連動更新
      if (typeof renderStagedOrders === 'function') {
        renderStagedOrders();
      }

      // 入力者の所属部署に合わせて右ペインの部署リボンを自動連動切り替え
      if (authorDept && typeof selectRibbonDept === 'function') {
        if (authorDept.includes('医師')) {
          selectRibbonDept('doctor');
        } else if (authorDept.includes('看') || authorDept.includes('病棟') || authorDept.includes('外来')) {
          selectRibbonDept('nurse');
        } else if (authorDept.includes('薬')) {
          selectRibbonDept('pharmacy');
        } else if (authorDept.includes('放') || authorDept.includes('レントゲン') || authorDept.includes('放射線')) {
          selectRibbonDept('radiology');
        } else if (authorDept.includes('リハ') || authorDept.includes('療法')) {
          selectRibbonDept('rehab');
        } else if (authorDept.includes('介') || authorDept.includes('福祉')) {
          selectRibbonDept('care');
        }
      }
    }

    // ↩ 一時代行入力の解除
    async function revertOverrideAuthor() {
      try {
        const res = await fetch('/api/revert-override', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' }
        });
        const data = await res.json();
        if (!res.ok || !data.success) {
          throw new Error(data.error || '代行解除に失敗しました。');
        }

        const restoredUser = data.user;
        if (restoredUser) {
          const selectEl = document.getElementById('headerAuthorSelect');
          if (selectEl) {
            selectEl.value = restoredUser.id;
            selectEl.setAttribute('data-current-id', restoredUser.id);
          }
          applyAuthorChange(restoredUser.id, restoredUser.userName, restoredUser.department, 'complete', null);
          showToastNotification(`↩ 代行入力を解除し、<strong>${escapeHtml(restoredUser.userName)} 様</strong> に戻しました`);
        } else {
          location.reload();
        }
      } catch (err) {
        alert('代行解除エラー: ' + err.message);
      }
    }

