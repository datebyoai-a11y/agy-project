    // バイタル測定記録の独自記事作成
    function createVitalArticle() {
      onVitalValuesChanged();
      let parts = [];
      if (currentVitals.sys && currentVitals.dia) parts.push(`血圧 (BP): ${currentVitals.sys} / ${currentVitals.dia} mmHg`);
      if (currentVitals.pulse) parts.push(`脈拍 (HR): ${currentVitals.pulse} bpm`);
      if (currentVitals.temp) parts.push(`体温 (BT): ${currentVitals.temp} ℃`);
      if (currentVitals.spo2) parts.push(`酸素飽和度 (SpO2): ${currentVitals.spo2} %`);
      if (currentVitals.resp) parts.push(`呼吸数 (RR): ${currentVitals.resp} 回/分`);

      if (parts.length === 0) {
        alert('バイタル測定値を入力するか、下のプリセットボタンを選択してください。');
        return;
      }

      let summaryTitle = 'バイタル測定';
      if (currentVitals.sys && currentVitals.temp) {
        summaryTitle = `バイタル (BP:${currentVitals.sys}/${currentVitals.dia}, BT:${currentVitals.temp}℃)`;
      } else if (currentVitals.sys) {
        summaryTitle = `バイタル (BP:${currentVitals.sys}/${currentVitals.dia})`;
      } else if (currentVitals.temp) {
        summaryTitle = `バイタル (BT:${currentVitals.temp}℃)`;
      }

      const vitalBody = `【バイタルサイン測定記録】\n測定日時: ${new Date().toLocaleString('ja-JP')}\n\n` + parts.join('\n') + `\n\n測定完了・状態観察良好。`;

      createUniqueArticleFromPalette('看護部', 'バイタル', summaryTitle, parts.join(', '), vitalBody);
    }

