    // 互換用: 旧タブ切り替え
    function switchRightMainTab(tabName) {
      selectRibbonMenu(tabName, null);
    }

    // 右ペインリボンの初期化 (右列がオーダリングに置き換わったため安全化)
    function initRightRibbon(userDept) {
      try {
        const deptKey = getDeptKeyFromDeptName(userDept);
        selectRibbonDept(deptKey);
      } catch (_) {}
    }

    // =========================================================================
    // 🌟 右メニューから選択した要素を「独自記事 (Article)」として作成する新機能
    // =========================================================================

    // =========================================================
    // 💡 最下段ステータスバー (最後の操作 & 通知) 管理システム
    // =========================================================
    const statusHistory = [];
    const MAX_STATUS_HISTORY = 30;

    function formatCurrentTime() {
      const d = new Date();
      const pad = n => String(n).padStart(2, '0');
      return `${pad(d.getHours())}:${pad(d.getMinutes())}:${pad(d.getSeconds())}`;
    }

    // 最後の操作を記録 & ステータスバー更新
    function setLastAction(actionText) {
      const timeStr = formatCurrentTime();
      const el = document.getElementById('statusBarLastAction');
      const elTime = document.getElementById('statusBarActionTime');
      const sec = document.getElementById('statusActionSection');
      if (el) {
        el.textContent = actionText;
        el.title = `[${timeStr}] ${actionText}`;
      }
      if (elTime) elTime.textContent = timeStr;
      if (sec) {
        sec.classList.remove('status-pulse-action');
        void sec.offsetWidth;
        sec.classList.add('status-pulse-action');
      }
      addStatusHistory('action', actionText, timeStr);
    }

    // 最新の通知を記録 & ステータスバー更新
    function setLatestNotice(noticeText, type = 'info') {
      const timeStr = formatCurrentTime();
      const el = document.getElementById('statusBarLatestNotice');
      const elTime = document.getElementById('statusBarNoticeTime');
      const elIcon = document.getElementById('statusBarNoticeIcon');
      const sec = document.getElementById('statusNoticeSection');

      let icon = '📢';
      let color = '#a7f3d0';
      if (type === 'success') {
        icon = '✅';
        color = '#4ade80';
      } else if (type === 'warning') {
        icon = '⚠️';
        color = '#fbbf24';
      } else if (type === 'error') {
        icon = '❌';
        color = '#f87171';
      } else if (type === 'info') {
        icon = 'ℹ️';
        color = '#38bdf8';
      }

      if (elIcon) elIcon.textContent = icon;
      if (el) {
        el.textContent = noticeText;
        el.style.color = color;
        el.title = `[${timeStr}] ${noticeText}`;
      }
      if (elTime) elTime.textContent = timeStr;
      if (sec) {
        sec.classList.remove('status-pulse-notice');
        void sec.offsetWidth;
        sec.classList.add('status-pulse-notice');
      }
      addStatusHistory(type, noticeText, timeStr);
    }

    // 操作と通知を両方一度に更新する
    function updateStatusBar(actionText, noticeText, type = 'info') {
      if (actionText) setLastAction(actionText);
      if (noticeText) setLatestNotice(noticeText, type);
    }

    function addStatusHistory(type, message, timeStr) {
      statusHistory.unshift({ type, message, time: timeStr });
      if (statusHistory.length > MAX_STATUS_HISTORY) {
        statusHistory.pop();
      }
      const countEl = document.getElementById('statusHistoryCount');
      if (countEl) countEl.textContent = statusHistory.length;
    }

    function toggleStatusHistoryModal() {
      const modal = document.getElementById('statusHistoryModal');
      if (!modal) return;
      if (modal.style.display === 'none' || !modal.style.display) {
        renderStatusHistoryList();
        modal.style.display = 'flex';
      } else {
        modal.style.display = 'none';
      }
    }

    function closeStatusHistoryModal(e) {
      if (!e || e.target === document.getElementById('statusHistoryModal') || 
          e.target.classList.contains('status-history-close-btn') || 
          e.target.classList.contains('status-history-ok-btn')) {
        const modal = document.getElementById('statusHistoryModal');
        if (modal) modal.style.display = 'none';
      }
    }

    function clearStatusHistory() {
      statusHistory.length = 0;
      const countEl = document.getElementById('statusHistoryCount');
      if (countEl) countEl.textContent = '0';
      renderStatusHistoryList();
    }

    function renderStatusHistoryList() {
      const container = document.getElementById('statusHistoryList');
      if (!container) return;
      if (statusHistory.length === 0) {
        container.innerHTML = '<div style="color:#64748b; text-align:center; padding:1.5rem 0; font-size:0.8rem;">操作・通知履歴はありません</div>';
        return;
      }
      let html = '';
      statusHistory.forEach(item => {
        let typeClass = 'type-action';
        let typeLabel = '操作';
        if (item.type === 'success') { typeClass = 'type-notice'; typeLabel = '成功'; }
        else if (item.type === 'notice' || item.type === 'info') { typeClass = 'type-notice'; typeLabel = '通知'; }
        else if (item.type === 'warning') { typeClass = 'type-warning'; typeLabel = '注意'; }
        else if (item.type === 'error') { typeClass = 'type-error'; typeLabel = 'エラー'; }

        html += `
          <div class="status-history-item">
            <span class="status-history-time">${escapeHtml(item.time)}</span>
            <span class="status-history-type ${typeClass}">${typeLabel}</span>
            <span class="status-history-msg">${escapeHtml(item.message)}</span>
          </div>
        `;
      });
      container.innerHTML = html;
    }

    // トースト通知の表示ヘルパー
    let toastTimeout = null;
    function showToastNotification(message, isSuccess = true) {
      const plainText = message.replace(/<[^>]*>/g, '').trim();
      setLatestNotice(plainText, isSuccess ? 'success' : 'error');

      const toast = document.getElementById('toastNotification');
      const msgEl = document.getElementById('toastMessage');
      if (!toast || !msgEl) return;

      toast.style.background = isSuccess ? '#0f172a' : '#991b1b';
      toast.style.border = isSuccess ? '1px solid #334155' : '1px solid #f87171';
      msgEl.innerHTML = message;
      toast.style.display = 'flex';

      if (toastTimeout) clearTimeout(toastTimeout);
      toastTimeout = setTimeout(() => {
        toast.style.display = 'none';
      }, 4000);
    }

    // 🌟 指定患者の最新オーダー記事（処方または放射線）を探索して「対」関係を検出
    function findLatestOrderArticle(targetPersonId, orderType) {
      const items = Array.from(document.querySelectorAll('.article-item'));
      for (let i = items.length - 1; i >= 0; i--) {
        const el = items[i];
        const artTargetId = el.getAttribute('data-target-id');
        if (targetPersonId && artTargetId && artTargetId !== targetPersonId && artTargetId !== 'ALL' && artTargetId !== 'NONE') {
          continue;
        }

        const artId = el.getAttribute('data-article-id');
        if (!artId) continue;

        const isPrescription = el.getAttribute('data-is-prescription') === 'true';
        const isRadiology = el.getAttribute('data-is-radiology') === 'true';
        const cat = el.getAttribute('data-category') || '';
        const titleEl = el.querySelector('div[style*="font-weight:bold; color:#0f172a"]');
        const title = titleEl ? titleEl.textContent.trim() : (el.getAttribute('data-title') || '');

        if (orderType === 'prescription') {
          if (isPrescription || cat === '処方' || cat === '処方オーダー' || cat === '点滴指示' || cat === '点滴オーダー' ||
              title.includes('【処方】') || title.includes('【点滴オーダー】') || title.includes('処方オーダー')) {
            return { id: artId, title: title || '処方オーダー', category: cat };
          }
        } else if (orderType === 'radiology') {
          if (isRadiology || cat.includes('放射線') || cat.includes('レントゲン') || cat.includes('CT') || cat.includes('MRI') ||
              title.includes('放射線') || title.includes('X線') || title.includes('CT')) {
            return { id: artId, title: title || '放射線オーダー', category: cat };
          }
        }
      }
      return null;
    }

    function escapeHtml(str) {
      if (str === null || str === undefined) return '';
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    // =========================================================================
    // 📦 仮置きオーダー（ステージング）管理
    // =========================================================================
    let stagedOrders = [];

    // 仮置きオーダー追加
    function addOrderToStaged(orderData) {
      const order = {
        id: 'staged_' + Date.now() + '_' + Math.random().toString(36).substr(2, 5),
        dept: orderData.dept || '医師',
        category: orderData.category || 'オーダー',
        title: orderData.title || '',
        detail: orderData.detail || '',
        content: orderData.content || '',
        targetPersonId: orderData.targetPersonId || document.getElementById('formTargetPersonSelect')?.value || '',
        createdAt: new Date().toISOString(),
        // 詳細属性（点滴・放射線・食事等）
        medicine: orderData.medicine || '',
        rate: orderData.rate || '',
        examType: orderData.examType || '',
        portable: orderData.portable || '放射線科撮影室',
        mealType: orderData.mealType || '常食 (一般食)',
        allergies: orderData.allergies || ''
      };

      stagedOrders.push(order);
      saveStagedOrdersToStorage();
      renderStagedOrders();

      // トースト通知で仮置き完了を知らせる
      showToastNotification(`📦 仮置きに追加: <strong>${escapeHtml(order.title)}</strong>`);

      // 仮置き欄へスムーズスクロール
      const container = document.getElementById('stagedOrdersContainer');
      if (container) {
        container.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }
    }

    // 特定の仮置きオーダーを削除
    function removeStagedOrder(orderId) {
      const idx = stagedOrders.findIndex(o => o.id === orderId);
      if (idx !== -1) {
        const removed = stagedOrders.splice(idx, 1)[0];
        saveStagedOrdersToStorage();
        renderStagedOrders();
        showToastNotification(`🗑️ 仮置きオーダーを削除しました: ${escapeHtml(removed.title)}`);
      }
    }

    // 全ての仮置きオーダーをクリア
    function clearAllStagedOrders() {
      if (stagedOrders.length === 0) return;
      if (confirm('仮置き中のオーダーをすべて削除しますか？')) {
        stagedOrders = [];
        saveStagedOrdersToStorage();
        renderStagedOrders();
        showToastNotification('🗑️ すべての仮置きオーダーを削除しました');
      }
    }

    // ローカルストレージ保存・復元
    function saveStagedOrdersToStorage() {
      try {
        const targetId = document.getElementById('formTargetPersonSelect')?.value || 'common';
        localStorage.setItem(`staged_orders_${targetId}`, JSON.stringify(stagedOrders));
      } catch (e) {
        console.warn('Failed to save staged orders:', e);
      }
    }

    function loadStagedOrdersFromStorage() {
      try {
        const targetId = document.getElementById('formTargetPersonSelect')?.value || 'common';
        const saved = localStorage.getItem(`staged_orders_${targetId}`);
        if (saved) {
          stagedOrders = JSON.parse(saved);
        } else {
          stagedOrders = [];
        }
        renderStagedOrders();
      } catch (e) {
        console.warn('Failed to load staged orders:', e);
      }
    }

    // 仮置きオーダー一覧のHTML再描画
    function renderStagedOrders() {
      const container = document.getElementById('stagedOrdersContainer');
      const countEl = document.getElementById('stagedOrdersCount');
      const listEl = document.getElementById('stagedOrdersList');
      const clearBtn = document.getElementById('clearStagedBtn');
      const submitBtnText = document.getElementById('submitBtnText');

      if (countEl) countEl.textContent = stagedOrders.length;

      if (!listEl) return;
      listEl.innerHTML = '';

      if (stagedOrders.length === 0) {
        if (container) container.style.display = 'none';
        if (clearBtn) clearBtn.style.display = 'none';
        if (submitBtnText) submitBtnText.textContent = '💾 カルテを完了・保存';
        return;
      }

      // 1件以上のオーダーがある場合のみ表示
      if (container) container.style.display = 'flex';
      if (clearBtn) clearBtn.style.display = 'inline-block';
      if (submitBtnText) {
        submitBtnText.textContent = `💾 カルテと仮置きオーダー (${stagedOrders.length}件) を確定・保存`;
      }

      const stagedAuthorTag = document.getElementById('stagedOrdersAuthorTag');
      const headerOverrideBadge = document.getElementById('headerOverrideBadge');
      const isOverriding = headerOverrideBadge && headerOverrideBadge.style.display !== 'none';
      if (stagedAuthorTag) {
        if (isOverriding) {
          const selectEl = document.getElementById('headerAuthorSelect');
          const authorName = selectEl ? (selectEl.selectedOptions[0]?.getAttribute('data-name') || selectEl.selectedOptions[0]?.text) : '';
          const origNoticeText = document.getElementById('overrideNoticeText');
          const matchOrig = origNoticeText ? origNoticeText.textContent.match(/元のログイン:\s*([^様）]+)/) : null;
          const origName = matchOrig ? matchOrig[1].trim() : '';
          stagedAuthorTag.textContent = `[発行名義: ${authorName || '担当者'} 様${origName ? ` / 代行入力: ${origName} 様` : ''}]`;
          stagedAuthorTag.style.display = 'inline';
        } else {
          stagedAuthorTag.textContent = '';
          stagedAuthorTag.style.display = 'none';
        }
      }

      stagedOrders.forEach((order, index) => {
        let badgeBg = '#0284c7';
        let badgeIcon = '📋';
        const cat = order.category || '';

        if (cat.includes('処方') || order.dept === '薬剤部') {
          badgeBg = '#0284c7';
          badgeIcon = '💊';
