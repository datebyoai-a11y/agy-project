    // 16. カルテ下書きの一時保存・自動復元機能
    let carteDraftSaveTimeout = null;

    // 現在選択されている患者IDの取得ヘルパー
    function getActiveCarteTargetId() {
      const formTarget = document.getElementById('formTargetPersonSelect');
      if (formTarget && formTarget.value && formTarget.value !== 'ALL' && formTarget.value !== 'NONE') {
        return formTarget.value;
      }
      const headerFilter = document.getElementById('headerTargetFilter');
      if (headerFilter && headerFilter.value && headerFilter.value !== 'ALL' && headerFilter.value !== 'NONE') {
        return headerFilter.value;
      }
      return 'common';
    }

    // カルテ下書きを localStorage に保存
    function saveCarteDraft(manual = false) {
      try {
        const textarea = document.getElementById('articleContentInput');
        if (!textarea) return;
        const content = textarea.value;
        const targetId = getActiveCarteTargetId();
        const indicator = document.getElementById('draftSaveTimeIndicator');

        // 本文が空の場合、下書きをクリア
        if (!content.trim()) {
          localStorage.removeItem(`carte_draft_${targetId}`);
          if (indicator && manual) indicator.textContent = '';
          if (manual) showToastNotification('ℹ️ 入力内容が空のため、一時保存データをクリアしました');
          return;
        }

        const now = new Date();
        const draftData = {
          content: content,
          savedAt: now.toISOString(),
          targetId: targetId
        };

        localStorage.setItem(`carte_draft_${targetId}`, JSON.stringify(draftData));

        const timeStr = now.toLocaleTimeString('ja-JP', { hour: '2-digit', minute: '2-digit' });
        if (indicator) {
          indicator.textContent = `一時保存済 (${timeStr})`;
          indicator.style.color = '#059669';
        }

        if (manual) {
          showToastNotification(`📝 カルテの下書きを一時保存しました (${timeStr})`);
        }
      } catch (e) {
        console.warn('カルテ下書き保存エラー:', e);
      }
    }

    // カルテ入力時の自動バックアップ（1.2秒デバウンス）
    function onCarteContentInput() {
      const indicator = document.getElementById('draftSaveTimeIndicator');
      if (indicator) {
        indicator.textContent = '入力中...';
        indicator.style.color = '#64748b';
      }
      if (carteDraftSaveTimeout) clearTimeout(carteDraftSaveTimeout);
      carteDraftSaveTimeout = setTimeout(() => {
        saveCarteDraft(false);
      }, 1200);
    }

    // カルテ下書きの自動復元
    function loadCarteDraftFromStorage(targetId = null) {
      try {
        const activeTargetId = targetId || getActiveCarteTargetId();
        const savedJson = localStorage.getItem(`carte_draft_${activeTargetId}`);
        const textarea = document.getElementById('articleContentInput');
        const banner = document.getElementById('draftNoticeBanner');
        const bannerText = document.getElementById('draftNoticeText');
        const indicator = document.getElementById('draftSaveTimeIndicator');

        if (!savedJson) {
          if (banner) banner.style.display = 'none';
          if (indicator) indicator.textContent = '';
          return false;
        }

        const draft = JSON.parse(savedJson);
        if (draft && draft.content && draft.content.trim()) {
          if (textarea) {
            textarea.value = draft.content;
          }

          const savedDate = draft.savedAt ? new Date(draft.savedAt) : null;
          const timeStr = savedDate ? savedDate.toLocaleString('ja-JP', { month: 'numeric', day: 'numeric', hour: '2-digit', minute: '2-digit' }) : '前回';

          if (banner) {
            banner.style.display = 'flex';
            if (bannerText) {
              bannerText.innerHTML = `前回の一時保存（下書き: <strong>${escapeHtml(timeStr)}</strong>）を自動復帰しました`;
            }
          }
          if (indicator) {
            indicator.textContent = `下書き復元済 (${savedDate ? savedDate.toLocaleTimeString('ja-JP', { hour: '2-digit', minute: '2-digit' }) : ''})`;
            indicator.style.color = '#059669';
          }

          showToastNotification(`📝 前回の一時保存（下書き: ${timeStr}）を自動復帰しました`);
          return true;
        } else {
          if (banner) banner.style.display = 'none';
          return false;
        }
      } catch (e) {
        console.warn('カルテ下書き復元エラー:', e);
        return false;
      }
    }

    // カルテ下書きの破棄
    function discardCarteDraft() {
      if (!confirm('一時保存されていた下書きを破棄し、入力をクリアしますか？')) return;
      const targetId = getActiveCarteTargetId();
      localStorage.removeItem(`carte_draft_${targetId}`);

      const textarea = document.getElementById('articleContentInput');
      if (textarea) textarea.value = '';

      const banner = document.getElementById('draftNoticeBanner');
      if (banner) banner.style.display = 'none';

      const indicator = document.getElementById('draftSaveTimeIndicator');
      if (indicator) indicator.textContent = '';

      showToastNotification('🗑️ 一時保存（下書き）を破棄しました');
    }

    // 現在日時を <input type="datetime-local"> 用 (YYYY-MM-DDTHH:mm) にフォーマットする関数
    function getCurrentDateTimeLocal() {
      const now = new Date();
      const year = now.getFullYear();
      const month = String(now.getMonth() + 1).padStart(2, '0');
      const day = String(now.getDate()).padStart(2, '0');
      const hours = String(now.getHours()).padStart(2, '0');
      const minutes = String(now.getMinutes()).padStart(2, '0');
      return `${year}-${month}-${day}T${hours}:${minutes}`;
    }

    // フィルタリング状態管理
    let currentSelectedTargetId = 'ALL';
    let currentSelectedDeptFilter = '<%= currentUserDept || "ALL" %>';
    let currentSelectedCatFilter = 'ALL';

    // 17. 最新記事（タイムラインの一番上）にフォーカスする関数
    function focusLatestArticle(smooth = true) {
      const container = document.getElementById('timelineContainer');
      const visibleItems = Array.from(document.querySelectorAll('.article-item'))
        .filter(item => item.style.display !== 'none');

      if (visibleItems.length > 0) {
        const latestItem = visibleItems[0]; // 上が最新記事！
        document.querySelectorAll('.article-item.latest-focus').forEach(el => el.classList.remove('latest-focus'));
        latestItem.classList.add('latest-focus');
        setTimeout(() => {
          latestItem.scrollIntoView({ behavior: smooth ? 'smooth' : 'auto', block: 'nearest' });
        }, 60);
      } else if (container) {
        container.scrollTop = 0;
      }
    }

    // 後方互換用エイリアス
    function scrollToLatestArticle(smooth = true) {
      focusLatestArticle(smooth);
    }

    function applyArticleFilters() {
      const items = document.querySelectorAll('.article-item');
      const allModeTags = document.querySelectorAll('.all-mode-target-tag');
      let visibleCount = 0;

      items.forEach(item => {
        // 🔒 引用修正によって非表示化された元記事は常に非表示を維持
        if (item.classList.contains('hidden-original-article') || item.getAttribute('data-is-original-hidden') === 'true') {
          item.style.display = 'none';
          return;
        }

        const itemTargetId = item.getAttribute('data-target-id');
        const itemCat = item.getAttribute('data-category') || '';
        const itemDept = item.getAttribute('data-author-dept') || '';

        // 1. 対象者一致判定
        const matchesTarget = (currentSelectedTargetId === 'ALL') || (currentSelectedTargetId === itemTargetId);

        // 2. 職種・部署一致判定（部分一致含む柔軟な判定）
        let matchesDept = true;
        if (currentSelectedDeptFilter !== 'ALL') {
          if (currentSelectedDeptFilter === 'リハビリ') {
            matchesDept = (itemDept === 'リハビリ') || itemDept.includes('リハビリ') || itemDept.includes('療法');
          } else {
            matchesDept = (itemDept === currentSelectedDeptFilter) || (itemDept.includes(currentSelectedDeptFilter));
          }
        }

        // 3. カテゴリー一致判定
        let matchesCat = true;
        if (currentSelectedCatFilter === 'RAD') {
          matchesCat = itemCat.includes('放射線') || itemCat.includes('レントゲン') || itemCat.includes('CT') || itemCat.includes('MRI');
        } else if (currentSelectedCatFilter === 'IV') {
          matchesCat = itemCat.includes('点滴') || itemCat.includes('注射');
        } else if (currentSelectedCatFilter === 'MEAL') {
          matchesCat = itemCat.includes('食事');
        } else if (currentSelectedCatFilter === 'NOTE') {
          matchesCat = !itemCat.includes('点滴') && !itemCat.includes('食事') && !itemCat.includes('放射線');
        }

        if (matchesTarget && matchesDept && matchesCat) {
          item.style.display = 'block';
          visibleCount++;
        } else {
          item.style.display = 'none';
        }
      });

      // 表示件数を更新
      document.getElementById('visibleCount').textContent = visibleCount;

      // 0件時のメッセージ表示制御
      const noNotice = document.getElementById('noArticlesNotice');
      if (noNotice) {
        if (visibleCount === 0) {
          noNotice.style.display = 'block';
          const labelEl = document.getElementById('currentDeptLabel');
          if (labelEl) {
            labelEl.textContent = currentSelectedDeptFilter === 'ALL' ? '全体' : currentSelectedDeptFilter;
          }
        } else {
          noNotice.style.display = 'none';
        }
      }

      scrollToLatestArticle();
    }

    // 職種ドロップダウンによる絞り込み
    function filterArticlesByDept(selectedDept) {
      currentSelectedDeptFilter = selectedDept;
      applyArticleFilters();
    }

