    // 🩺 入力者切り替えモーダルの起動
    function promptSwitchAuthor(selectEl) {
      if (!selectEl) return;
      const targetAuthorId = selectEl.value;
      const currentAuthorId = selectEl.getAttribute('data-current-id') || '';

      // 同じユーザーが選択された場合は何もしない
      if (targetAuthorId && targetAuthorId === currentAuthorId) return;

      const selectedOpt = selectEl.selectedOptions ? selectEl.selectedOptions[0] : null;
      if (!selectedOpt) return;

      const authorName = selectedOpt.getAttribute('data-name') || selectedOpt.text;
      const authorDept = selectedOpt.getAttribute('data-dept') || '';
      const authorLoginId = selectedOpt.getAttribute('data-loginid') || '';

      const modal = document.getElementById('switchAuthorModal');
      const targetIdInput = document.getElementById('switchTargetAuthorId');
      const targetNameEl = document.getElementById('switchTargetAuthorName');
      const targetDeptEl = document.getElementById('switchTargetAuthorDept');
      const targetLoginEl = document.getElementById('switchTargetAuthorLoginId');
      const passwordInput = document.getElementById('switchAuthorPassword');
      const errorEl = document.getElementById('switchAuthorError');

      if (!modal) {
        console.warn('switchAuthorModal が見つかりません。');
        return;
      }

      targetIdInput.value = targetAuthorId;
      if (targetNameEl) targetNameEl.textContent = authorName + ' 様';
      if (targetDeptEl) targetDeptEl.textContent = authorDept || '一般';
      if (targetLoginEl) targetLoginEl.textContent = authorLoginId ? `ログインID: ${authorLoginId}` : '';
      if (passwordInput) passwordInput.value = '';
      if (errorEl) {
        errorEl.style.display = 'none';
        errorEl.textContent = '';
      }

      // モーダル表示
      modal.style.display = 'flex';
      setTimeout(() => {
        if (passwordInput) passwordInput.focus();
      }, 100);
    }

    // ✕ 入力者切り替えモーダルのキャンセル
    function cancelSwitchAuthorModal(event) {
      if (event && event.target && event.target !== event.currentTarget && !event.target.classList.contains('pgp-modal-close') && event.target.tagName !== 'BUTTON') {
        return;
      }
      const modal = document.getElementById('switchAuthorModal');
      if (modal) modal.style.display = 'none';

      // セレクトボックスの選択を以前の値に戻す
      const selectEl = document.getElementById('headerAuthorSelect');
      if (selectEl) {
        const currentAuthorId = selectEl.getAttribute('data-current-id');
        if (currentAuthorId) {
          selectEl.value = currentAuthorId;
        }
      }
    }

    // 🔑 入力者切り替えの実行（パスワード認証 & モード適用）
    async function handleSwitchAuthorSubmit(event) {
      if (event) event.preventDefault();
      const targetIdInput = document.getElementById('switchTargetAuthorId');
      const authorId = targetIdInput ? targetIdInput.value : '';
      const passwordInput = document.getElementById('switchAuthorPassword');
      const password = passwordInput ? passwordInput.value : '';
      const modeRadio = document.querySelector('input[name="switchMode"]:checked');
      const mode = modeRadio ? modeRadio.value : 'override';
      const errorEl = document.getElementById('switchAuthorError');
      const submitBtn = document.getElementById('switchAuthorSubmitBtn');

      if (!authorId) {
        if (errorEl) {
          errorEl.textContent = '切り替え先ユーザーが指定されていません。';
          errorEl.style.display = 'block';
        }
        return;
      }
      if (!password) {
        if (errorEl) {
          errorEl.textContent = 'パスワードを入力してください。';
          errorEl.style.display = 'block';
        }
        if (passwordInput) passwordInput.focus();
        return;
      }

      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.innerHTML = '<span>🔄 認証中...</span>';
      }
      if (errorEl) {
        errorEl.style.display = 'none';
        errorEl.textContent = '';
      }

      try {
        const res = await fetch('/api/switch-author', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify({ authorId, password, mode })
        });

        const data = await res.json();
        if (!res.ok || !data.success) {
          throw new Error(data.error || 'パスワード認証に失敗しました。');
        }

        // 成功時の画面反映
        const selectEl = document.getElementById('headerAuthorSelect');
        const selectedOpt = selectEl ? selectEl.querySelector(`option[value="${authorId}"]`) : null;
        const authorName = data.user ? data.user.userName : (selectedOpt ? selectedOpt.getAttribute('data-name') : '');
        const authorDept = data.user ? data.user.department : (selectedOpt ? selectedOpt.getAttribute('data-dept') : '');
        const origUser = data.originalUser || null;

        if (selectEl) {
          selectEl.value = authorId;
          selectEl.setAttribute('data-current-id', authorId);
        }

        applyAuthorChange(authorId, authorName, authorDept, data.mode, origUser);

        // モーダルを閉じる
        const modal = document.getElementById('switchAuthorModal');
        if (modal) modal.style.display = 'none';

        if (data.mode === 'override') {
          showToastNotification(`🩺 <strong>${escapeHtml(authorName)} 様</strong> として代行入力モードに切り替えました`);
        } else {
          showToastNotification(`👤 担当者を <strong>${escapeHtml(authorName)} 様</strong> に完全切り替えしました`);
        }
      } catch (err) {
        if (errorEl) {
          errorEl.textContent = err.message;
          errorEl.style.display = 'block';
        }
        if (passwordInput) {
          passwordInput.select();
        }
      } finally {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.innerHTML = '<span>🔑 認証して切り替える</span>';
        }
      }
    }

    // UI上の入力者情報・バナー反映
    function applyAuthorChange(authorId, authorName, authorDept, mode, originalUser) {
      // 隠しフィールドの更新
      const formAuthorInput = document.getElementById('formAuthorId');
      if (formAuthorInput) formAuthorInput.value = authorId;

      // SOAPヘッダーの記録者バッジ更新（元の入力者とオーバーライド中の入力者の両方を表示）
      const indicator = document.getElementById('carteAuthorIndicator');
      const origName = originalUser ? (originalUser.name || originalUser.userName || originalUser.id || '') : '';

      if (indicator) {
        if (mode === 'override') {
          indicator.style.background = '#f0fdf4';
          indicator.style.color = '#166534';
          indicator.style.borderColor = '#86efac';
          indicator.innerHTML = `🩺 記録者: ${escapeHtml(authorName)} 様 (${escapeHtml(authorDept || '一般')})${origName ? ` <span style="color:#2563eb; font-weight:normal; margin-left:0.3rem;">[代行入力: ${escapeHtml(origName)} 様]</span>` : ''}`;
        } else {
          indicator.style.background = '#e0f2fe';
          indicator.style.color = '#0369a1';
          indicator.style.borderColor = '#bae6fd';
          indicator.innerHTML = `🩺 記録者: ${escapeHtml(authorName)} 様 (${escapeHtml(authorDept || '一般')})`;
        }
      }

      // バナー & ヘッダーバッジの表示制御
      const banner = document.getElementById('overrideNoticeBanner');
      const headerBadge = document.getElementById('headerOverrideBadge');
      const noticeText = document.getElementById('overrideNoticeText');

      if (mode === 'override') {
        if (banner) banner.style.display = 'flex';
        if (headerBadge) headerBadge.style.display = 'inline-block';
        if (noticeText) {
          noticeText.innerHTML = `現在、<strong>${escapeHtml(authorName)}</strong> 様として一時的に代行入力中です${origName ? `（元のログイン: ${escapeHtml(origName)} 様）` : ''}`;
        }
      } else {
        if (banner) banner.style.display = 'none';
        if (headerBadge) headerBadge.style.display = 'none';
      }

      // 仮置きオーダーの著者タグも連動更新
      if (typeof renderStagedOrders === 'function') {
        renderStagedOrders();
      }

      // 入力者の所属部署に合わせて右ペインの部署リボンを自動連動切り替え
      if (authorDept && typeof selectRibbonDept === 'function') {
        if (authorDept.includes('医師')) {
          selectRibbonDept('doctor');
        } else if (authorDept.includes('看') || authorDept.includes('病棟') || authorDept.includes('外来')) {
          selectRibbonDept('nurse');
        } else if (authorDept.includes('薬')) {
          selectRibbonDept('pharmacy');
        } else if (authorDept.includes('放') || authorDept.includes('レントゲン') || authorDept.includes('放射線')) {
          selectRibbonDept('radiology');
        } else if (authorDept.includes('リハ') || authorDept.includes('療法')) {
          selectRibbonDept('rehab');
        } else if (authorDept.includes('介') || authorDept.includes('福祉')) {
          selectRibbonDept('care');
        }
      }
    }

    // ↩ 一時代行入力の解除
    async function revertOverrideAuthor() {
      try {
        const res = await fetch('/api/revert-override', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' }
        });
        const data = await res.json();
        if (!res.ok || !data.success) {
          throw new Error(data.error || '代行解除に失敗しました。');
        }

        const restoredUser = data.user;
        if (restoredUser) {
          const selectEl = document.getElementById('headerAuthorSelect');
          if (selectEl) {
            selectEl.value = restoredUser.id;
            selectEl.setAttribute('data-current-id', restoredUser.id);
          }
          applyAuthorChange(restoredUser.id, restoredUser.userName, restoredUser.department, 'complete', null);
          showToastNotification(`↩ 代行入力を解除し、<strong>${escapeHtml(restoredUser.userName)} 様</strong> に戻しました`);
        } else {
          location.reload();
        }
      } catch (err) {
        alert('代行解除エラー: ' + err.message);
      }
    }

    // 🔗 現在選択中の患者情報を付与したオーダリングシステムのURLを動的に生成
    function getOrderingSystemUrl(customOrderType = null) {
      const headerFilter = document.getElementById('headerTargetFilter');
      const formTarget = document.getElementById('formTargetPersonSelect');
      let targetPersonId = (formTarget && formTarget.value) ? formTarget.value : '';
      if (!targetPersonId && headerFilter && headerFilter.value !== 'ALL' && headerFilter.value !== 'NONE') {
        targetPersonId = headerFilter.value;
      }

      let patientName = '';
      let patientCustomId = '';
      let patientDept = '';

      if (targetPersonId) {
        const opt = document.querySelector(`#headerTargetFilter option[value="${targetPersonId}"]`) ||
                    document.querySelector(`#formTargetPersonSelect option[value="${targetPersonId}"]`);
        if (opt) {
          patientName = opt.getAttribute('data-name') || opt.textContent.split('(')[0].replace(/^\[.*?\]\s*/, '').trim();
          patientCustomId = opt.getAttribute('data-custom-id') || targetPersonId;
          patientDept = opt.getAttribute('data-dept') || '';
        }
      }

      // フォールバック: ヘッダー表示から患者情報を直接取得
      if (!patientCustomId) {
        const idText = document.getElementById('cartePatientId')?.textContent?.trim();
        const nameText = document.getElementById('cartePatientName')?.textContent?.trim();
        if (idText && idText !== '未選択' && idText !== '0000000001') {
          patientCustomId = idText;
        }
        if (nameText && nameText !== '未選択' && nameText !== '全患者（すべての記事）') {
          patientName = nameText;
        }
      }

      let orderType = customOrderType;
      if (!orderType) {
        const catSelect = document.getElementById('formCategorySelect');
        const cat = catSelect ? catSelect.value : '';
        if (cat.includes('点滴')) orderType = 'IV';
        else if (cat.includes('処方')) orderType = 'PRESCRIPTION';
        else if (cat.includes('放射線') || cat.includes('レントゲン') || cat.includes('CT')) orderType = 'RADIOLOGY';
        else if (cat.includes('食事')) orderType = 'MEAL';
        else if (cat.includes('検査')) orderType = 'LAB_EXAM';
        else orderType = 'IV'; // デフォルトは病棟用注射指示
      }

      const isHttps = window.location.protocol === 'https:';
      const senderPort = isHttps ? 4443 : 4000;
      const protocol = isHttps ? 'https:' : 'http:';
      const host = window.location.hostname || 'localhost';
      const url = new URL(`${protocol}//${host}:${senderPort}/`);

      if (patientCustomId) url.searchParams.set('patientId', patientCustomId);
      if (patientName) url.searchParams.set('patientName', patientName);
      if (patientDept) url.searchParams.set('patientDept', patientDept);
      if (orderType) url.searchParams.set('orderType', orderType);

      // 電子カルテ戻りURLもパラメータにセット
      try {
        const returnUrl = new URL(window.location.origin + '/articles');
        if (patientCustomId) returnUrl.searchParams.set('targetId', patientCustomId);
        url.searchParams.set('returnUrl', returnUrl.toString());
      } catch (_) {}

      return url.toString();
    }

    // 🚀 オーダリングシステム送信画面 (Port 4000) を現在選択中の患者情報を引き継いで開く（既存タブがあれば再利用・移行）
    function openOrderingSystem(customOrderType = null) {
      const targetUrl = getOrderingSystemUrl(customOrderType);
      try {
        const win = window.open(targetUrl, 'app_ordering_sender');
        if (win && !win.closed) {
          try { win.focus(); } catch (_) {}
        } else {
          window.location.href = targetUrl;
        }
      } catch (e) {
        window.location.href = targetUrl;
      }
    }

    // リンククリック時のハンドラ (ポップアップブロックを防止しつつ確実に開く)
    function handleOrderingClick(event, elem, customOrderType = null) {
      const targetUrl = getOrderingSystemUrl(customOrderType);
      if (elem) elem.href = targetUrl;
      // 通常クリックの場合
      if (event && !event.ctrlKey && !event.metaKey && !event.shiftKey) {
        event.preventDefault();
        openOrderingSystem(customOrderType);
        return false;
      }
      return true;
    }

    // 📋 原本様式の注射指示入力画面（案）を開くハンドラ（既存タブがあれば再利用・移行）
    function handlePaperInjectionClick(event, elem) {
      const isHttps = window.location.protocol === 'https:';
      const hostname = window.location.hostname || 'localhost';
      const port = isHttps ? 5443 : 4000;
      let url = `${window.location.protocol}//${hostname}:${port}/injection-sheet-form`;
      const params = new URLSearchParams();
      if (currentTargetPersonId) params.set('patientId', currentTargetPersonId);
      if (currentTargetPersonName) params.set('patientName', currentTargetPersonName);
      if (currentTargetPersonWard) params.set('patientDept', currentTargetPersonWard);
      const queryStr = params.toString();
      if (queryStr) url += `?${queryStr}`;

      if (elem) elem.href = url;
      try {
        const win = window.open(url, 'app_injection_sheet');
        if (win && !win.closed) {
          try { win.focus(); } catch (_) {}
        }
      } catch (e) {
        window.location.href = url;
      }
      if (event) event.preventDefault();
      return false;
    }

    // 画面上の全オーダリングボタン・リンクおよび右列iframeのURLを最新状態に同期
    function updateOrderingLinks() {
      try {
        const targetUrl = getOrderingSystemUrl();
        const topBtn = document.getElementById('btnOrderingTop');
        if (topBtn) topBtn.href = targetUrl;
        const gearLink = document.getElementById('btnOrderingGear');
        if (gearLink) gearLink.href = targetUrl;
        const extBtn = document.getElementById('btnOrderingOpenExternal');
        if (extBtn) extBtn.href = targetUrl;

        // 原本様式入力画面へのリンクも更新
        const paperLink = document.getElementById('btnPaperInjectionGear');
        if (paperLink) {
          const isHttps = window.location.protocol === 'https:';
          const hostname = window.location.hostname || 'localhost';
          const port = isHttps ? 5443 : 4000;
          let paperUrl = `${window.location.protocol}//${hostname}:${port}/injection-sheet-form`;
          const params = new URLSearchParams();
          if (currentTargetPersonId) params.set('patientId', currentTargetPersonId);
          if (currentTargetPersonName) params.set('patientName', currentTargetPersonName);
          if (currentTargetPersonWard) params.set('patientDept', currentTargetPersonWard);
          const pStr = params.toString();
          if (pStr) paperUrl += `?${pStr}`;
          paperLink.href = paperUrl;
        }

        // 🚀 右ペインのオーダリング埋め込み iframe (embedded=1) を同期
        const frame = document.getElementById('orderingSenderFrame');
        if (frame) {
          const embeddedUrl = new URL(targetUrl);
          embeddedUrl.searchParams.set('embedded', '1');
          const finalUrlStr = embeddedUrl.toString();

          const currentSrc = frame.getAttribute('src');
          if (currentSrc !== finalUrlStr) {
            frame.src = finalUrlStr;
          }
        }
      } catch (err) {
        console.warn('updateOrderingLinks error:', err);
      }
    }

    // オーダリングiframe再読込
    function reloadOrderingFrame() {
      const frame = document.getElementById('orderingSenderFrame');
      if (frame) {
        try {
          frame.contentWindow.location.reload();
        } catch (e) {
          const currentSrc = frame.src;
          frame.src = currentSrc;
        }
      }
    }

    // 📨 オーダリング送信完了イベントのリスナー (iframe連携)
    window.addEventListener('message', (event) => {
      if (event && event.data && event.data.type === 'ORDER_SUBMITTED') {
        const orderData = event.data;
        try {
          playCarteBellSound('normal');
        } catch (_) {}
        showToastNotification(`🚀 <strong>オーダー [${escapeHtml(orderData.orderId || '')}] 送信完了！</strong><br>カルテタイムラインに自動反映中...`);

        // 新着記事ポーリングを即座にキック
        setTimeout(() => {
          if (typeof checkNewArticles === 'function') {
            checkNewArticles();
          }
        }, 600);
      }
    });

    // 📡 オーダリング受信側 (Port 5000: 部門モニター) へ即座にオーダーを送信（飛ばす）
    async function sendOrderToOrderingReceiver(orderData, targetPersonId, authorName) {
      try {
        const cat = orderData.category || '';
        const title = orderData.title || '';
        let orderType = 'GENERAL';
        if (cat.includes('点滴') || title.includes('点滴')) orderType = 'IV';
        else if (cat.includes('処方') || title.includes('処方')) orderType = 'PRESCRIPTION';
        else if (cat.includes('放射線') || cat.includes('レントゲン') || cat.includes('CT') || title.includes('放射線')) orderType = 'RADIOLOGY';
        else if (cat.includes('検査') || title.includes('検査')) orderType = 'LAB_EXAM';
        else if (cat.includes('食事') || title.includes('食事')) orderType = 'MEAL';
        else if (cat.includes('リハビリ') || title.includes('リハビリ')) orderType = 'REHAB';

        const opt = document.querySelector(`#headerTargetFilter option[value="${targetPersonId}"]`) ||
                    document.querySelector(`#formTargetPersonSelect option[value="${targetPersonId}"]`);
        const pName = opt ? (opt.getAttribute('data-name') || opt.textContent.split('(')[0].replace(/^\[.*?\]\s*/, '').trim()) : '患者';
        const pCustomId = opt ? (opt.getAttribute('data-custom-id') || targetPersonId) : (targetPersonId || 'P000');
        const pDept = opt ? (opt.getAttribute('data-dept') || '一般病棟') : '一般病棟';

        const host = window.location.hostname || 'localhost';
        const receiverUrl = `http://${host}:5000/api/orders/receive`;

        const orderId = 'ORD-' + orderType.substring(0, 3) + '-' + Date.now().toString().slice(-6);

        const payload = {
          orderId: orderId,
          orderType: orderType,
          title: orderData.title || `${orderType}指示`,
          priority: 'ROUTINE',
          patient: {
            id: pCustomId,
            name: pName,
            department: pDept
          },
          doctor: {
            name: authorName || '<%= user %>',
            department: '<%= currentUserDept %>'
          },
          details: {
            medicine: orderData.medicine || orderData.title || '',
            dose: orderData.dose || '',
            rate: orderData.rate || '',
            route: orderData.route || '点滴静注',
            examType: orderData.examType || '',
            portable: orderData.portable || '放射線科撮影室',
            mealType: orderData.mealType || '',
            allergies: orderData.allergies || '',
            remarks: orderData.detail || orderData.remarks || '',
            content: orderData.content || ''
          },
          senderHost: window.location.origin,
          senderUser: authorName || '<%= user %>',
          orderDate: new Date().toISOString()
        };

        console.log(`🚀 [オーダリング送信] 部門モニター (Port 5000) へオーダー送信: [${orderId}]`);
        const res = await fetch(receiverUrl, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
          signal: AbortSignal.timeout(4000)
        });
        if (res.ok) {
          console.log(`✅ [オーダリング送信完了] 受信側 (Port 5000) で受付されました: ${orderId}`);
          return true;
        }
      } catch (e) {
        console.warn('⚠️ オーダリング受信側への直接送信通知 (バックエンド側で送信済み):', e.message);
      }
      return false;
    }

    // （後方互換用）
    function changeCurrentAuthor(authorId) {
      const selectEl = document.getElementById('headerAuthorSelect');
      if (selectEl) promptSwitchAuthor(selectEl);
    }

    // 🌟 カルテ診療記録と仮置きオーダーの一括確定・保存
    async function handleCarteAndStagedOrdersSubmit(event) {
      if (event) event.preventDefault();

      // 1. 対象者（患者）IDの取得
      const targetIdSelect = document.getElementById('formTargetPersonSelect');
      const headerFilter = document.getElementById('headerTargetFilter');
      let targetPersonId = (targetIdSelect && targetIdSelect.value) ? targetIdSelect.value : '';
      if (!targetPersonId && headerFilter && headerFilter.value !== 'ALL' && headerFilter.value !== 'NONE') {
        targetPersonId = headerFilter.value;
      }

      if (!targetPersonId) {
        alert('対象者（患者）が選択されていません。');
        return;
      }

      // 2. 診療記録 (SOAP) の本文取得
      const contentInput = document.getElementById('articleContentInput');
      let soapContent = contentInput ? contentInput.value.trim() : '';

      // もしSOAP本文が空の場合
      if (!soapContent) {
        if (stagedOrders.length > 0) {
          // 確認ポップアップなしで直接オーダー確定内容を自動セットして保存
          soapContent = `【診療記録】\n診察に基づき、以下のオーダー（${stagedOrders.length}件）を発行・確定しました。\n\n` +
            stagedOrders.map((o, idx) => `${idx + 1}. [${o.category}] ${o.title} ${o.detail || ''}`).join('\n');
          if (contentInput) contentInput.value = soapContent;
        } else {
          alert('診療記録(SOAP)を入力するか、右側メニューからオーダーを選択してください。');
          if (contentInput) contentInput.focus();
          return;
        }
      }

      // 3. 送信ボタンを送信中状態にする
      const submitBtn = document.getElementById('submitBtn');
      const submitBtnText = document.getElementById('submitBtnText');
      if (submitBtn) submitBtn.disabled = true;
      if (submitBtnText) submitBtnText.textContent = '⏳ カルテとオーダーを一括確定中...';

      showToastNotification('⏳ カルテ診療記録と仮置きオーダーを確定・オーダリング送信中...');

      try {
        // 4. まずメインの診療記録 (SOAP) を親記事として保存
        const parentArticleId = document.getElementById('formParentArticleId')?.value || '';
        const selectedAuthorId = document.getElementById('formAuthorId')?.value || document.getElementById('headerAuthorSelect')?.value || '';
        const authorOpt = document.querySelector(`#headerAuthorSelect option[value="${selectedAuthorId}"]`);
        const currentAuthorName = authorOpt ? authorOpt.getAttribute('data-name') : '<%= user %>';

        const mainPayload = {
          targetPersonId: targetPersonId,
          category: 'カルテ診療録',
          title: '電子カルテ診療記録',
          content: soapContent,
          parentArticleId: parentArticleId,
          authorId: selectedAuthorId
        };

        const mainRes = await fetch('/api/articles', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json'
          },
          body: JSON.stringify(mainPayload)
        });

        if (!mainRes.ok) {
          const errData = await mainRes.json().catch(() => ({}));
          throw new Error(errData.error || `カルテ診療記録の保存に失敗しました (HTTP ${mainRes.status})`);
        }

        const mainData = await mainRes.json();
        const createdParentId = mainData.article ? mainData.article._id : null;

        // 5. 仮置きされているオーダー群を、作成した診療記録を親として一括確定保存 ＆ オーダリング受信側へ飛ばす
        if (stagedOrders.length > 0 && createdParentId) {
          for (let i = 0; i < stagedOrders.length; i++) {
            const order = stagedOrders[i];
            const orderPayload = {
              targetPersonId: order.targetPersonId || targetPersonId,
              category: order.category,
              title: order.title,
              content: order.content,
              parentArticleId: createdParentId, // 🌟 今回保存したカルテにぶら下げる！
              authorId: selectedAuthorId,
              medicine: order.medicine || '',
              rate: order.rate || '',
              examType: order.examType || '',
              portable: order.portable || '放射線科撮影室',
              mealType: order.mealType || '常食 (一般食)',
              allergies: order.allergies || ''
            };

            // カルテ記事として保存 (バックエンド側でも Port 5000 オーダリングへ自動転送されます)
            const orderRes = await fetch('/api/articles', {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
                'Accept': 'application/json'
              },
              body: JSON.stringify(orderPayload)
            });

            if (!orderRes.ok) {
              console.error(`オーダー #${i + 1} (${order.title}) の保存エラー`);
            } else {
              // フロントエンドからも念のためオーダリング受信側 (Port 5000) へダイレクト通知
              sendOrderToOrderingReceiver(orderPayload, targetPersonId, currentAuthorName);
            }
          }
        }

        // 6. 仮置きと下書きのクリアと後始末
        const savedOrderCount = stagedOrders.length;
        stagedOrders = [];
        try {
          const tId = targetPersonId || 'common';
          localStorage.removeItem(`staged_orders_${tId}`);
          localStorage.removeItem(`carte_draft_${tId}`);
          localStorage.removeItem('carte_draft_content');
          const banner = document.getElementById('draftNoticeBanner');
          if (banner) banner.style.display = 'none';
          const indicator = document.getElementById('draftSaveTimeIndicator');
          if (indicator) indicator.textContent = '';
        } catch (e) {}

        renderStagedOrders();

        showToastNotification(`✅ カルテ診療記録およびオーダー (${savedOrderCount}件) を確定保存し、オーダリング受信側 (Port 5000) へ送信しました！`);

        // 7. 画面を更新して最新タイムラインを表示
        setTimeout(() => {
          window.location.href = `/articles?targetId=${targetPersonId}`;
        }, 500);

      } catch (err) {
        alert('保存エラー: ' + err.message);
        if (submitBtn) submitBtn.disabled = false;
        renderStagedOrders();
      }
    }

    // 🌟 タイムラインのオーダー記事から直接「対になる実施確認記事」を作成開始
    function startOrderExecution(orderArticleId, orderType, orderTitle) {
      const orderEl = document.querySelector(`.article-item[data-article-id="${orderArticleId}"]`);
      const targetPersonId = orderEl ? orderEl.getAttribute('data-target-id') : '';

      let category = '';
      let title = '';
      let content = '';

      const nowTime = new Date().toLocaleTimeString('ja-JP', { hour: '2-digit', minute: '2-digit' });
      const nowDate = new Date().toLocaleDateString('ja-JP');

      if (orderType === 'pharmacy') {
        category = '処方鑑査・調剤';
        title = `【処方鑑査・調剤確認】${orderTitle ? orderTitle.replace(/^【[^】]+】/, '') : '処方オーダー'}`;
        content = `【薬剤師 処方鑑査・調剤実施記録】\n対象オーダー: ${orderTitle || '処方オーダー'}\n確認時刻: ${nowDate} ${nowTime}\n担当薬剤師: <%= user || "薬剤師" %> (薬剤部)\n\n■ 処方鑑査結果:\n・用法・用量: 適正確認\n・相互作用・重複投薬: 重複・禁忌なし確認\n・アレルギー歴・禁忌情報: 確認済み (異常なし)\n\n■ 調剤・交付状況:\n・調剤完了・鑑査終了。病棟への配薬準備完了。`;
      } else if (orderType === 'radiology') {
        category = '放射線検査実施';
        title = `【放射線検査実施記録】${orderTitle ? orderTitle.replace(/^【[^】]+】/, '') : '放射線検査'}`;
        content = `【放射線技師 撮影実施・照射記録】\n対象オーダー: ${orderTitle || '放射線検査指示'}\n撮影時刻: ${nowDate} ${nowTime}\n担当技師: <%= user || "放射線技師" %> (放射線科)\n撮影場所: 放射線科撮影室\n\n■ 実施確認事項:\n・本人確認・部位確認: 照合完了 (左右・照射部位合致)\n・体位保持・撮影条件: 良好 (体動アーチファクトなし)\n・PACS送信: 画像サーバー送信完了・技師検像終了。`;
      }

      openQuickArticleModal({
        targetPersonId: targetPersonId,
        category: category,
        title: title,
        content: content,
        parentArticleId: orderArticleId,
        autoAttach: true,
        orderNotice: (orderType === 'pharmacy')
          ? '💊 医師の処方オーダーに対する薬剤師の鑑査・調剤確認（対になる子記事）を作成します。'
          : '🩻 医師の放射線オーダーに対する技師の撮影実施確認（対になる子記事）を作成します。',
        mode: 'directPost'
      });
    }

    // 独自記事・オーダー作成の共通ハンドラ (ワンクリック時は中央ペインに仮置き、通常時はクイックモーダルを開く)
    function createUniqueArticleFromPalette(dept, category, title, detail, defaultContent, extraData = {}) {
      // 1. 対象者IDの取得
      const targetIdSelect = document.getElementById('formTargetPersonSelect');
      const headerFilter = document.getElementById('headerTargetFilter');
      const quickSelect = document.getElementById('quickModalTargetPerson');

      let currentTargetId = (targetIdSelect && targetIdSelect.value) ? targetIdSelect.value : '';
      if (!currentTargetId && headerFilter && headerFilter.value !== 'ALL' && headerFilter.value !== 'NONE') {
        currentTargetId = headerFilter.value;
      }
      if (!currentTargetId && quickSelect && quickSelect.value) {
        currentTargetId = quickSelect.value;
      }

      if (!currentTargetId) {
        alert('対象者（患者）を選択してください。画面上部の対象者フィルタまたは選択欄で対象者を指定してください。');
        return;
      }

      const catName = category || dept || '診療記録';
      const articleTitle = `【${catName}】${title}`;
      let articleContent = defaultContent;
      if (!articleContent) {
        articleContent = `【${dept ? dept + ' - ' : ''}${catName}】\n${title}\n`;
        if (detail) {
          articleContent += `内容・規格: ${detail}\n`;
        }
        articleContent += `指示・記録日時: ${new Date().toLocaleString('ja-JP')}\n指示内容を確認。`;
      }

      // 🌟 薬剤部・放射線科の事後実施確認（既存オーダーが存在する場合）の判定
      let finalParentArticleId = document.getElementById('formParentArticleId')?.value || '';
      let isAutoAttach = false;
      let orderNotice = '';

      if (!finalParentArticleId) {
        if (dept === '薬剤部' || catName.includes('鑑査') || catName.includes('服薬指導') || catName.includes('調剤') || catName.includes('疑義照会') || catName.includes('TDM')) {
          const latestPrescription = findLatestOrderArticle(currentTargetId, 'prescription');
          if (latestPrescription) {
            finalParentArticleId = latestPrescription.id;
            isAutoAttach = true;
            orderNotice = `💊 医師の処方オーダー（${latestPrescription.title}）に対する薬剤師の実施確認として自動紐づけされます。`;
          }
        } else if (dept === '放射線科' || catName.includes('放射線検査') || catName.includes('ポータブル') || catName.includes('撮影') || catName.includes('造影剤')) {
          const latestRad = findLatestOrderArticle(currentTargetId, 'radiology');
          if (latestRad) {
            finalParentArticleId = latestRad.id;
            isAutoAttach = true;
            orderNotice = `🩻 医師の放射線オーダー（${latestRad.title}）に対する技師の撮影実施確認として自動紐づけされます。`;
          }
        }
      }

      const isDirectPost = document.getElementById('directPostToggle')?.checked;

      // 既存オーダーへの実施確認（対になる記事）の場合は直接投稿/確認モーダル
      if (isAutoAttach) {
        if (isDirectPost) {
          postUniqueArticleApi({
            targetPersonId: currentTargetId,
            category: catName,
            title: articleTitle,
            content: articleContent,
            parentArticleId: finalParentArticleId
          });
        } else {
          openQuickArticleModal({
            targetPersonId: currentTargetId,
            category: catName,
            title: articleTitle,
            content: articleContent,
            parentArticleId: finalParentArticleId,
            autoAttach: true,
            orderNotice: orderNotice,
            mode: 'directPost'
          });
        }
        return;
      }

      // 🌟 通常のオーダー（処方・放射線指示・点滴・処置・バイタル等）: 中央ペインの診療記録の下に仮置き！
      const orderData = {
        dept: dept || '医師',
        category: catName,
        title: articleTitle,
        detail: detail || '',
        content: articleContent,
        targetPersonId: currentTargetId,
        ...extraData
      };

      if (isDirectPost) {
        // ⚡ ワンクリック仮置きモード: 中央ペインの診療記録の下に仮置き！
        addOrderToStaged(orderData);
      } else {
        // 📝 クイックモーダルで確認してから仮置きに追加
        openQuickArticleModal({
          targetPersonId: currentTargetId,
          category: catName,
          title: articleTitle,
          content: articleContent,
          detail: detail,
          dept: dept,
          mode: 'stage'
        });
      }
    }

    // 🌟 タイムライン内のカルテ記事から、指定患者の親カルテ候補を動的収集
    function getAvailableParentArticles(targetPersonId) {
      const items = document.querySelectorAll('.article-item');
      const results = [];

      items.forEach(item => {
        const itemTargetId = item.getAttribute('data-target-id');
        if (targetPersonId && itemTargetId && itemTargetId !== targetPersonId && itemTargetId !== 'ALL' && itemTargetId !== 'NONE') {
          return;
        }

        const artId = item.getAttribute('data-article-id');
        if (!artId) return;

        const cat = item.getAttribute('data-category') || 'カルテ';
        const depth = parseInt(item.getAttribute('data-depth') || '0', 10);

        // 日時取得
        const strongEl = item.querySelector('strong');
        const dateStr = strongEl ? strongEl.textContent.trim() : '';

        // タイトル取得
        let title = '';
        const titleDiv = item.querySelector('div[style*="font-weight:bold; color:#0f172a"]');
        if (titleDiv) {
          title = titleDiv.textContent.trim();
        }

        // 著者取得
        let authorText = '';
        item.querySelectorAll('span').forEach(sp => {
          const txt = sp.textContent.trim();
          if (txt.startsWith('記載:')) {
            authorText = txt.replace('記載:', '').trim();
          }
        });

        const indent = depth > 0 ? '　'.repeat(Math.min(depth, 3)) + '↳ ' : '';
        const displayLabel = `${indent}[${dateStr}] ${title ? title + ' ' : ''}(${cat}${authorText ? ' / ' + authorText : ''})`;

        results.push({
          id: artId,
          label: displayLabel,
          depth: depth
        });
      });

      return results;
    }

    // 🌟 親カルテ選択肢（セレクトボックス）の動的更新
    function updateQuickModalParentOptions(targetPersonId, preferredParentId) {
      const select = document.getElementById('quickModalParentArticleSelect');
      const notice = document.getElementById('quickModalParentNotice');
      if (!select) return;

      select.innerHTML = '';
      const list = getAvailableParentArticles(targetPersonId);

      if (list.length === 0) {
        const opt = document.createElement('option');
        opt.value = '';
        opt.textContent = '（※選択中の患者に過去カルテ記事がありません）';
        opt.disabled = true;
        opt.selected = true;
        select.appendChild(opt);
        if (notice) {
          notice.textContent = '※選択中の患者にカルテ記事がないため、親カルテにはぶら下げられません。';
          notice.style.color = '#dc2626';
        }
        return;
      }

      if (notice) {
        notice.textContent = '※選択した親カルテの下にツリー形式（↳ 追記）でぶら下げて作成されます。';
        notice.style.color = '#64748b';
      }

      // 最新の記事が上（先頭）に並ぶように逆順表示
      const reversedList = [...list].reverse();
      let hasSelected = false;

      reversedList.forEach((art, idx) => {
        const opt = document.createElement('option');
        opt.value = art.id;
        opt.textContent = art.label;

        // 指定の優先親IDがある場合はそれを選択、なければ先頭（最新記事）を選択
        if (preferredParentId && art.id === preferredParentId) {
          opt.selected = true;
          hasSelected = true;
        } else if (!preferredParentId && !hasSelected && idx === 0) {
          opt.selected = true;
          hasSelected = true;
        }

        select.appendChild(opt);
      });

      if (!hasSelected && select.options.length > 0) {
        select.options[0].selected = true;
      }
    }

    // 🌟 「親カルテにぶら下げる」チェックボックス切り替えハンドラ
    function handleParentCheckboxChange(isChecked) {
      const container = document.getElementById('quickModalParentSelectContainer');
      const wrap = document.getElementById('quickModalParentWrap');
      const submitBtn = document.getElementById('quickModalSubmitBtn');

      if (isChecked) {
        if (container) container.style.display = 'block';
        if (wrap) {
          wrap.style.background = '#fffbeb';
          wrap.style.borderColor = '#f59e0b';
        }
        if (submitBtn) {
          submitBtn.innerHTML = '🔗 親カルテにぶら下げて保存';
          submitBtn.style.background = '#d97706';
        }
      } else {
        if (container) container.style.display = 'none';
        if (wrap) {
          wrap.style.background = '#f8fafc';
          wrap.style.borderColor = '#cbd5e1';
        }
        if (submitBtn) {
          submitBtn.innerHTML = '💾 独自記事として保存・投稿';
          submitBtn.style.background = '#0284c7';
        }
      }
    }

    let currentQuickModalData = null;

    // モーダルを開く
    function openQuickArticleModal(data) {
      currentQuickModalData = data;
      const modal = document.getElementById('quickArticleModal');
      if (!modal) return;

      const isDirectPostMode = (data.mode === 'directPost');

      const headerTitle = document.getElementById('quickModalHeaderTitle');
      if (headerTitle) {
        headerTitle.innerHTML = isDirectPostMode
          ? '<span>📝</span> 独自記事・実施確認として保存'
          : '<span>📝</span> オーダー内容の確認・仮置き追加';
      }

      const targetSelect = document.getElementById('quickModalTargetPerson');
      if (targetSelect && data.targetPersonId) {
        targetSelect.value = data.targetPersonId;
      }

      const catInput = document.getElementById('quickModalCategory');
      if (catInput) catInput.value = data.category || '';

      const titleInput = document.getElementById('quickModalTitle');
      if (titleInput) titleInput.value = data.title || '';

      const contentInput = document.getElementById('quickModalContent');
      if (contentInput) contentInput.value = data.content || '';

      const parentWrap = document.getElementById('quickModalParentWrap');
      const submitBtn = document.getElementById('quickModalSubmitBtn');

      if (!isDirectPostMode) {
        // 仮置きモード: 親カルテぶら下げ選択は不要（カルテ保存時に自動で親カルテに紐づく）
        if (parentWrap) parentWrap.style.display = 'none';
        if (submitBtn) {
          submitBtn.innerHTML = '📦 仮置きオーダーに追加';
          submitBtn.style.background = '#0284c7';
        }
      } else {
        // 直接投稿モード（既存オーダーへの実施確認等）
        if (parentWrap) parentWrap.style.display = 'block';
        const parentCheckbox = document.getElementById('quickModalAttachToParent');
        const shouldAttach = Boolean(data.autoAttach && data.parentArticleId);
        if (parentCheckbox) {
          parentCheckbox.checked = shouldAttach;
          parentCheckbox.disabled = false;
        }
        const currentTargetPersonId = (targetSelect && targetSelect.value) ? targetSelect.value : (data.targetPersonId || '');
        updateQuickModalParentOptions(currentTargetPersonId, data.parentArticleId || null);
        handleParentCheckboxChange(shouldAttach);

        const noticeEl = document.getElementById('quickModalParentNotice');
        if (noticeEl && data.orderNotice) {
          noticeEl.innerHTML = `<strong>✨ オーダー対連携:</strong> ${data.orderNotice}`;
          noticeEl.style.color = '#0284c7';
        }
      }

      modal.style.display = 'flex';
      setTimeout(() => {
        if (contentInput) contentInput.focus();
      }, 100);
    }

    // モーダルを閉じる
    function closeQuickArticleModal(event) {
      if (event && event.target !== event.currentTarget && event.type === 'click') {
        return; // 背景クリック以外は無視
      }
      const modal = document.getElementById('quickArticleModal');
      if (modal) modal.style.display = 'none';
      currentQuickModalData = null;
    }

    // モーダルフォーム送信
    function submitQuickArticle(e) {
      if (e) e.preventDefault();

      const targetId = document.getElementById('quickModalTargetPerson')?.value;
      const category = document.getElementById('quickModalCategory')?.value?.trim();
      const title = document.getElementById('quickModalTitle')?.value?.trim();
      const content = document.getElementById('quickModalContent')?.value?.trim();

      if (!targetId) {
        alert('対象者（患者）を選択してください。');
        return;
      }
      if (!category || !title || !content) {
        alert('カテゴリ、タイトル、内容は必須です。');
        return;
      }

      const isDirectPostMode = currentQuickModalData && currentQuickModalData.mode === 'directPost';

      if (!isDirectPostMode) {
        // 🌟 中央ペインの仮置きオーダー一覧に追加！
        addOrderToStaged({
          dept: (currentQuickModalData && currentQuickModalData.dept) || 'オーダー',
          category: category,
          title: title,
          detail: (currentQuickModalData && currentQuickModalData.detail) || '',
          content: content,
          targetPersonId: targetId
        });
      } else {
        // 直接投稿モード（既存オーダーに対する事後確認）
        const parentCheckbox = document.getElementById('quickModalAttachToParent');
        const parentSelect = document.getElementById('quickModalParentArticleSelect');
        let parentId = '';

        if (parentCheckbox && parentCheckbox.checked) {
          parentId = (parentSelect?.value || '').trim();
        }

        postUniqueArticleApi({
          targetPersonId: targetId,
          category,
          title,
          content,
          parentArticleId: parentId
        });
      }

      closeQuickArticleModal();
    }

    // 独自記事をバックエンドへ非同期POST送信
    async function postUniqueArticleApi(payload) {
      try {
        const selectedAuthorId = document.getElementById('formAuthorId')?.value || document.getElementById('headerAuthorSelect')?.value || '';
        if (!payload.authorId && selectedAuthorId) {
          payload.authorId = selectedAuthorId;
        }

        showToastNotification(`⏳ 独自記事を作成・署名中: ${payload.title}...`);

        const res = await fetch('/api/articles', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json'
          },
          body: JSON.stringify(payload)
        });

        if (!res.ok) {
          const errData = await res.json().catch(() => ({}));
          throw new Error(errData.error || `HTTP ${res.status}`);
        }

        const data = await res.json();
        if (data.success && data.article) {
          const cat = payload.category || '';
          const title = payload.title || '';
          const isOrder = cat.includes('オーダー') || cat.includes('指示') || cat.includes('処方') || title.includes('オーダー') || title.includes('指示');
          if (isOrder) {
            const authorOpt = document.querySelector(`#headerAuthorSelect option[value="${selectedAuthorId}"]`);
            const authorName = authorOpt ? authorOpt.getAttribute('data-name') : '<%= user %>';
            sendOrderToOrderingReceiver(payload, payload.targetPersonId, authorName);
            showToastNotification(`✅ カルテ記事保存 ＆ オーダリング送信完了: <strong>${data.article.title || payload.title}</strong>`);
          } else {
            showToastNotification(`✅ 独自記事を作成しました: <strong>${data.article.title || payload.title}</strong>`);
          }
          appendArticleToTimeline(data.article);
        } else {
          showToastNotification(`✅ 独自記事を作成しました`);
          setTimeout(() => location.reload(), 1000);
        }
      } catch (err) {
        console.error('Failed to post unique article:', err);
        alert(`独自記事の作成に失敗しました: ${err.message}`);
      }
    }

    // 作成された独自記事カードを左ペインのタイムラインへ即時動的追加 (時系列末尾・最新位置へ配置)
    function appendArticleToTimeline(art) {
      const container = document.getElementById('timelineContainer');
      if (!container) return;

      const noNotice = document.getElementById('noArticlesNotice');
      if (noNotice) noNotice.style.display = 'none';

      const authorDept = (art.author && art.author.department) ? art.author.department : '<%= currentUserDept || "一般" %>';
      const authorName = art.author ? (art.author.userName || art.author.loginId) : '<%= user || "担当者" %>';
      const createdDate = art.createdAt ? new Date(art.createdAt) : new Date();
      const createdDateStr = createdDate.toLocaleDateString('ja-JP', { year: 'numeric', month: '2-digit', day: '2-digit', weekday: 'short' });
      const createdTimeStr = createdDate.toLocaleTimeString('ja-JP', { hour: '2-digit', minute: '2-digit' });
      const isPgpValid = Boolean(art.pgpSignature || (art.pgpVerification && art.pgpVerification.isValid));
      // 🌟 親記事がある場合のみ isQuoted = true (ツリー追記)
      const parentId = art.parentArticle ? (art.parentArticle._id || art.parentArticle) : '';
      const isQuoted = Boolean(parentId && typeof parentId === 'string' && parentId.trim() !== '');
      const safeContent = (art.content || '').replace(/\\/g, '\\\\').replace(/`/g, '\\`').replace(/\$/g, '\\$').replace(/\r?\n/g, '\\n');
      const safeTitle = (art.title || '').replace(/'/g, "\\'");

      // オーダー・実施確認の判定
      const cat = art.category || '';
      const title = art.title || '';
      const isPrescriptionOrder = (cat === '処方' || cat === '処方オーダー' || cat === '点滴指示' || cat === '点滴オーダー') || title.includes('【処方】') || title.includes('【点滴オーダー】') || title.includes('処方オーダー');
      const isRadiologyOrder = cat.includes('放射線') || cat.includes('レントゲン') || cat.includes('CT') || cat.includes('MRI') || title.includes('【放射線オーダー】') || title.includes('放射線指示');
      const isMealOrder = cat.includes('食事') || title.includes('【食事選択オーダー】');
      const isDirectOrder = Boolean(art.ivOrderDetails || art.radiologyOrderDetails || art.mealOrderDetails || isPrescriptionOrder || isRadiologyOrder || isMealOrder);

      const isPharmacyExecution = isQuoted && (
        authorDept === '薬剤師' ||
        cat.includes('処方鑑査') || cat.includes('調剤') || cat.includes('服薬指導') || cat.includes('疑義照会') || cat.includes('TDM') ||
        title.includes('薬剤師') || title.includes('処方鑑査') || title.includes('調剤')
      );
      const isRadiologyExecution = isQuoted && (
        authorDept === '放射線技師' ||
        cat.includes('放射線検査') || cat.includes('ポータブル撮影') || cat.includes('撮影実施') || cat.includes('造影剤') ||
        title.includes('放射線技師') || title.includes('撮影実施')
      );
      const isExecutionCheck = isPharmacyExecution || isRadiologyExecution;

      // 親カードの要素を取得して親がオーダーかどうか判定
      const parentCard = parentId ? document.querySelector(`.article-item[data-article-id="${parentId}"]`) : null;
      const isParentOrder = Boolean(
        parentCard && (
          parentCard.getAttribute('data-is-prescription') === 'true' ||
          parentCard.getAttribute('data-is-radiology') === 'true' ||
          (parentCard.getAttribute('data-category') && parentCard.getAttribute('data-category').includes('オーダー'))
        )
      ) || Boolean(art.parentArticleData && art.parentArticleData.isOrder);

      const isExplicitCorrection = Boolean(
        art.isCorrection ||
        title.includes('【修正】') ||
        title.includes('【追記】') ||
        (art.content && (art.content.includes('【引用元:') || art.content.includes('【修正・追記内容】')))
      );

      // 🌟 親記事を隠すかどうかの判定（カルテ修正、またはオーダー修正、またはオーダー実施確認）
      let isQuotedCorrection = false;
      if (isQuoted) {
        if (isParentOrder) {
          // 親がオーダーの場合: 実施確認（調剤・撮影等）またはオーダー修正なら親オーダーを隠す
          if (isExecutionCheck || isExplicitCorrection || isDirectOrder) {
            isQuotedCorrection = true;
          }
        } else {
          // 親がカルテ記事の場合: カルテ修正なら親カルテを隠す（新規オーダーは親カルテを隠さない）
          if (isExplicitCorrection && !isDirectOrder && !isExecutionCheck) {
            isQuotedCorrection = true;
          }
        }
      }

      // 🔒 元記事を表示しない：もし引用修正・更新記事の場合、元記事のDOMカードを即時非表示にする
      let pDateStr = '';
      let pAuthorStr = '';
      let pContentSafe = '';

      if (isQuotedCorrection && parentId) {
        if (parentCard) {
          parentCard.style.display = 'none';
          parentCard.classList.add('hidden-original-article');
          parentCard.setAttribute('data-is-original-hidden', 'true');

          const pDateEl = parentCard.querySelector('strong');
          pDateStr = pDateEl ? pDateEl.textContent.trim() : '';
          const pAuthEl = parentCard.querySelector('span[style*="#64748b"]');
          pAuthorStr = pAuthEl ? pAuthEl.textContent.replace('記載:', '').trim() : '';
          const pContEl = parentCard.querySelector('.article-content');
          pContentSafe = pContEl ? pContEl.textContent.trim() : '';
        } else if (art.parentArticleData || (art.parentArticle && typeof art.parentArticle === 'object')) {
          const pObj = art.parentArticleData || art.parentArticle;
          if (pObj.createdAt) {
            pDateStr = new Date(pObj.createdAt).toLocaleString('ja-JP', { year:'numeric', month:'2-digit', day:'2-digit', hour:'2-digit', minute:'2-digit' });
          }
          if (pObj.author) {
            pAuthorStr = `${pObj.author.userName || pObj.author.loginId || '担当者'}${pObj.author.department ? ` (${pObj.author.department})` : ''}`;
          } else if (pObj.authorName) {
            pAuthorStr = `${pObj.authorName}${pObj.authorDept ? ` (${pObj.authorDept})` : ''}`;
          }
          pContentSafe = pObj.content || '';
        }
      }

      let cardBorderLeft = isQuotedCorrection ? '#f59e0b' : (isQuoted ? '#f59e0b' : '#0284c7');
      let cardBg = isQuotedCorrection ? '#fffdf7' : (isQuoted ? '#fffdf5' : '#ffffff');
      if (isPharmacyExecution) {
        cardBorderLeft = '#059669';
        cardBg = '#f0fdf4';
      } else if (isRadiologyExecution) {
        cardBorderLeft = '#7c3aed';
        cardBg = '#faf5ff';
      } else if (isPrescriptionOrder) {
        cardBorderLeft = '#0284c7';
        cardBg = '#f8fafc';
      } else if (isRadiologyOrder) {
        cardBorderLeft = '#6d28d9';
        cardBg = '#fbfbfe';
      }

      const card = document.createElement('div');
      card.className = `article-item latest-article ${isQuoted ? 'tree-quoted-item' : ''} ${isQuotedCorrection ? 'quoted-correction-item' : ''} ${isPrescriptionOrder ? 'order-prescription-item' : ''} ${isRadiologyOrder ? 'order-radiology-item' : ''}`;
      card.id = `latestArticleItem`;
      card.dataset.targetId = art.targetPerson ? (art.targetPerson._id || art.targetPerson) : 'NONE';
      card.dataset.targetName = art.targetPerson ? (art.targetPerson.name || '') : '';
      card.dataset.category = cat || '独自記事';
      card.dataset.authorDept = authorDept;
      card.dataset.articleId = art._id;
      card.dataset.parentId = parentId;
      // 深さの計算: 親カードがある場合はその深さを適切に引き継ぐ
      let computedDepth = 0;
      if (isQuotedCorrection) {
        computedDepth = parentCard ? parseInt(parentCard.dataset.depth || '0', 10) : 0;
      } else if (isQuoted) {
        const pDepth = parentCard ? parseInt(parentCard.dataset.depth || '0', 10) : 0;
        computedDepth = pDepth + 1;
      }
      card.dataset.depth = computedDepth;
      card.dataset.isCorrection = isQuotedCorrection ? 'true' : 'false';
      card.dataset.isPrescription = isPrescriptionOrder ? 'true' : 'false';
      card.dataset.isRadiology = isRadiologyOrder ? 'true' : 'false';
      card.style.background = cardBg;
      card.style.border = '1px solid #e2e8f0';
      card.style.borderLeft = `3px solid ${cardBorderLeft}`;
      card.style.borderRadius = '4px';
      card.style.padding = '0.5rem 0.65rem';
      card.style.marginBottom = '0.5rem';
      card.style.boxShadow = '0 2px 8px rgba(2,132,199,0.15)';
      if (computedDepth > 0) {
        card.style.marginLeft = `${Math.min(computedDepth, 4) * 1.5}rem`;
      }

      // 既存カードの「最新」状態とIDを解除
      document.querySelectorAll('.article-item.latest-article, #latestArticleItem').forEach(el => {
        if (el !== card) {
          el.classList.remove('latest-article');
          if (el.id === 'latestArticleItem') el.id = `article-${el.dataset.articleId || 'prev'}`;
          const b = el.querySelector('.badge-latest-tag');
          if (b) b.remove();
        }
      });

      const pgpBadge = isPgpValid ? `<span style="font-size:0.68rem; color:#047857; cursor:pointer;" onclick="openPgpModal('${art._id}')" title="PGP真正保証（改ざんなし）">🔏</span>` : '';
      
      let badgeType = '';
      if (isPharmacyExecution) {
        badgeType = '<span style="background:#d1fae5; color:#065f46; border:1px solid #6ee7b7; font-size:0.68rem; padding:0.05rem 0.4rem; border-radius:3px; font-weight:bold;">💊 薬剤師 鑑査調剤済</span>';
      } else if (isRadiologyExecution) {
        badgeType = '<span style="background:#ede9fe; color:#5b21b6; border:1px solid #c4b5fd; font-size:0.68rem; padding:0.05rem 0.4rem; border-radius:3px; font-weight:bold;">🩻 技師 撮影実施済</span>';
      } else if (isQuotedCorrection) {
        badgeType = '<span style="background:#fef3c7; color:#92400e; border:1px solid #f59e0b; font-size:0.68rem; padding:0.05rem 0.4rem; border-radius:3px; font-weight:bold;">📝 引用記事 (最新)</span>';
      } else if (isPrescriptionOrder) {
        badgeType = '<span style="background:#e0f2fe; color:#0369a1; border:1px solid #bae6fd; font-size:0.68rem; padding:0.05rem 0.4rem; border-radius:3px; font-weight:bold;">💊 処方オーダー</span><span style="background:#fff7ed; color:#c2410c; border:1px solid #fed7aa; font-size:0.65rem; font-weight:bold; padding:0.05rem 0.35rem; border-radius:3px;">⏳ 未鑑査・未調剤</span>';
      } else if (isRadiologyOrder) {
        badgeType = '<span style="background:#f3e8ff; color:#6b21a8; border:1px solid #e9d5ff; font-size:0.68rem; padding:0.05rem 0.4rem; border-radius:3px; font-weight:bold;">🩻 放射線オーダー</span><span style="background:#fef2f2; color:#b91c1c; border:1px solid #fecaca; font-size:0.65rem; font-weight:bold; padding:0.05rem 0.35rem; border-radius:3px;">⏳ 未撮影</span>';
      } else if (isQuoted) {
        badgeType = '<span style="background:#fef3c7; color:#b45309; border:1px solid #fde68a; font-size:0.65rem; padding:0.05rem 0.35rem; border-radius:3px; font-weight:bold;">↳ 追記</span>';
      } else {
        badgeType = `<span style="background:#e0f2fe; color:#0369a1; font-size:0.68rem; padding:0.05rem 0.35rem; border-radius:3px; font-weight:bold;">📄 独自記事 [${cat || '一般'}]</span>`;
      }

      let directOrderBtn = '';
      if (isPrescriptionOrder && !isPharmacyExecution) {
        directOrderBtn = `<button type="button" onclick="startOrderExecution('${art._id}', 'pharmacy', '${safeTitle}')" style="background:#0284c7; border:none; color:white; padding:0.12rem 0.45rem; border-radius:3px; font-size:0.7rem; font-weight:bold; cursor:pointer;" title="この処方オーダーに対して薬剤師の鑑査・調剤確認（対になる子記事）を作成">💊 鑑査・実施確認</button>`;
      } else if (isRadiologyOrder && !isRadiologyExecution) {
        directOrderBtn = `<button type="button" onclick="startOrderExecution('${art._id}', 'radiology', '${safeTitle}')" style="background:#7c3aed; border:none; color:white; padding:0.12rem 0.45rem; border-radius:3px; font-size:0.7rem; font-weight:bold; cursor:pointer;" title="この放射線オーダーに対して放射線技師の撮影実施確認（対になる子記事）を作成">🩻 撮影実施確認</button>`;
      }

      let quoteHeader = '';
      if (isQuotedCorrection) {
        let hBadgeText = '📝 引用記事（修正記事）';
        let hBadgeBg = '#fef3c7';
        let hBadgeColor = '#92400e';
        let hBadgeBorder = '#f59e0b';
        let toggleText = '👁️ 修正前の元記事を表示';

        if (isPharmacyExecution) {
          hBadgeText = '✅ 処方オーダー (鑑査・調剤済)';
          hBadgeBg = '#d1fae5';
          hBadgeColor = '#065f46';
          hBadgeBorder = '#10b981';
          toggleText = '👁️ 医師の元処方オーダーを表示';
        } else if (isRadiologyExecution) {
          hBadgeText = '✅ 放射線オーダー (撮影実施済)';
          hBadgeBg = '#ede9fe';
          hBadgeColor = '#5b21b6';
          hBadgeBorder = '#8b5cf6';
          toggleText = '👁️ 医師の元撮影指示を表示';
        } else if (isParentOrder) {
          hBadgeText = '📝 オーダー変更・修正 (最新指示)';
          hBadgeBg = '#fef3c7';
          hBadgeColor = '#92400e';
          hBadgeBorder = '#f59e0b';
          toggleText = '👁️ 変更前の元オーダーを表示';
        }

        quoteHeader = `
          <div style="background:${isPharmacyExecution ? '#f0fdf4' : (isRadiologyExecution ? '#faf5ff' : '#fffbeb')}; border:1px solid ${isPharmacyExecution ? '#a7f3d0' : (isRadiologyExecution ? '#ddd6fe' : '#fde68a')}; border-left:3px solid ${hBadgeBorder}; padding:0.35rem 0.55rem; border-radius:4px; margin-bottom:0.4rem; font-size:0.75rem; color:${hBadgeColor}; display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:0.3rem;">
            <div style="display:flex; align-items:center; gap:0.4rem; flex-wrap:wrap;">
              <span style="background:${hBadgeBg}; color:${hBadgeColor}; border:1px solid ${hBadgeBorder}; font-weight:bold; font-size:0.7rem; padding:0.1rem 0.4rem; border-radius:3px;">
                ${hBadgeText}
              </span>
              ${pDateStr ? `<span style="color:${hBadgeColor}; font-weight:600; font-size:0.72rem;">元指示: [${escapeHtml(pDateStr)}] ${escapeHtml(pAuthorStr)}</span>` : ''}
            </div>
            ${pContentSafe ? `
              <button type="button" onclick="toggleOriginalArticleContent('${art._id}')" style="background:#ffffff; border:1px solid ${hBadgeBorder}; color:${hBadgeColor}; font-size:0.68rem; font-weight:bold; padding:0.1rem 0.4rem; border-radius:3px; cursor:pointer;" id="toggleOriginalBtn-${art._id}" title="元の指示内容を確認">
                ${toggleText}
              </button>
            ` : ''}
          </div>
          ${pContentSafe ? `
            <div id="originalArticleBox-${art._id}" style="display:none; margin-bottom:0.5rem; background:#f8fafc; border:1px dashed #cbd5e1; border-radius:4px; padding:0.45rem; font-size:0.75rem; color:#475569;">
              <div style="font-size:0.7rem; font-weight:bold; color:#64748b; margin-bottom:0.25rem;">
                【元オーダー・指示内容】 (${escapeHtml(pDateStr)} ${escapeHtml(pAuthorStr)} 発行)
              </div>
              <div style="white-space:pre-wrap; word-break:break-word; max-height:160px; overflow-y:auto; background:#ffffff; padding:0.4rem; border:1px solid #e2e8f0; border-radius:3px; font-size:0.75rem; line-height:1.45;">${escapeHtml(pContentSafe)}</div>
            </div>
          ` : ''}
        `;
      } else if (isQuoted) {
        if (isPharmacyExecution) {
          quoteHeader = `<div style="font-size:0.68rem; margin-bottom:0.25rem; font-weight:600; color:#047857;">↳ 処方オーダーに対する薬剤師 実施確認 (鑑査・調剤)</div>`;
        } else if (isRadiologyExecution) {
          quoteHeader = `<div style="font-size:0.68rem; margin-bottom:0.25rem; font-weight:600; color:#6b21a8;">↳ 放射線オーダーに対する技師 撮影実施確認</div>`;
        } else {
          quoteHeader = `<div style="font-size:0.68rem; margin-bottom:0.25rem; font-weight:600; color:#b45309;">↳ 親カルテへの追記・修正</div>`;
        }
      }

      let proxyAuthorHtml = '';
      if (art.isOverride && art.originalAuthor) {
        const origName = art.originalAuthor.userName || art.originalAuthor.name || art.originalAuthor.loginId || '';
        const origDept = art.originalAuthor.department || '';
        proxyAuthorHtml = `<span class="badge-proxy-author" style="background:#eff6ff; color:#1d4ed8; border:1px solid #bfdbfe; font-size:0.65rem; font-weight:bold; padding:0.05rem 0.35rem; border-radius:3px;" title="代行入力（端末操作者）: ${escapeHtml(origName)}${origDept ? ` (${escapeHtml(origDept)})` : ''}">代行入力: ${escapeHtml(origName)}${origDept ? ` (${escapeHtml(origDept)})` : ''}</span>`;
      }

      card.innerHTML = `
        ${quoteHeader}
        <div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:0.3rem; font-size:0.75rem;">
          <div style="display:flex; align-items:center; gap:0.35rem; flex-wrap:wrap;">
            ${badgeType}
            <strong style="color:#0f172a;">${createdDateStr} ${createdTimeStr}</strong>
            <span style="color:#64748b;">記載: ${authorName} (${authorDept})</span>
            ${proxyAuthorHtml}
            <span class="badge-latest-tag" style="background:#dbeafe; color:#1e40af; font-size:0.65rem; font-weight:bold; padding:0.05rem 0.3rem; border-radius:3px;">最新</span>
          </div>
          <div style="display:flex; align-items:center; gap:0.3rem;">
            ${pgpBadge}
            ${directOrderBtn}
            <button type="button" 
                    onclick="startQuotedCorrection('${art._id}', '${createdDateStr} ${createdTimeStr}', '${authorName}', \`${safeContent}\`)"
                    style="background:#f0fdf4; border:1px solid #86efac; color:#166534; padding:0.12rem 0.45rem; border-radius:3px; font-size:0.7rem; font-weight:bold; cursor:pointer;"
                    title="このカルテを引用して修正・追記を作成">
              📝 引用して修正
            </button>
          </div>
        </div>
        <div style="font-size:0.85rem; font-weight:bold; color:#0f172a; margin-bottom:0.25rem;">
          ${art.title || ''}
        </div>
        <div class="article-content" style="font-size:0.8rem; line-height:1.5; color:#334155; max-height:none !important; overflow:visible !important; white-space:pre-wrap; word-break:break-word;">${art.content || ''}</div>
      `;

      // 🌟 もし親オーダーが存在する場合、親カードの未確認バッジを確認済みにリアルタイム更新！
      if (isQuoted && parentId) {
        const parentCard = document.querySelector(`.article-item[data-article-id="${parentId}"]`);
        if (parentCard) {
          if (isPharmacyExecution) {
            const pendingBadge = parentCard.querySelector('span[style*="#c2410c"]');
            if (pendingBadge) {
              pendingBadge.style.background = '#ecfdf5';
              pendingBadge.style.color = '#047857';
              pendingBadge.style.border = '1px solid #a7f3d0';
              pendingBadge.textContent = '✅ 鑑査調剤済';
            }
          } else if (isRadiologyExecution) {
            const pendingBadge = parentCard.querySelector('span[style*="#b91c1c"]');
            if (pendingBadge) {
              pendingBadge.style.background = '#f5f3ff';
              pendingBadge.style.color = '#6d28d9';
              pendingBadge.style.border = '1px solid #ddd6fe';
              pendingBadge.textContent = '✅ 撮影実施済';
            }
          }
        }
      }

      // 挿入位置: 元記事が非表示になった場合はその位置（親カードの直後）に配置してツリー位置を保つ
      if (isQuotedCorrection && parentCard && parentCard.parentNode) {
        parentCard.parentNode.insertBefore(card, parentCard.nextSibling);
      } else {
        container.appendChild(card);
      }

      // フィルタ適用・件数再カウント
