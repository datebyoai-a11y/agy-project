                ${badgeIcon} ${escapeHtml(order.category)}
              </span>
              <span style="font-size:0.74rem; color:#64748b; font-weight:500;">[${escapeHtml(order.dept)}]</span>
              <strong style="font-size:0.86rem; color:#0f172a;">${escapeHtml(order.title)}</strong>
