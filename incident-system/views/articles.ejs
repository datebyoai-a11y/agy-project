      }
    }

    // 🔏 PGP詳細モーダルを開く
    async function openPgpModal(articleId) {
      const modal = document.getElementById('pgpDetailModal');
      const body = document.getElementById('pgpModalBody');
      modal.style.display = 'flex';
      body.innerHTML = '<div style="text-align:center; padding:2rem 0; color:#64748b;">⏳ PGP電子署名を暗号学的に検証中...</div>';

      try {
        const res = await fetch(`/api/articles/${articleId}/verify-pgp`);
        const data = await res.json();

        if (!data.success) {
          body.innerHTML = `<div style="padding:1rem; background:#fee2e2; color:#b91c1c; border-radius:6px;">❌ エラー: ${data.message}</div>`;
          return;
        }

        const isValid = data.isValid;
        const isTampered = data.tampered;
        const statusBadge = isValid
          ? '<div style="background:#ecfdf5; border:1px solid #6ee7b7; color:#065f46; padding:0.75rem; border-radius:8px; font-weight:bold; display:flex; align-items:center; gap:0.5rem; margin-bottom:0.75rem;"><span style="font-size:1.3rem;">✅</span> <div><div style="font-size:0.95rem;">真正性確認済み (Authentic & Intact)</div><div style="font-size:0.78rem; font-weight:normal; color:#047857; margin-top:2px;">作成時のRSA署名と現在のデータが完全一致しています。改ざんは検出されませんでした。</div></div></div>'
          : isTampered
            ? '<div style="background:#fef2f2; border:1px solid #f87171; color:#991b1b; padding:0.75rem; border-radius:8px; font-weight:bold; display:flex; align-items:center; gap:0.5rem; margin-bottom:0.75rem;"><span style="font-size:1.3rem;">⚠️</span> <div><div style="font-size:0.95rem;">改ざん検知 (Signature Mismatch)</div><div style="font-size:0.78rem; font-weight:normal; color:#b91c1c; margin-top:2px;">現在のデータと署名時データに不一致があります！データベースまたは本文が直接書き換えられた可能性があります。</div></div></div>'
            : '<div style="background:#f8fafc; border:1px solid #cbd5e1; color:#475569; padding:0.75rem; border-radius:8px; font-weight:bold; margin-bottom:0.75rem;">🔏 未署名データです。</div>';

        body.innerHTML = `
          ${statusBadge}
          <div class="pgp-info-grid">
            <span class="pgp-info-label">署名ステータス:</span>
            <span class="pgp-info-value" style="font-weight:bold; color:${isValid ? '#059669' : '#dc2626'};">${isValid ? '✅ 有効 (Valid Signature)' : '❌ 無効・不一致 (Invalid)'}</span>

            <span class="pgp-info-label">署名者:</span>
            <span class="pgp-info-value">${data.signedBy || '不明'} [${data.signerRole || '職種未設定'}]</span>
            ${(data.isOverride || data.proxyBy) ? `
              <span class="pgp-info-label" style="color:#2563eb;">代行入力者:</span>
              <span class="pgp-info-value" style="color:#1d4ed8; font-weight:bold;">🔄 ${escapeHtml(data.proxyBy || '代行入力')}</span>
            ` : ''}

            <span class="pgp-info-label">署名日時:</span>
            <span class="pgp-info-value">📅 ${data.signedAt ? new Date(data.signedAt).toLocaleString('ja-JP') : '記録なし'}</span>

            <span class="pgp-info-label">署名Key ID:</span>
            <span class="pgp-info-value" style="font-family:monospace; color:#0284c7; font-weight:bold;">${data.keyId || 'なし'}</span>

            <span class="pgp-info-label">フィンガープリント:</span>
            <span class="pgp-info-value" style="font-family:monospace; font-size:0.78rem;">${data.fingerprint || 'なし'}</span>

            <span class="pgp-info-label">暗号アルゴリズム:</span>
            <span class="pgp-info-value">${data.algorithm || 'RSA-SHA256 (OpenPGP Armor)'}</span>
          </div>

          <div style="margin-top:0.75rem;">
            <div style="display:flex; justify-content:space-between; align-items:center;">
              <label style="font-size:0.8rem; font-weight:bold; color:#334155;">🔏 OpenPGP ASCII Armor 署名ブロック:</label>
              <button type="button" onclick="copyPgpCode('pgpArmorCode')" style="background:#f1f5f9; border:1px solid #cbd5e1; border-radius:4px; padding:0.15rem 0.45rem; font-size:0.72rem; cursor:pointer; font-weight:600;">📋 署名をコピー</button>
            </div>
            <pre id="pgpArmorCode" class="pgp-code-block" style="max-height:130px;">${data.armorSignature || '署名なし'}</pre>
          </div>

          <div style="margin-top:0.6rem;">
            <div style="display:flex; justify-content:space-between; align-items:center;">
              <label style="font-size:0.8rem; font-weight:bold; color:#334155;">📄 署名対象カノニカルデータ (Canonical Signed Payload):</label>
              <button type="button" onclick="copyPgpCode('pgpPayloadCode')" style="background:#f1f5f9; border:1px solid #cbd5e1; border-radius:4px; padding:0.15rem 0.45rem; font-size:0.72rem; cursor:pointer; font-weight:600;">📋 データをコピー</button>
            </div>
            <pre id="pgpPayloadCode" class="pgp-code-block" style="max-height:110px; color:#a5f3fc;">${data.signedPayload || data.currentPayload || 'なし'}</pre>
          </div>

          <div style="display:flex; justify-content:space-between; align-items:center; margin-top:1rem; padding-top:0.75rem; border-top:1px solid #e2e8f0;">
            <button type="button" onclick="openPgpModal('${articleId}')" style="background:#f8fafc; border:1px solid #cbd5e1; padding:0.35rem 0.8rem; border-radius:6px; font-size:0.8rem; cursor:pointer; font-weight:600;">⚡ 再検証実行</button>
            <button type="button" onclick="closePgpModal()" style="background:#0f172a; color:white; border:none; padding:0.4rem 1.2rem; border-radius:6px; font-size:0.85rem; cursor:pointer; font-weight:bold;">閉じる</button>
          </div>
        `;
      } catch (err) {
        body.innerHTML = `<div style="padding:1rem; background:#fee2e2; color:#b91c1c; border-radius:6px;">❌ 検証通信失敗: ${err.message}</div>`;
      }
    }

    function closePgpModal(e) {
      if (!e || e.target === document.getElementById('pgpDetailModal') || (e.target && e.target.classList && e.target.classList.contains('pgp-modal-close'))) {
        document.getElementById('pgpDetailModal').style.display = 'none';
      }
    }

    // 🔑 システム公開鍵モーダルを開く
    async function showSystemPublicKeyModal() {
      const modal = document.getElementById('pgpPublicKeyModal');
      const pre = document.getElementById('publicKeyPre');
      modal.style.display = 'flex';
      pre.textContent = '公開鍵を取得中...';

      try {
        const res = await fetch('/api/pgp/public-key');
        const text = await res.text();
        pre.textContent = text;
      } catch (err) {
        pre.textContent = '公開鍵取得エラー: ' + err.message;
      }
    }

    function closePublicKeyModal(e) {
      if (!e || e.target === document.getElementById('pgpPublicKeyModal') || (e.target && e.target.classList && e.target.classList.contains('pgp-modal-close'))) {
        document.getElementById('pgpPublicKeyModal').style.display = 'none';
      }
    }

    function copyPgpCode(elementId) {
      const el = document.getElementById(elementId);
      if (el) {
        navigator.clipboard.writeText(el.textContent).then(() => {
          alert('📋 クリップボードにコピーしました。');
        }).catch(err => {
          alert('コピーに失敗しました: ' + err.message);
        });
      }
    }

    function copyPublicKeyText() {
      copyPgpCode('publicKeyPre');
    }

    // 🔏 全記事PGP一括検証
    async function verifyAllArticlesPgp() {
      try {
        const res = await fetch('/api/articles-verify-all-pgp');
        const data = await res.json();

        if (!data.success) {
          alert('❌ 一括検証エラー: ' + data.message);
          return;
        }

        const { total, validCount, tamperedCount, unsignedCount } = data.summary;
        let msg = `【🔏 PGP電子署名 一括改ざん検証結果】\n\n`;
        msg += `・全記事総数: ${total} 件\n`;
        msg += `・✅ 真正保証 (正常): ${validCount} 件\n`;
        msg += `・⚠️ 改ざん検知 (不一致): ${tamperedCount} 件\n`;
        msg += `・ℹ️ 未署名: ${unsignedCount} 件\n\n`;

        if (tamperedCount === 0) {
          msg += `🎉 すべての署名付き記事の完全性が確認されました。改ざんは検出されていません。`;
        } else {
          msg += `⚠️ ${tamperedCount} 件の記事で署名とデータの不一致が検知されました！タイムライン上の赤色バッジを確認してください。`;
        }

        alert(msg);
      } catch (err) {
        alert('❌ 検証リクエストに失敗しました: ' + err.message);
      }
    }

    // ⚙️ 歯車印メニューの開閉制御
    (function initGearMenu() {
      const gearBtn = document.getElementById('gearMenuBtn');
      const gearDropdown = document.getElementById('gearDropdown');
      const gearCloseBtn = document.getElementById('gearCloseBtn');

      if (!gearBtn || !gearDropdown) return;

      function toggleGearMenu(e) {
        if (e) e.stopPropagation();
        const isOpen = gearDropdown.classList.toggle('show');
        gearBtn.classList.toggle('active', isOpen);
        gearBtn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
      }

      function closeGearMenu() {
        gearDropdown.classList.remove('show');
        gearBtn.classList.remove('active');
        gearBtn.setAttribute('aria-expanded', 'false');
      }

      gearBtn.addEventListener('click', toggleGearMenu);
      if (gearCloseBtn) {
        gearCloseBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          closeGearMenu();
        });
      }

      document.addEventListener('click', (e) => {
        if (!gearDropdown.contains(e.target) && !gearBtn.contains(e.target)) {
          closeGearMenu();
        }
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && gearDropdown.classList.contains('show')) {
          closeGearMenu();
        }
      });
    })();
  </script>

