      border: 1px solid #e2e8f0;
      border-radius: 8px;
      padding: 0.75rem;
      margin-bottom: 0.75rem;
      font-size: 0.84rem;
    }
    .pgp-info-label {
      color: #64748b;
      font-weight: 600;
    }
    .pgp-info-value {
      color: #0f172a;
      font-weight: 500;
      word-break: break-all;
    }
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 0.82rem;
      color: var(--text-muted);
