              切り替え先ユーザーのパスワード: <span style="color:#ef4444;">*</span>
            </label>
            <input type="password" id="switchAuthorPassword" class="form-control" style="width:100%; font-size:0.88rem; padding:0.45rem 0.6rem; border:1px solid #94a3b8; border-radius:4px; box-sizing:border-box;" placeholder="パスワードを入力してください" required autocomplete="current-password">
            <div id="switchAuthorError" style="display:none; color:#ef4444; font-size:0.76rem; font-weight:bold; margin-top:0.35rem;"></div>
          </div>

          <!-- フッターボタン -->
          <div style="display:flex; justify-content:flex-end; gap:0.6rem; border-top:1px solid #e2e8f0; padding-top:0.8rem;">
            <button type="button" onclick="cancelSwitchAuthorModal()" style="background:#f1f5f9; border:1px solid #cbd5e1; color:#475569; padding:0.4rem 0.9rem; border-radius:4px; font-size:0.82rem; cursor:pointer;">
              キャンセル
            </button>
            <button type="submit" id="switchAuthorSubmitBtn" style="background:#0284c7; color:white; border:none; padding:0.4rem 1.2rem; border-radius:4px; font-size:0.84rem; font-weight:bold; cursor:pointer; box-shadow:0 2px 4px rgba(2,132,199,0.3); display:flex; align-items:center; gap:0.3rem;">
              <span>🔑 認証して切り替える</span>
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- 最下段固定ステータスバー (画面操作専用・最後の操作と通知を表示) -->
  <footer id="carteStatusBar" class="carte-status-bar no-print" role="status" aria-live="polite">
    <div class="status-bar-container">
      <!-- 左側: システム稼働状態 & 最後の操作 -->
      <div class="status-section status-left" id="statusActionSection">
        <span class="status-indicator-dot" title="電子カルテシステム正常稼働中"></span>
        <span class="status-label">最後の操作:</span>
        <span id="statusBarLastAction" class="status-value status-action-text" title="直近のユーザー操作">電子カルテ画面を表示しました</span>
        <span id="statusBarActionTime" class="status-time">--:--:--</span>
      </div>

      <!-- 中央: 最新の通知 -->
      <div class="status-section status-center" id="statusNoticeSection">
        <span id="statusBarNoticeIcon" style="font-size:0.85rem; flex-shrink:0;">📢</span>
        <span class="status-label">通知:</span>
        <span id="statusBarLatestNotice" class="status-value status-notice-text" title="最新のシステム通知・案内">準備完了（記事の閲覧・記録・オーダリング連携が可能です）</span>
        <span id="statusBarNoticeTime" class="status-time">--:--:--</span>
      </div>

      <!-- 右側: 連動状態 & 履歴ログ表示ボタン -->
      <div class="status-section status-right">
        <span class="status-badge-connection" title="オーダリング(Port 4000) / 受信部門(Port 5000) リアルタイム連動中">🟢 連携稼働中</span>
        <button type="button" class="status-log-btn" onclick="toggleStatusHistoryModal()" title="直近の操作・通知履歴を表示">
          <span>📜</span> <span>履歴 (<span id="statusHistoryCount">0</span>)</span>
        </button>
      </div>
    </div>
  </footer>

  <!-- 操作・通知 履歴ポップアップモーダル -->
  <div id="statusHistoryModal" class="status-history-modal no-print" style="display:none;" onclick="closeStatusHistoryModal(event)">
    <div class="status-history-dialog" onclick="event.stopPropagation()">
      <div class="status-history-header">
        <div style="display:flex; align-items:center; gap:0.5rem;">
          <span style="font-size:1.1rem;">📜</span>
          <h4 style="margin:0; font-size:0.92rem; font-weight:bold; color:#f8fafc;">電子カルテ操作＆通知 履歴ログ</h4>
          <span style="font-size:0.72rem; color:#94a3b8;">（直近30件）</span>
        </div>
        <button type="button" onclick="closeStatusHistoryModal()" class="status-history-close-btn" title="閉じる">✕</button>
      </div>
      <div class="status-history-body" id="statusHistoryList">
        <!-- JSで動的に追加 -->
      </div>
      <div class="status-history-footer">
        <button type="button" onclick="clearStatusHistory()" class="status-history-clear-btn">履歴消去</button>
        <button type="button" onclick="closeStatusHistoryModal()" class="status-history-ok-btn">閉じる</button>
      </div>
    </div>
  </div>

  <!-- 🔔 トースト通知コンテナ -->
  <div id="toastNotification" style="display:none; position:fixed; bottom:46px; right:24px; background:#0f172a; color:#ffffff; padding:0.75rem 1.25rem; border-radius:8px; box-shadow:0 6px 20px rgba(0,0,0,0.3); z-index:10000; font-size:0.85rem; font-weight:bold; align-items:center; gap:0.5rem; transition:all 0.3s ease;">
    <span id="toastMessage"></span>
  </div>
</body>
</html>
