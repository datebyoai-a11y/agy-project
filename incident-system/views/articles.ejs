    // 🔔 ベル・チャイム音再生エンジン (Web Audio API)
    let carteAudioCtx = null;
    function getCarteAudioContext() {
      if (!carteAudioCtx) {
        const AudioContextClass = window.AudioContext || window.webkitAudioContext;
        if (AudioContextClass) carteAudioCtx = new AudioContextClass();
      }
      if (carteAudioCtx && carteAudioCtx.state === 'suspended') {
        carteAudioCtx.resume();
      }
      return carteAudioCtx;
    }

    document.addEventListener('click', () => {
      if (carteAudioCtx && carteAudioCtx.state === 'suspended') {
        carteAudioCtx.resume();
      }
    }, { once: false, passive: true });

    function playCarteBellSound(type = 'normal') {
      try {
        const ctx = getCarteAudioContext();
        if (!ctx) return;
        const now = ctx.currentTime;

        if (type === 'urgent') {
          // 🚨 至急用アラート
          [0, 0.15].forEach(delay => {
            const osc = ctx.createOscillator();
            const gain = ctx.createGain();
            osc.type = 'sine';
            osc.frequency.setValueAtTime(880, now + delay);
            gain.gain.setValueAtTime(0.25, now + delay);
            gain.gain.exponentialRampToValueAtTime(0.001, now + delay + 0.12);
            osc.connect(gain);
            gain.connect(ctx.destination);
            osc.start(now + delay);
            osc.stop(now + delay + 0.12);
          });
        } else {
          // 🔔 通常チャイム音 (ソ: 784Hz -> ド: 1046.5Hz)
          const osc1 = ctx.createOscillator();
          const gain1 = ctx.createGain();
          osc1.type = 'sine';
          osc1.frequency.setValueAtTime(783.99, now);
          gain1.gain.setValueAtTime(0.28, now);
          gain1.gain.exponentialRampToValueAtTime(0.001, now + 0.45);
          osc1.connect(gain1);
          gain1.connect(ctx.destination);
          osc1.start(now);
          osc1.stop(now + 0.45);

          const osc2 = ctx.createOscillator();
          const gain2 = ctx.createGain();
          osc2.type = 'sine';
          osc2.frequency.setValueAtTime(1046.50, now + 0.22);
          gain2.gain.setValueAtTime(0.32, now + 0.22);
          gain2.gain.exponentialRampToValueAtTime(0.001, now + 0.85);
          osc2.connect(gain2);
          gain2.connect(ctx.destination);
          osc2.start(now + 0.22);
          osc2.stop(now + 0.85);
        }
      } catch (e) {
        console.warn('カルテベル再生エラー:', e);
      }
    }

    function testCarteBellSound() {
      getCarteAudioContext();
      playCarteBellSound('normal');
      showToastNotification('🔔 ベル通知音を試聴しました（ピンポーン♪）');
    }

    // 🔔 リアルタイム新着記事・オーダー自動同期システム
    let lastArticleTimestamp = '<%= (articles && articles.length > 0) ? articles[articles.length - 1].createdAt.toISOString() : new Date().toISOString() %>';
    let isPollingArticles = false;

    async function checkNewArticles() {
      if (isPollingArticles) return;
      isPollingArticles = true;

      try {
        const url = `/api/articles?since=${encodeURIComponent(lastArticleTimestamp)}`;
        const res = await fetch(url, { headers: { 'Accept': 'application/json' } });
        if (!res.ok) return;

        const newArticles = await res.json();
        if (Array.isArray(newArticles) && newArticles.length > 0) {
          let hasCurrentTargetNew = false;
          let otherTargetNewNames = [];

          for (const art of newArticles) {
            // 既にDOMに存在しているか重複確認
            const existing = document.querySelector(`.article-item[data-article-id="${art._id}"]`);
            if (existing) continue;

            appendArticleToTimeline(art);

            if (art.createdAt && new Date(art.createdAt) > new Date(lastArticleTimestamp)) {
              lastArticleTimestamp = art.createdAt;
            }

            const artTargetId = art.targetPerson ? (art.targetPerson._id || art.targetPerson) : 'NONE';
            const artTargetCustomId = art.targetPerson ? (art.targetPerson.customId || '') : '';
            const artTargetName = art.targetPerson ? (art.targetPerson.name || '患者') : '全体';

            if (currentSelectedTargetId === 'ALL' || currentSelectedTargetId === artTargetId || (artTargetCustomId && currentSelectedTargetId === artTargetCustomId)) {
              hasCurrentTargetNew = true;
            } else {
              otherTargetNewNames.push({ id: artTargetId, customId: artTargetCustomId, name: artTargetName, title: art.title });
            }
          }

          if (hasCurrentTargetNew) {
            scrollToLatestArticle(true);
            playCarteBellSound('normal');
            showToastNotification('🔔 <strong>新着オーダー／記事を受信しました！</strong> タイムラインに自動反映されました。');
          } else if (otherTargetNewNames.length > 0) {
            playCarteBellSound('normal');
            const first = otherTargetNewNames[0];
            const notifMsg = `🔔 <strong>${escapeHtml(first.name)} 様</strong> 宛ての新着オーダーを受信しました <button type="button" onclick="onCarteTargetSelect('${first.id}')" style="background:#0284c7; color:white; border:none; padding:2px 8px; border-radius:4px; font-size:0.75rem; font-weight:bold; cursor:pointer; margin-left:6px;">表示する ↗</button>`;
            showToastNotification(notifMsg);
          }
        }
      } catch (err) {
        console.warn('新着記事ポーリング通信エラー:', err.message);
      } finally {
        isPollingArticles = false;
      }
    }

    function focusInput(e) {
