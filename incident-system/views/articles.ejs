  <script>
    // ↔️ 2ペイン分割（左ペインと中央記載ペイン）のリサイズ制御
    function initPaneResizers() {
      const leftPane = document.querySelector('.carte-pane-left');
      const centerPane = document.querySelector('.carte-pane-center');
      const resizerLeft = document.getElementById('resizerLeft');
      const container = document.querySelector('.carte-layout-3col');

      if (!leftPane || !centerPane || !resizerLeft || !container) return;

      const DEFAULT_LEFT_WIDTH = 290;
      const MIN_LEFT_WIDTH = 150;
      const MAX_LEFT_WIDTH = 750;
      const MIN_CENTER_WIDTH = 300;

      // 保存された幅の復元 (localStorage)
      try {
        const savedLeft = localStorage.getItem('carte_pane_left_width');
        if (savedLeft) {
          const w = parseInt(savedLeft, 10);
          if (!isNaN(w) && w >= MIN_LEFT_WIDTH && w <= MAX_LEFT_WIDTH) {
            leftPane.style.width = `${w}px`;
            leftPane.style.flex = `0 0 ${w}px`;
          }
        }
      } catch (e) {}

      let isDraggingLeft = false;
      let startXLeft = 0;
      let startWidthLeft = 0;

      // --- 左スプリッター (左ペインと中央ペインの境界) ---
      function onMouseDownLeft(e) {
        if (window.innerWidth <= 768) return;
        isDraggingLeft = true;
        startXLeft = (e.touches && e.touches[0] ? e.touches[0].clientX : e.clientX);
        startWidthLeft = leftPane.getBoundingClientRect().width;
        resizerLeft.classList.add('resizing');
        document.body.style.cursor = 'col-resize';
        document.body.style.userSelect = 'none';
        if (e.cancelable && e.type !== 'touchstart') e.preventDefault();
      }

      function onMouseMove(e) {
        if (!isDraggingLeft) return;

        const clientX = (e.touches && e.touches[0] ? e.touches[0].clientX : e.clientX);
        if (clientX === undefined) return;

        const containerRect = container.getBoundingClientRect();
        const deltaX = clientX - startXLeft;
        let newWidth = startWidthLeft + deltaX;

        const maxAllowed = containerRect.width - MIN_CENTER_WIDTH - 12;
        const actualMax = Math.min(MAX_LEFT_WIDTH, maxAllowed);

        if (newWidth < MIN_LEFT_WIDTH) newWidth = MIN_LEFT_WIDTH;
        if (newWidth > actualMax) newWidth = actualMax;

        const rounded = Math.round(newWidth);
        leftPane.style.width = `${rounded}px`;
        leftPane.style.flex = `0 0 ${rounded}px`;
      }

      function onMouseUp() {
        if (isDraggingLeft) {
          isDraggingLeft = false;
          resizerLeft.classList.remove('resizing');
          document.body.style.cursor = '';
          document.body.style.userSelect = '';
          try {
            localStorage.setItem('carte_pane_left_width', Math.round(leftPane.getBoundingClientRect().width));
          } catch (e) {}
        }
      }

      // ダブルクリックでデフォルト幅にリセット
      resizerLeft.addEventListener('dblclick', () => {
        leftPane.style.width = `${DEFAULT_LEFT_WIDTH}px`;
        leftPane.style.flex = `0 0 ${DEFAULT_LEFT_WIDTH}px`;
        try {
          localStorage.setItem('carte_pane_left_width', DEFAULT_LEFT_WIDTH);
        } catch (e) {}
      });

      resizerLeft.addEventListener('mousedown', onMouseDownLeft);
      resizerLeft.addEventListener('touchstart', onMouseDownLeft, { passive: true });

      window.addEventListener('mousemove', onMouseMove);
      window.addEventListener('touchmove', onMouseMove, { passive: true });

      window.addEventListener('mouseup', onMouseUp);
      window.addEventListener('touchend', onMouseUp);
    }

    if (document.readyState === 'complete' || document.readyState === 'interactive') {
      setTimeout(initPaneResizers, 50);
    } else {
      document.addEventListener('DOMContentLoaded', initPaneResizers);
    }

    // 🌐 全患者表示モード切り替え
    function toggleAllPatientsView() {
      const select = document.getElementById('headerTargetFilter');
      if (!select) return;
      if (currentSelectedTargetId === 'ALL') {
        const prevId = window._lastSelectedSpecificTargetId || (select.options.length > 1 ? select.options[1].value : 'ALL');
        onCarteTargetSelect(prevId);
      } else {
        window._lastSelectedSpecificTargetId = currentSelectedTargetId;
        onCarteTargetSelect('ALL');
      }
    }

    // 1. 患者選択切り替え時のヘッダー情報更新 & 全画面引き継ぎ
    async function onCarteTargetSelect(targetId) {
      const prevTargetId = currentSelectedTargetId;

      // 以前の患者の入力内容があれば一時保存
      if (typeof saveCarteDraft === 'function' && prevTargetId && prevTargetId !== 'ALL' && prevTargetId !== 'NONE') {
        saveCarteDraft(false);
      }

      const select = document.getElementById('headerTargetFilter');
      let matchedOption = null;

      // targetId が _id または customId のいずれでもマッチするように探索
      if (select && targetId) {
        for (let i = 0; i < select.options.length; i++) {
          const opt = select.options[i];
          const optCustomId = opt.getAttribute('data-custom-id') || '';
          if (opt.value === targetId || (optCustomId && optCustomId.toLowerCase() === String(targetId).toLowerCase())) {
            matchedOption = opt;
            select.selectedIndex = i;
            break;
          }
        }
      }

      if (!matchedOption && select && select.selectedIndex >= 0) {
        matchedOption = select.options[select.selectedIndex];
      }

      const effectiveTargetId = (matchedOption && matchedOption.value !== 'ALL') ? matchedOption.value : (targetId === 'ALL' ? 'ALL' : '');
      currentSelectedTargetId = effectiveTargetId;

      // 全患者切り替えボタンの外観を同期
      const toggleBtn = document.getElementById('btnToggleAllPatients');
      if (toggleBtn) {
        if (effectiveTargetId === 'ALL') {
          toggleBtn.style.background = '#0284c7';
          toggleBtn.style.borderColor = '#38bdf8';
          toggleBtn.innerHTML = '<span>🌐 全患者表示中</span>';
        } else {
          toggleBtn.style.background = 'rgba(255,255,255,0.15)';
          toggleBtn.style.borderColor = 'rgba(255,255,255,0.3)';
          toggleBtn.innerHTML = '<span>🌐 全患者表示</span>';
        }
      }

      // 1. 入力画面フォーム（中央ペイン）の hidden input を更新
      const formTarget = document.getElementById('formTargetPersonSelect');
      if (formTarget) {
        formTarget.value = (effectiveTargetId === 'ALL' || effectiveTargetId === 'NONE') ? '' : effectiveTargetId;
      }

      // 2. モーダル内セレクトボックスの対象患者も連動同期
      const quickTargetSelect = document.getElementById('quickModalTargetPerson');
      if (quickTargetSelect && effectiveTargetId && effectiveTargetId !== 'ALL') {
        quickTargetSelect.value = effectiveTargetId;
      }

      // 3. 患者情報バッジ群（ヘッダー、入力画面、オーダーパレット）の表示更新
      let patientCustomId = '';
      let patientName = '全患者';
      let patientDept = '';

      if (matchedOption && matchedOption.value !== 'ALL') {
        patientCustomId = matchedOption.getAttribute('data-custom-id') || '';
        patientName = matchedOption.getAttribute('data-name') || matchedOption.textContent.replace(/^\[.*?\]\s*/, '').trim();
        patientDept = matchedOption.getAttribute('data-dept') || '';

        // トップヘッダーバッジ
        document.getElementById('cartePatientId').textContent = patientCustomId ? `[${patientCustomId}]` : '';
        document.getElementById('cartePatientName').textContent = patientName ? `${patientName} 様` : '全患者';
        document.getElementById('cartePatientKana').textContent = patientDept ? `(${patientDept})` : '';

        // 中央ペイン（入力画面）の対象患者インジケーター
        const carteIndicator = document.getElementById('carteTargetPersonIndicatorText');
        if (carteIndicator) {
          carteIndicator.textContent = `[${patientCustomId}] ${patientName} 様${patientDept ? ` (${patientDept})` : ''}`;
        }

        // 右ペイン（オーダー画面）の対象患者インジケーター
        const paletteIndicator = document.getElementById('paletteTargetPersonText');
        if (paletteIndicator) {
          paletteIndicator.textContent = `[${patientCustomId}] ${patientName} 様`;
        }
      } else {
        document.getElementById('cartePatientId').textContent = '未選択';
        document.getElementById('cartePatientName').textContent = '全患者（すべての記事）';
        document.getElementById('cartePatientKana').textContent = '';

        const carteIndicator = document.getElementById('carteTargetPersonIndicatorText');
        if (carteIndicator) carteIndicator.textContent = '未選択 (全患者表示中)';

        const paletteIndicator = document.getElementById('paletteTargetPersonText');
        if (paletteIndicator) paletteIndicator.textContent = '未選択';
      }

      // 4. サーバー側セッションへ非同期同期（リロードや別画面遷移後も維持）
      try {
        fetch('/api/select-target-person', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify({ targetPersonId: effectiveTargetId })
        }).catch(() => {});
      } catch (e) {}

      // 5. ブラウザの URL パラメータを更新（ブックマークや戻る進むで引き継ぐ）
      if (window.history && window.history.replaceState) {
        try {
          const url = new URL(window.location.href);
          if (patientCustomId) {
            url.searchParams.set('targetId', patientCustomId);
          } else if (effectiveTargetId && effectiveTargetId !== 'ALL') {
            url.searchParams.set('targetId', effectiveTargetId);
          } else {
            url.searchParams.delete('targetId');
          }
          window.history.replaceState(null, '', url.toString());
        } catch (e) {}
      }

      // 6. ローカルストレージに保存
      try {
        if (effectiveTargetId && effectiveTargetId !== 'ALL') {
          localStorage.setItem('selected_target_person_id', effectiveTargetId);
          if (patientCustomId) localStorage.setItem('selected_target_person_custom_id', patientCustomId);
        }
      } catch (e) {}

      // 🌟 患者切り替え時に一時的オーバーライドを自動終了
      const headerOverrideBadge = document.getElementById('headerOverrideBadge');
      const isOverriding = headerOverrideBadge && headerOverrideBadge.style.display !== 'none';
      if (isOverriding && prevTargetId && prevTargetId !== effectiveTargetId) {
        try {
          const res = await fetch('/api/revert-override', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' }
          });
          const data = await res.json();
          if (res.ok && data.success && data.user) {
            const selectEl = document.getElementById('headerAuthorSelect');
            if (selectEl) {
              selectEl.value = data.user.id;
              selectEl.setAttribute('data-current-id', data.user.id);
            }
            applyAuthorChange(data.user.id, data.user.userName, data.user.department, 'complete', null);
            showToastNotification(`🔄 患者が切り替わったため、代行入力を終了し <strong>${escapeHtml(data.user.userName)} 様</strong> に自動復帰しました`);
          }
        } catch (e) {
          console.warn('患者切り替え時の代行自動解除エラー:', e);
        }
      }

      applyArticleFilters();
      loadStagedOrdersFromStorage();

      // 🌟 切り替え先患者の下書きカルテを自動復帰
      const restored = loadCarteDraftFromStorage(effectiveTargetId);
      if (!restored) {
        const textarea = document.getElementById('articleContentInput');
        if (textarea && prevTargetId && prevTargetId !== effectiveTargetId) {
          textarea.value = '';
        }
        const banner = document.getElementById('draftNoticeBanner');
        if (banner) banner.style.display = 'none';
      }

      // 🌟 オーダリング画面への遷移リンクに最新の患者情報を反映
      updateOrderingLinks();
    }

    // 2. 左ペインタブ切り替え（過去カルテ / 患者サマリー）
    function switchLeftTab(tab) {
      const tabPast = document.getElementById('tabPastCarte');
      const tabSum = document.getElementById('tabSummary');
      if (tab === 'carte') {
        tabPast.classList.add('active');
        tabSum.classList.remove('active');
      } else {
        tabSum.classList.add('active');
        tabPast.classList.remove('active');
      }
    }

    // 3. 🎀 右ペイン 2段リボン制御 (上段: 部署選択 / 下段: 部署別メニュー)
    function getDeptKeyFromDeptName(deptName) {
      if (!deptName) return 'doctor';
      const name = String(deptName).toLowerCase();
      if (name.includes('医局') || name.includes('医師')) return 'doctor';
      if (name.includes('看護') || name.includes('病棟') || name.includes('外来')) return 'nurse';
      if (name.includes('薬')) return 'pharmacy';
      if (name.includes('放射線') || name.includes('レントゲン')) return 'radiology';
      if (name.includes('リハビリ') || name.includes('pt') || name.includes('ot') || name.includes('st')) return 'rehab';
      if (name.includes('介護') || name.includes('ケア')) return 'care';
      if (name.includes('栄養')) return 'nutrition';
      if (name.includes('安全')) return 'safety';
      if (name.includes('事務') || name.includes('医事')) return 'admin';
      return 'doctor';
    }

    // 上段リボン: 部署の切り替え (初期値は入力者の部署)
    function selectRibbonDept(deptKey) {
      // 1. 上段リボンボタンのアクティブ切り替え
      const deptBtns = document.querySelectorAll('.ribbon-dept-btn');
      deptBtns.forEach(btn => btn.classList.remove('active'));
      const targetBtn = document.getElementById(`deptBtn_${deptKey}`);
      if (targetBtn) {
        targetBtn.classList.add('active');
        try { targetBtn.scrollIntoView({ behavior: 'smooth', inline: 'nearest', block: 'nearest' }); } catch(e){}
      }

      // 2. 下段リボンのメニューグループ切り替え
      const menuGroups = document.querySelectorAll('.ribbon-menu-group');
      menuGroups.forEach(g => g.classList.remove('active'));
      const targetGroup = document.getElementById(`menuGroup_${deptKey}`);
      if (targetGroup) {
        targetGroup.classList.add('active');
        // その部署の先頭メニューボタンを自動選択
        const firstMenuBtn = targetGroup.querySelector('.ribbon-menu-btn');
        if (firstMenuBtn) {
          firstMenuBtn.click();
        }
      }
    }

