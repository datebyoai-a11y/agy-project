    // 16. カルテ下書きの一時保存・自動復元機能
    let carteDraftSaveTimeout = null;

    // 現在選択されている患者IDの取得ヘルパー
    function getActiveCarteTargetId() {
      const formTarget = document.getElementById('formTargetPersonSelect');
      if (formTarget && formTarget.value && formTarget.value !== 'ALL' && formTarget.value !== 'NONE') {
        return formTarget.value;
      }
      const headerFilter = document.getElementById('headerTargetFilter');
      if (headerFilter && headerFilter.value && headerFilter.value !== 'ALL' && headerFilter.value !== 'NONE') {
        return headerFilter.value;
      }
      return 'common';
    }

    // カルテ下書きを localStorage に保存
    function saveCarteDraft(manual = false) {
      try {
        const textarea = document.getElementById('articleContentInput');
        if (!textarea) return;
        const content = textarea.value;
        const targetId = getActiveCarteTargetId();
        const indicator = document.getElementById('draftSaveTimeIndicator');

        // 本文が空の場合、下書きをクリア
        if (!content.trim()) {
          localStorage.removeItem(`carte_draft_${targetId}`);
          if (indicator && manual) indicator.textContent = '';
          if (manual) showToastNotification('ℹ️ 入力内容が空のため、一時保存データをクリアしました');
          return;
        }

        const now = new Date();
        const draftData = {
          content: content,
          savedAt: now.toISOString(),
          targetId: targetId
        };

        localStorage.setItem(`carte_draft_${targetId}`, JSON.stringify(draftData));

        const timeStr = now.toLocaleTimeString('ja-JP', { hour: '2-digit', minute: '2-digit' });
        if (indicator) {
          indicator.textContent = `一時保存済 (${timeStr})`;
          indicator.style.color = '#059669';
        }

        if (manual) {
          showToastNotification(`📝 カルテの下書きを一時保存しました (${timeStr})`);
        }
      } catch (e) {
        console.warn('カルテ下書き保存エラー:', e);
      }
    }

    // カルテ入力時の自動バックアップ（1.2秒デバウンス）
    function onCarteContentInput() {
      const indicator = document.getElementById('draftSaveTimeIndicator');
      if (indicator) {
        indicator.textContent = '入力中...';
        indicator.style.color = '#64748b';
      }
      if (carteDraftSaveTimeout) clearTimeout(carteDraftSaveTimeout);
      carteDraftSaveTimeout = setTimeout(() => {
        saveCarteDraft(false);
      }, 1200);
    }

    // カルテ下書きの自動復元
    function loadCarteDraftFromStorage(targetId = null) {
      try {
        const activeTargetId = targetId || getActiveCarteTargetId();
        const savedJson = localStorage.getItem(`carte_draft_${activeTargetId}`);
        const textarea = document.getElementById('articleContentInput');
        const banner = document.getElementById('draftNoticeBanner');
        const bannerText = document.getElementById('draftNoticeText');
        const indicator = document.getElementById('draftSaveTimeIndicator');

        if (!savedJson) {
          if (banner) banner.style.display = 'none';
          if (indicator) indicator.textContent = '';
          return false;
        }

        const draft = JSON.parse(savedJson);
        if (draft && draft.content && draft.content.trim()) {
          if (textarea) {
            textarea.value = draft.content;
          }

          const savedDate = draft.savedAt ? new Date(draft.savedAt) : null;
          const timeStr = savedDate ? savedDate.toLocaleString('ja-JP', { month: 'numeric', day: 'numeric', hour: '2-digit', minute: '2-digit' }) : '前回';

          if (banner) {
            banner.style.display = 'flex';
            if (bannerText) {
              bannerText.innerHTML = `前回の一時保存（下書き: <strong>${escapeHtml(timeStr)}</strong>）を自動復帰しました`;
            }
          }
          if (indicator) {
            indicator.textContent = `下書き復元済 (${savedDate ? savedDate.toLocaleTimeString('ja-JP', { hour: '2-digit', minute: '2-digit' }) : ''})`;
            indicator.style.color = '#059669';
          }

          showToastNotification(`📝 前回の一時保存（下書き: ${timeStr}）を自動復帰しました`);
          return true;
        } else {
          if (banner) banner.style.display = 'none';
          return false;
        }
      } catch (e) {
        console.warn('カルテ下書き復元エラー:', e);
        return false;
      }
    }

    // カルテ下書きの破棄
    function discardCarteDraft() {
      if (!confirm('一時保存されていた下書きを破棄し、入力をクリアしますか？')) return;
      const targetId = getActiveCarteTargetId();
      localStorage.removeItem(`carte_draft_${targetId}`);

      const textarea = document.getElementById('articleContentInput');
      if (textarea) textarea.value = '';

      const banner = document.getElementById('draftNoticeBanner');
      if (banner) banner.style.display = 'none';

      const indicator = document.getElementById('draftSaveTimeIndicator');
      if (indicator) indicator.textContent = '';

      showToastNotification('🗑️ 一時保存（下書き）を破棄しました');
    }

    // 現在日時を <input type="datetime-local"> 用 (YYYY-MM-DDTHH:mm) にフォーマットする関数
    function getCurrentDateTimeLocal() {
      const now = new Date();
      const year = now.getFullYear();
      const month = String(now.getMonth() + 1).padStart(2, '0');
      const day = String(now.getDate()).padStart(2, '0');
      const hours = String(now.getHours()).padStart(2, '0');
      const minutes = String(now.getMinutes()).padStart(2, '0');
      return `${year}-${month}-${day}T${hours}:${minutes}`;
    }

    // フィルタリング状態管理
    let currentSelectedTargetId = 'ALL';
    let currentSelectedDeptFilter = '<%= currentUserDept || "ALL" %>';
    let currentSelectedCatFilter = 'ALL';

    // 17. 最新記事（タイムラインの一番下）にフォーカスする関数
    function focusLatestArticle(smooth = true) {
      const container = document.getElementById('timelineContainer');
      const visibleItems = Array.from(document.querySelectorAll('.article-item'))
        .filter(item => item.style.display !== 'none');

      if (visibleItems.length > 0) {
        const latestItem = visibleItems[visibleItems.length - 1]; // 日時順で一番下の最新記事
        document.querySelectorAll('.article-item.latest-focus').forEach(el => el.classList.remove('latest-focus'));
        latestItem.classList.add('latest-focus');
        setTimeout(() => {
          latestItem.scrollIntoView({ behavior: smooth ? 'smooth' : 'auto', block: 'center' });
        }, 60);
      } else if (container) {
        container.scrollTop = container.scrollHeight;
      }
    }

    // 後方互換用エイリアス
    function scrollToLatestArticle(smooth = true) {
      focusLatestArticle(smooth);
    }

    function applyArticleFilters() {
      const items = document.querySelectorAll('.article-item');
      const allModeTags = document.querySelectorAll('.all-mode-target-tag');
      let visibleCount = 0;

      items.forEach(item => {
        // 🔒 引用修正によって非表示化された元記事は常に非表示を維持
        if (item.classList.contains('hidden-original-article') || item.getAttribute('data-is-original-hidden') === 'true') {
          item.style.display = 'none';
          return;
        }

        const itemTargetId = item.getAttribute('data-target-id');
        const itemCat = item.getAttribute('data-category') || '';
        const itemDept = item.getAttribute('data-author-dept') || '';

        // 1. 対象者一致判定
        const matchesTarget = (currentSelectedTargetId === 'ALL') || (currentSelectedTargetId === itemTargetId);

        // 2. 職種・部署一致判定（部分一致含む柔軟な判定）
        let matchesDept = true;
        if (currentSelectedDeptFilter !== 'ALL') {
          if (currentSelectedDeptFilter === 'リハビリ') {
            matchesDept = (itemDept === 'リハビリ') || itemDept.includes('リハビリ') || itemDept.includes('療法');
          } else {
            matchesDept = (itemDept === currentSelectedDeptFilter) || (itemDept.includes(currentSelectedDeptFilter));
          }
        }

        // 3. カテゴリー一致判定
        let matchesCat = true;
        if (currentSelectedCatFilter === 'RAD') {
          matchesCat = itemCat.includes('放射線') || itemCat.includes('レントゲン') || itemCat.includes('CT') || itemCat.includes('MRI');
        } else if (currentSelectedCatFilter === 'IV') {
          matchesCat = itemCat.includes('点滴') || itemCat.includes('注射');
        } else if (currentSelectedCatFilter === 'MEAL') {
          matchesCat = itemCat.includes('食事');
        } else if (currentSelectedCatFilter === 'NOTE') {
          matchesCat = !itemCat.includes('点滴') && !itemCat.includes('食事') && !itemCat.includes('放射線');
        }

        if (matchesTarget && matchesDept && matchesCat) {
          item.style.display = 'block';
          visibleCount++;
        } else {
          item.style.display = 'none';
        }
      });

      // 表示件数を更新
      document.getElementById('visibleCount').textContent = visibleCount;

      // 0件時のメッセージ表示制御
      const noNotice = document.getElementById('noArticlesNotice');
      if (noNotice) {
        if (visibleCount === 0) {
          noNotice.style.display = 'block';
          const labelEl = document.getElementById('currentDeptLabel');
          if (labelEl) {
            labelEl.textContent = currentSelectedDeptFilter === 'ALL' ? '全体' : currentSelectedDeptFilter;
          }
        } else {
          noNotice.style.display = 'none';
        }
      }

      scrollToLatestArticle();
    }

    // 職種ドロップダウンによる絞り込み
    function filterArticlesByDept(selectedDept) {
      currentSelectedDeptFilter = selectedDept;
      applyArticleFilters();
    }

    // 対象者選択による絞り込み
    function filterArticlesByTarget(selectedTargetId) {
      currentSelectedTargetId = selectedTargetId;
      const allModeTags = document.querySelectorAll('.all-mode-target-tag');
      const bannerName = document.getElementById('bannerTargetName');
      const bannerBadge = document.getElementById('bannerTargetBadge');
      const filterSelect = document.getElementById('headerTargetFilter');

      if (selectedTargetId === 'ALL') {
        if (bannerName) bannerName.textContent = '🌐 全対象者（すべての記事を表示中）';
        if (bannerBadge) {
          bannerBadge.textContent = '全体表示モード';
          bannerBadge.style.background = '#e0f2fe';
          bannerBadge.style.color = '#0284c7';
        }
        allModeTags.forEach(tag => tag.style.display = 'inline-block');
      } else if (selectedTargetId === 'NONE') {
        if (bannerName) bannerName.textContent = '📂 対象者なし（全体共有メモ・お知らせ）';
        if (bannerBadge) {
          bannerBadge.textContent = '全体共有のみ';
          bannerBadge.style.background = '#f1f5f9';
          bannerBadge.style.color = '#475569';
        }
        allModeTags.forEach(tag => tag.style.display = 'none');
      } else {
        let targetText = '🎯 特定の対象者';
        if (filterSelect && filterSelect.selectedIndex >= 0) {
          targetText = filterSelect.options[filterSelect.selectedIndex].text;
        }
        if (bannerName) bannerName.textContent = targetText + ' さん限定';
        if (bannerBadge) {
          bannerBadge.textContent = '🎯 対象者限定モード';
          bannerBadge.style.background = '#ccfbf1';
          bannerBadge.style.color = '#0d9488';
          bannerBadge.style.borderColor = '#5eead4';
        }
        allModeTags.forEach(tag => tag.style.display = 'none');
      }

      // 入力フォームの対象者選択欄とも連動
      const formSelect = document.getElementById('formTargetPersonSelect');
      if (selectedTargetId !== 'ALL' && selectedTargetId !== 'NONE') {
        if (formSelect) formSelect.value = selectedTargetId;
      } else {
        if (formSelect) formSelect.value = '';
      }

      applyArticleFilters();
    }

    // カテゴリーボタンによるタイムライン絞り込み
    function filterArticlesByCat(catFilter) {
      currentSelectedCatFilter = catFilter;
      document.querySelectorAll('.timeline-filter-btn').forEach(btn => {
        if (btn.getAttribute('data-cat-filter') === catFilter) {
          btn.style.background = (catFilter === 'RAD') ? '#8b5cf6' : (catFilter === 'IV') ? '#059669' : (catFilter === 'MEAL') ? '#d97706' : '#0284c7';
          btn.style.color = 'white';
          btn.classList.add('active');
        } else {
          btn.style.background = '#ffffff';
          btn.style.color = '#334155';
          btn.classList.remove('active');
        }
      });
      applyArticleFilters();
    }

    // 区分選択によって入力画面を自動スイッチする関数
    function onCategoryChange(category) {
      const normalArea = document.getElementById('normalContentArea');
      const ivArea = document.getElementById('ivOrderFieldsArea');
      const mealArea = document.getElementById('mealOrderFieldsArea');
      const radArea = document.getElementById('radOrderFieldsArea');
      const submitBtn = document.getElementById('submitBtn');
      const textInput = document.getElementById('articleContentInput');
      const ivMedInput = document.getElementById('ivMedicine');
      const radExamInput = document.getElementById('radExamType');
      const finalHostInput = document.getElementById('remoteHostUrlFinal');
      const finalScheduledInput = document.getElementById('scheduledAtFinal');

      if (category && category.includes('点滴')) {
        normalArea.style.display = 'none';
        ivArea.style.display = 'block';
        mealArea.style.display = 'none';
        if (radArea) radArea.style.display = 'none';
        if (submitBtn) {
          submitBtn.textContent = '💉 点滴オーダーを発行＆別ホストへ送信';
          submitBtn.className = 'btn btn-success';
          submitBtn.style.background = '#059669';
        }
        if (textInput) textInput.removeAttribute('required');
        if (radExamInput) radExamInput.removeAttribute('required');
        if (ivMedInput) {
          ivMedInput.setAttribute('required', 'required');
          ivMedInput.focus();
        }
        if (finalHostInput) finalHostInput.value = document.getElementById('remoteHostUrlIv').value;
        if (finalScheduledInput) finalScheduledInput.value = document.getElementById('scheduledAtIv').value;
      } else if (category && category.includes('食事')) {
        normalArea.style.display = 'none';
        ivArea.style.display = 'none';
        mealArea.style.display = 'block';
        if (radArea) radArea.style.display = 'none';
        if (submitBtn) {
          submitBtn.textContent = '🍱 食事オーダーを発行＆別ホストへ送信';
          submitBtn.className = 'btn btn-primary';
          submitBtn.style.background = '#d97706';
        }
        if (textInput) textInput.removeAttribute('required');
        if (ivMedInput) ivMedInput.removeAttribute('required');
        if (radExamInput) radExamInput.removeAttribute('required');
        if (finalHostInput) finalHostInput.value = document.getElementById('remoteHostUrlMeal').value;
        if (finalScheduledInput) finalScheduledInput.value = document.getElementById('scheduledAtMeal').value;
      } else if (category && (category.includes('放射線') || category.includes('レントゲン') || category.includes('CT') || category.includes('MRI'))) {
        normalArea.style.display = 'none';
        ivArea.style.display = 'none';
        mealArea.style.display = 'none';
        if (radArea) radArea.style.display = 'block';
        if (submitBtn) {
          submitBtn.textContent = '🩻 放射線科オーダーを発行＆別ホストへ送信';
          submitBtn.className = 'btn btn-primary';
          submitBtn.style.background = '#8b5cf6';
        }
        if (textInput) textInput.removeAttribute('required');
        if (ivMedInput) ivMedInput.removeAttribute('required');
        if (radExamInput) {
          radExamInput.setAttribute('required', 'required');
          radExamInput.focus();
        }
        if (finalHostInput) finalHostInput.value = document.getElementById('remoteHostUrlRad').value;
        if (finalScheduledInput) finalScheduledInput.value = document.getElementById('scheduledAtRad').value;
      } else {
        normalArea.style.display = 'block';
        ivArea.style.display = 'none';
        mealArea.style.display = 'none';
        if (radArea) radArea.style.display = 'none';
        if (submitBtn) {
          submitBtn.textContent = '投稿する';
          submitBtn.className = 'btn btn-primary';
          submitBtn.style.background = '';
        }
        if (textInput) {
          textInput.setAttribute('required', 'required');
          textInput.focus();
        }
        if (ivMedInput) ivMedInput.removeAttribute('required');
        if (radExamInput) radExamInput.removeAttribute('required');
        if (finalHostInput) finalHostInput.value = '';
        if (finalScheduledInput) finalScheduledInput.value = '';
      }
    }

    // 点滴クイックプリセット入力
    function setIvPreset(med, rate, route) {
      document.getElementById('ivMedicine').value = med;
      if (rate) document.getElementById('ivRate').value = rate;
      if (route) {
        const routeSelect = document.querySelector('#articlePostForm select[name="route"]');
        if (routeSelect) routeSelect.value = route;
      }
    }

    // 食事クイックプリセット入力
    function setMealPreset(type, staple, side, allergy) {
      const typeSelect = document.getElementById('mealType');
      if (typeSelect) typeSelect.value = type;
      if (staple || side) {
        document.getElementById('mealStaple').value = `主食:${staple || '標準'} / 副食:${side || '標準'}`;
      }
      if (allergy) {
        document.getElementById('mealAllergies').value = allergy;
      }
    }

    // 放射線クイックプリセット入力
    function setRadPreset(examType, modality, contrast, portable, purpose) {
      if (examType) document.getElementById('radExamType').value = examType;
      if (modality) document.getElementById('radModality').value = modality;
      if (contrast) document.getElementById('radContrast').value = contrast;
      if (portable) document.getElementById('radPortable').value = portable;
      if (purpose) document.getElementById('radPurpose').value = purpose;
    }

    // 🌐 送信先ホストとの接続疎通テスト（テスト指示は記事保存せずスキップして捨てる）
    async function testHostConnection(type = 'iv') {
      let inputId = 'remoteHostUrlIv';
      let endpoint = '/api/iv-orders/test-connection';
      if (type === 'meal') {
        inputId = 'remoteHostUrlMeal';
        endpoint = '/api/meal-orders/test-connection';
      } else if (type === 'rad') {
        inputId = 'remoteHostUrlRad';
        endpoint = '/api/radiology-orders/test-connection';
      }
      const targetUrl = document.getElementById(inputId).value;

      if (!targetUrl) {
        alert('送信先ホストのURLを入力してください。');
        return;
      }

      try {
        const res = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ targetUrl })
        });
        const data = await res.json();
        if (data.success) {
          alert('✅ ' + data.message);
        } else {
          alert('❌ ' + data.message);
        }
      } catch (err) {
        alert('❌ 疎通テスト失敗: ' + err.message);
      }
    }

    // フォーム送信前にリモートURLと開始日時を自動補完・同期
    document.addEventListener('DOMContentLoaded', () => {
      // 🎀 右ペイン2段リボンの初期化 (初期値は入力者の部署)
      const userDept = "<%= currentUserDept || '' %>";
      initRightRibbon(userDept);

      // ↔️ 縦3列境界リサイザーの初期化 (ドラッグで幅を変更可能)
      initPaneResizers();

      // 電子カルテ現在日時のフォーマット表示
      const now = new Date();
      const days = ['日', '月', '火', '水', '木', '金', '土'];
      const dateStr = `${now.getFullYear()}/${String(now.getMonth()+1).padStart(2,'0')}/${String(now.getDate()).padStart(2,'0')} (${days[now.getDay()]})`;
      const timeStr = `${String(now.getHours()).padStart(2,'0')}:${String(now.getMinutes()).padStart(2,'0')}`;
      
      const dateHeader = document.getElementById('carteInputDateTime');
      if (dateHeader) dateHeader.textContent = `${dateStr} ${timeStr}`;
      
      const leftActiveDate = document.getElementById('leftActiveCarteDate');
      if (leftActiveDate) leftActiveDate.textContent = dateStr;

      // 初期の患者情報同期
      const targetFilter = document.getElementById('headerTargetFilter');
      if (targetFilter && targetFilter.options.length > 1) {
        // 先頭の患者を選択初期値にする
        targetFilter.selectedIndex = 1;
        onCarteTargetSelect(targetFilter.value);
      }

      const defaultNow = getCurrentDateTimeLocal();
      const ivSchedInput = document.getElementById('scheduledAtIv');
      const mealSchedInput = document.getElementById('scheduledAtMeal');
      const radSchedInput = document.getElementById('scheduledAtRad');
      if (ivSchedInput) ivSchedInput.value = defaultNow;
      if (mealSchedInput) mealSchedInput.value = defaultNow;
      if (radSchedInput) radSchedInput.value = defaultNow;

      const form = document.getElementById('articlePostForm');
      if (form) {
        form.addEventListener('submit', (e) => {
          e.preventDefault();
          handleCarteAndStagedOrdersSubmit(e);
        });
      }

      // 仮置きオーダーおよびカルテ下書きの初期復元
      loadStagedOrdersFromStorage();
      loadCarteDraftFromStorage();

      // 職種フィルターの初期値を自分の職種にセット＆フィルタリング適用
      const deptSelect = document.getElementById('leftDeptFilterSelect');
      if (deptSelect && currentSelectedDeptFilter) {
        deptSelect.value = currentSelectedDeptFilter;
      }
      applyArticleFilters();

      const urlParams = new URLSearchParams(window.location.search);
      const targetId = urlParams.get('targetId');
      const orderParam = urlParams.get('order');

      // オーダー種別パラメータに応じた自動スイッチ
      if (orderParam) {
        const catSelect = document.getElementById('formCategorySelect');
        if (orderParam === 'radiology' || orderParam === 'rad') {
          if (catSelect) catSelect.value = '🩻 放射線科オーダー';
          onCategoryChange('🩻 放射線科オーダー');
          filterArticlesByCat('RAD');
        } else if (orderParam === 'iv' || orderParam === 'injection') {
          if (catSelect) catSelect.value = '💉 点滴指示オーダー';
          onCategoryChange('💉 点滴指示オーダー');
          filterArticlesByCat('IV');
        } else if (orderParam === 'meal') {
          if (catSelect) catSelect.value = '🍱 食事選択オーダー';
          onCategoryChange('🍱 食事選択オーダー');
          filterArticlesByCat('MEAL');
        }
      }

      if (targetId) {
        const filterSelect = document.getElementById('headerTargetFilter');
        if (filterSelect) {
          filterSelect.value = targetId;
          filterArticlesByTarget(targetId);
        }
        
        // 最下部の入力欄にスクロールしてフォーカスを当てる
        setTimeout(() => {
          const input = document.getElementById('articleContentInput');
          if (input) {
            input.scrollIntoView({ behavior: 'smooth', block: 'center' });
            input.focus();
          }
        }, 150);
      }
      
      // ページ読み込み完了時に左側タイムラインを一番下（最新記事）へ自動スクロール
      scrollToLatestArticle();
    });

    function focusInput(e) {
      e.preventDefault();
      const input = document.getElementById('articleContentInput');
      if (input) {
        input.scrollIntoView({ behavior: 'smooth', block: 'center' });
        input.focus();
      }
    }

    // 🔏 PGP詳細モーダルを開く
    async function openPgpModal(articleId) {
      const modal = document.getElementById('pgpDetailModal');
      const body = document.getElementById('pgpModalBody');
      modal.style.display = 'flex';
      body.innerHTML = '<div style="text-align:center; padding:2rem 0; color:#64748b;">⏳ PGP電子署名を暗号学的に検証中...</div>';

      try {
        const res = await fetch(`/api/articles/${articleId}/verify-pgp`);
        const data = await res.json();

        if (!data.success) {
          body.innerHTML = `<div style="padding:1rem; background:#fee2e2; color:#b91c1c; border-radius:6px;">❌ エラー: ${data.message}</div>`;
          return;
        }

        const isValid = data.isValid;
        const isTampered = data.tampered;
        const statusBadge = isValid
          ? '<div style="background:#ecfdf5; border:1px solid #6ee7b7; color:#065f46; padding:0.75rem; border-radius:8px; font-weight:bold; display:flex; align-items:center; gap:0.5rem; margin-bottom:0.75rem;"><span style="font-size:1.3rem;">✅</span> <div><div style="font-size:0.95rem;">真正性確認済み (Authentic & Intact)</div><div style="font-size:0.78rem; font-weight:normal; color:#047857; margin-top:2px;">作成時のRSA署名と現在のデータが完全一致しています。改ざんは検出されませんでした。</div></div></div>'
          : isTampered
            ? '<div style="background:#fef2f2; border:1px solid #f87171; color:#991b1b; padding:0.75rem; border-radius:8px; font-weight:bold; display:flex; align-items:center; gap:0.5rem; margin-bottom:0.75rem;"><span style="font-size:1.3rem;">⚠️</span> <div><div style="font-size:0.95rem;">改ざん検知 (Signature Mismatch)</div><div style="font-size:0.78rem; font-weight:normal; color:#b91c1c; margin-top:2px;">現在のデータと署名時データに不一致があります！データベースまたは本文が直接書き換えられた可能性があります。</div></div></div>'
            : '<div style="background:#f8fafc; border:1px solid #cbd5e1; color:#475569; padding:0.75rem; border-radius:8px; font-weight:bold; margin-bottom:0.75rem;">🔏 未署名データです。</div>';

        body.innerHTML = `
          ${statusBadge}
          <div class="pgp-info-grid">
            <span class="pgp-info-label">署名ステータス:</span>
            <span class="pgp-info-value" style="font-weight:bold; color:${isValid ? '#059669' : '#dc2626'};">${isValid ? '✅ 有効 (Valid Signature)' : '❌ 無効・不一致 (Invalid)'}</span>

            <span class="pgp-info-label">署名者:</span>
            <span class="pgp-info-value">${data.signedBy || '不明'} [${data.signerRole || '職種未設定'}]</span>
            ${(data.isOverride || data.proxyBy) ? `
              <span class="pgp-info-label" style="color:#2563eb;">代行入力者:</span>
              <span class="pgp-info-value" style="color:#1d4ed8; font-weight:bold;">🔄 ${escapeHtml(data.proxyBy || '代行入力')}</span>
            ` : ''}

            <span class="pgp-info-label">署名日時:</span>
            <span class="pgp-info-value">📅 ${data.signedAt ? new Date(data.signedAt).toLocaleString('ja-JP') : '記録なし'}</span>

            <span class="pgp-info-label">署名Key ID:</span>
            <span class="pgp-info-value" style="font-family:monospace; color:#0284c7; font-weight:bold;">${data.keyId || 'なし'}</span>

            <span class="pgp-info-label">フィンガープリント:</span>
            <span class="pgp-info-value" style="font-family:monospace; font-size:0.78rem;">${data.fingerprint || 'なし'}</span>

            <span class="pgp-info-label">暗号アルゴリズム:</span>
            <span class="pgp-info-value">${data.algorithm || 'RSA-SHA256 (OpenPGP Armor)'}</span>
          </div>

          <div style="margin-top:0.75rem;">
            <div style="display:flex; justify-content:space-between; align-items:center;">
              <label style="font-size:0.8rem; font-weight:bold; color:#334155;">🔏 OpenPGP ASCII Armor 署名ブロック:</label>
              <button type="button" onclick="copyPgpCode('pgpArmorCode')" style="background:#f1f5f9; border:1px solid #cbd5e1; border-radius:4px; padding:0.15rem 0.45rem; font-size:0.72rem; cursor:pointer; font-weight:600;">📋 署名をコピー</button>
            </div>
            <pre id="pgpArmorCode" class="pgp-code-block" style="max-height:130px;">${data.armorSignature || '署名なし'}</pre>
          </div>

          <div style="margin-top:0.6rem;">
            <div style="display:flex; justify-content:space-between; align-items:center;">
              <label style="font-size:0.8rem; font-weight:bold; color:#334155;">📄 署名対象カノニカルデータ (Canonical Signed Payload):</label>
              <button type="button" onclick="copyPgpCode('pgpPayloadCode')" style="background:#f1f5f9; border:1px solid #cbd5e1; border-radius:4px; padding:0.15rem 0.45rem; font-size:0.72rem; cursor:pointer; font-weight:600;">📋 データをコピー</button>
            </div>
            <pre id="pgpPayloadCode" class="pgp-code-block" style="max-height:110px; color:#a5f3fc;">${data.signedPayload || data.currentPayload || 'なし'}</pre>
          </div>

          <div style="display:flex; justify-content:space-between; align-items:center; margin-top:1rem; padding-top:0.75rem; border-top:1px solid #e2e8f0;">
            <button type="button" onclick="openPgpModal('${articleId}')" style="background:#f8fafc; border:1px solid #cbd5e1; padding:0.35rem 0.8rem; border-radius:6px; font-size:0.8rem; cursor:pointer; font-weight:600;">⚡ 再検証実行</button>
            <button type="button" onclick="closePgpModal()" style="background:#0f172a; color:white; border:none; padding:0.4rem 1.2rem; border-radius:6px; font-size:0.85rem; cursor:pointer; font-weight:bold;">閉じる</button>
          </div>
        `;
      } catch (err) {
        body.innerHTML = `<div style="padding:1rem; background:#fee2e2; color:#b91c1c; border-radius:6px;">❌ 検証通信失敗: ${err.message}</div>`;
      }
    }

    function closePgpModal(e) {
      if (!e || e.target === document.getElementById('pgpDetailModal') || (e.target && e.target.classList && e.target.classList.contains('pgp-modal-close'))) {
        document.getElementById('pgpDetailModal').style.display = 'none';
      }
    }

    // 🔑 システム公開鍵モーダルを開く
    async function showSystemPublicKeyModal() {
      const modal = document.getElementById('pgpPublicKeyModal');
      const pre = document.getElementById('publicKeyPre');
      modal.style.display = 'flex';
      pre.textContent = '公開鍵を取得中...';

      try {
        const res = await fetch('/api/pgp/public-key');
        const text = await res.text();
        pre.textContent = text;
      } catch (err) {
        pre.textContent = '公開鍵取得エラー: ' + err.message;
      }
    }

    function closePublicKeyModal(e) {
      if (!e || e.target === document.getElementById('pgpPublicKeyModal') || (e.target && e.target.classList && e.target.classList.contains('pgp-modal-close'))) {
        document.getElementById('pgpPublicKeyModal').style.display = 'none';
      }
    }

    function copyPgpCode(elementId) {
      const el = document.getElementById(elementId);
      if (el) {
        navigator.clipboard.writeText(el.textContent).then(() => {
          alert('📋 クリップボードにコピーしました。');
        }).catch(err => {
          alert('コピーに失敗しました: ' + err.message);
        });
      }
    }

    function copyPublicKeyText() {
      copyPgpCode('publicKeyPre');
    }

    // 🔏 全記事PGP一括検証
    async function verifyAllArticlesPgp() {
      try {
        const res = await fetch('/api/articles-verify-all-pgp');
        const data = await res.json();

        if (!data.success) {
          alert('❌ 一括検証エラー: ' + data.message);
          return;
        }

        const { total, validCount, tamperedCount, unsignedCount } = data.summary;
        let msg = `【🔏 PGP電子署名 一括改ざん検証結果】\n\n`;
        msg += `・全記事総数: ${total} 件\n`;
        msg += `・✅ 真正保証 (正常): ${validCount} 件\n`;
        msg += `・⚠️ 改ざん検知 (不一致): ${tamperedCount} 件\n`;
        msg += `・ℹ️ 未署名: ${unsignedCount} 件\n\n`;

        if (tamperedCount === 0) {
          msg += `🎉 すべての署名付き記事の完全性が確認されました。改ざんは検出されていません。`;
        } else {
          msg += `⚠️ ${tamperedCount} 件の記事で署名とデータの不一致が検知されました！タイムライン上の赤色バッジを確認してください。`;
        }

        alert(msg);
      } catch (err) {
        alert('❌ 検証リクエストに失敗しました: ' + err.message);
      }
    }

    // ⚙️ 歯車印メニューの開閉制御
    (function initGearMenu() {
      const gearBtn = document.getElementById('gearMenuBtn');
      const gearDropdown = document.getElementById('gearDropdown');
      const gearCloseBtn = document.getElementById('gearCloseBtn');

      if (!gearBtn || !gearDropdown) return;

      function toggleGearMenu(e) {
        if (e) e.stopPropagation();
        const isOpen = gearDropdown.classList.toggle('show');
        gearBtn.classList.toggle('active', isOpen);
        gearBtn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
      }

      function closeGearMenu() {
        gearDropdown.classList.remove('show');
        gearBtn.classList.remove('active');
        gearBtn.setAttribute('aria-expanded', 'false');
      }

      gearBtn.addEventListener('click', toggleGearMenu);
      if (gearCloseBtn) {
        gearCloseBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          closeGearMenu();
        });
      }

      document.addEventListener('click', (e) => {
        if (!gearDropdown.contains(e.target) && !gearBtn.contains(e.target)) {
          closeGearMenu();
        }
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && gearDropdown.classList.contains('show')) {
          closeGearMenu();
        }
      });
    })();
  </script>

  <!-- 🔏 PGP電子署名・改ざん検証詳細モーダル -->
  <div id="pgpDetailModal" class="pgp-modal-overlay" onclick="closePgpModal(event)">
    <div class="pgp-modal-content" onclick="event.stopPropagation()">
      <div class="pgp-modal-header">
        <h3>🔏 PGP改ざん防止・真正性検証ログ</h3>
        <button type="button" class="pgp-modal-close" onclick="closePgpModal()">&times;</button>
      </div>
      <div class="pgp-modal-body" id="pgpModalBody">
        <div style="text-align:center; padding:1.5rem 0; color:#64748b;">
          ⏳ 署名データを検証中...
        </div>
      </div>
    </div>
  </div>

  <!-- 🔑 システムPGP公開鍵モーダル -->
  <div id="pgpPublicKeyModal" class="pgp-modal-overlay" onclick="closePublicKeyModal(event)">
    <div class="pgp-modal-content" onclick="event.stopPropagation()">
      <div class="pgp-modal-header">
        <h3>🔑 システムPGP公開鍵ブロック (Public Key Block)</h3>
        <button type="button" class="pgp-modal-close" onclick="closePublicKeyModal()">&times;</button>
      </div>
      <div class="pgp-modal-body">
        <p style="margin:0 0 0.5rem 0; font-size:0.84rem; color:#475569;">
          この記事システムで発行されるすべての電子署名の真正性を検証するための公開鍵です。OpenPGP / GnuPG 互換クライアント等にインポートして独立検証も可能です。
        </p>
        <div style="display:flex; justify-content:flex-end; margin-bottom:0.4rem;">
          <button type="button" onclick="copyPublicKeyText()" style="background:#0284c7; color:white; border:none; padding:0.25rem 0.6rem; border-radius:4px; font-size:0.75rem; cursor:pointer; font-weight:bold;">📋 公開鍵をコピー</button>
        </div>
        <pre id="publicKeyPre" class="pgp-code-block" style="max-height:280px;">公開鍵を読み込み中...</pre>
      </div>
    </div>
  </div>

  <!-- 📝 右メニュー選択要素の独自記事クイック作成モーダル -->
  <div id="quickArticleModal" class="pgp-modal-overlay" style="display:none;" onclick="closeQuickArticleModal(event)">
    <div class="pgp-modal-content" onclick="event.stopPropagation()" style="max-width:540px; width:95%; border-radius:8px; overflow:hidden; box-shadow:0 10px 30px rgba(0,0,0,0.25);">
      <div class="pgp-modal-header" style="background:#0f172a; color:white; padding:0.6rem 0.9rem; display:flex; justify-content:space-between; align-items:center;">
        <h3 id="quickModalHeaderTitle" style="margin:0; font-size:0.95rem; color:white; display:flex; align-items:center; gap:0.4rem;">
          <span>📝</span> 独自記事として作成・保存
        </h3>
        <button type="button" class="pgp-modal-close" onclick="closeQuickArticleModal()" style="color:white; background:none; border:none; font-size:1.3rem; cursor:pointer;">&times;</button>
      </div>
      <div class="pgp-modal-body" style="padding:0.9rem 1rem; background:#ffffff;">
        <form id="quickArticleForm" onsubmit="submitQuickArticle(event)">
          <!-- 対象者選択 -->
          <div style="margin-bottom:0.6rem;">
            <label style="display:block; font-size:0.78rem; font-weight:bold; color:#475569; margin-bottom:0.2rem;">対象者 (患者):</label>
            <select id="quickModalTargetPerson" class="form-control" style="width:100%; font-size:0.82rem; padding:0.35rem 0.5rem;" onchange="updateQuickModalParentOptions(this.value, null)" required>
              <% if (targetPeople && targetPeople.length > 0) { %>
                <% targetPeople.forEach(t => { %>
                  <option value="<%= t._id %>"><%= t.customId %>: <%= t.name %> (<%= t.department || '一般' %>)</option>
                <% }); %>
              <% } %>
            </select>
          </div>

          <!-- 記事区分・カテゴリ & タイトル -->
          <div style="display:grid; grid-template-columns: 140px 1fr; gap:0.5rem; margin-bottom:0.6rem;">
            <div>
              <label style="display:block; font-size:0.78rem; font-weight:bold; color:#475569; margin-bottom:0.2rem;">記事カテゴリ:</label>
              <input type="text" id="quickModalCategory" class="form-control" style="font-size:0.82rem; padding:0.35rem 0.5rem; font-weight:bold; color:#0284c7;" required>
            </div>
            <div>
              <label style="display:block; font-size:0.78rem; font-weight:bold; color:#475569; margin-bottom:0.2rem;">記事タイトル:</label>
              <input type="text" id="quickModalTitle" class="form-control" style="font-size:0.82rem; padding:0.35rem 0.5rem; font-weight:bold;" required>
            </div>
          </div>

          <!-- 記事本文 -->
          <div style="margin-bottom:0.6rem;">
            <label style="display:block; font-size:0.78rem; font-weight:bold; color:#475569; margin-bottom:0.2rem;">記事内容 (記録本文):</label>
            <textarea id="quickModalContent" class="form-control" rows="5" style="width:100%; font-size:0.85rem; line-height:1.5; padding:0.4rem 0.5rem; box-sizing:border-box; font-family:inherit;" required></textarea>
          </div>

          <!-- 親記事へのぶら下げ (初期値: OFF、ユーザーが明示的にチェックした場合のみ親カルテ選択を展開) -->
          <div id="quickModalParentWrap" style="margin-bottom:0.8rem; background:#f8fafc; border:1px solid #cbd5e1; padding:0.55rem 0.75rem; border-radius:6px; font-size:0.78rem; color:#334155; transition:all 0.2s ease;">
            <div style="display:flex; align-items:center; gap:0.5rem;">
              <input type="checkbox" id="quickModalAttachToParent" style="cursor:pointer; width:16px; height:16px;" onchange="handleParentCheckboxChange(this.checked)">
              <label id="quickModalAttachToParentLabel" for="quickModalAttachToParent" style="cursor:pointer; user-select:none; font-weight:bold; color:#1e293b;">
                親カルテにぶら下げる (カルテへの追記・引用ツリーとして作成)
              </label>
            </div>
            <!-- 親カルテ選択ドロップダウン (チェックON時のみ表示) -->
            <div id="quickModalParentSelectContainer" style="display:none; margin-top:0.5rem; padding-top:0.5rem; border-top:1px dashed #cbd5e1;">
              <label style="display:block; font-size:0.74rem; font-weight:bold; color:#475569; margin-bottom:0.25rem;">
                ぶら下げ先となる親カルテ記事を選択:
              </label>
              <select id="quickModalParentArticleSelect" class="form-control" style="width:100%; font-size:0.78rem; padding:0.35rem 0.5rem; background:#ffffff; color:#0f172a; border:1px solid #94a3b8; border-radius:4px;">
                <!-- JavaScriptで動的生成 -->
              </select>
              <div id="quickModalParentNotice" style="font-size:0.7rem; color:#64748b; margin-top:0.3rem;">
                ※選択した親カルテの下にツリー形式（↳ 追記）でぶら下げて作成されます。
              </div>
            </div>
          </div>


          <!-- フッターボタン -->
          <div style="display:flex; justify-content:space-between; align-items:center; border-top:1px solid #e2e8f0; padding-top:0.75rem;">
            <button type="button" onclick="closeQuickArticleModal()" style="background:#f1f5f9; border:1px solid #cbd5e1; color:#475569; padding:0.35rem 0.8rem; border-radius:4px; font-size:0.8rem; cursor:pointer;">キャンセル</button>
            <button type="submit" id="quickModalSubmitBtn" style="background:#0284c7; color:white; border:none; padding:0.4rem 1.2rem; border-radius:4px; font-size:0.84rem; font-weight:bold; cursor:pointer; box-shadow:0 2px 4px rgba(2,132,199,0.3);">
              💾 独自記事として保存・投稿
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- 🔐 入力者切り替え・パスワード認証 & モード選択モーダル -->
  <div id="switchAuthorModal" class="pgp-modal-overlay" style="display:none;" onclick="cancelSwitchAuthorModal(event)">
    <div class="pgp-modal-content" onclick="event.stopPropagation()" style="max-width:480px; width:95%; border-radius:8px; overflow:hidden; box-shadow:0 12px 32px rgba(0,0,0,0.3); border:1px solid #cbd5e1;">
      <div class="pgp-modal-header" style="background:#0f172a; color:white; padding:0.65rem 1rem; display:flex; justify-content:space-between; align-items:center;">
        <h3 style="margin:0; font-size:0.95rem; color:white; display:flex; align-items:center; gap:0.4rem;">
          <span>🔐</span> <strong>入力者切り替えの認証</strong>
        </h3>
        <button type="button" class="pgp-modal-close" onclick="cancelSwitchAuthorModal()" style="color:white; background:none; border:none; font-size:1.3rem; cursor:pointer;">&times;</button>
      </div>
      <div class="pgp-modal-body" style="padding:1rem 1.2rem; background:#ffffff;">
        <form id="switchAuthorForm" onsubmit="handleSwitchAuthorSubmit(event)">
          <input type="hidden" id="switchTargetAuthorId" value="">
          
          <!-- 切り替え先ユーザー情報バッジ -->
          <div style="background:#f8fafc; border:1px solid #e2e8f0; border-radius:6px; padding:0.6rem 0.8rem; margin-bottom:0.9rem; display:flex; align-items:center; justify-content:space-between;">
            <div>
              <div style="font-size:0.72rem; color:#64748b; font-weight:bold;">切り替え先担当者</div>
              <div style="font-size:1rem; font-weight:bold; color:#0f172a; margin-top:0.1rem;" id="switchTargetAuthorName">-</div>
            </div>
            <div style="text-align:right;">
              <span id="switchTargetAuthorDept" style="background:#e0f2fe; color:#0369a1; font-size:0.75rem; font-weight:bold; padding:0.15rem 0.5rem; border-radius:4px; border:1px solid #bae6fd;">-</span>
              <div id="switchTargetAuthorLoginId" style="font-size:0.72rem; color:#94a3b8; margin-top:0.2rem;">ID: -</div>
            </div>
          </div>

          <!-- 切り替えモード選択（ラジオボタン） -->
          <div style="margin-bottom:1rem;">
            <label style="display:block; font-size:0.8rem; font-weight:bold; color:#334155; margin-bottom:0.4rem;">切り替え方法を選択してください:</label>
            
            <div style="display:flex; flex-direction:column; gap:0.5rem;">
              <!-- 選択肢1: 一時的オーバーライド -->
              <label style="display:flex; align-items:flex-start; gap:0.5rem; background:#f0fdf4; border:1.5px solid #86efac; border-radius:6px; padding:0.6rem 0.75rem; cursor:pointer;">
                <input type="radio" name="switchMode" value="override" checked style="margin-top:0.2rem; cursor:pointer;">
                <div>
                  <div style="font-size:0.85rem; font-weight:bold; color:#166534; display:flex; align-items:center; gap:0.3rem;">
                    <span>🔄 一時的オーバーライド (代行入力モード)</span>
                    <span style="font-size:0.68rem; background:#dcfce7; color:#15803d; padding:0.05rem 0.35rem; border-radius:3px; border:1px solid #bbf7d0;">推奨</span>
                  </div>
                  <div style="font-size:0.74rem; color:#475569; margin-top:0.2rem; line-height:1.4;">
                    現在のログインセッションを維持したまま、今回のカルテ・オーダーの記録者名義のみ一時的に切り替えます。画面上部のボタンからいつでも元の担当者に復帰できます。
                  </div>
                </div>
              </label>

              <!-- 選択肢2: 完全切り替え -->
              <label style="display:flex; align-items:flex-start; gap:0.5rem; background:#f8fafc; border:1.5px solid #cbd5e1; border-radius:6px; padding:0.6rem 0.75rem; cursor:pointer;">
                <input type="radio" name="switchMode" value="complete" style="margin-top:0.2rem; cursor:pointer;">
                <div>
                  <div style="font-size:0.85rem; font-weight:bold; color:#1e293b;">
                    <span>👤 完全切り替え (担当者交代モード)</span>
                  </div>
                  <div style="font-size:0.74rem; color:#475569; margin-top:0.2rem; line-height:1.4;">
                    端末のログインセッション自体を完全に切り替え先ユーザーに交代します。以降のすべての操作が切り替え先ユーザーとして記録されます。
                  </div>
                </div>
              </label>
            </div>
          </div>

          <!-- パスワード入力 -->
          <div style="margin-bottom:1rem;">
            <label for="switchAuthorPassword" style="display:block; font-size:0.8rem; font-weight:bold; color:#334155; margin-bottom:0.25rem;">
              切り替え先ユーザーのパスワード: <span style="color:#ef4444;">*</span>
            </label>
            <input type="password" id="switchAuthorPassword" class="form-control" style="width:100%; font-size:0.88rem; padding:0.45rem 0.6rem; border:1px solid #94a3b8; border-radius:4px; box-sizing:border-box;" placeholder="パスワードを入力してください" required autocomplete="current-password">
            <div id="switchAuthorError" style="display:none; color:#ef4444; font-size:0.76rem; font-weight:bold; margin-top:0.35rem;"></div>
          </div>

          <!-- フッターボタン -->
          <div style="display:flex; justify-content:flex-end; gap:0.6rem; border-top:1px solid #e2e8f0; padding-top:0.8rem;">
            <button type="button" onclick="cancelSwitchAuthorModal()" style="background:#f1f5f9; border:1px solid #cbd5e1; color:#475569; padding:0.4rem 0.9rem; border-radius:4px; font-size:0.82rem; cursor:pointer;">
              キャンセル
            </button>
            <button type="submit" id="switchAuthorSubmitBtn" style="background:#0284c7; color:white; border:none; padding:0.4rem 1.2rem; border-radius:4px; font-size:0.84rem; font-weight:bold; cursor:pointer; box-shadow:0 2px 4px rgba(2,132,199,0.3); display:flex; align-items:center; gap:0.3rem;">
              <span>🔑 認証して切り替える</span>
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- 🔔 トースト通知コンテナ -->
  <div id="toastNotification" style="display:none; position:fixed; bottom:24px; right:24px; background:#0f172a; color:#ffffff; padding:0.75rem 1.25rem; border-radius:8px; box-shadow:0 6px 20px rgba(0,0,0,0.3); z-index:9999; font-size:0.85rem; font-weight:bold; align-items:center; gap:0.5rem; transition:all 0.3s ease;">
    <span id="toastMessage"></span>
  </div>
</body>
</html>
