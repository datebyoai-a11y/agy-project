<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <title>対象者の追加</title>
</head>
<body>
    <h1>🎯 対象者の追加</h1>

    <% if (error) { %>
        <p style="color:red;"><%= error %></p>
    <% } %>

    <form action="/add-target" method="POST">
        <label>氏名：</label><br>
        <input type="text" name="name" required><br><br>

        <label>ID：</label><br>
        <input type="text" name="targetId" required><br><br>

        <button type="submit">登録する</button>
    </form>

    <br>
    <a href="/dashboard">← ダッシュボードへ戻る</a>
</body>
</html>

