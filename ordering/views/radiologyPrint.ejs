<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <title><%= order.formName %> (<%= order.orderNumber %>)</title>
  <style>
    @page { size: A4 portrait; margin: 10mm; }
    * { box-sizing: border-box; }
    body { margin: 0; font-family: "Noto Sans JP", "Yu Gothic", sans-serif; font-size: 11px; color: #000; background: #eee; }
    .no-print { padding: 6px 12px; background: #15314b; color: #fff; display: flex; justify-content: space-between; align-items: center; }
    .no-print button { padding: 4px 12px; font-weight: 700; cursor: pointer; }
    .sheet { width: 190mm; margin: 8mm auto; background: #fff; padding: 6mm; display: flex; flex-direction: column; gap: 6mm; }
    .slip { border: 1.5px solid #000; }
    .bar { height: 10px; border-bottom: 1.5px solid #000; }
    .bar-CT { background: #facc15; }
    .bar-FLUORO { background: #0284c7; }
    .bar-XRAY { background: #16a34a; }
    .slip-head { display: flex; justify-content: space-between; align-items: center; padding: 4px 8px; border-bottom: 1px solid #000; }
    .slip-title { font-size: 15px; font-weight: 700; letter-spacing: 3px; }
    .copy-badge { border: 1.5px solid #000; padding: 1px 8px; font-weight: 700; font-size: 11px; }
    table { width: 100%; border-collapse: collapse; }
    th, td { border: 1px solid #000; padding: 3px 6px; vertical-align: top; }
    th { background: #f3f4f6; width: 18%; text-align: left; }
    .cut-line { border-top: 1px dashed #666; text-align: center; font-size: 9px; color: #555; padding-top: 2px; }
    @media print {
      body { background: #fff; }
      .no-print { display: none; }
      .sheet { margin: 0; padding: 0; width: 100%; }
    }
  </style>
</head>
<body>
  <div class="no-print">
    <span>伝票プレビュー（A4 正・控え2枚組）: <%= order.orderNumber %></span>
    <div>
      <button type="button" onclick="window.print()">印刷</button>
      <button type="button" onclick="window.close()">閉じる</button>
    </div>
  </div>

  <div class="sheet">
    <% ['【正】放射線科提出用', '【控え】病棟・外来保管用'].forEach((copyLabel, idx) => { %>
      <% if (idx === 1) { %><div class="cut-line">切り取り線</div><% } %>
      <div class="slip">
        <div class="bar bar-<%= order.formType %>"></div>
        <div class="slip-head">
          <span>オーダー番号: <strong><%= order.orderNumber %></strong></span>
          <span class="slip-title"><%= order.formName %></span>
          <span class="copy-badge"><%= copyLabel %></span>
        </div>
        <table>
          <tr>
            <th>患者ID / 氏名</th>
            <td><strong><%= order.patientId %></strong>　<%= order.patientName %>（<%= order.patientKana || '-' %>）</td>
            <th>生年月日 / 性 / 年齢</th>
            <td><%= order.birthDate || '-' %> / <%= order.gender %> / <%= order.age != null ? order.age + '歳' : '-' %></td>
          </tr>
          <tr>
            <th>区分・病室</th>
            <td><%= order.ward %> <%= order.room ? order.room + '号室' : '' %></td>
            <th>検査予定日時</th>
            <td><%= order.scheduledDate ? new Date(order.scheduledDate).toLocaleString('ja-JP', { hour12: false }) : '-' %></td>
          </tr>
          <tr>
            <th>依頼医師 / 科</th>
            <td><%= order.doctorName %>（<%= order.requestDepartment %>）</td>
            <th>移動 / 感染症</th>
            <td><%= order.mobility %> / 感染症: <%= order.infection %><%= order.isUrgent ? ' 【至急】' : '' %></td>
          </tr>
          <tr>
            <th>検査種別・部位</th>
            <td colspan="3">
              <strong><%= order.examType %></strong>
              <% if (order.partsDetail) { %>（<%= order.partsDetail %>）<% } %>
              <% if (order.isPortable) { %> 【病室ポータブル: <%= order.portableRoom || order.room || '病室' %>】<% } %>
              <% if (order.dynamicPhase) { %> [Dynamic: <%= order.dynamicPhase %>]<% } %>
            </td>
          </tr>
          <tr>
            <th>使用薬剤 / 材料</th>
            <td><%= order.medications || '-' %><%= order.materials ? ' / ' + order.materials : '' %></td>
            <th>撮影条件</th>
            <td>kV: <%= order.conditionKv || '-' %> / mA: <%= order.conditionMa || '-' %> / sec: <%= order.conditionSec || '-' %></td>
          </tr>
          <tr>
            <th>検査目的・所見</th>
            <td colspan="3"><%= order.purpose || '-' %></td>
          </tr>
          <tr>
            <th>備考 / 状態</th>
            <td colspan="3">
              <%= order.remarks || '-' %>
              <% if (order.isCancelled) { %> 【中止: <%= order.cancelReason %>】<% } %>
              <% if (order.isSuperseded) { %> 【訂正済 -> <%= order.supersededBy %>】<% } %>
              <% if (order.parentOrderNumber) { %> 【訂正元: <%= order.parentOrderNumber %>】<% } %>
            </td>
          </tr>
        </table>
      </div>
    <% }) %>
  </div>

  <% if (autoPrint) { %>
    <script>window.addEventListener('load', () => window.print());</script>
  <% } %>
</body>
</html>
