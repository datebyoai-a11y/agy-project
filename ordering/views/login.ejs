<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= statusBar.screenTitle %> | オーダリングシステム</title>
  <link rel="stylesheet" href="/css/common.css">
  <link rel="stylesheet" href="/css/login.css">
</head>
<body class="page-login">
  <%- include('partials/statusBar', { statusBar }) %>

  <main class="login-main">
    <section class="login-card" aria-label="ログイン入力フォーム">
      <% if (errorMessage) { %>
        <div class="login-alert" role="alert" data-testid="login-error">
          <%= errorMessage %>
        </div>
      <% } %>

      <form action="/login" method="POST" class="login-form" id="loginForm" novalidate>
        <div class="form-field">
          <label for="staffId" class="form-label">職員ID</label>
          <input
            type="text"
            id="staffId"
            name="staffId"
            class="form-input"
            value="<%= formValues.staffId %>"
            placeholder="例: doc01"
            autocomplete="username"
            required
            autofocus
          >
        </div>

        <div class="form-field">
          <label for="password" class="form-label">パスワード</label>
          <div class="password-input-wrap">
            <input
              type="password"
              id="password"
              name="password"
              class="form-input"
              placeholder="パスワードを入力"
              autocomplete="current-password"
              required
            >
            <button
              type="button"
              class="password-toggle-btn"
              id="togglePasswordBtn"
              aria-label="パスワードの表示切替"
              aria-pressed="false"
            >表示</button>
          </div>
        </div>

        <div class="form-field">
          <label for="departmentCode" class="form-label">ログイン先部署</label>
          <select id="departmentCode" name="departmentCode" class="form-select">
            <option value="" <%= !formValues.departmentCode ? 'selected' : '' %>>
              所属部署を自動選択（推奨）
            </option>
            <% departments.forEach((dept) => { %>
              <option
                value="<%= dept.code %>"
                <%= formValues.departmentCode === dept.code ? 'selected' : '' %>
              >
                <%= dept.name %>
              </option>
            <% }) %>
          </select>
          <p class="form-hint">複数部署を兼務する職種（医師・看護師など）はここで勤務先部署を選択できます。</p>
        </div>

        <div class="form-actions">
          <button type="submit" class="btn-primary login-submit-btn">ログイン</button>
        </div>
      </form>
    </section>

    <details class="demo-accounts">
      <summary class="demo-accounts__summary">
        初期アカウント一覧（クリックでID・パスワード入力 / 共通パスワード: pass）
      </summary>
      <div class="demo-accounts__body">
        <table class="demo-table">
          <thead>
            <tr>
              <th>職員ID</th>
              <th>氏名</th>
              <th>職種</th>
              <th>主所属部署</th>
              <th>操作</th>
            </tr>
          </thead>
          <tbody>
            <% demoAccounts.forEach((acc) => { %>
              <tr>
                <td><code><%= acc.staffId %></code></td>
                <td><%= acc.fullName %></td>
                <td><span class="role-badge"><%= acc.roleName %></span></td>
                <td><%= acc.defaultDepartmentName %></td>
                <td>
                  <button
                    type="button"
                    class="btn-quick-fill"
                    data-fill-staff-id="<%= acc.staffId %>"
                    data-fill-dept="<%= acc.defaultDepartmentCode %>"
                  >入力</button>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </details>
  </main>

  <script src="/js/statusBar.js"></script>
  <script src="/js/login.js"></script>
</body>
</html>
