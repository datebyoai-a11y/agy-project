            <label style="cursor:pointer; display:flex; align-items:center; gap:0.25rem;" title="既存の記載を残して末尾に追記します（複数薬剤の混注に便利）">
              <input type="radio" name="modalInsertMode" value="append" checked>
              <span>追記（混注・追加）</span>
            </label>
            <label style="cursor:pointer; display:flex; align-items:center; gap:0.25rem;" title="既存の記載を置き換えます">
              <input type="radio" name="modalInsertMode" value="overwrite">
              <span>上書き</span>
