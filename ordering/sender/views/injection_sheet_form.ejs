  </div>

  <!-- 💊 薬剤マスタ インクリメンタル検索モーダル -->
  <div class="med-search-overlay no-print" id="medSearchModal" onclick="closeMedSearchModal(event)">
    <div class="med-search-box" onclick="event.stopPropagation()">
      <!-- モーダルヘッダー -->
      <div class="med-search-header">
        <div style="display:flex; align-items:center; gap:0.75rem;">
          <span style="font-weight:bold; font-size:1.05rem;">🔍 薬品検索 (インクリメンタルサーチ)</span>
          <div style="display:flex; align-items:center; gap:0.4rem; background:rgba(255,255,255,0.15); padding:0.2rem 0.5rem; border-radius:4px; font-size:0.8rem;">
            <span>反映先処方枠:</span>
            <select id="modalTargetRowSelect" onchange="onModalTargetRowChange(this.value)" style="background:#1e293b; color:white; border:1px solid #64748b; border-radius:3px; padding:1px 4px; font-weight:bold; font-size:0.82rem;">
              <% for(let r = 1; r <= 10; r++) { %>
                <option value="<%= r %>">No. <%= r %></option>
