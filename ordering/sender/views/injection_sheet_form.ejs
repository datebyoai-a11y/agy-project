    }

    function onModalKeywordInput(val) {
      const clearBtn = document.getElementById('modalKeywordClearBtn');
      if (clearBtn) clearBtn.style.display = val ? 'block' : 'none';
      performModalSearch(val);
    }

    function normSearchText(str) {
      if (!str) return '';
      return String(str)
        .toLowerCase()
        .replace(/[ぁ-ん]/g, s => String.fromCharCode(s.charCodeAt(0) + 0x60))
        .replace(/[Ａ-Ｚａ-ｚ０-９]/g, s => String.fromCharCode(s.charCodeAt(0) - 0xFEE0))
        .replace(/[\s　・－ー]/g, '');
    }

    // 超高速インクリメンタル検索処理 (メモリ上キャッシュからミリ秒検索)
    function performModalSearch(keyword) {
      const q = normSearchText(keyword.trim());
      modalActiveIndex = -1;

      // 注射指示箋なので注射薬のみに限定
      let list = cachedMedicines.filter(m => m.category === '注射剤' || (m.category && m.category.includes('注射')));

      if (q) {
        const matches = [];
        for (const m of list) {
          const nameNorm = normSearchText(m.name);
          const kanaNorm = normSearchText(m.kana);
          const genNorm = normSearchText(m.genericName);
          const idNorm = normSearchText(m.id);
          const specNorm = normSearchText(m.spec);

          let score = 0;
          if (nameNorm.startsWith(q) || kanaNorm.startsWith(q)) {
            score += 100;
          } else if (nameNorm.includes(q) || kanaNorm.includes(q)) {
            score += 60;
          } else if (genNorm.includes(q)) {
            score += 40;
          } else if (specNorm.includes(q) || idNorm.includes(q)) {
            score += 20;
          }

          if (score > 0) {
            matches.push({ medicine: m, score });
          }
        }
        matches.sort((a, b) => b.score - a.score);
        modalFilteredMedicines = matches.map(x => x.medicine);
      } else {
        // キーワードが空の場合は注射薬全件
        modalFilteredMedicines = list.slice();
      }

      renderModalSearchResults();
    }

    function renderModalSearchResults() {
      const tbody = document.getElementById('medSearchResultList');
      const countEl = document.getElementById('modalResultCountText');
      if (!tbody) return;

      const total = modalFilteredMedicines.length;
      if (countEl) {
        countEl.textContent = `該当: ${total}品目 (注射薬限定)`;
      }

      if (total === 0) {
        tbody.innerHTML = `
          <tr>
            <td colspan="6" style="text-align:center; padding:2.5rem; color:#64748b;">
              該当する注射薬が見つかりませんでした。別のキーワードをお試しください。
            </td>
          </tr>
        `;
        return;
      }

      // 上位100件まで描画（DOM軽量化）
      const displayItems = modalFilteredMedicines.slice(0, 100);
      tbody.innerHTML = displayItems.map((m, idx) => {
        const rowId = `modal_tr_${idx}`;
        const escapedId = escapeHtml(m.id);

        return `
          <tr id="${rowId}" class="med-modal-tr ${idx === modalActiveIndex ? 'active-row' : ''}"
              onmouseenter="onModalTrMouseEnter(this, '${escapedId}')"
              onmouseleave="onModalTrMouseLeave()"
              onclick="insertMedicineToTargetRow('${escapedId}')"
              title="クリックして No.${activeRowIndex} に反映（ホバーで用法・詳細確認）">
            <td><span class="badge-cat badge-iv">💉 注射</span></td>
            <td>
              <div style="font-weight:bold; color:#0f172a; font-size:0.88rem;">${escapeHtml(m.name)}</div>
              ${m.kana ? `<div style="font-size:0.72rem; color:#64748b;">${escapeHtml(m.kana)}</div>` : ''}
            </td>
            <td style="color:#0369a1; font-weight:bold;">${escapeHtml(m.spec || m.unit || '―')}</td>
            <td style="color:#334155; font-size:0.78rem;">${escapeHtml(m.genericName || '―')}</td>
            <td style="color:#475569; font-size:0.78rem;">
              <span style="color:#0284c7; font-weight:bold;">ℹ️ ホバーで用法表示</span>
            </td>
            <td style="text-align:center;">
              <button type="button" class="med-btn-insert" onclick="event.stopPropagation(); insertMedicineToTargetRow('${escapedId}')">
                反映 ＋
              </button>
            </td>
          </tr>
        `;
      }).join('');
    }

    // 上下キー＆Enterキーでの操作
    function onModalInputKeydown(e) {
      if (modalFilteredMedicines.length === 0) return;

      if (e.key === 'ArrowDown') {
        e.preventDefault();
        const max = Math.min(modalFilteredMedicines.length, 100) - 1;
        modalActiveIndex = Math.min(modalActiveIndex + 1, max);
        updateActiveModalRow();
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        modalActiveIndex = Math.max(modalActiveIndex - 1, 0);
        updateActiveModalRow();
      } else if (e.key === 'Enter') {
        e.preventDefault();
        const targetIdx = modalActiveIndex >= 0 ? modalActiveIndex : 0;
        if (modalFilteredMedicines[targetIdx]) {
          insertMedicineToTargetRow(modalFilteredMedicines[targetIdx].id);
        }
      }
    }

    function updateActiveModalRow() {
      document.querySelectorAll('.med-modal-tr').forEach((tr, i) => {
        if (i === modalActiveIndex) {
          tr.classList.add('active-row');
          tr.scrollIntoView({ block: 'nearest' });
        } else {
          tr.classList.remove('active-row');
        }
      });
    }

    // 薬品を指示箋の対象行に反映（注意書き・用法は含めず薬品名と規格・単位のみ）
    function insertMedicineToTargetRow(medId) {
      const med = cachedMedicines.find(m => m.id === medId);
      if (!med) return;

      const targetRow = parseInt(document.getElementById('modalTargetRowSelect')?.value, 10) || activeRowIndex || 1;
      const textarea = document.getElementById(`rxText_${targetRow}`);
      if (!textarea) return;

      const insertMode = document.querySelector('input[name="modalInsertMode"]:checked')?.value || 'append';

      // 補完文字列の構築（注意書きは含めず薬品名と規格・単位のみ）
      const cleanSpec = (med.spec && !med.name.includes(med.spec)) ? ` ${med.spec}` : '';
      const cleanUnit = med.unit ? ` 1${med.unit}` : '';
      let insertText = `${med.name}${cleanSpec}${cleanUnit}`.trim();

      if (insertMode === 'append' && textarea.value.trim().length > 0) {
        textarea.value = textarea.value.trim() + '\n' + insertText;
      } else {
        textarea.value = insertText;
      }

      // 投与経路の自動判定・自動選択
      const medInfo = (med.name || '') + (med.dosage || '') + (med.standardUsage || '');
      if (medInfo.includes('輸液') || medInfo.includes('点滴') || medInfo.includes('DIV') || medInfo.includes('ブドウ糖') || medInfo.includes('ソルデム') || medInfo.includes('生食') || medInfo.includes('リンゲル')) {
        selectRoute(targetRow, 'DIV');
      } else if (medInfo.includes('静注') || medInfo.includes('iv') || medInfo.includes('ワンショット')) {
        selectRoute(targetRow, 'iv');
      } else if (medInfo.includes('皮下') || medInfo.includes('is')) {
        selectRoute(targetRow, 'is');
      } else if (medInfo.includes('筋注') || medInfo.includes('im')) {
        selectRoute(targetRow, 'im');
      } else if (!selectedRoutes[targetRow]) {
        selectRoute(targetRow, 'DIV'); // デフォルトDIV
      }

      // 行の薬品データ登録とホバーバッジ表示
      setRowMedicineData(targetRow, med);

      setLastAction(`薬品検索から No.${targetRow} に「${med.name}」を反映`);

      // トースト通知 & ステータスバー通知
      showToastNotice(`No.${targetRow} に「${med.name}」を反映しました`);

      // モーダルを閉じる
      closeMedSearchModal();
      hideHoverCard();
      textarea.focus();
    }

    function showToastNotice(msg) {
      setLatestNotice(msg, 'success');
      let toast = document.getElementById('sheetToastNotice');
      if (!toast) {
        toast = document.createElement('div');
        toast.id = 'sheetToastNotice';
        toast.style.cssText = 'position:fixed; bottom:46px; right:24px; background:#0f172a; color:#38bdf8; border:1.5px solid #0284c7; padding:0.65rem 1.25rem; border-radius:6px; font-size:0.85rem; font-weight:bold; box-shadow:0 10px 15px -3px rgba(0,0,0,0.3); z-index:10000; transition:opacity 0.2s;';
        document.body.appendChild(toast);
      }
      toast.textContent = msg;
      toast.style.display = 'block';
      toast.style.opacity = '1';
      setTimeout(() => {
        toast.style.opacity = '0';
        setTimeout(() => toast.style.display = 'none', 200);
      }, 2000);
    }

    function escapeHtml(str) {
      if (!str) return '';
      return String(str).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }

    // =========================================================
    // 10-B. 処方入力枠（キー入力）で自動発動するインクリメンタル検索
    // =========================================================
    let sfsActiveRow = null;
    let sfsResults = [];
    let sfsSelectedIndex = -1;

    function onSheetRxFocus(rowIdx, textarea, event) {
      activeRowIndex = rowIdx;
      hideHoverCard();
    }

    function onSheetRxInput(rowIdx, textarea, event) {
      activeRowIndex = rowIdx;
      sfsActiveRow = rowIdx;
      detectMedicinesInTextarea(rowIdx);

      const val = textarea.value;
      const cursorPos = textarea.selectionStart || val.length;
      const textBefore = val.slice(0, cursorPos);
      const lines = textBefore.split('\n');
      const currentLine = lines[lines.length - 1].trim();

      // 空文字の場合はパネルを閉じる
      if (!currentLine) {
        hideFloatingSearch();
        return;
      }

      // キャッシュデータからインクリメンタル検索（注射薬のみ抽出）
      const matches = searchFloatingMedicines(currentLine);
      if (matches.length === 0) {
        hideFloatingSearch();
        return;
      }

      showFloatingSearch(rowIdx, textarea, matches, currentLine);
    }

    function searchFloatingMedicines(keyword) {
      const q = normSearchText(keyword.trim());
      if (!q) return [];

      const matches = [];
      for (const m of cachedMedicines) {
        // 注射箋には候補は注射薬しか出さない
        const isIv = (m.category === '注射剤' || (m.category && m.category.includes('注射')));
        if (!isIv) continue;

        const nameNorm = normSearchText(m.name);
        const kanaNorm = normSearchText(m.kana);
        const genNorm = normSearchText(m.genericName);
        const specNorm = normSearchText(m.spec);

        let score = 0;
        if (nameNorm.startsWith(q) || kanaNorm.startsWith(q)) {
          score += 100;
        } else if (nameNorm.includes(q) || kanaNorm.includes(q)) {
          score += 60;
        } else if (genNorm.includes(q) || specNorm.includes(q)) {
          score += 30;
        }

        if (score > 0) {
          matches.push({ medicine: m, score });
        }
      }

      matches.sort((a, b) => b.score - a.score);
      return matches.slice(0, 8).map(x => x.medicine);
    }

    function showFloatingSearch(rowIdx, textarea, results, keyword) {
      const panel = document.getElementById('sheetFloatingSearch');
      const listEl = document.getElementById('sfsListContainer');
      const targetNoEl = document.getElementById('sfsTargetNo');
      if (!panel || !listEl) return;

      sfsResults = results;
      sfsSelectedIndex = 0;
      if (targetNoEl) targetNoEl.textContent = String(rowIdx);

      // 候補リストをレンダリング（見やすいクリアなゴシックデザイン & ホバー対応）
      listEl.innerHTML = results.map((m, idx) => {
        const specText = (m.spec && !m.name.includes(m.spec)) ? `<span class="sfs-spec">${escapeHtml(m.spec)}</span>` : '';
        const unitText = m.unit ? `<span class="sfs-spec">[1${escapeHtml(m.unit)}]</span>` : '';

        return `
          <div class="sfs-item ${idx === 0 ? 'active' : ''}"
               data-idx="${idx}"
               data-med-id="${escapeHtml(m.id)}"
               onmouseenter="onSfsItemMouseEnter(this, '${escapeHtml(m.id)}')"
               onmouseleave="onSfsItemMouseLeave()"
               onmousedown="applyFloatingMedicine(${rowIdx}, '${escapeHtml(m.id)}'); event.preventDefault();">
            <div>
              <div class="sfs-name">
                <span class="badge-cat badge-iv">💉 注射</span>
                <span>${escapeHtml(m.name)}</span>
                ${specText}
                ${unitText}
              </div>
              <div class="sfs-sub">
                ${m.genericName ? `成分: ${escapeHtml(m.genericName)} ` : ''}
                ${(m.standardUsage || m.dosage) ? `<span style="color:#0284c7; font-weight:600;">ℹ️ ホバーで用法表示</span>` : ''}
              </div>
            </div>
            <div class="sfs-action-btn">反映 ＋</div>
          </div>
        `;
      }).join('');

      // テキストエリアの位置から最適な配置座標を計算（画面外はみ出し防止）
      const rect = textarea.getBoundingClientRect();
      const panelWidth = 520;
      let left = rect.left;
      if (left + panelWidth > window.innerWidth - 10) {
        left = Math.max(10, window.innerWidth - panelWidth - 10);
      }

      const panelHeight = Math.min(results.length * 52 + 35, 300);
      let top = rect.bottom + 4;
      // 画面下端をはみ出す場合は上側に表示
      if (top + panelHeight > window.innerHeight - 10) {
        top = Math.max(10, rect.top - panelHeight - 4);
      }

      panel.style.left = `${left}px`;
      panel.style.top = `${top}px`;
      panel.style.display = 'flex';
    }

    function hideFloatingSearch() {
      const panel = document.getElementById('sheetFloatingSearch');
      if (panel) panel.style.display = 'none';
      sfsResults = [];
      sfsSelectedIndex = -1;
      hideHoverCard();
    }

    function onSheetRxKeydown(rowIdx, textarea, event) {
      const panel = document.getElementById('sheetFloatingSearch');
      if (!panel || panel.style.display === 'none' || sfsResults.length === 0) {
        return;
      }

      const items = panel.querySelectorAll('.sfs-item');
      if (items.length === 0) return;

      if (event.key === 'ArrowDown') {
        event.preventDefault();
        items[sfsSelectedIndex]?.classList.remove('active');
        sfsSelectedIndex = (sfsSelectedIndex + 1) % items.length;
        items[sfsSelectedIndex]?.classList.add('active');
        items[sfsSelectedIndex]?.scrollIntoView({ block: 'nearest' });
        if (sfsResults[sfsSelectedIndex] && items[sfsSelectedIndex]) {
          showHoverCardForElement(items[sfsSelectedIndex], sfsResults[sfsSelectedIndex]);
        }
      } else if (event.key === 'ArrowUp') {
        event.preventDefault();
        items[sfsSelectedIndex]?.classList.remove('active');
        sfsSelectedIndex = (sfsSelectedIndex - 1 + items.length) % items.length;
        items[sfsSelectedIndex]?.classList.add('active');
        items[sfsSelectedIndex]?.scrollIntoView({ block: 'nearest' });
        if (sfsResults[sfsSelectedIndex] && items[sfsSelectedIndex]) {
          showHoverCardForElement(items[sfsSelectedIndex], sfsResults[sfsSelectedIndex]);
        }
      } else if (event.key === 'Enter' || event.key === 'Tab') {
        if (sfsSelectedIndex >= 0 && sfsResults[sfsSelectedIndex]) {
          event.preventDefault();
          applyFloatingMedicine(rowIdx, sfsResults[sfsSelectedIndex].id);
        }
      } else if (event.key === 'Escape') {
        hideFloatingSearch();
      }
    }

    function applyFloatingMedicine(rowIdx, medId) {
      const med = cachedMedicines.find(m => m.id === medId);
      if (!med) return;

      const textarea = document.getElementById(`rxText_${rowIdx}`);
      hideFloatingSearch();
      hideHoverCard();

      if (textarea) {
        const val = textarea.value;
        const cursorPos = textarea.selectionStart || val.length;
        const textBefore = val.slice(0, cursorPos);
        const textAfter = val.slice(cursorPos);
        const lines = textBefore.split('\n');

        // 直前行の入力中キーワードをクリアして補完テキストに置換
        lines[lines.length - 1] = '';

        // 注意書き（standardUsage, dosage 等）は含めず、薬品名と規格・単位のみ挿入
        const cleanSpec = (med.spec && !med.name.includes(med.spec)) ? ` ${med.spec}` : '';
        const cleanUnit = med.unit ? ` 1${med.unit}` : '';
        let complementText = `${med.name}${cleanSpec}${cleanUnit}`.trim();

        const prefix = lines.join('\n');
        const newText = (prefix.trim() ? prefix.trim() + '\n' : '') + complementText + (textAfter.trim() ? '\n' + textAfter.trim() : '');
        textarea.value = newText;
        textarea.focus();
      }

      // 投与経路の自動推奨判定・自動選択
      if (!selectedRoutes[rowIdx]) {
        const medInfo = (med.name || '') + (med.dosage || '') + (med.standardUsage || '');
        if (medInfo.includes('輸液') || medInfo.includes('点滴') || medInfo.includes('DIV') || medInfo.includes('ブドウ糖') || medInfo.includes('ソルデム') || medInfo.includes('生食') || medInfo.includes('リンゲル')) {
          selectRoute(rowIdx, 'DIV');
        } else if (medInfo.includes('静注') || medInfo.includes('iv') || medInfo.includes('ワンショット')) {
          selectRoute(rowIdx, 'iv');
        } else if (medInfo.includes('皮下') || medInfo.includes('is')) {
          selectRoute(rowIdx, 'is');
        } else if (medInfo.includes('筋注') || medInfo.includes('im')) {
          selectRoute(rowIdx, 'im');
        } else {
          selectRoute(rowIdx, 'DIV');
        }
      }

      // 行の薬品データを保存＆ホバーバッジ表示
      setRowMedicineData(rowIdx, med);

      setLastAction(`インクリメンタル候補から No.${rowIdx} に「${med.name}」を反映`);

      showToastNotice(`No.${rowIdx} に「${med.name}」を反映しました`);
    }

    // パネル外クリックで閉じる
    document.addEventListener('click', (e) => {
      const panel = document.getElementById('sheetFloatingSearch');
      if (panel && panel.style.display !== 'none') {
        if (!e.target.closest('.rx-textarea') && !e.target.closest('#sheetFloatingSearch')) {
          hideFloatingSearch();
        }
      }
    });

    // =========================================================
    // 💡 薬品詳細・注意書き ホバーフローティングウィンドウ管理
    // =========================================================
    const rowMedicinesMap = {}; // rowIdx -> array of medicines
    let hoverHideTimer = null;

    function setRowMedicineData(rowIdx, med) {
      if (!rowMedicinesMap[rowIdx]) {
        rowMedicinesMap[rowIdx] = [];
      }
      if (!rowMedicinesMap[rowIdx].some(m => m.id === med.id)) {
        rowMedicinesMap[rowIdx].push(med);
      }
      updateRowInfoBadge(rowIdx);
    }

    function updateRowInfoBadge(rowIdx) {
      const badge = document.getElementById(`rxInfoBadge_${rowIdx}`);
      const list = rowMedicinesMap[rowIdx] || [];
      if (!badge) return;
      if (list.length > 0) {
        let displayName = '';
        if (list.length === 1) {
          const name = list[0].name;
          displayName = name.length > 18 ? name.slice(0, 18) + '…' : name;
        } else {
          displayName = list.map(m => m.name.length > 8 ? m.name.slice(0, 8) + '…' : m.name).join(' / ');
          if (displayName.length > 24) displayName = displayName.slice(0, 24) + '…';
        }
        badge.textContent = displayName;
        badge.title = `${list.map(m => m.name).join(' / ')}（ホバーで用法・詳細を表示）`;
        badge.style.display = 'inline-flex';
      } else {
        badge.style.display = 'none';
        badge.textContent = '';
      }
    }

    function detectMedicinesInTextarea(rowIdx) {
      const textarea = document.getElementById(`rxText_${rowIdx}`);
      if (!textarea || cachedMedicines.length === 0) return;
      const text = textarea.value;
      if (!text.trim()) {
        rowMedicinesMap[rowIdx] = [];
        updateRowInfoBadge(rowIdx);
        return;
      }
      const found = [];
      const lines = text.split('\n');
      lines.forEach(line => {
        const trimmed = line.trim();
        if (!trimmed) return;
        const normLine = normSearchText(trimmed);
        const match = cachedMedicines.find(m => {
          const isIv = (m.category === '注射剤' || (m.category && m.category.includes('注射')));
          if (!isIv) return false;
          const n = normSearchText(m.name);
          return n && (normLine.includes(n) || n.includes(normLine));
        });
        if (match && !found.some(x => x.id === match.id)) {
          found.push(match);
        }
      });
      if (found.length > 0) {
        rowMedicinesMap[rowIdx] = found;
      }
      updateRowInfoBadge(rowIdx);
    }

    function renderMedHoverContent(meds) {
      if (!Array.isArray(meds)) meds = [meds];
      if (meds.length === 0) return '';

      return meds.map((med, idx) => {
        const isMulti = meds.length > 1;
        const cleanSpec = (med.spec && !med.name.includes(med.spec)) ? med.spec : '';
        const unitStr = med.unit ? `1${med.unit}` : '';
        const badgeText = [cleanSpec, unitStr].filter(Boolean).join(' / ');

        const usageText = med.dosage || med.standardUsage || '添付文書の用法・用量をご確認ください。';
        const hasRemarks = Boolean(med.remarks || med.pharmacyComment);

        return `
          <div class="smhc-med-block ${isMulti ? 'smhc-multi' : ''}">
            ${isMulti ? `<div class="smhc-multi-idx">薬品 ${idx + 1} / ${meds.length}</div>` : ''}
            <div class="smhc-header">
              <div class="smhc-tag-row">
                <span class="smhc-tag-cat">💉 注射薬</span>
                ${med.brandType ? `<span class="smhc-tag-brand">${escapeHtml(med.brandType)}</span>` : ''}
                ${badgeText ? `<span class="smhc-tag-spec">${escapeHtml(badgeText)}</span>` : ''}
              </div>
              <div class="smhc-title">${escapeHtml(med.name)}</div>
              ${med.genericName ? `<div class="smhc-generic">一般名 (成分): <strong>${escapeHtml(med.genericName)}</strong></div>` : ''}
              ${(med.therapeuticCategoryMajor || med.therapeuticCategoryMiddle) ? `
                <div class="smhc-category">${escapeHtml([med.therapeuticCategoryMajor, med.therapeuticCategoryMiddle].filter(Boolean).join(' › '))}</div>
              ` : ''}
            </div>

            <div class="smhc-body">
              <div class="smhc-section smhc-usage-sec">
                <div class="smhc-sec-label">📋 用法・用量 (使用上の注意書き):</div>
                <div class="smhc-usage-text">${escapeHtml(usageText)}</div>
              </div>

              ${hasRemarks ? `
                <div class="smhc-section smhc-warning-sec">
                  <div class="smhc-sec-label warning">⚠️ 備考・薬剤科コメント:</div>
                  <div class="smhc-sec-text warning">
                    ${med.remarks ? `<div style="margin-bottom:2px;">• 備考: ${escapeHtml(med.remarks)}</div>` : ''}
                    ${med.pharmacyComment ? `<div>• 薬剤科連絡: ${escapeHtml(med.pharmacyComment)}</div>` : ''}
                  </div>
                </div>
              ` : ''}
            </div>
          </div>
        `;
      }).join('<div class="smhc-divider"></div>');
    }

    function positionHoverCard(anchorEl) {
      const card = document.getElementById('sheetMedHoverCard');
      if (!card || !anchorEl) return;

      const rect = anchorEl.getBoundingClientRect();
      const cardWidth = 380;
      card.style.display = 'block';
      card.style.visibility = 'hidden';
      card.style.width = `${cardWidth}px`;

      const cardHeight = card.offsetHeight || 220;

      let left = rect.right + 10;
      if (left + cardWidth > window.innerWidth - 10) {
        left = Math.max(10, rect.left - cardWidth - 10);
      }

      let top = rect.top;
      if (top + cardHeight > window.innerHeight - 10) {
        top = Math.max(10, window.innerHeight - cardHeight - 10);
      }

      card.style.left = `${left}px`;
      card.style.top = `${top}px`;
      card.style.visibility = 'visible';
    }

    function showHoverCardForElement(anchorEl, meds) {
      cancelHoverHide();
      const card = document.getElementById('sheetMedHoverCard');
      const container = document.getElementById('smhcContainer');
      if (!card || !container) return;

      const html = renderMedHoverContent(meds);
      if (!html) {
        card.style.display = 'none';
        return;
      }

      container.innerHTML = html;
      positionHoverCard(anchorEl);
    }

    function scheduleHoverHide() {
      if (hoverHideTimer) clearTimeout(hoverHideTimer);
      hoverHideTimer = setTimeout(() => {
        const card = document.getElementById('sheetMedHoverCard');
        if (card) card.style.display = 'none';
      }, 180);
    }

    function cancelHoverHide() {
      if (hoverHideTimer) {
        clearTimeout(hoverHideTimer);
        hoverHideTimer = null;
      }
    }

    function hideHoverCard() {
      cancelHoverHide();
      const card = document.getElementById('sheetMedHoverCard');
      if (card) card.style.display = 'none';
    }

    function onInfoBadgeMouseEnter(el, rowIdx) {
      const meds = rowMedicinesMap[rowIdx] || [];
      if (meds.length > 0) {
        showHoverCardForElement(el, meds);
      } else {
        detectMedicinesInTextarea(rowIdx);
        const updated = rowMedicinesMap[rowIdx] || [];
        if (updated.length > 0) {
          showHoverCardForElement(el, updated);
        }
      }
    }

    function onInfoBadgeMouseLeave() {
      scheduleHoverHide();
    }

    function onCellRxMouseEnter(el, rowIdx) {
      const textarea = document.getElementById(`rxText_${rowIdx}`);
      if (document.activeElement === textarea) return;
      const badge = document.getElementById(`rxInfoBadge_${rowIdx}`);
      const meds = rowMedicinesMap[rowIdx] || [];
      if (meds.length > 0) {
        showHoverCardForElement(badge || el, meds);
      }
    }

    function onCellRxMouseLeave(el, rowIdx) {
      scheduleHoverHide();
    }

    function onSfsItemMouseEnter(el, medId) {
      const med = cachedMedicines.find(m => m.id === medId);
      if (med) {
        showHoverCardForElement(el, med);
      }
    }

    function onSfsItemMouseLeave() {
      scheduleHoverHide();
    }

    function onModalTrMouseEnter(el, medId) {
      const med = cachedMedicines.find(m => m.id === medId);
      if (med) {
        showHoverCardForElement(el, med);
      }
    }

    function onModalTrMouseLeave() {
      scheduleHoverHide();
    }

    // 11. 全クリア
    function clearSheetForm() {
      if (!confirm('用紙の入力内容をすべてクリアしますか？')) return;
      hideHoverCard();
      for (let r = 1; r <= 10; r++) {
        rowMedicinesMap[r] = [];
        updateRowInfoBadge(r);
        const tx = document.getElementById(`rxText_${r}`);
        if (tx) tx.value = '';
        selectedRoutes[r] = '';
        const grid = document.getElementById(`routeGrid_${r}`);
        if (grid) grid.querySelectorAll('.route-selected').forEach(el => el.classList.remove('route-selected'));
        for (let d = 1; d <= 15; d++) {
          const t = document.getElementById(`cell_top_${r}_${d}`);
          const b = document.getElementById(`cell_bottom_${r}_${d}`);
          if (t) t.innerHTML = '';
          if (b) b.innerHTML = '';
        }
      }
      setLastAction('指示箋の全入力内容をクリア');
      setLatestNotice('指示箋の入力内容を初期状態にリセットしました', 'info');
    }

    // 12. データの収集
    function collectSheetData() {
      const year = document.getElementById('sheetYear')?.value || '';
      const month = document.getElementById('sheetMonth')?.value || '';
      const startDate = document.getElementById('sheetStartDate')?.value || '';
      const patientId = document.getElementById('metaPatientId')?.value || '';
      const patientName = document.getElementById('metaPatientName')?.value || '';
      const ward = document.getElementById('metaWard')?.value || '';
      const room = document.getElementById('metaRoom')?.value || '';
      const age = document.getElementById('metaAge')?.value || '';
      const gender = document.getElementById('genderMale')?.classList.contains('gender-circle') ? '男' : '女';
      const doctorName = document.getElementById('docStampName')?.textContent || '北島';

      const medicines = [];
      for (let r = 1; r <= 10; r++) {
        const rx = document.getElementById(`rxText_${r}`)?.value.trim() || '';
        if (rx) {
          const route = selectedRoutes[r] || 'DIV';
          medicines.push({
            no: r,
            medicine: rx.split('\n')[0],
            dosage: rx.split('\n')[1] || '',
            route: route,
            startDate: startDate,
            remarks: rx.split('\n').slice(2).join(' ')
          });
        }
      }

      // 15日目の終了日を計算
      let endDate = startDate;
      if (startDate) {
        const endD = new Date(startDate);
        endD.setDate(endD.getDate() + 14);
        endDate = endD.toISOString().split('T')[0];
      }

      return {
        year, month, startDate, endDate, patientId, patientName, ward, room, age, gender, doctorName, medicines
      };
    }

    // 13. 保存処理
    function saveSheetData() {
      const data = collectSheetData();
      try {
        localStorage.setItem(`injection_sheet_${data.patientId || 'common'}`, JSON.stringify(data));
        setLastAction(`指示箋データを一時保存 (開始日: ${data.startDate || '未指定'} / 患者: ${data.patientName || data.patientId})`);
        setLatestNotice('指示箋の入力内容をローカルに一時保存しました', 'success');
        alert('✅ 注射指示箋の入力内容を一時保存しました');
      } catch (e) {
        setLatestNotice('一時保存エラー: ' + e.message, 'error');
        alert('保存エラー: ' + e.message);
      }
    }

    // 14. オーダリング送信 & 電子カルテ連携
    async function submitToOrderingAndCarte() {
      const data = collectSheetData();
      if (!data.medicines || data.medicines.length === 0) {
        setLatestNotice('処方内容が入力されていません (1行以上必要)', 'warning');
        alert('処方内容が入力されていません。1行以上入力してください。');
        return;
      }

      setLastAction(`オーダー送信を開始 (開始日: ${data.startDate} / 患者: ${data.patientName || data.patientId} / ${data.medicines.length}品目)`);

      if (!confirm(`患者 [${data.patientId}] ${data.patientName} 様の注射指示(${data.medicines.length}件 / 開始日: ${data.startDate || '今日'}) を確定し、部門モニターおよび電子カルテへ送信しますか？`)) {
        setLastAction('オーダー送信の確認でキャンセルを選択');
        return;
      }

      const orderPayload = {
        orderType: 'IV',
        priority: 'ROUTINE',
        orderDate: data.startDate || new Date().toISOString().split('T')[0],
        patient: {
          id: data.patientId,
          name: data.patientName,
          ward: data.ward,
          room: data.room,
          gender: data.gender,
          age: parseInt(data.age, 10) || 65
        },
        doctor: {
          name: data.doctorName,
          department: data.ward
        },
        details: {
          route: data.medicines[0].route || 'DIV',
          medicine: data.medicines.map(m => m.medicine).join(' + '),
          medicines: data.medicines,
          startDate: data.startDate,
          endDate: data.endDate,
          scheduleDays: `${data.startDate} 〜 ${data.endDate} (15日間)`,
          pharmacistChecked: true,
          remarks: `注射指示箋(原本様式)より一括送信 [開始日: ${data.startDate || '即時'}]`
        }
      };

      try {
        setLatestNotice('オーダリングサーバーへ送信中...', 'info');
        // Port 4000 のオーダー送信 API
        const res = await fetch('/api/orders/send', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(orderPayload)
        });
        const resData = await res.json();
        if (res.ok && resData.success) {
          setLastAction(`オーダー送信完了 [${resData.order.orderId}]`);
          setLatestNotice(`オーダー送信完了！ [${resData.order.orderId}] 部門モニターおよび電子カルテ記事に反映されました`, 'success');
          alert(`✅ オーダー送信完了！ [${resData.order.orderId}]\n開始日: ${data.startDate || '今日'}\n部門モニターおよび電子カルテ記事に反映されました。`);
          window.location.href = `http://${window.location.hostname || 'localhost'}:4000/?orderType=IV&patientId=${encodeURIComponent(data.patientId)}`;
        } else {
          setLatestNotice('送信失敗: ' + (resData.error || '不明なエラー'), 'error');
          alert('❌ 送信失敗: ' + (resData.error || '不明なエラー'));
        }
      } catch (err) {
        setLatestNotice('通信エラー: ' + err.message, 'error');
        alert('❌ 通信エラー: ' + err.message);
      }
    }

    // =========================================================
    // 📅 指示開始日 & 15日間カレンダー連動システム
    // =========================================================
    function onStartDateChange(dateVal) {
      if (!dateVal) return;
      updateGridDates(dateVal);
      setLastAction(`指示開始日を変更: ${dateVal}`);
      setLatestNotice(`カレンダーを ${dateVal} 開始に更新しました`, 'info');
    }

    function setQuickStartDate(offsetDays = 0) {
      const d = new Date();
      d.setDate(d.getDate() + offsetDays);
      const yyyy = d.getFullYear();
      const mm = String(d.getMonth() + 1).padStart(2, '0');
      const dd = String(d.getDate()).padStart(2, '0');
      const dateStr = `${yyyy}-${mm}-${dd}`;
      const input = document.getElementById('sheetStartDate');
      if (input) input.value = dateStr;
      updateGridDates(dateStr);
      setLastAction(`指示開始日を${offsetDays === 0 ? '今日' : '明日'} (${dateStr}) に設定`);
    }

    function syncDateFromYearMonth() {
      const y = parseInt(document.getElementById('sheetYear')?.value, 10);
      const m = parseInt(document.getElementById('sheetMonth')?.value, 10);
      const curStart = document.getElementById('sheetStartDate')?.value;
      let day = 1;
      if (curStart) {
        const parts = curStart.split('-');
        if (parts.length === 3) day = parseInt(parts[2], 10);
      }
      if (y && m) {
        const dateStr = `${y}-${String(m).padStart(2, '0')}-${String(day).padStart(2, '0')}`;
        const input = document.getElementById('sheetStartDate');
        if (input) input.value = dateStr;
        updateGridDates(dateStr);
      }
    }

    function updateGridDates(startDateStr) {
      if (!startDateStr) return;
      const parts = startDateStr.split('-');
      if (parts.length !== 3) return;
      const startYear = parseInt(parts[0], 10);
      const startMonth = parseInt(parts[1], 10);
      const startDay = parseInt(parts[2], 10);

      const start = new Date(startYear, startMonth - 1, startDay);
      if (isNaN(start.getTime())) return;

      // 用紙ヘッダーの年月を同期
      const yInput = document.getElementById('sheetYear');
      const mInput = document.getElementById('sheetMonth');
      if (yInput) yInput.value = startYear;
      if (mInput) mInput.value = startMonth;

      // 用紙内の開始日案内テキストを同期
      const label = document.getElementById('labelStartDate');
      if (label) label.textContent = `${startYear}/${startMonth}/${startDay}`;

      const dows = ['日', '月', '火', '水', '木', '金', '土'];

      // 15日分の各列ヘッダーを計算して更新
      for (let i = 1; i <= 15; i++) {
        const cur = new Date(startYear, startMonth - 1, startDay + (i - 1));
        const curY = cur.getFullYear();
        const curM = cur.getMonth() + 1;
        const curD = cur.getDate();
        const dow = cur.getDay(); // 0=日, 6=土
        const dowChar = dows[dow];

        const dayInput = document.getElementById(`headerDay_${i}`);
        if (dayInput) {
          dayInput.value = curD;
          dayInput.title = `${curY}/${curM}/${curD} (${dowChar})`;
          // 月替わりの日を視覚的に強調
          if (curM !== startMonth && curD === 1) {
            dayInput.style.color = '#7c3aed';
            dayInput.style.fontWeight = '900';
          } else {
            dayInput.style.color = '';
            dayInput.style.fontWeight = '';
          }
        }

        const dowSpan = document.getElementById(`headerDow_${i}`);
        if (dowSpan) {
          dowSpan.textContent = dowChar;
          dowSpan.className = 'header-day-dow no-print' + (dow === 6 ? ' sat' : dow === 0 ? ' sun' : '');
        }

        // 処方グリッド各行の対応セルにも日付をデータ属性として紐付け
        for (let r = 1; r <= 10; r++) {
          const topCell = document.getElementById(`cell_top_${r}_${i}`);
          const btmCell = document.getElementById(`cell_bottom_${r}_${i}`);
          const dateIso = `${curY}-${String(curM).padStart(2, '0')}-${String(curD).padStart(2, '0')}`;
          if (topCell) topCell.setAttribute('data-date', dateIso);
          if (btmCell) btmCell.setAttribute('data-date', dateIso);
        }
      }

      // ローカルストレージに開始日を一時記録
      try {
        const pId = document.getElementById('metaPatientId')?.value || 'common';
        localStorage.setItem(`injection_sheet_start_date_${pId}`, startDateStr);
      } catch (_) {}
    }

    // 初期化処理: 開始日付のセットアップ
    (function initInjectionSheetDates() {
      const today = new Date();
      const yyyy = today.getFullYear();
      const mm = String(today.getMonth() + 1).padStart(2, '0');
      const dd = String(today.getDate()).padStart(2, '0');
      let initialDate = `${yyyy}-${mm}-${dd}`;

      // URLパラメータの startDate や localStorage からの復元チェック
      try {
        const urlParams = new URLSearchParams(window.location.search);
        const qDate = urlParams.get('startDate') || urlParams.get('orderDate');
        const pId = document.getElementById('metaPatientId')?.value || 'common';
        const savedDate = localStorage.getItem(`injection_sheet_start_date_${pId}`);
        if (qDate && /^\d{4}-\d{2}-\d{2}$/.test(qDate)) {
          initialDate = qDate;
        } else if (savedDate && /^\d{4}-\d{2}-\d{2}$/.test(savedDate)) {
          initialDate = savedDate;
        }
      } catch (_) {}

      const dateInput = document.getElementById('sheetStartDate');
      if (dateInput) {
        dateInput.value = initialDate;
      }
      updateGridDates(initialDate);
    })();
  </script>
</body>
</html>
