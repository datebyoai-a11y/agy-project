    // =========================================================
    // 10. 薬品マスタ インクリメンタル検索モーダルシステム
    // =========================================================
    let modalSearchCategory = '注射剤'; // デフォルトは注射剤
    let cachedMedicines = [];
    let modalFilteredMedicines = [];
    let modalActiveIndex = -1;

    // 起動時に全薬品データを取得＆キャッシュ（超高速検索のため）
    async function initMedicinesData() {
      try {
        const res = await fetch('/api/medicines?limit=1000');
        const data = await res.json();
        if (data.medicines && Array.isArray(data.medicines)) {
          cachedMedicines = data.medicines;
          updateModalCounts();
          // 初期表示されている処方行の薬品を検出してホバーバッジを準備
          for (let r = 1; r <= 10; r++) {
            detectMedicinesInTextarea(r);
          }
          const ivCount = cachedMedicines.filter(m => m.category === '注射剤' || (m.category && m.category.includes('注射'))).length;
          setLatestNotice(`薬品マスタ (${ivCount}品の注射薬) をロード完了。処方枠で自動補完可能です。`, 'info');
        }
      } catch (e) {
        console.error('Failed to load medicines for incremental search:', e);
        setLatestNotice('薬品マスタのロードに失敗しました: ' + e.message, 'warning');
      }
    }
    initMedicinesData();

    function updateModalCounts() {
      const ivCount = cachedMedicines.filter(m => m.category === '注射剤' || (m.category && m.category.includes('注射'))).length;
      const cIv = document.getElementById('modalCountIv');
      if (cIv) cIv.textContent = ivCount;
    }

    function setModalSearchCategory(cat, btn) {
