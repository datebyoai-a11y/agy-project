    function clearModalKeyword() {
      const input = document.getElementById('medSearchKeyword');
      if (input) {
        input.value = '';
        const clearBtn = document.getElementById('modalKeywordClearBtn');
        if (clearBtn) clearBtn.style.display = 'none';
        input.focus();
        performModalSearch('');
