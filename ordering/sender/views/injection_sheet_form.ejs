    function returnToOrdering(url) {
      setLastAction('オーダリング画面への遷移を実行');
      if (window.opener && !window.opener.closed) {
        try {
          window.opener.location.href = url;
          window.opener.focus();
          window.close();
          return false;
        } catch (_) {}
      }
      try {
        const win = window.open(url, 'app_ordering_sender');
        if (win && !win.closed) {
          try { win.focus(); } catch (_) {}
        } else {
          window.location.href = url;
        }
      } catch (e) {
        window.location.href = url;
      }
      return false;
    }

