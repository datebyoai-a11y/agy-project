<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>注射指示箋 入力画面案 (原本様式忠実再現) - だて病院</title>
  <script>window.name = 'app_injection_sheet';</script>
  <style>
    /* 全体リセット & 画面表示用ベーススタイル */
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }
    body {
      background: #e2e8f0;
      color: #000000;
      font-family: "游明朝", "Yu Mincho", "Hiragino Mincho ProN", "MS P明朝", serif;
      padding: 0.4rem 0.5rem 40px 0.5rem;
      display: flex;
      flex-direction: column;
      align-items: center;
      min-height: 100vh;
    }

    /* 上部操作ツールバー (リボン・画面操作用・印刷時は非表示) */
    .screen-toolbar {
      width: 100%;
      max-width: 1140px;
      background: #1e293b;
      color: #ffffff;
      padding: 0.28rem 0.75rem;
      border-radius: 6px;
      margin-bottom: 0.5rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 0.6rem;
      box-shadow: 0 2px 4px -1px rgba(0,0,0,0.12);
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      min-height: 40px;
    }
    .screen-toolbar .title-area {
      display: flex;
      align-items: center;
      gap: 0.45rem;
    }
    .screen-toolbar .title-area h2 {
      font-size: 0.95rem;
      font-weight: bold;
      color: #f8fafc;
      white-space: nowrap;
      margin: 0;
    }
    .screen-toolbar .badge {
      background: #0284c7;
      color: white;
      font-size: 0.68rem;
      padding: 0.15rem 0.4rem;
      border-radius: 3px;
      font-weight: bold;
      white-space: nowrap;
    }
    .screen-toolbar .actions {
      display: flex;
      align-items: center;
      gap: 0.35rem;
      flex-wrap: nowrap;
    }
    .btn-action {
      background: #334155;
      color: white;
      border: 1px solid #475569;
      padding: 0.25rem 0.55rem;
      border-radius: 4px;
      font-size: 0.76rem;
      font-weight: bold;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 0.25rem;
      text-decoration: none;
      transition: background 0.15s ease, border-color 0.15s ease;
      white-space: nowrap;
    }
    .btn-action:hover {
      background: #475569;
    }
    .btn-action.btn-primary {
      background: #0284c7;
      border-color: #0284c7;
    }
    .btn-action.btn-primary:hover {
      background: #0369a1;
    }
    .btn-action.btn-success {
      background: #059669;
      border-color: #059669;
    }
    .btn-action.btn-success:hover {
      background: #047857;
    }
    .toolbar-date-group {
      display: inline-flex;
      align-items: center;
      gap: 0.3rem;
      background: rgba(2, 132, 199, 0.18);
      border: 1px solid #38bdf8;
      padding: 0.18rem 0.45rem;
      border-radius: 4px;
    }
    .toolbar-date-label {
      font-size: 0.74rem;
      font-weight: bold;
      color: #7dd3fc;
      white-space: nowrap;
      display: flex;
      align-items: center;
      gap: 0.2rem;
    }
    .toolbar-date-input {
      background: #0f172a;
      color: #ffffff;
      border: 1px solid #0284c7;
      border-radius: 3px;
      padding: 0.15rem 0.35rem;
      font-size: 0.78rem;
      font-weight: bold;
      outline: none;
      cursor: pointer;
      color-scheme: dark;
    }
    .btn-date-quick {
      background: #0284c7;
      color: white;
      border: none;
      border-radius: 3px;
      padding: 0.15rem 0.4rem;
      font-size: 0.7rem;
      font-weight: bold;
      cursor: pointer;
      transition: background 0.15s;
      white-space: nowrap;
    }
    .btn-date-quick:hover {
      background: #0369a1;
    }
    .day-header-wrapper {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      height: 100%;
      padding: 1px 0;
    }
    .header-day-dow {
      font-size: 9px;
      line-height: 1;
      font-weight: bold;
      color: #64748b;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      margin-top: 1px;
    }
    .header-day-dow.sat { color: #0284c7; }
    .header-day-dow.sun { color: #dc2626; }

    /* 用紙コンテナ (A4横サイズを忠実に模倣) */
    .paper-container {
      width: 1140px;
      background: #ffffff;
      padding: 24px 28px 20px 28px;
      box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.15), 0 8px 10px -6px rgba(0, 0, 0, 0.1);
      border-radius: 2px;
      position: relative;
    }

    /* パンチ穴 (上部4穴の再現) */
    .punch-holes-bar {
      position: absolute;
      top: 8px;
      left: 0;
      right: 0;
      display: flex;
      justify-content: space-evenly;
      pointer-events: none;
    }
    .punch-hole {
      width: 14px;
      height: 14px;
      border-radius: 50%;
      background: #cbd5e1;
      border: 1px solid #94a3b8;
    }

    /* ヘッダー全体 */
    .inj-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      margin-top: 10px;
      margin-bottom: 6px;
    }

    /* ヘッダー左側: 表題「注射指示」 & 年月 */
    .inj-title-area {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }
    .inj-main-title {
      font-size: 26px;
      font-weight: 900;
      letter-spacing: 2px;
      color: #000000;
      line-height: 1;
    }
    .inj-year-month-area {
      display: flex;
      align-items: center;
      gap: 4px;
      font-size: 16px;
      font-weight: bold;
      margin-left: 110px; /* 原本の右寄り配置に忠実 */
    }
    .inj-year-month-area input {
      border: none;
      border-bottom: 1px solid #000;
      text-align: center;
      font-size: 16px;
      font-weight: bold;
      font-family: inherit;
      outline: none;
      background: transparent;
    }

    /* ヘッダー右側: 担当医・患者情報テーブル (原本忠実) */
    .inj-meta-table {
      border-collapse: collapse;
      border: 1.5px solid #000000;
      font-size: 13px;
    }
    .inj-meta-table td, .inj-meta-table th {
      border: 1px solid #000000;
      padding: 3px 6px;
      vertical-align: middle;
    }
    .inj-meta-table th {
      font-weight: normal;
      background: transparent;
      text-align: center;
    }

    /* 担当医枠 */
    .meta-doctor-cell {
      width: 80px;
      height: 52px;
      text-align: left;
      vertical-align: top !important;
      position: relative;
    }
    .meta-doctor-label {
      font-size: 12px;
    }
    .doctor-stamp-box {
      position: absolute;
      bottom: 4px;
      right: 12px;
      width: 38px;
      height: 38px;
      border: 1.5px solid #dc2626;
      border-radius: 50%;
      color: #dc2626;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      font-size: 8px;
      line-height: 1;
      cursor: pointer;
      user-select: none;
      background: rgba(254, 242, 242, 0.3);
    }
    .doctor-stamp-box span.stamp-name {
      font-size: 11px;
      font-weight: bold;
      margin-top: 1px;
    }

    /* 病棟・号室 */
    .meta-ward-room-cell {
      width: 90px;
      text-align: center;
    }
    .meta-input-inline {
      border: none;
      background: transparent;
      font-family: inherit;
      font-size: 13px;
      outline: none;
      width: 100%;
      text-align: center;
    }

    /* ID・氏名 */
    .meta-id-name-cell {
      width: 320px;
      padding: 2px 8px !important;
    }
    .meta-id-row {
      display: flex;
      align-items: center;
      border-bottom: 1px solid #71717a;
      padding-bottom: 2px;
      margin-bottom: 2px;
    }
    .meta-name-row {
      display: flex;
      align-items: center;
    }
    .underline-input {
      border: none;
      outline: none;
      background: transparent;
      font-family: inherit;
      font-size: 14px;
      font-weight: bold;
      flex: 1;
      padding-left: 6px;
    }

    /* 生年月日・性別 */
    .meta-birth-sex-cell {
      width: 160px;
      font-size: 12px;
    }
    .era-circle, .gender-circle {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 18px;
      height: 18px;
      border: 1.5px solid #dc2626;
      border-radius: 50%;
      color: #dc2626;
      font-weight: bold;
    }
    .clickable-option {
      cursor: pointer;
      user-select: none;
      padding: 0 1px;
    }

    /* メイン指示グリッドテーブル (原本忠実再現) */
    .main-grid-table {
      width: 100%;
      border-collapse: collapse;
      border: 1.5px solid #000000;
      table-layout: fixed;
    }
    .main-grid-table th, .main-grid-table td {
      border: 1px solid #000000;
      padding: 0;
      vertical-align: middle;
      text-align: center;
    }

    /* ヘッダー行 */
    .grid-header-row th {
      height: 26px;
      font-weight: normal;
      font-size: 13px;
      background: transparent;
    }
    .col-no {
      width: 28px;
    }
    .col-rx {
      width: 440px;
    }
    th.col-rx {
      font-size: 15px !important;
      letter-spacing: 2em; /* 「処　　方」の原本忠実な字間 */
      text-indent: 2em;
    }
    td.col-rx {
      font-size: 12.5px;
      letter-spacing: normal !important;
      text-indent: 0 !important;
    }
    .col-route {
      width: 82px;
    }
    .col-date-title {
      width: 48px;
      font-size: 13px !important;
    }
    .col-day-cell {
      width: 36px;
    }

    /* ヘッダーの日付入力欄 */
    .header-day-input {
      width: 100%;
      height: 100%;
      border: none;
      outline: none;
      text-align: center;
      font-size: 12px;
      font-family: inherit;
      background: transparent;
    }

    /* 処方行 (全10行) */
    .grid-data-row {
      height: 52px;
    }
    .cell-no {
      font-size: 11px;
      color: #475569;
      font-family: -apple-system, BlinkMacSystemFont, monospace;
    }
    .cell-rx {
      text-align: left !important;
      padding: 3px 6px !important;
      vertical-align: top !important;
      position: relative;
      letter-spacing: normal !important;
      text-indent: 0 !important;
    }
    .rx-textarea {
      width: 100%;
      height: 46px;
      border: none;
      outline: none;
      resize: none;
      font-family: "游明朝", "Yu Mincho", serif;
      font-size: 12.5px;
      line-height: 1.35;
      background: transparent;
      letter-spacing: normal !important;
      text-indent: 0 !important;
    }
    .rx-quick-btn {
      position: absolute;
      right: 4px;
      bottom: 3px;
      font-size: 11px;
      background: #e0f2fe;
      border: 1px solid #7dd3fc;
      border-radius: 4px;
      padding: 1px 6px;
      cursor: pointer;
      color: #0369a1;
      font-weight: bold;
      opacity: 0.85;
      display: inline-flex;
      align-items: center;
      gap: 2px;
      box-shadow: 0 1px 2px rgba(0,0,0,0.05);
      transition: all 0.15s ease;
    }
    .rx-quick-btn:hover {
      opacity: 1;
      background: #0284c7;
      color: #ffffff;
      border-color: #0284c7;
    }

    /* 💊 処方枠インクリメンタル検索 フローティングパネル (入力時に自動発動) */
    .sheet-floating-search {
      position: fixed;
      width: 520px;
      max-height: 300px;
      background: #ffffff;
      border: 2px solid #0284c7;
      border-radius: 8px;
      box-shadow: 0 20px 35px -5px rgba(0, 0, 0, 0.35), 0 8px 16px rgba(0, 0, 0, 0.15);
      z-index: 10000;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
      font-size: 12px;
      display: flex;
      flex-direction: column;
      overflow: hidden;
      text-align: left;
    }
    .sfs-header {
      background: #0f172a;
      color: #ffffff;
      padding: 6px 12px;
      font-size: 11.5px;
      font-weight: bold;
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-bottom: 1.5px solid #0284c7;
    }
    .sfs-guide {
      font-size: 10.5px;
      color: #94a3b8;
    }
    .sfs-list-container {
      overflow-y: auto;
      max-height: 255px;
      background: #ffffff;
    }
    .sfs-item {
      padding: 7px 12px;
      border-bottom: 1px solid #f1f5f9;
      cursor: pointer;
      display: flex;
      justify-content: space-between;
      align-items: center;
      transition: background 0.1s ease;
    }
    .sfs-item:hover, .sfs-item.active {
      background: #e0f2fe;
    }
    .sfs-item.active {
      border-left: 4px solid #0284c7;
      background: #e0f2fe;
    }
    .sfs-name {
      font-weight: bold;
      font-size: 12.5px;
      color: #0f172a;
      display: flex;
      align-items: center;
      gap: 6px;
    }
    .sfs-spec {
      color: #0369a1;
      font-weight: bold;
      font-size: 11.5px;
      margin-left: 4px;
    }
    .sfs-sub {
      color: #64748b;
      font-size: 11px;
      margin-top: 2px;
    }
    .sfs-action-btn {
      background: #0284c7;
      color: white;
      font-size: 11px;
      font-weight: bold;
      padding: 3px 8px;
      border-radius: 4px;
      white-space: nowrap;
    }

    /* 投与経路セル (is, im, iv / DIV, IVH, ( )) 原本忠実配置 */
    .cell-route {
      font-size: 11px;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      padding: 2px !important;
      user-select: none;
    }
    .route-grid {
      display: grid;
      grid-template-columns: 1fr 1.2fr;
      row-gap: 2px;
      align-items: center;
      text-align: center;
      line-height: 1.15;
    }
    .route-item {
      cursor: pointer;
      padding: 1px 0;
      position: relative;
      display: inline-flex;
      justify-content: center;
      align-items: center;
    }
    .route-item:hover {
      color: #0284c7;
    }
    .route-selected {
      border: 1.5px solid #dc2626;
      border-radius: 50%;
      color: #dc2626;
      font-weight: bold;
      padding: 0 2px;
    }

    /* 日付列 (指示 / 実施) */
    .cell-date-label {
      font-size: 11px;
    }
    .split-top-bottom {
      display: flex;
      flex-direction: column;
      height: 52px;
    }
    .split-top {
      height: 26px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-bottom: 1px dashed #000000; /* 原本の破線 */
      font-size: 11px;
    }
    .split-bottom {
      height: 25px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 11px;
    }

    /* 15日グリッドの各セル (上段:指示サイン/下段:実施印) */
    .day-matrix-cell {
      border-right: 1px solid #000000 !important;
    }
    /* 日付列との境界縦線 (原本通り少し太め) */
    .border-thick-left {
      border-left: 1.5px solid #000000 !important;
    }
    .cell-interactive {
      cursor: pointer;
      user-select: none;
      transition: background 0.1s ease;
    }
    .cell-interactive:hover {
      background: #f8fafc;
    }

    /* フッター部 (病棟枠 / 薬剤師枠 / だて病院ロゴ) */
    .inj-footer {
      margin-top: 8px;
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      position: relative;
    }

    /* 病棟枠 (左下独立枠) */
    .ward-stamp-box {
      border: 1px solid #000000;
      width: 75px;
      height: 28px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 13px;
      letter-spacing: 0.5em;
      text-indent: 0.5em;
      cursor: pointer;
      user-select: none;
      background: transparent;
    }
    .ward-stamp-box.stamped {
      border-color: #dc2626;
      color: #dc2626;
      font-weight: bold;
    }

    /* 薬剤師テーブル (メインテーブル直下に連動配置) */
    .pharmacist-container {
      display: flex;
      position: absolute;
      right: 0;
      top: -9px; /* メインテーブル底辺にピッタリ接合 */
    }
    .pharmacist-table {
      border-collapse: collapse;
      border: 1.5px solid #000000;
      table-layout: fixed;
    }
    .pharmacist-table th, .pharmacist-table td {
      border: 1px solid #000000;
      height: 28px;
      text-align: center;
      vertical-align: middle;
      padding: 0;
    }
    .pharmacist-th {
      width: 130px; /* 投与経路＋日付列と直結 */
      font-size: 13px;
      font-weight: normal;
      letter-spacing: 0.3em;
      text-indent: 0.3em;
    }
    .pharmacist-cell {
      width: 36px;
      cursor: pointer;
      user-select: none;
    }
    .pharmacist-cell:hover {
      background: #f8fafc;
    }

    /* 右下欄外の病院・様式表示 */
    .footer-hospital-stamp {
      position: absolute;
      right: 0;
      bottom: -22px;
      font-size: 11px;
      color: #1e293b;
      letter-spacing: 0.05em;
    }

    /* 💊 薬剤マスタ インクリメンタル検索モーダル */
    .med-search-overlay {
      position: fixed;
      inset: 0;
      background: rgba(15, 23, 42, 0.65);
      backdrop-filter: blur(2px);
      display: none;
      align-items: center;
      justify-content: center;
      z-index: 9999;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    }
    .med-search-box {
      background: #ffffff;
      width: 860px;
      max-width: 95vw;
      height: 82vh;
      border-radius: 10px;
      box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.35);
      display: flex;
      flex-direction: column;
      overflow: hidden;
      border: 1px solid #cbd5e1;
    }
    .med-search-header {
      background: #0f172a;
      color: #ffffff;
      padding: 0.75rem 1.25rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-bottom: 2px solid #0284c7;
    }
    .med-search-body {
      padding: 1rem 1.25rem;
      flex: 1;
      display: flex;
      flex-direction: column;
      overflow: hidden;
      background: #f8fafc;
    }
    .med-search-tabs .tab-btn {
      padding: 0.35rem 0.75rem;
      border: 1px solid #cbd5e1;
      background: #ffffff;
      border-radius: 6px;
      font-size: 0.8rem;
      font-weight: bold;
      color: #475569;
      cursor: pointer;
      transition: all 0.15s ease;
    }
    .med-search-tabs .tab-btn:hover {
      background: #f1f5f9;
      border-color: #94a3b8;
    }
    .med-search-tabs .tab-btn.active {
      background: #0284c7;
      color: #ffffff;
      border-color: #0284c7;
      box-shadow: 0 1px 3px rgba(2, 132, 199, 0.3);
    }
    .med-search-input {
      width: 100%;
      padding: 0.65rem 2.2rem 0.65rem 0.85rem;
      border: 2px solid #94a3b8;
      border-radius: 6px;
      font-size: 0.95rem;
      font-family: inherit;
      outline: none;
      box-shadow: 0 1px 2px rgba(0,0,0,0.05);
      transition: border-color 0.15s ease, box-shadow 0.15s ease;
    }
    .med-search-input:focus {
      border-color: #0284c7;
      box-shadow: 0 0 0 3px rgba(2, 132, 199, 0.2);
    }
    .med-search-list-wrapper {
      flex: 1;
      overflow-y: auto;
      background: #ffffff;
      border: 1px solid #cbd5e1;
      border-radius: 6px;
    }
    .med-modal-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.82rem;
      text-align: left;
    }
    .med-modal-table th {
      position: sticky;
      top: 0;
      background: #f1f5f9;
      color: #475569;
      padding: 0.55rem 0.7rem;
      border-bottom: 2px solid #cbd5e1;
      font-weight: bold;
      z-index: 5;
    }
    .med-modal-table td {
      padding: 0.55rem 0.7rem;
      border-bottom: 1px solid #f1f5f9;
      vertical-align: middle;
    }
    .med-modal-tr {
      cursor: pointer;
      transition: background 0.1s ease;
    }
    .med-modal-tr:hover {
      background: #f0fdf4;
    }
    .med-modal-tr.active-row {
      background: #e0f2fe !important;
      outline: 2px solid #0284c7;
    }
    .badge-cat {
      display: inline-block;
      padding: 0.15rem 0.4rem;
      border-radius: 4px;
      font-size: 0.72rem;
      font-weight: bold;
      white-space: nowrap;
    }
    .badge-iv {
      background: #e0f2fe;
      color: #0369a1;
      border: 1px solid #bae6fd;
    }
    .badge-oral {
      background: #fef3c7;
      color: #b45309;
      border: 1px solid #fde68a;
    }
    .badge-ext {
      background: #f3e8ff;
      color: #7e22ce;
      border: 1px solid #e9d5ff;
    }
    .med-btn-insert {
      background: #0284c7;
      color: #ffffff;
      border: 1px solid #0369a1;
      padding: 0.25rem 0.6rem;
      border-radius: 4px;
      font-size: 0.78rem;
      font-weight: bold;
      cursor: pointer;
      white-space: nowrap;
      transition: background 0.15s ease;
    }
    .med-btn-insert:hover {
      background: #0369a1;
    }

    /* 印刷用スタイル (A4横サイズ1枚にピッタリ収める最適化) */
    @media print {
      @page {
        size: A4 landscape;
        margin: 4mm 6mm;
      }
      *, *::before, *::after {
        box-shadow: none !important;
        text-shadow: none !important;
      }
      html, body {
        background: #ffffff !important;
        padding: 0 !important;
        margin: 0 !important;
        width: 100% !important;
        -webkit-print-color-adjust: exact !important;
        print-color-adjust: exact !important;
      }
      .no-print {
        display: none !important;
      }
      .paper-container {
        box-shadow: none !important;
        width: 100% !important;
        max-width: 100% !important;
        padding: 0 !important;
        margin: 0 !important;
        border: none !important;
        page-break-inside: avoid !important;
        page-break-after: avoid !important;
      }
      .punch-holes-bar {
        display: none !important;
      }
      .rx-quick-btn {
        display: none !important;
      }
      .sheet-floating-search, .med-search-overlay, .sheet-med-hover-card, .rx-cell-header, .rx-med-info-badge, .sheet-status-bar, .status-history-modal {
        display: none !important;
      }
      /* 入力欄の印刷時表示 */
      input, textarea {
        border: none !important;
        background: transparent !important;
        outline: none !important;
        resize: none !important;
        color: #000000 !important;
        font-family: inherit !important;
      }
      .rx-textarea {
        height: auto !important;
        min-height: 40px !important;
        overflow: hidden !important;
      }
      /* テーブルの改ページ防止 */
      .matrix-table {
        page-break-inside: avoid !important;
        width: 100% !important;
      }
      tr {
        page-break-inside: avoid !important;
      }
    }

    /* 💡 処方枠ヘッダー & 薬品名ホバー表示 (背景に溶け込む単純な黒文字) */
    .rx-cell-header {
      position: absolute;
      top: 3px;
      right: 6px;
      z-index: 5;
      display: flex;
      align-items: center;
      gap: 4px;
      pointer-events: auto;
    }
    .rx-med-info-badge {
      display: none;
      align-items: center;
      gap: 2px;
      background: transparent;
      color: #000000;
      border: none;
      border-radius: 0;
      padding: 0;
      font-size: 12px;
      font-weight: bold;
      letter-spacing: normal !important;
      text-indent: 0 !important;
      cursor: pointer;
      box-shadow: none;
      transition: color 0.15s ease;
      font-family: "游明朝", "Yu Mincho", "Hiragino Mincho ProN", serif;
      user-select: none;
    }
    .rx-med-info-badge:hover {
      background: transparent;
      color: #000000;
      text-decoration: underline;
      border: none;
      box-shadow: none;
    }

    /* 💡 薬品詳細・注意書き ホバーフローティングウィンドウ */
    .sheet-med-hover-card {
      position: fixed;
      z-index: 2147483000;
      background: #ffffff;
      color: #1e293b;
      border-radius: 12px;
      box-shadow: 0 15px 35px -5px rgba(15, 23, 42, 0.3), 0 0 0 1px rgba(2, 132, 199, 0.18);
      border: 1.5px solid #0284c7;
      padding: 14px 16px;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Hiragino Kaku Gothic ProN", Meiryo, sans-serif;
      width: 380px;
      max-width: 90vw;
      max-height: 480px;
      overflow-y: auto;
      pointer-events: auto;
      transition: opacity 0.15s ease;
      box-sizing: border-box;
    }
    .smhc-med-block {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }
    .smhc-multi-idx {
      font-size: 10px;
      font-weight: 800;
      color: #0284c7;
      background: #f0f9ff;
      border-radius: 3px;
      padding: 1px 6px;
      align-self: flex-start;
      margin-bottom: 2px;
    }
    .smhc-divider {
      height: 1px;
      background: #e2e8f0;
      margin: 10px 0;
    }
    .smhc-header {
      border-bottom: 1px solid #f1f5f9;
      padding-bottom: 6px;
    }
    .smhc-tag-row {
      display: flex;
      align-items: center;
      gap: 5px;
      flex-wrap: wrap;
      margin-bottom: 4px;
    }
    .smhc-tag-cat {
      background: #f0fdf4;
      color: #15803d;
      border: 1px solid #86efac;
      font-size: 10px;
      font-weight: 700;
      padding: 1px 6px;
      border-radius: 4px;
    }
    .smhc-tag-brand {
      background: #f1f5f9;
      color: #475569;
      font-size: 10px;
      font-weight: 600;
      padding: 1px 5px;
      border-radius: 4px;
    }
    .smhc-tag-spec {
      background: #f8fafc;
      color: #0369a1;
      font-size: 10px;
      font-weight: 700;
      padding: 1px 6px;
      border-radius: 4px;
      border: 1px solid #e2e8f0;
    }
    .smhc-title {
      font-size: 14px;
      font-weight: 800;
      color: #0f172a;
      line-height: 1.35;
      margin-bottom: 3px;
    }
    .smhc-generic {
      font-size: 11px;
      color: #475569;
      margin-bottom: 2px;
    }
    .smhc-category {
      font-size: 10px;
      color: #64748b;
    }
    .smhc-body {
      display: flex;
      flex-direction: column;
      gap: 6px;
      margin-top: 4px;
    }
    .smhc-section {
      border-radius: 6px;
      padding: 8px 10px;
      font-size: 12px;
      line-height: 1.5;
    }
    .smhc-usage-sec {
      background: #f8fafc;
      border: 1px solid #e2e8f0;
    }
    .smhc-sec-label {
      font-weight: 800;
      color: #0369a1;
      font-size: 11px;
      margin-bottom: 3px;
      display: flex;
      align-items: center;
      gap: 4px;
    }
    .smhc-usage-text {
      color: #1e293b;
      font-size: 12px;
      white-space: pre-wrap;
      word-break: break-word;
    }
    .smhc-warning-sec {
      background: #fffbeb;
      border: 1px solid #fde68a;
    }
    .smhc-sec-label.warning {
      color: #b45309;
    }
    .smhc-sec-text.warning {
      color: #92400e;
      font-size: 11.5px;
      font-weight: 600;
    }

    /* 最下段固定ステータスバー (画面操作専用) */
    .sheet-status-bar {
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      height: 38px;
      background: #0f172a;
      border-top: 1.5px solid #1e293b;
      color: #cbd5e1;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
      font-size: 0.78rem;
      z-index: 9999;
      box-shadow: 0 -3px 12px rgba(0, 0, 0, 0.35);
      display: flex;
      align-items: center;
      user-select: none;
    }
    .status-bar-container {
      width: 100%;
      max-width: 1240px;
      margin: 0 auto;
      padding: 0 1rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 1rem;
    }
    .status-section {
      display: flex;
      align-items: center;
      gap: 0.45rem;
      white-space: nowrap;
      min-width: 0;
    }
    .status-left {
      flex: 1 1 45%;
      min-width: 0;
      overflow: hidden;
    }
    .status-center {
      flex: 1 1 45%;
      min-width: 0;
      overflow: hidden;
      border-left: 1px solid #334155;
      padding-left: 0.75rem;
    }
    .status-right {
      flex: 0 0 auto;
      gap: 0.5rem;
      border-left: 1px solid #334155;
      padding-left: 0.75rem;
    }
    .status-indicator-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: #22c55e;
      box-shadow: 0 0 6px #22c55e;
      flex-shrink: 0;
    }
    .status-label {
      color: #94a3b8;
      font-weight: 700;
      font-size: 0.72rem;
      text-transform: uppercase;
      letter-spacing: 0.4px;
      flex-shrink: 0;
    }
    .status-value {
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
      font-weight: 600;
      min-width: 0;
      transition: color 0.2s ease;
    }
    .status-action-text {
      color: #38bdf8;
    }
    .status-notice-text {
      color: #a7f3d0;
    }
    .status-time {
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
      font-size: 0.7rem;
      color: #64748b;
      flex-shrink: 0;
      margin-left: 0.25rem;
    }
    .status-badge-connection {
      background: #1e293b;
      color: #38bdf8;
      border: 1px solid #0284c7;
      padding: 0.15rem 0.45rem;
      border-radius: 4px;
      font-size: 0.7rem;
      font-weight: bold;
    }
    .status-log-btn {
      background: #1e293b;
      border: 1px solid #475569;
      color: #cbd5e1;
      padding: 0.2rem 0.55rem;
      border-radius: 4px;
      font-size: 0.72rem;
      font-weight: bold;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 0.3rem;
      transition: all 0.15s ease;
    }
    .status-log-btn:hover {
      background: #334155;
      color: #ffffff;
      border-color: #64748b;
    }

    /* アニメーション用 (操作や通知が変わった瞬間の視覚的フィードバック) */
    @keyframes statusPulseAction {
      0% { background: rgba(56, 189, 248, 0.35); border-radius: 4px; }
      100% { background: transparent; }
    }
    @keyframes statusPulseNotice {
      0% { background: rgba(52, 211, 153, 0.35); border-radius: 4px; }
      100% { background: transparent; }
    }
    .status-pulse-action {
      animation: statusPulseAction 0.9s ease-out;
    }
    .status-pulse-notice {
      animation: statusPulseNotice 0.9s ease-out;
    }

    /* 操作・通知 履歴ポップアップモーダル */
    .status-history-modal {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.55);
      backdrop-filter: blur(2px);
      display: flex;
      align-items: flex-end;
      justify-content: flex-end;
      padding: 0 1.5rem 48px 0;
      z-index: 10001;
    }
    .status-history-dialog {
      background: #0f172a;
      border: 1.5px solid #334155;
      border-radius: 8px;
      width: 540px;
      max-width: 92vw;
      max-height: 420px;
      box-shadow: 0 15px 30px rgba(0, 0, 0, 0.6);
      display: flex;
      flex-direction: column;
      overflow: hidden;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    }
    .status-history-header {
      padding: 0.6rem 0.85rem;
      background: #1e293b;
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-bottom: 1px solid #334155;
    }
    .status-history-close-btn {
      background: none;
      border: none;
      color: #94a3b8;
      font-size: 1.1rem;
      cursor: pointer;
      line-height: 1;
      padding: 0.1rem 0.3rem;
      border-radius: 4px;
    }
    .status-history-close-btn:hover {
      color: #ffffff;
      background: #334155;
    }
    .status-history-body {
      padding: 0.6rem;
      overflow-y: auto;
      flex: 1;
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
      background: #0b1120;
    }
    .status-history-item {
      padding: 0.4rem 0.6rem;
      background: #1e293b;
      border: 1px solid #334155;
      border-radius: 5px;
      font-size: 0.78rem;
      display: flex;
      align-items: flex-start;
      gap: 0.5rem;
    }
    .status-history-time {
      font-family: ui-monospace, SFMono-Regular, monospace;
      color: #64748b;
      flex-shrink: 0;
      font-size: 0.72rem;
      margin-top: 1px;
    }
    .status-history-type {
      font-weight: bold;
      font-size: 0.68rem;
      padding: 0.05rem 0.35rem;
      border-radius: 3px;
      flex-shrink: 0;
    }
    .type-action { background: #0369a1; color: #e0f2fe; }
    .type-notice { background: #065f46; color: #d1fae5; }
    .type-warning { background: #92400e; color: #fef3c7; }
    .type-error { background: #991b1b; color: #fee2e2; }
    .status-history-msg {
      color: #f1f5f9;
      word-break: break-all;
      flex: 1;
      line-height: 1.35;
    }
    .status-history-footer {
      padding: 0.45rem 0.85rem;
      background: #1e293b;
      border-top: 1px solid #334155;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .status-history-clear-btn {
      background: none;
      border: none;
      color: #94a3b8;
      font-size: 0.75rem;
      cursor: pointer;
      text-decoration: underline;
    }
    .status-history-clear-btn:hover {
      color: #f87171;
    }
    .status-history-ok-btn {
      background: #0284c7;
      color: #ffffff;
      border: none;
      padding: 0.28rem 0.8rem;
      border-radius: 4px;
      font-size: 0.75rem;
      font-weight: bold;
      cursor: pointer;
    }
    .status-history-ok-btn:hover {
      background: #0369a1;
    }
  </style>
</head>
<body>

  <!-- 上部操作ツールバー (スリムリボン・印刷時は非表示) -->
  <div class="screen-toolbar no-print">
    <div class="title-area">
      <a href="http://<%= serverHostname %>:<%= port %>/?orderType=IV&patientId=<%= encodeURIComponent(selectedPatient.id) %>" target="app_ordering_sender" onclick="return returnToOrdering(this.href);" class="btn-action" title="オーダリング画面へ戻る">
        <span>◀</span> <span>戻る</span>
      </a>
      <h2>💉 注射指示箋</h2>
      <span class="badge">A4横様式</span>
      
      <!-- 対象患者バッジ (コンパクト) -->
      <div style="background:#0f172a; color:#fef08a; border:1px solid #334155; padding:0.18rem 0.5rem; border-radius:4px; font-size:0.75rem; display:flex; align-items:center; gap:0.35rem; white-space:nowrap; margin-left:0.2rem;" title="対象患者（カルテ引き継ぎ）">
        <span style="color:#94a3b8; font-size:0.7rem;">👤</span>
        <strong style="color:white;">[<%= selectedPatient.id %>] <%= selectedPatient.name %> 様</strong>
        <span style="font-size:0.7rem; color:#7dd3fc;">(<%= selectedPatient.ward || 'しおかぜ' %>)</span>
      </div>
      <input type="hidden" id="quickPatientSelect" value="<%= selectedPatient.id %>">
    </div>

    <!-- 📅 指示開始日セレクター (リボン中央に配置) -->
    <div class="toolbar-date-group">
      <span class="toolbar-date-label">📅 開始日:</span>
      <input type="date" id="sheetStartDate" class="toolbar-date-input" value="<%= typeof initialStartDate !== 'undefined' ? initialStartDate : '' %>" onchange="onStartDateChange(this.value)">
      <button type="button" onclick="setQuickStartDate(0)" class="btn-date-quick" title="今日に設定">今日</button>
      <button type="button" onclick="setQuickStartDate(1)" class="btn-date-quick" title="明日に設定">明日</button>
    </div>

    <!-- 右側アクションボタン群 -->
    <div class="actions">
      <!-- 薬品検索モーダルを開くボタン -->
      <button type="button" class="btn-action" onclick="openMedSearchModal()" style="background:#0284c7; border-color:#38bdf8;" title="薬品マスタからインクリメンタル検索して指示箋に入力">
        <span>🔍</span> <span>薬品検索</span>
      </button>
      <!-- 採用薬一覧へ飛ぶボタン -->
      <a href="/medicines-list?cat=注射剤" target="app_medicines_list" class="btn-action" style="background:#334155; border-color:#475569;" title="検索機能付き採用薬一覧を開く">
        <span>📚</span> <span>採用薬</span>
      </a>
      <!-- 保存ボタン -->
      <button type="button" class="btn-action btn-success" onclick="saveSheetData()" title="ブラウザに一時保存">
        <span>💾</span> <span>保存</span>
      </button>
      <!-- 送信ボタン: 受信部門(Port 5000) & 電子カルテへ反映 -->
      <button type="button" class="btn-action btn-primary" onclick="submitToOrderingAndCarte()" style="box-shadow:0 1px 3px rgba(2,132,199,0.3);" title="部門モニターおよび電子カルテへオーダー送信">
        <span>🚀</span> <span>確定送信</span>
      </button>
      <!-- A4指示箋印刷ボタン -->
      <button type="button" class="btn-action" onclick="triggerPrintSheet()" style="background:#475569; border-color:#64748b;" title="原本様式のままA4横1枚で印刷します">
        <span>🖨️</span> <span>印刷</span>
      </button>
      <!-- クリアボタン -->
      <button type="button" class="btn-action" onclick="clearSheetForm()" style="background:#ef4444; border-color:#dc2626;" title="入力内容をクリア">
        <span>🧹</span>
      </button>
    </div>
  </div>

  <!-- A4横 用紙コンテナ (原本レイアウトを忠実に再現) -->
  <div class="paper-container" id="printablePaper">
    
    <!-- 上部パンチ穴 (原本の4つ穴を忠実に再現) -->
    <div class="punch-holes-bar">
      <div class="punch-hole" style="margin-left: 40px;"></div>
      <div class="punch-hole"></div>
      <div class="punch-hole"></div>
      <div class="punch-hole" style="margin-right: 40px;"></div>
    </div>

    <!-- ヘッダー部 -->
    <div class="inj-header">
      <!-- 左側: 注射指示 & 年月 & 開始日 -->
      <div class="inj-title-area">
        <div style="display:flex; align-items:baseline; gap:12px;">
          <h1 class="inj-main-title">注射指示</h1>
          <div class="inj-year-month-area" style="margin-left:0;">
            <input type="text" id="sheetYear" value="<%= new Date().getFullYear() %>" style="width: 48px;" onchange="syncDateFromYearMonth()">
            <span>年</span>
            <input type="text" id="sheetMonth" value="<%= new Date().getMonth() + 1 %>" style="width: 28px;" onchange="syncDateFromYearMonth()">
            <span>月</span>
          </div>
          <!-- 用紙内にも開始日の視覚的案内 -->
          <div class="no-print" style="font-size:12px; color:#0369a1; font-weight:bold; display:flex; align-items:center; gap:4px; font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">
            <span>(開始: <span id="labelStartDate"></span> 〜 15日間)</span>
          </div>
        </div>
      </div>

      <!-- 右側: 担当医・患者情報テーブル (原本忠実) -->
      <table class="inj-meta-table">
        <tr>
          <!-- 担当医 (2行結合) -->
          <td rowspan="2" class="meta-doctor-cell">
            <div class="meta-doctor-label">担当医</div>
            <div class="doctor-stamp-box" id="doctorStamp" onclick="toggleDoctorStamp()" title="クリックで印鑑切替">
              <span style="font-size:7px;">担当医</span>
              <span class="stamp-name" id="docStampName">北島</span>
            </div>
          </td>
          <!-- 病棟 -->
          <th style="width: 44px;">病棟</th>
          <td class="meta-ward-room-cell">
            <input type="text" class="meta-input-inline" id="metaWard" value="<%= selectedPatient.ward || 'しおかぜ' %>" readonly tabindex="-1" style="cursor:default;">
          </td>
          <!-- ID -->
          <td class="meta-id-name-cell">
            <div class="meta-id-row">
              <span style="width: 32px; font-weight: normal;">ID</span>
              <input type="text" class="underline-input" id="metaPatientId" value="<%= selectedPatient.id %>" readonly tabindex="-1" style="cursor:default; font-family:monospace; font-weight:bold;">
            </div>
          </td>
          <!-- 生年月日 -->
          <th style="width: 60px;">生年月日</th>
          <td class="meta-birth-sex-cell" style="user-select:none;">
            <span class="clickable-option" id="eraM" style="cursor:default;">M</span>・<span class="clickable-option" id="eraT" style="cursor:default;">T</span>・<span class="clickable-option era-circle" id="eraS" style="cursor:default;">S</span>
            <input type="text" id="metaBirthYear" value="<%= selectedPatient.birthDate ? selectedPatient.birthDate.split('-')[0].slice(2) : '21' %>" readonly tabindex="-1" style="width: 24px; text-align: center; border: none; border-bottom: 1px solid #000; font-family: inherit; font-size: 12px; outline: none; cursor:default;"> 年
            <input type="text" id="metaBirthMonth" value="<%= selectedPatient.birthDate ? selectedPatient.birthDate.split('-')[1] : '12' %>" readonly tabindex="-1" style="width: 20px; text-align: center; border: none; border-bottom: 1px solid #000; font-family: inherit; font-size: 12px; outline: none; cursor:default;"> 月
            <input type="text" id="metaBirthDay" value="<%= selectedPatient.birthDate ? selectedPatient.birthDate.split('-')[2] : '06' %>" readonly tabindex="-1" style="width: 20px; text-align: center; border: none; border-bottom: 1px solid #000; font-family: inherit; font-size: 12px; outline: none; cursor:default;"> 日
          </td>
        </tr>
        <tr>
          <!-- 号室 -->
          <th>号室</th>
          <td class="meta-ward-room-cell">
            <input type="text" class="meta-input-inline" id="metaRoom" value="<%= selectedPatient.room || '302号室' %>" readonly tabindex="-1" style="cursor:default;">
          </td>
          <!-- 氏名 -->
          <td class="meta-id-name-cell">
            <div class="meta-name-row">
              <span style="width: 32px; font-weight: normal;">氏名</span>
              <input type="text" class="underline-input" id="metaPatientName" value="<%= selectedPatient.name %>" readonly tabindex="-1" style="cursor:default; font-weight:bold; font-size:13px;">
              <span style="font-size: 13px; font-weight: bold; margin-left: 4px;">様</span>
            </div>
          </td>
          <!-- 性別 -->
          <th>性別</th>
          <td class="meta-birth-sex-cell" style="user-select:none;">
            <span class="clickable-option <%= selectedPatient.gender === '男' ? 'gender-circle' : '' %>" id="genderMale" style="cursor:default;">男</span>
            &nbsp;
            <span class="clickable-option <%= selectedPatient.gender === '女' ? 'gender-circle' : '' %>" id="genderFemale" style="cursor:default;">女</span>
            &nbsp;&nbsp;
            <input type="text" id="metaAge" value="<%= selectedPatient.age || '70' %>" readonly tabindex="-1" style="width: 28px; text-align: center; border: none; border-bottom: 1px solid #000; font-family: inherit; font-size: 12px; outline: none; cursor:default;"> 才
          </td>
        </tr>
      </table>
    </div>

    <!-- メイン指示テーブル (全10行 × 15日グリッド: 原本完全再現) -->
    <table class="main-grid-table">
      <thead>
        <tr class="grid-header-row">
          <th class="col-no"></th>
          <th class="col-rx">処　　方</th>
          <th class="col-route"></th>
          <th class="col-date-title">日付</th>
          <!-- 15日分カレンダーヘッダー -->
          <% for(let d = 1; d <= 15; d++) { %>
            <th class="col-day-cell <%= d === 1 ? 'border-thick-left' : '' %>" id="th_day_<%= d %>">
              <div class="day-header-wrapper">
                <input type="text" class="header-day-input" id="headerDay_<%= d %>" value="<%= d %>" title="クリックで日付を直接編集可能">
                <span class="header-day-dow no-print" id="headerDow_<%= d %>"></span>
              </div>
            </th>
          <% } %>
        </tr>
      </thead>
      <tbody id="sheetTbody">
        <% 
          // 既存オーダーの薬品リストを引き継ぐ（もしあれば）
          const existingMeds = (targetOrder && targetOrder.details && targetOrder.details.medicines) ? targetOrder.details.medicines : [];
        %>
        <!-- 1行目〜10行目 (原本に忠実な10行構成) -->
        <% for(let r = 1; r <= 10; r++) { 
             const currentMed = existingMeds[r - 1] || null;
             let defaultRxText = '';
             let defaultRoute = 'DIV';
             if (currentMed) {
               defaultRxText = `${currentMed.medicine || ''} ${currentMed.dosage || ''}\n${currentMed.rate ? '速度: ' + currentMed.rate : ''} ${currentMed.remarks || ''}`.trim();
               defaultRoute = currentMed.route || 'DIV';
             } else if (r === 1 && !targetOrder) {
               defaultRxText = 'ソルデム3号輸液 200mL 1袋\nファモチジン静注 20mg 1管 (側管注 80mL/h)';
               defaultRoute = 'DIV';
             } else if (r === 2 && !targetOrder) {
               defaultRxText = 'ブドウ糖注射液 5% 500mL 1袋\n(末梢静脈点滴 60mL/h)';
               defaultRoute = 'DIV';
             }
        %>
          <tr class="grid-data-row" data-row="<%= r %>">
            <!-- 左端 細列 (行番号) -->
            <td class="col-no cell-no"><%= r %></td>

            <!-- 処方欄 (キー入力で自動インクリメンタル検索発動) -->
            <td class="col-rx cell-rx" onmouseenter="onCellRxMouseEnter(this, <%= r %>)" onmouseleave="onCellRxMouseLeave(this, <%= r %>)">
              <div style="position:relative; width:100%; height:100%;">
                <div class="rx-cell-header no-print">
                  <span class="rx-med-info-badge" id="rxInfoBadge_<%= r %>"
                        onmouseenter="onInfoBadgeMouseEnter(this, <%= r %>)"
                        onmouseleave="onInfoBadgeMouseLeave()"
                        title="ホバーで薬品詳細・用法を表示"></span>
                </div>
                <textarea class="rx-textarea" id="rxText_<%= r %>"
                          placeholder="薬品名・規格・速度を入力（キー入力で自動インクリメンタル検索）"
                          autocomplete="off"
                          oninput="onSheetRxInput(<%= r %>, this, event)"
                          onkeydown="onSheetRxKeydown(<%= r %>, this, event)"
                          onfocus="onSheetRxFocus(<%= r %>, this, event)"
                          ondblclick="openMedSearchModal(<%= r %>)"><%= defaultRxText %></textarea>
              </div>
              <button type="button" class="rx-quick-btn no-print" onclick="openMedSearchModal(<%= r %>)" title="薬品マスタから検索して入力">🔍 検索</button>
            </td>

            <!-- 投与経路欄 (is, DIV / im, IVH / iv, ( )) 原本配置再現 -->
            <td class="col-route cell-route">
              <div class="route-grid" id="routeGrid_<%= r %>">
                <div class="route-item" onclick="selectRoute(<%= r %>, 'is')">
                  <span class="<%= defaultRoute === 'is' ? 'route-selected' : '' %>" id="route_<%= r %>_is">is</span>
                </div>
                <div class="route-item" onclick="selectRoute(<%= r %>, 'DIV')">
                  <span class="<%= defaultRoute === 'DIV' ? 'route-selected' : '' %>" id="route_<%= r %>_DIV">DIV</span>
                </div>
                <div class="route-item" onclick="selectRoute(<%= r %>, 'im')">
                  <span class="<%= defaultRoute === 'im' ? 'route-selected' : '' %>" id="route_<%= r %>_im">im</span>
                </div>
                <div class="route-item" onclick="selectRoute(<%= r %>, 'IVH')">
                  <span class="<%= defaultRoute === 'IVH' ? 'route-selected' : '' %>" id="route_<%= r %>_IVH">IVH</span>
                </div>
                <div class="route-item" onclick="selectRoute(<%= r %>, 'iv')">
                  <span class="<%= defaultRoute === 'iv' ? 'route-selected' : '' %>" id="route_<%= r %>_iv">iv</span>
                </div>
                <div class="route-item" onclick="selectRoute(<%= r %>, 'OTHER')">
                  <span class="<%= (defaultRoute !== 'is' && defaultRoute !== 'DIV' && defaultRoute !== 'im' && defaultRoute !== 'IVH' && defaultRoute !== 'iv') ? 'route-selected' : '' %>" id="route_<%= r %>_OTHER">( &nbsp; )</span>
                </div>
              </div>
            </td>

            <!-- 日付列ラベル (指示 / 実施 原本破線再現) -->
            <td class="col-date-title cell-date-label">
              <div class="split-top-bottom">
                <div class="split-top">指示</div>
                <div class="split-bottom">実施</div>
              </div>
            </td>

            <!-- 15日分 グリッドセル (破線区切り) -->
            <% for(let d = 1; d <= 15; d++) { 
                 let topContent = '';
                 let bottomContent = '';
                 // デフォルトで1〜3日目に指示・実施例を少し配置（雰囲気確認用）
                 if ((r === 1 || r === 2) && d <= 3 && !targetOrder) {
                   topContent = '<span style="color:#0284c7; font-weight:bold;">──▶</span>';
                   bottomContent = '<span style="color:#16a34a; font-weight:bold;">✔ 看</span>';
                 }
            %>
              <td class="col-day-cell day-matrix-cell <%= d === 1 ? 'border-thick-left' : '' %>">
                <div class="split-top-bottom">
                  <!-- 上段: 指示 (クリックで ──▶ / ✕中止 / サイン / 空 切替) -->
                  <div class="split-top cell-interactive" onclick="toggleCellTop(this, <%= r %>, <%= d %>)" title="クリックで指示内容を切替" id="cell_top_<%= r %>_<%= d %>"><%- topContent %></div>
                  <!-- 下段: 実施 (クリックで ✔ / 看 / 時刻 / 空 切替) -->
                  <div class="split-bottom cell-interactive" onclick="toggleCellBottom(this, <%= r %>, <%= d %>)" title="クリックで実施確認を切替" id="cell_bottom_<%= r %>_<%= d %>"><%- bottomContent %></div>
                </div>
              </td>
            <% } %>
          </tr>
        <% } %>
      </tbody>
    </table>

    <!-- フッター部 (病棟枠 / 薬剤師枠 / だて病院ロゴ) -->
    <div class="inj-footer">
      <!-- 左下: 独立枠「病　棟」 (原本忠実) -->
      <div>
        <div class="ward-stamp-box" id="wardStampBox" onclick="toggleWardStamp()" title="クリックで病棟受領印切替">
          病　棟
        </div>
      </div>

      <!-- 中央〜右: テーブル底辺直結の「薬剤師」枠 ＋ 15日鑑査枠 (原本忠実) -->
      <div class="pharmacist-container">
        <table class="pharmacist-table">
          <tr>
            <th class="pharmacist-th" onclick="togglePharmacistAll()" title="クリックで全日鑑査印" style="cursor:pointer;">薬剤師</th>
            <% for(let d = 1; d <= 15; d++) { %>
              <td class="pharmacist-cell" onclick="togglePharmacistCell(this, <%= d %>)" id="pharma_cell_<%= d %>" title="薬剤師確認印">
                <% if (d <= 3 && !targetOrder) { %>
                  <span style="color:#2563eb; font-size:10px; font-weight:bold;">調</span>
                <% } %>
              </td>
            <% } %>
          </tr>
        </table>
      </div>

      <!-- 右下欄外: 発行元・様式番号 (原本忠実) -->
      <div class="footer-hospital-stamp">
        交雄会だて病院　2026.5　1.0
      </div>
    </div>

  </div>

  <!-- 💊 処方枠インクリメンタル検索 フローティングパネル (キー入力で自動発動) -->
  <div id="sheetFloatingSearch" class="sheet-floating-search no-print" style="display:none;">
