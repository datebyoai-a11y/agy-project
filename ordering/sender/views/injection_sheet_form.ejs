    function renderStatusHistoryList() {
      const container = document.getElementById('statusHistoryList');
      if (!container) return;
      if (statusHistory.length === 0) {
        container.innerHTML = '<div style="color:#64748b; text-align:center; padding:1.5rem 0; font-size:0.8rem;">操作・通知履歴はありません</div>';
        return;
      }
      let html = '';
      statusHistory.forEach(item => {
        let typeClass = 'type-action';
        let typeLabel = '操作';
        if (item.type === 'success') { typeClass = 'type-notice'; typeLabel = '成功'; }
        else if (item.type === 'notice' || item.type === 'info') { typeClass = 'type-notice'; typeLabel = '通知'; }
        else if (item.type === 'warning') { typeClass = 'type-warning'; typeLabel = '注意'; }
        else if (item.type === 'error') { typeClass = 'type-error'; typeLabel = 'エラー'; }

        html += `
          <div class="status-history-item">
            <span class="status-history-time">${escapeHtml(item.time)}</span>
            <span class="status-history-type ${typeClass}">${typeLabel}</span>
            <span class="status-history-msg">${escapeHtml(item.message)}</span>
          </div>
        `;
      });
      container.innerHTML = html;
