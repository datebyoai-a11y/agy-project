          <button type="button" onclick="clearModalKeyword()" id="modalKeywordClearBtn" style="position:absolute; right:10px; top:50%; transform:translateY(-50%); background:none; border:none; color:#94a3b8; font-size:1.1rem; cursor:pointer; display:none;" title="クリア">✕</button>
        </div>

        <!-- 検索結果情報バー -->
        <div style="display:flex; justify-content:space-between; align-items:center; font-size:0.78rem; color:#64748b; margin-bottom:0.4rem; padding:0 2px;">
          <span id="modalResultCountText">読み込み中...</span>
          <span style="font-size:0.72rem; color:#94a3b8;">※ 行クリックまたは「反映」で指定処方枠に転記 / [↑][↓]キーで選択 [Enter]で反映確定</span>
