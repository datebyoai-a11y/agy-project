            <button type="button" onclick="selectMedicine('${activeLookupTarget}', '${m.id}'); closeMedicineModal();" style="background:#0284c7; color:white; border:none; padding:0.25rem 0.55rem; border-radius:4px; font-size:0.72rem; font-weight:bold; cursor:pointer;">
              選択
