                  <span id="rxUnitLabel_${item.id}" style="background:#e2e8f0; color:#1e293b; padding:0.25rem 0.5rem; border-radius:4px; font-weight:bold; font-size:0.75rem; white-space:nowrap; border:1px solid #cbd5e1;" title="薬剤マスタの単位">
                    ${escapeHtml(item.unit || '錠')}
