      border-color: #0284c7;
      box-shadow: 0 2px 6px rgba(2, 132, 199, 0.4);
      transform: translateY(-1px);
    }
    .tab-btn.tab-rx.active { background: #059669; border-color: #059669; }
    .tab-btn.tab-iv.active { background: #0284c7; border-color: #0284c7; }
    .tab-btn.tab-rad.active { background: #7c3aed; border-color: #7c3aed; }
    .tab-btn.tab-lab.active { background: #db2777; border-color: #db2777; }
    .tab-btn.tab-rehab.active { background: #ea580c; border-color: #ea580c; }
    .tab-btn.tab-meal.active { background: #d97706; border-color: #d97706; }

    /* 優先度ラジオ */
    .priority-group {
      display: flex;
      gap: 0.4rem;
    }
    .priority-label {
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.25rem;
      font-size: 0.78rem;
      font-weight: bold;
      padding: 0.35rem 0.2rem;
      border: 1px solid #cbd5e1;
      border-radius: 5px;
      cursor: pointer;
    }
    .priority-label input { cursor: pointer; }
    .priority-label.stat { color: #dc2626; border-color: #fca5a5; }
    .priority-label.urgent { color: #ea580c; border-color: #fdba74; }
    .priority-label.routine { color: #0284c7; border-color: #bae6fd; }

    /* 送信ボタン */
    .btn-submit {
      background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%);
      color: white;
      border: none;
      padding: 0.75rem;
      font-size: 0.95rem;
      font-weight: bold;
      border-radius: 6px;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      transition: background 0.15s, transform 0.1s;
      box-shadow: 0 3px 8px rgba(2,132,199,0.3);
      margin-top: 0.25rem;
    }
    .btn-submit:hover {
      background: linear-gradient(135deg, #0369a1 0%, #075985 100%);
    }
    .btn-submit:active {
      transform: translateY(1px);
    }

    /* 右列: 送信履歴・ステータス画面 (縦2列の右側) */
    .history-card {
      background: white;
      border: 1px solid #cbd5e1;
      border-radius: 0 8px 8px 0;
      padding: 0.85rem 1rem;
      box-shadow: 0 2px 6px rgba(0,0,0,0.06);
      display: flex;
      flex-direction: column;
      gap: 0.6rem;
      flex: 1 1 0;
      min-width: 320px;
      box-sizing: border-box;
      overflow-x: hidden;
      overflow-y: auto;
      height: 100%;
    }
    .history-mode-btn {
      background: transparent;
      border: none;
      padding: 0.2rem 0.45rem;
      border-radius: 3px;
      font-size: 0.72rem;
      font-weight: bold;
      color: #64748b;
      cursor: pointer;
      transition: all 0.15s;
    }
    .history-mode-btn.active {
      background: white;
      color: #0284c7;
      box-shadow: 0 1px 2px rgba(0,0,0,0.1);
    }
    .history-list {
      flex: 1;
      overflow-y: auto;
      display: flex;
      flex-direction: column;
      gap: 0.55rem;
      max-height: 750px;
    }
    .history-item {
      background: #f8fafc;
      border: 1px solid #e2e8f0;
      border-left: 4px solid #0284c7;
      border-radius: 6px;
      padding: 0.6rem 0.75rem;
      font-size: 0.8rem;
      transition: all 0.15s;
      word-break: break-word;
      overflow-wrap: anywhere;
    }
    .history-card.wrap-mode .history-title,
    .history-card.wrap-mode .history-remarks,
    .history-card.wrap-mode .history-action-note,
    .history-card.wrap-mode .history-meta {
      white-space: normal !important;
      word-break: break-word;
      overflow-wrap: anywhere;
      line-height: 1.45;
    }
    .history-card:not(.wrap-mode) .history-title,
    .history-card:not(.wrap-mode) .history-remarks {
      white-space: nowrap !important;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    /* 送信履歴テーブル表示モード */
    .history-table-container {
      flex: 1;
      overflow-x: auto;
      overflow-y: auto;
      max-height: 750px;
      border: 1px solid #e2e8f0;
      border-radius: 6px;
      background: white;
      position: relative;
    }
    .history-table {
      width: 100%;
      min-width: 100%;
      border-collapse: collapse;
      font-size: 0.78rem;
      table-layout: fixed;
    }
    .history-table th {
      background: #f8fafc;
      color: #475569;
      font-weight: 700;
      padding: 0.55rem 0.5rem;
      border-bottom: 2px solid #cbd5e1;
      white-space: nowrap;
      position: sticky;
      top: 0;
      z-index: 15;
      user-select: none;
      box-sizing: border-box;
      overflow: visible;
    }
    .history-table td {
      padding: 0.5rem 0.55rem;
      border-bottom: 1px solid #e2e8f0;
      vertical-align: middle;
      box-sizing: border-box;
    }
    .history-table.wrap-mode td {
      white-space: normal;
      word-break: break-word;
      overflow-wrap: anywhere;
    }
    .history-table.wrap-mode .details-cell {
      white-space: normal !important;
      word-break: break-word;
      overflow-wrap: anywhere;
      line-height: 1.45;
    }
    .history-table:not(.wrap-mode) td {
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    /* 列幅ドラッグ境界線 (Resizer Handle) */
    .col-resizer {
      position: absolute;
      top: 0;
      right: -4px;
      width: 10px;
      height: 100%;
      cursor: col-resize;
      user-select: none;
      z-index: 20;
      touch-action: none;
    }
    .col-resizer::after {
      content: '';
      position: absolute;
      top: 15%;
      bottom: 15%;
      right: 4px;
      width: 2px;
      background: #cbd5e1;
      border-radius: 1px;
      transition: all 0.15s ease;
    }
    .col-resizer:hover::after,
    .col-resizer.is-resizing::after {
      background: #0284c7;
      width: 4px;
      right: 3px;
      top: 0;
      bottom: 0;
    }
    .col-resizer:hover,
    .col-resizer.is-resizing {
      background: rgba(2, 132, 199, 0.12);
    }
    body.is-col-resizing {
      cursor: col-resize !important;
      user-select: none !important;
    }
    .col-resize-guide {
      position: absolute;
      top: 0;
      width: 2px;
      background: #0284c7;
      pointer-events: none;
      z-index: 25;
      display: none;
      box-shadow: 0 0 6px rgba(2, 132, 199, 0.6);
    }

    /* 薬品マスタモーダルテーブル */
    .med-master-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.78rem;
      table-layout: fixed;
    }
    .med-master-table th {
      background: #f8fafc;
      position: sticky;
      top: 0;
      z-index: 10;
      border-bottom: 2px solid #cbd5e1;
      padding: 0.45rem 0.6rem;
      text-align: left;
      user-select: none;
      position: relative;
    }
    .med-master-table td {
      padding: 0.45rem 0.6rem;
      border-bottom: 1px solid #f1f5f9;
      vertical-align: middle;
      word-break: break-word;
      overflow-wrap: anywhere;
    }
    .history-item.status-SENT { border-left-color: #64748b; }
    .history-item.status-RECEIVED { border-left-color: #0284c7; background: #f0f9ff; }
    .history-item.status-ACCEPTED { border-left-color: #f59e0b; background: #fffdf5; }
    .history-item.status-IN_PROGRESS { border-left-color: #8b5cf6; background: #faf5ff; }
    .history-item.status-COMPLETED { border-left-color: #10b981; background: #f0fdf4; }
    .history-item.status-FAILED { border-left-color: #ef4444; background: #fffcfc; }
    .history-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 0.25rem;
    }
    .history-meta {
      font-size: 0.72rem;
      color: #64748b;
      margin-bottom: 0.35rem;
    }
    .status-tag {
      padding: 0.12rem 0.45rem;
      border-radius: 4px;
      font-size: 0.7rem;
      font-weight: bold;
      display: inline-flex;
      align-items: center;
      gap: 0.2rem;
    }
    .status-tag.SENT { background: #f1f5f9; color: #475569; border: 1px solid #e2e8f0; }
    .status-tag.RECEIVED { background: #e0f2fe; color: #0369a1; border: 1px solid #bae6fd; }
    .status-tag.ACCEPTED { background: #fef3c7; color: #b45309; border: 1px solid #fde68a; }
    .status-tag.IN_PROGRESS { background: #ede9fe; color: #6d28d9; border: 1px solid #ddd6fe; }
    .status-tag.COMPLETED { background: #d1fae5; color: #065f46; border: 1px solid #a7f3d0; }
    .status-tag.FAILED { background: #fee2e2; color: #991b1b; border: 1px solid #fecaca; }

    @keyframes highlightPulse {
      0% { transform: scale(1); box-shadow: 0 0 0 rgba(16, 185, 129, 0.6); }
      50% { transform: scale(1.015); box-shadow: 0 0 10px rgba(16, 185, 129, 0.7); background: #f0fdf4; }
      100% { transform: scale(1); box-shadow: none; }
    }
    .history-item.status-updated {
      animation: highlightPulse 1.2s ease-in-out;
    }

    /* トースト通知 */
    #toast {
      position: fixed;
      bottom: 46px;
      right: 24px;
      background: #0f172a;
      color: white;
      padding: 0.75rem 1.25rem;
      border-radius: 8px;
      font-size: 0.85rem;
      font-weight: bold;
      display: none;
      align-items: center;
      gap: 0.5rem;
      box-shadow: 0 8px 20px rgba(0,0,0,0.25);
      z-index: 10000;
    }

    /* 最下段固定ステータスバー */
    .app-status-bar {
      height: 36px;
      background: #0f172a;
      border-top: 1.5px solid #1e293b;
      color: #cbd5e1;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      font-size: 0.78rem;
      z-index: 9990;
      box-shadow: 0 -3px 12px rgba(0, 0, 0, 0.3);
      display: flex;
      align-items: center;
      flex-shrink: 0;
      user-select: none;
    }
    .status-bar-container {
      width: 100%;
      margin: 0 auto;
      padding: 0 1rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 1rem;
    }
    .status-section {
      display: flex;
      align-items: center;
      gap: 0.45rem;
      white-space: nowrap;
      min-width: 0;
    }
    .status-left {
      flex: 1 1 45%;
      min-width: 0;
      overflow: hidden;
    }
    .status-center {
      flex: 1 1 45%;
      min-width: 0;
      overflow: hidden;
      border-left: 1px solid #334155;
      padding-left: 0.75rem;
    }
    .status-right {
      flex: 0 0 auto;
      gap: 0.5rem;
      border-left: 1px solid #334155;
      padding-left: 0.75rem;
    }
    .status-indicator-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: #22c55e;
      box-shadow: 0 0 6px #22c55e;
      flex-shrink: 0;
    }
    .status-label {
      color: #94a3b8;
      font-weight: 700;
      font-size: 0.72rem;
      text-transform: uppercase;
      letter-spacing: 0.4px;
      flex-shrink: 0;
    }
    .status-value {
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
      font-weight: 600;
      min-width: 0;
      transition: color 0.2s ease;
    }
    .status-action-text {
      color: #38bdf8;
    }
    .status-notice-text {
      color: #a7f3d0;
    }
    .status-time {
      font-family: ui-monospace, SFMono-Regular, monospace;
      font-size: 0.7rem;
      color: #64748b;
      flex-shrink: 0;
      margin-left: 0.25rem;
    }
    .status-badge-connection {
      background: #1e293b;
      color: #38bdf8;
      border: 1px solid #0284c7;
      padding: 0.15rem 0.45rem;
      border-radius: 4px;
      font-size: 0.7rem;
      font-weight: bold;
    }
    .status-log-btn {
      background: #1e293b;
      border: 1px solid #475569;
      color: #cbd5e1;
      padding: 0.2rem 0.55rem;
      border-radius: 4px;
      font-size: 0.72rem;
      font-weight: bold;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 0.3rem;
      transition: all 0.15s ease;
    }
    .status-log-btn:hover {
      background: #334155;
      color: #ffffff;
      border-color: #64748b;
    }

    @keyframes statusPulseAction {
      0% { background: rgba(56, 189, 248, 0.35); border-radius: 4px; }
      100% { background: transparent; }
    }
    @keyframes statusPulseNotice {
      0% { background: rgba(52, 211, 153, 0.35); border-radius: 4px; }
      100% { background: transparent; }
    }
    .status-pulse-action {
      animation: statusPulseAction 0.9s ease-out;
    }
    .status-pulse-notice {
      animation: statusPulseNotice 0.9s ease-out;
    }

    /* 操作・通知 履歴ポップアップモーダル */
    .status-history-modal {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.55);
      backdrop-filter: blur(2px);
      display: flex;
      align-items: flex-end;
      justify-content: flex-end;
      padding: 0 1.5rem 44px 0;
      z-index: 10001;
    }
    .status-history-dialog {
      background: #0f172a;
      border: 1.5px solid #334155;
      border-radius: 8px;
      width: 540px;
      max-width: 92vw;
      max-height: 420px;
      box-shadow: 0 15px 30px rgba(0, 0, 0, 0.6);
      display: flex;
      flex-direction: column;
      overflow: hidden;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    }
    .status-history-header {
      padding: 0.6rem 0.85rem;
      background: #1e293b;
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-bottom: 1px solid #334155;
    }
    .status-history-close-btn {
      background: none;
      border: none;
      color: #94a3b8;
      font-size: 1.1rem;
      cursor: pointer;
      line-height: 1;
      padding: 0.1rem 0.3rem;
      border-radius: 4px;
    }
    .status-history-close-btn:hover {
      color: #ffffff;
      background: #334155;
    }
    .status-history-body {
      padding: 0.6rem;
      overflow-y: auto;
      flex: 1;
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
      background: #0b1120;
    }
    .status-history-item {
      padding: 0.4rem 0.6rem;
      background: #1e293b;
      border: 1px solid #334155;
      border-radius: 5px;
      font-size: 0.78rem;
      display: flex;
      align-items: flex-start;
      gap: 0.5rem;
    }
    .status-history-time {
      font-family: ui-monospace, SFMono-Regular, monospace;
      color: #64748b;
      flex-shrink: 0;
      font-size: 0.72rem;
      margin-top: 1px;
    }
    .status-history-type {
      font-weight: bold;
      font-size: 0.68rem;
      padding: 0.05rem 0.35rem;
      border-radius: 3px;
      flex-shrink: 0;
    }
    .type-action { background: #0369a1; color: #e0f2fe; }
    .type-notice { background: #065f46; color: #d1fae5; }
    .type-warning { background: #92400e; color: #fef3c7; }
    .type-error { background: #991b1b; color: #fee2e2; }
    .status-history-msg {
      color: #f1f5f9;
      word-break: break-all;
      flex: 1;
      line-height: 1.35;
    }
    .status-history-footer {
      padding: 0.45rem 0.85rem;
      background: #1e293b;
      border-top: 1px solid #334155;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .status-history-clear-btn {
      background: none;
      border: none;
      color: #94a3b8;
      font-size: 0.75rem;
      cursor: pointer;
      text-decoration: underline;
    }
    .status-history-clear-btn:hover {
      color: #f87171;
    }
    .status-history-ok-btn {
      background: #0284c7;
      color: #ffffff;
      border: none;
      padding: 0.28rem 0.8rem;
      border-radius: 4px;
      font-size: 0.75rem;
      font-weight: bold;
      cursor: pointer;
    }
    .status-history-ok-btn:hover {
      background: #0369a1;
    }

    /* 薬品サジェスト ドロップダウン & 詳細バッジ */
    .med-suggest-dropdown {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: white;
      border: 1px solid #cbd5e1;
      border-radius: 6px;
      box-shadow: 0 10px 25px rgba(0,0,0,0.15);
      max-height: 280px;
      overflow-y: auto;
      z-index: 1000;
      margin-top: 3px;
    }
    .med-suggest-item {
      padding: 0.45rem 0.7rem;
      border-bottom: 1px solid #f1f5f9;
      cursor: pointer;
      display: flex;
      justify-content: space-between;
      align-items: center;
      transition: background-color 0.12s;
    }
    .med-suggest-item:hover {
      background-color: #f0fdf4;
    }
    .med-suggest-main {
      font-size: 0.82rem;
      font-weight: bold;
      color: #0f172a;
    }
    .med-suggest-sub {
      font-size: 0.7rem;
      color: #64748b;
      margin-top: 0.1rem;
    }
    .med-suggest-badges {
      display: flex;
      gap: 0.2rem;
      align-items: center;
      flex-wrap: wrap;
    }

    .med-detail-card {
      margin-top: 0.35rem;
      background: #f8fafc;
      border: 1px solid #e2e8f0;
      border-left: 4px solid #0284c7;
      border-radius: 6px;
      padding: 0.45rem 0.7rem;
      font-size: 0.73rem;
      line-height: 1.35;
    }
    .med-tag {
      display: inline-block;
      padding: 0.1rem 0.35rem;
      border-radius: 3px;
      font-size: 0.65rem;
      font-weight: bold;
      white-space: nowrap;
    }
    .med-tag-brand-orig { background: #dbeafe; color: #1e40af; border: 1px solid #bfdbfe; }
    .med-tag-brand-gen { background: #fef3c7; color: #92400e; border: 1px solid #fde68a; }
    .med-tag-ok { background: #dcfce7; color: #15803d; border: 1px solid #bbf7d0; }
    .med-tag-ng { background: #fee2e2; color: #b91c1c; border: 1px solid #fecaca; }
    .med-tag-warn { background: #ffedd5; color: #c2410c; border: 1px solid #fed7aa; }

    .btn-lookup {
      background: #f0f9ff;
      color: #0284c7;
      border: 1px solid #bae6fd;
      padding: 0.18rem 0.5rem;
      border-radius: 4px;
      font-size: 0.72rem;
      font-weight: bold;
      cursor: pointer;
      transition: all 0.15s;
    }
    .btn-lookup:hover {
      background: #0284c7;
      color: white;
    }

    /* 薬品マスタモーダル */
    .modal-overlay {
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,0.5);
      display: none;
      align-items: center;
      justify-content: center;
      z-index: 10000;
    }
    .modal-content {
      background: white;
      border-radius: 8px;
      width: 92%;
      max-width: 860px;
      max-height: 88vh;
      overflow-y: auto;
      padding: 1.25rem;
      box-shadow: 0 10px 25px rgba(0,0,0,0.25);
    }
    .filter-btn {
      background: #f8fafc;
      border: 1px solid #cbd5e1;
      color: #475569;
      padding: 0.35rem 0.75rem;
      border-radius: 6px;
      font-size: 0.8rem;
      font-weight: bold;
      cursor: pointer;
      transition: all 0.15s;
    }
    .filter-btn.active {
      background: #0284c7;
      color: white;
      border-color: #0369a1;
    }

    /* 複数薬剤処方カード */
    .rx-item-card {
      background: #ffffff;
      border: 1px solid #cbd5e1;
      border-left: 4px solid #0284c7;
      border-radius: 6px;
      padding: 0.55rem 0.7rem;
      box-shadow: 0 1px 2px rgba(0,0,0,0.03);
    }
    .rx-item-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 0.3rem;
    }
    .rx-rp-badge {
      background: #0284c7;
      color: white;
      font-size: 0.75rem;
      font-weight: bold;
      padding: 0.12rem 0.45rem;
      border-radius: 4px;
    }
    .btn-rx-delete {
      background: #fee2e2;
      color: #b91c1c;
      border: 1px solid #fecaca;
      padding: 0.15rem 0.45rem;
      border-radius: 4px;
      font-size: 0.7rem;
      font-weight: bold;
      cursor: pointer;
    }
    .btn-rx-delete:hover {
      background: #fca5a5;
      color: white;
    }

    /* 注射指示 投与経路選択ボタン群 */
    .route-pill-group {
      display: flex;
      gap: 0.4rem;
      flex-wrap: wrap;
    }
    .route-pill {
      display: flex;
      align-items: center;
      gap: 0.3rem;
      font-size: 0.8rem;
      font-weight: bold;
      padding: 0.3rem 0.65rem;
      border: 1px solid #cbd5e1;
      border-radius: 9999px;
      background: white;
      cursor: pointer;
      transition: all 0.15s;
    }
    .route-pill.active {
      background: #166534;
      color: white;
      border-color: #15803d;
    }

    /* リハビリ大区分見出し */
    .rehab-section-title {
      font-size: 0.82rem;
      font-weight: bold;
      color: #065f46;
      background: #e6fcf5;
      padding: 0.25rem 0.5rem;
      border-radius: 4px;
      margin-top: 0.4rem;
    }

    /* 注射指示箋 インタラクティブ操作スタイル */
    .inj-rx-cell[contenteditable="true"] {
      cursor: text;
      transition: background-color 0.15s, outline 0.15s;
    }
    .inj-rx-cell[contenteditable="true"]:hover {
      background-color: #f0fdf4;
      outline: 1px dashed #86efac;
    }
    .inj-rx-cell[contenteditable="true"]:focus {
      background-color: #ffffff;
      outline: 2px solid #0284c7;
    }
    .inj-route-item {
      cursor: pointer;
      user-select: none;
      transition: all 0.1s;
      border-radius: 3px;
      padding: 1px 2px;
    }
    .inj-route-item:hover {
      background-color: #fee2e2;
    }
    .inj-day-top {
      cursor: pointer;
      user-select: none;
      transition: background-color 0.1s;
    }
    .inj-day-top:hover {
      background-color: #e0f2fe;
    }
    .inj-day-bottom {
      cursor: pointer;
      user-select: none;
      transition: background-color 0.1s;
    }
    .inj-day-bottom:hover {
      background-color: #f0fdf4;
    }
    .inj-day-cancel {
      color: #dc2626;
      font-weight: 900;
      text-align: center;
      line-height: 1;
    }
    .inj-exec-check {
      color: #16a34a;
      font-weight: 900;
      text-align: center;
      line-height: 1;
    }
    .inj-exec-stamp {
      border: 1.2px solid #dc2626;
      color: #dc2626;
      border-radius: 50%;
      width: 18px;
      height: 18px;
      line-height: 16px;
      font-size: 8.5px;
      font-weight: bold;
      text-align: center;
      margin: 0 auto;
    }
    .inj-editable-meta[contenteditable="true"] {
      cursor: text;
      transition: background-color 0.15s;
    }
    .inj-editable-meta[contenteditable="true"]:hover {
      background-color: #f0f9ff;
      outline: 1px dashed #38bdf8;
    }
    .inj-editable-meta[contenteditable="true"]:focus {
      background-color: #ffffff;
      outline: 1.5px solid #0284c7;
    }

    /* 注射指示箋プレビュー & A4横用紙スタイル */
    .injection-modal-overlay {
      display: none;
      position: fixed;
      top: 0; left: 0; right: 0; bottom: 0;
      background: rgba(15, 23, 42, 0.75);
      backdrop-filter: blur(4px);
      z-index: 9999;
      align-items: center;
      justify-content: center;
      overflow-y: auto;
      padding: 1.5rem;
    }
    .injection-modal-wrapper {
      background: white;
      border-radius: 12px;
      box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.35);
      width: 100%;
      max-width: 1140px;
      margin: auto;
      overflow: hidden;
      display: flex;
      flex-direction: column;
    }
    .inj-preview-toolbar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 0.8rem 1.25rem;
      background: #f8fafc;
      border-bottom: 1px solid #e2e8f0;
    }
    .btn-inj-action {
      background: #0284c7;
      color: white;
      border: none;
      padding: 0.55rem 1.2rem;
      border-radius: 6px;
      font-weight: bold;
      font-size: 0.9rem;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 0.4rem;
      box-shadow: 0 2px 5px rgba(2,132,199,0.25);
    }
    .btn-inj-action:hover { background: #0369a1; }
    .btn-close-print {
      background: white;
      color: #475569;
      border: 1px solid #cbd5e1;
      padding: 0.5rem 0.9rem;
      border-radius: 6px;
      font-weight: bold;
      font-size: 0.85rem;
      cursor: pointer;
    }
    .btn-inj-print { background: #e0f2fe; color: #0284c7; border: 1px solid #7dd3fc; }
    .btn-inj-print:hover { background: #0284c7; color: white; }

    /* A4 横向き 注射指示箋 用紙スタイル */
    .injection-sheet-container {
      padding: 1.5rem;
      background: #cbd5e1;
      display: flex;
      justify-content: center;
      overflow-x: auto;
    }
    .injection-sheet {
      background: #ffffff;
      border: 1.5px solid #000000;
      color: #000000;
      width: 1050px;
      min-height: 720px;
      padding: 14px 20px 10px 20px;
      box-sizing: border-box;
      position: relative;
      font-family: -apple-system, BlinkMacSystemFont, "Hiragino Kaku Gothic ProN", "Yu Gothic", Meiryo, sans-serif;
      box-shadow: 0 4px 15px rgba(0,0,0,0.15);
    }
    .punch-holes-bar {
      position: absolute;
      top: 10px;
      left: 0;
      width: 100%;
      display: flex;
      justify-content: space-around;
      padding: 0 100px;
      box-sizing: border-box;
      pointer-events: none;
    }
    .punch-hole {
      width: 16px;
      height: 16px;
      border-radius: 50%;
      background: #e2e8f0;
      border: 1px solid #94a3b8;
      box-shadow: inset 0 1px 3px rgba(0,0,0,0.3);
    }
    .inj-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      margin-top: 18px;
      margin-bottom: 8px;
    }
    .inj-title-area {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }
    .inj-main-title {
      font-size: 26px;
      font-weight: 900;
      letter-spacing: 4px;
      margin: 0;
      color: #000;
      line-height: 1.1;
    }
    .inj-date-title {
      font-size: 14px;
      font-weight: bold;
      letter-spacing: 2px;
      padding-left: 20px;
    }
    .inj-meta-table {
      border-collapse: collapse;
      border: 1.5px solid #000;
      font-size: 11.5px;
      background: #fff;
    }
    .inj-meta-table td, .inj-meta-table th {
      border: 1px solid #000;
      padding: 3px 5px;
    }
    .inj-doc-cell {
      width: 74px;
      height: 56px;
      text-align: center;
      vertical-align: top;
      position: relative;
    }
    .inj-stamp-circle {
      width: 42px;
      height: 42px;
      border: 1.5px solid #dc2626;
      border-radius: 50%;
      margin: 2px auto 0 auto;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      color: #dc2626;
      font-size: 9px;
      line-height: 1.1;
    }
    .inj-grid-table {
      width: 100%;
      border-collapse: collapse;
      border: 1.5px solid #000;
      font-size: 11px;
      table-layout: fixed;
    }
    .inj-grid-table th, .inj-grid-table td {
      border: 1px solid #000;
      padding: 0;
      box-sizing: border-box;
    }
    .inj-grid-table th {
      background: #fff;
      font-weight: bold;
      text-align: center;
      height: 22px;
    }
    .inj-col-no { width: 30px; }
    .inj-col-rx { width: 320px; }
    .inj-col-route { width: 85px; }
    .inj-col-date-label { width: 44px; }
    .inj-col-day { width: calc((100% - 479px) / 15); }
    .inj-rx-cell {
      padding: 3px 6px !important;
      vertical-align: top;
      line-height: 1.35;
      font-size: 11px;
      height: 46px;
      word-break: break-all;
    }
    .inj-route-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      padding: 1px 3px;
      font-size: 11px;
      line-height: 1.25;
      height: 100%;
      box-sizing: border-box;
      align-items: center;
      text-align: center;
    }
    .inj-route-item {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      position: relative;
    }
    .inj-route-circle {
      border: 1.5px solid #dc2626;
      border-radius: 50%;
      padding: 0 3px;
      color: #dc2626;
      font-weight: bold;
    }
    .inj-day-cell {
      height: 46px;
      display: flex;
      flex-direction: column;
    }
    .inj-day-top {
      flex: 1;
      border-bottom: 1px dashed #71717a;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 10px;
    }
    .inj-day-bottom {
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 10px;
    }
    .inj-day-arrow {
      width: 100%;
      text-align: center;
      color: #0284c7;
      font-weight: bold;
      font-size: 12px;
      line-height: 1;
    }
    .inj-footer-area {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-top: 8px;
    }
    .inj-ward-stamp {
      border: 1px solid #000;
      padding: 2px 10px;
      font-size: 11.5px;
      letter-spacing: 4px;
      text-indent: 4px;
      display: inline-block;
      margin-top: 2px;
    }
    .inj-pharmacist-area {
      margin-left: 170px;
      display: flex;
      align-items: stretch;
    }
    .inj-pharmacist-table {
      border-collapse: collapse;
      border: 1px solid #000;
      font-size: 10.5px;
    }
    .inj-pharmacist-table td, .inj-pharmacist-table th {
      border: 1px solid #000;
      padding: 2px 6px;
      text-align: center;
    }
    .inj-bottom-hospital-credit {
      font-size: 10px;
      color: #000;
      text-align: right;
      letter-spacing: 0.5px;
    }
    .era-circle, .gender-circle {
      border: 1.5px solid #dc2626;
      border-radius: 50%;
      padding: 0 2px;
      color: #dc2626;
      font-weight: bold;
    }

    @media print {
      body * { visibility: hidden !important; }
      body.printing-injection #injectionSheetModal, body.printing-injection #injectionSheetModal * { visibility: visible !important; }
      body.printing-injection #injectionSheetModal {
        position: absolute !important; left: 0 !important; top: 0 !important;
        width: 100% !important; height: auto !important; background: transparent !important;
        padding: 0 !important; margin: 0 !important; display: block !important;
      }
      body.printing-injection .injection-modal-wrapper {
        box-shadow: none !important; border: none !important; padding: 0 !important;
        width: 100% !important; max-width: 100% !important; background: transparent !important;
      }
      body.printing-injection .injection-sheet-container {
        padding: 0 !important; background: transparent !important;
      }
      body.printing-injection .injection-sheet {
        border: 1.5px solid #000 !important; box-shadow: none !important;
        padding: 8mm 10mm 6mm 10mm !important; margin: 0 !important;
        width: 100% !important; min-height: auto !important;
      }
      body.printing-injection .punch-hole {
        border-color: #cbd5e1 !important; background: transparent !important;
      }
      .no-print { display: none !important; }
      .inj-stamp-circle, .inj-route-circle, .era-circle, .gender-circle {
        border-color: #dc2626 !important; color: #dc2626 !important;
        -webkit-print-color-adjust: exact; print-color-adjust: exact;
      }
      .inj-meta-table th, .inj-meta-table td, .inj-grid-table th, .inj-grid-table td,
      .inj-pharmacist-table th, .inj-pharmacist-table td {
        border-color: #000 !important;
      }
    }

    <% if (typeof isEmbedded !== 'undefined' && isEmbedded) { %>
    /* 嵌入（カルテ右ペイン埋め込み）モード専用スタイル */
    header {
      display: none !important;
    }
    body {
      background: #f8fafc;
      height: 100vh;
      overflow: hidden;
    }
    .container {
      padding: 0.3rem 0.45rem;
      height: 100vh;
      gap: 0;
    }
    .form-card {
      flex: 1 1 100% !important;
      max-width: 100% !important;
      width: 100% !important;
      border-radius: 4px;
      padding: 0.5rem 0.65rem;
      box-shadow: none;
      border: 1px solid #cbd5e1;
    }
    .pane-resizer {
      display: none !important;
    }
    .history-card {
      display: none !important;
    }
    <% } %>
  </style>
</head>
<body>
  <!-- 最上部ヘッダー -->
  <header>
    <div class="header-branding">
      <div class="header-logo-icon">🏥</div>
      <div>
        <div class="header-hospital-name">医療法人 社団 交雄会 だて病院</div>
        <div class="header-app-title">オーダリング指示発行システム</div>
      </div>
      <div class="header-badges">
        <span class="header-badge" style="background:#38bdf8; color:#0c4a6e;">Port <%= port %> (Sender)</span>
        <% if (typeof isHttps !== 'undefined' && isHttps) { %>
          <span class="header-badge" style="background:#10b981; color:white;">🔒 HTTPS 暗号化</span>
        <% } else { %>
          <span class="header-badge" style="background:#64748b; color:white;">🔓 HTTP 平文</span>
        <% } %>
      </div>
    </div>
    <div class="header-links">
      <a href="<%= typeof protocol !== 'undefined' ? protocol : 'http' %>://<%= typeof serverHostname !== 'undefined' ? serverHostname : 'localhost' %>:<%= typeof protocol !== 'undefined' && protocol === 'https' ? 5443 : 5000 %>" target="app_ordering_receiver">📥 受信側モニター</a>
      <% const initPId = (typeof initialPatientId !== 'undefined' && initialPatientId) ? initialPatientId : ''; %>
      <% const initPName = (typeof initialPatientName !== 'undefined' && initialPatientName) ? initialPatientName : ''; %>
      <a id="headerInjSheetLink" href="/injection-sheet-form<%= initPId ? `?patientId=${encodeURIComponent(initPId)}` : '' %>" target="app_injection_sheet" onclick="return openInjectionSheetWithCurrentPatient(event);" style="background:#059669; color:white; border-color:#059669; font-weight:bold;" title="注射指示箋を開く (インクリメンタル薬品検索完備・選択中の患者を引き継ぎます)">💉 注射指示箋 ↗</a>
      <a id="headerCarteLink" href="http://<%= typeof serverHostname !== 'undefined' ? serverHostname : 'localhost' %>:3000/articles<%= initPId ? `?targetId=${encodeURIComponent(initPId)}` : '' %>" target="app_carte_articles" style="background:#0284c7; color:white; border-color:#0284c7; font-weight:bold;" title="電子カルテを開く (選択中の患者を引き継ぎます)">📋 電子カルテ <%= initPName ? `[${initPName}]` : '(Port 3000)' %></a>
      <button type="button" onclick="clearHistory()" style="background:rgba(255,255,255,0.18); color:white; border:none; padding:0.25rem 0.55rem; border-radius:4px; font-size:0.75rem; cursor:pointer;">
        履歴クリア
      </button>
    </div>
  </header>

  <div class="container">
    <!-- 左列: 患者情報と各種指示入力・送信ボタン画面 (縦2列の左側) -->
    <div class="form-card" id="formCard">
      <!-- 左列ヘッダー: 画面の役割を明確化 & クイック送信ボタン -->
      <div style="display:flex; justify-content:space-between; align-items:center; padding-bottom:0.4rem; border-bottom:2px solid #0284c7; flex-shrink:0;">
        <div style="font-weight:900; font-size:0.92rem; color:#0369a1; display:flex; align-items:center; gap:0.4rem;">
          <span>📝 オーダー指示入力・発行</span>
          <span style="font-size:0.75rem; color:#64748b; font-weight:normal;">(患者情報・指示作成・送信画面)</span>
        </div>
        <button type="button" onclick="submitOrder()" style="background:#0284c7; color:white; border:none; padding:0.28rem 0.75rem; border-radius:4px; font-weight:bold; font-size:0.78rem; cursor:pointer; display:flex; align-items:center; gap:0.3rem; box-shadow:0 1px 3px rgba(2,132,199,0.3);" title="入力内容を受信側サーバーへ送信">
          <span>🚀</span> <span>指示票を送信</span>
        </button>
      </div>

      <!-- ★最上部固定: オーダー種別タブナビゲーション (画面を開いて即座に見える位置に配置)★ -->
      <div class="tabs-nav-sticky-wrapper">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.35rem;">
          <span style="font-weight:bold; font-size:0.9rem; color:#0f172a; display:flex; align-items:center; gap:0.4rem;">
            <span>📋</span>
            <span>オーダー種別を選択（クリックで切替）:</span>
          </span>
          <span style="font-size:0.75rem; color:#64748b;">だて病院 診療録・指示票様式連動</span>
        </div>
        <div class="tabs-nav">
          <button type="button" class="tab-btn tab-rx active" onclick="switchOrderType('PRESCRIPTION', this)" title="内服・外用処方せん">
            <span>💊</span> <span>処方 (内服・外用)</span>
          </button>
          <button type="button" class="tab-btn tab-iv" onclick="switchOrderType('IV', this)" title="病棟用 注射指示箋 (DIV/静注/皮下等)">
            <span>💉</span> <span>注射指示</span>
          </button>
          <button type="button" class="tab-btn tab-rad" onclick="switchOrderType('RADIOLOGY', this)" title="CT検査 / 透視検査 / 診療X線照射録">
            <span>🩻</span> <span>放射線科 (CT/透視/X線)</span>
          </button>
          <button type="button" class="tab-btn tab-lab" onclick="switchOrderType('LAB_EXAM', this)" title="生理検査 / 検体検査">
            <span>🔬</span> <span>検査科 (生理/検体)</span>
          </button>
          <button type="button" class="tab-btn tab-rehab" onclick="switchOrderType('REHAB', this)" title="PT / OT / ST リハビリ指示">
            <span>🏃</span> <span>リハビリ</span>
          </button>
          <button type="button" class="tab-btn tab-meal" onclick="switchOrderType('MEAL', this)" title="食種・禁忌・アレルギー">
            <span>🍱</span> <span>食事管理</span>
          </button>
        </div>
      </div>

      <!-- 送信先サーバー設定 (コンパクト折りたたみ) -->
      <details style="background:#f8fafc; border:1px solid #e2e8f0; border-radius:6px; padding:0.35rem 0.65rem; font-size:0.75rem;">
        <summary style="cursor:pointer; font-weight:bold; color:#64748b; user-select:none;">
          📡 送信先サーバー接続設定 (標準: Port <%= typeof protocol !== 'undefined' && protocol === 'https' ? 5443 : 5000 %> 受信エンドポイント)
        </summary>
        <div style="display:flex; gap:0.5rem; align-items:center; margin-top:0.4rem;">
          <input type="text" id="receiverUrlInput" class="form-control" style="font-family:monospace; font-size:0.78rem; flex:1;" value="<%= defaultReceiverUrl %>">
          <select onchange="document.getElementById('receiverUrlInput').value = this.value;" class="form-control" style="width:160px; font-size:0.75rem; padding:0.2rem 0.35rem;">
            <option value="<%= defaultReceiverUrl %>">標準 (Port <%= typeof protocol !== 'undefined' && protocol === 'https' ? 5443 : 5000 %>)</option>
            <option value="http://<%= typeof serverHostname !== 'undefined' ? serverHostname : 'localhost' %>:5000">Port 5000 (HTTP)</option>
            <option value="https://<%= typeof serverHostname !== 'undefined' ? serverHostname : 'localhost' %>:5443">Port 5443 (HTTPS)</option>
            <option value="http://<%= typeof serverHostname !== 'undefined' ? serverHostname : 'localhost' %>:3000">Port 3000 (カルテ連携)</option>
          </select>
        </div>
      </details>

      <!-- 2. だて病院 共通患者情報セクション (表示のみ・選択不可) -->
      <div class="patient-master-card" style="background:#f8fafc; border:1px solid #cbd5e1; border-left:4px solid #0284c7; border-radius:6px; padding:0.5rem 0.75rem; display:flex; flex-direction:column; gap:0.35rem;">
        <div class="patient-master-header" style="margin-bottom:0.15rem; padding-bottom:0.25rem; border-bottom:1px solid #e2e8f0; display:flex; justify-content:space-between; align-items:center;">
          <div class="patient-master-title" style="font-size:0.85rem; font-weight:bold; color:#0369a1; display:flex; align-items:center; gap:0.35rem;">
            <span>👤 対象患者情報</span>
            <span style="font-size:0.72rem; color:#64748b; font-weight:normal;">(引き継ぎ対象者・表示のみ / 選択不可)</span>
          </div>
          <span class="hospital-stamp-label" style="font-size:0.7rem; color:#0284c7; background:#e0f2fe; padding:0.1rem 0.4rem; border-radius:3px; font-weight:bold;">だて病院 診療録・指示票様式</span>
        </div>

        <!-- 1行目: ID、氏名、カナ、属性(性別/年齢/生年月日/身体計測) 表示のみ -->
        <div style="display:flex; align-items:center; gap:0.55rem; flex-wrap:wrap; font-size:0.85rem; line-height:1.4;">
          <span style="background:#0f172a; color:#fef08a; font-family:monospace; font-weight:bold; padding:0.15rem 0.45rem; border-radius:4px; font-size:0.85rem;" id="dispPatientId">
            [<%= patients[0].id %>]
          </span>
          <span style="font-size:1.02rem; font-weight:bold; color:#0f172a;" id="dispPatientName">
            <%= patients[0].name %> 様
          </span>
          <span style="font-size:0.78rem; color:#64748b;" id="dispPatientKana">
            (<%= patients[0].kana || '' %>)
          </span>
          <span style="background:#e0f2fe; color:#0369a1; font-weight:bold; font-size:0.78rem; padding:0.1rem 0.45rem; border-radius:3px;" id="dispPatientMeta">
            <%= patients[0].gender || '男' %> / <%= patients[0].age || '' %>才 (<%= patients[0].era || '昭' %><%= patients[0].birthDate ? ` / ${patients[0].birthDate}` : '' %>)
          </span>
          <span style="font-size:0.78rem; color:#475569;" id="dispPatientBody">
            <% if (patients[0].height || patients[0].weight) { %>
              📏 <%= patients[0].height ? `${patients[0].height}cm` : '' %> <%= patients[0].weight ? `${patients[0].weight}kg` : '' %>
            <% } %>
          </span>
        </div>

