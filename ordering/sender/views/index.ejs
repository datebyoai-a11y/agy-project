        <input type="text" id="medModalSearchInput" class="form-control" placeholder="薬品名、成分名、読み仮名、薬品IDで検索..." style="font-size:0.9rem; padding:0.5rem 0.75rem;" oninput="onModalSearchInput(this.value)">
