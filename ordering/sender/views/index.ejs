        <div style="margin-top:0.2rem; display:flex; gap:0.3rem; align-items:center; flex-wrap:wrap;">
          ${med.crushOk ? `<span class="med-tag ${med.crushOk === '〇' ? 'med-tag-ok' : (med.crushOk === '×' ? 'med-tag-ng' : 'med-tag-warn')}">粉砕:${escapeHtml(med.crushOk)}</span>` : ''}
          ${med.suspensionOk ? `<span class="med-tag ${med.suspensionOk === '〇' ? 'med-tag-ok' : (med.suspensionOk === '×' ? 'med-tag-ng' : 'med-tag-warn')}">懸濁:${escapeHtml(med.suspensionOk)}</span>` : ''}
          ${med.uncapsuleOk ? `<span class="med-tag ${med.uncapsuleOk === '〇' ? 'med-tag-ok' : (med.uncapsuleOk === '×' ? 'med-tag-ng' : 'med-tag-warn')}">脱カプセル:${escapeHtml(med.uncapsuleOk)}</span>` : ''}
        </div>
        ${med.pharmacyComment ? `
          <div style="margin-top:0.25rem; padding:0.15rem 0.4rem; background:#fff1f2; border:1px solid #fecdd3; border-radius:3px; color:#be123c; font-weight:bold; font-size:0.7rem;">
            ⚠️ ${escapeHtml(med.pharmacyComment)}
          </div>
        ` : ''}
      `;
    }

    function renderRxMedicinesList() {
      const container = document.getElementById('rxMedicinesListContainer');
      if (!container) return;
      const countLabel = document.getElementById('rxTotalMedCountText');
      if (countLabel) countLabel.textContent = `登録薬剤: ${rxItems.length}品目`;

      container.innerHTML = rxItems.map((item, index) => {
        const med = allMedicines.find(m => m.id === item.medicineId) || allMedicines.find(m => m.name === item.medicine);
        let detailCardHtml = '';
        if (med) detailCardHtml = buildMedDetailCardHtml(med);

        return `
          <div class="rx-item-card" id="rxCard_${item.id}">
            <div class="rx-item-header">
              <span class="rx-rp-badge">Rp. ${index + 1}</span>
              <div style="display:flex; gap:0.35rem; align-items:center;">
                <button type="button" class="btn-lookup" onclick="openMedicineModal('rx_${item.id}')">🔍 薬品マスタ選択</button>
                ${rxItems.length > 1 ? `
                  <button type="button" onclick="removeRxMedicineRow('${item.id}')" class="btn-rx-delete" title="この薬剤を削除">✕ 削除</button>
                ` : ''}
              </div>
            </div>
            <div class="form-group" style="position:relative; margin-top:0.3rem;">
              <div style="position:relative;">
                <input type="text" id="rxMedicine_${item.id}" class="form-control"
                       placeholder="薬品名・カナ・成分名を入力（例: ユナシン、カロナール、ロキソ...）"
                       value="${escapeHtml(item.medicine)}"
                       autocomplete="off"
                       oninput="onRxItemInput('${item.id}', this.value)"
                       onfocus="onRxItemInput('${item.id}', this.value)"
                       onchange="updateRxItemField('${item.id}', 'medicine', this.value)">
                <div id="rxMedicineSuggest_${item.id}" class="med-suggest-dropdown" style="display:none;"></div>
              </div>
              <input type="hidden" id="rxMedicineId_${item.id}" value="${item.medicineId || ''}">
              <div id="rxMedDetailCard_${item.id}" class="med-detail-card" style="${detailCardHtml ? '' : 'display:none;'}">
                ${detailCardHtml}
              </div>
            </div>
            <div class="form-row" style="margin-top:0.35rem; gap:0.45rem;">
              <div class="form-group" style="flex:2;">
                <label class="form-label" style="font-size:0.73rem;">用法・用量 (服用時期):</label>
                <input type="text" id="rxDosage_${item.id}" class="form-control"
                       value="${escapeHtml(item.dosage || '')}"
                       placeholder="例: 1回1錠 1日3回 毎食後"
                       onchange="updateRxItemField('${item.id}', 'dosage', this.value)">
              </div>
              <div class="form-group" style="flex:1;">
                <label class="form-label" style="font-size:0.73rem;">日数/回数:</label>
                <input type="number" id="rxDays_${item.id}" class="form-control"
                       value="${item.days || 7}" min="1" max="90"
                       onchange="updateRxItemField('${item.id}', 'days', this.value); autoCalcQuantity('${item.id}');">
              </div>
              <div class="form-group" style="flex:1;">
                <label class="form-label" style="font-size:0.73rem;">調剤総量:</label>
                <input type="text" id="rxQuantity_${item.id}" class="form-control"
                       value="${escapeHtml(item.quantity || '')}"
                       placeholder="例: 21錠"
                       onchange="updateRxItemField('${item.id}', 'quantity', this.value)">
              </div>
              <div class="form-group" style="flex:1;">
                <label class="form-label" style="font-size:0.73rem;">調剤指示:</label>
                <input type="text" id="rxInstruction_${item.id}" class="form-control"
                       value="${escapeHtml(item.instruction || '')}"
                       placeholder="例: 粉砕、一包化"
                       onchange="updateRxItemField('${item.id}', 'instruction', this.value)">
              </div>
            </div>
          </div>
        `;
      }).join('');
    }

    function addNewRxMedicineRow() {
      const commonDays = parseInt(document.getElementById('rxCommonDays')?.value || '7', 10) || 7;
      const newId = 'med_' + Date.now() + '_' + Math.floor(Math.random() * 1000);
      rxItems.push({
        id: newId,
        medicine: '',
        medicineId: '',
        dosage: '1回1錠 1日3回 毎食後',
        days: commonDays,
        quantity: '',
        instruction: ''
      });
      renderRxMedicinesList();
      setTimeout(() => {
        const inp = document.getElementById(`rxMedicine_${newId}`);
        if (inp) inp.focus();
      }, 50);
      showToast(`➕ 処方薬剤 (Rp. ${rxItems.length}) を追加しました`);
    }

    function removeRxMedicineRow(id) {
      if (rxItems.length <= 1) return;
      rxItems = rxItems.filter(item => item.id !== id);
      renderRxMedicinesList();
      showToast('🗑️ 薬剤を削除しました');
    }

    function updateRxItemField(id, field, val) {
      const item = rxItems.find(it => it.id === id);
      if (item) item[field] = val;
    }

    function applyCommonDaysToAll(days) {
      const d = parseInt(days, 10) || 7;
      rxItems.forEach(it => {
        it.days = d;
        const el = document.getElementById(`rxDays_${it.id}`);
        if (el) el.value = d;
        autoCalcQuantity(it.id);
      });
      showToast(`全薬剤の処方日数を ${d} 日分に統一しました`);
    }

    function autoCalcQuantity(id) {
      const item = rxItems.find(it => it.id === id);
      if (!item) return;
      const days = parseInt(document.getElementById(`rxDays_${id}`)?.value || item.days || '7', 10);
      const dosage = document.getElementById(`rxDosage_${id}`)?.value || item.dosage || '';
      let dailyDose = 0;
      if (dosage.includes('1日3回') || dosage.includes('毎食後')) dailyDose = 3;
      else if (dosage.includes('1日2回') || dosage.includes('朝夕')) dailyDose = 2;
      else if (dosage.includes('1日1回') || dosage.includes('就寝前')) dailyDose = 1;

      let unitDose = 1;
      const unitMatch = dosage.match(/1回([0-9０-９]+)/);
      if (unitMatch) unitDose = parseInt(unitMatch[1], 10) || 1;

      if (dailyDose > 0 && days > 0) {
        const total = dailyDose * unitDose * days;
        const qEl = document.getElementById(`rxQuantity_${id}`);
        if (qEl) {
          const medName = document.getElementById(`rxMedicine_${id}`)?.value || '';
          const unit = medName.includes('カプセル') ? 'Cap' : (medName.includes('散') || medName.includes('顆粒') ? '包' : (medName.includes('外用') || medName.includes('軟膏') ? '本' : '錠'));
          qEl.value = `${total}${unit}`;
          item.quantity = qEl.value;
        }
      }
    }

    function onRxItemInput(id, val) {
      const suggestBox = document.getElementById(`rxMedicineSuggest_${id}`);
      if (!suggestBox) return;
      if (!val || val.trim().length === 0) {
        suggestBox.style.display = 'none';
        return;
      }
      const results = searchLocalMedicines(val, '内服・外用');
      if (!results || results.length === 0) {
        suggestBox.innerHTML = `<div style="padding:0.5rem 0.7rem; color:#94a3b8; font-size:0.75rem;">一致する薬品が見つかりません（手動入力可）</div>`;
        suggestBox.style.display = 'block';
        return;
      }

      suggestBox.innerHTML = results.map(m => `
        <div class="med-suggest-item" onclick="selectMedicine('rx_${id}', '${m.id}')">
          <div>
            <div class="med-suggest-main">${escapeHtml(m.name)}</div>
            <div class="med-suggest-sub">
              <span>[${escapeHtml(m.id)}]</span>
              <span style="margin-left:0.3rem;">成分: ${escapeHtml(m.genericName || '―')}</span>
              ${m.dosage ? `<span style="margin-left:0.4rem; color:#0369a1;">用法: ${escapeHtml(m.dosage)}</span>` : ''}
            </div>
          </div>
          <div class="med-suggest-badges">
            <span class="med-tag ${m.brandType === '先発' ? 'med-tag-brand-orig' : 'med-tag-brand-gen'}">${escapeHtml(m.brandType || '後発')}</span>
            <span class="med-tag" style="background:#f1f5f9; color:#475569;">${escapeHtml(m.category)}</span>
            ${m.crushOk ? `<span class="med-tag ${m.crushOk === '〇' ? 'med-tag-ok' : (m.crushOk === '×' ? 'med-tag-ng' : 'med-tag-warn')}">粉砕:${escapeHtml(m.crushOk)}</span>` : ''}
          </div>
        </div>
      `).join('');
      suggestBox.style.display = 'block';
    }

    function hiraToKata(str) {
      if (!str) return '';
      return str.replace(/[\u3041-\u3096]/g, ch => String.fromCharCode(ch.charCodeAt(0) + 0x60));
    }
    function zenToHan(str) {
      if (!str) return '';
      return str.replace(/[！-～]/g, ch => String.fromCharCode(ch.charCodeAt(0) - 0xfee0)).replace(/　/g, ' ');
    }
    function normText(str) {
      if (!str) return '';
      return zenToHan(hiraToKata(String(str).toLowerCase().trim()));
    }

    function searchLocalMedicines(query, targetCategory) {
      const qNorm = normText(query);
      let list = allMedicines;
      if (targetCategory === '内服・外用') {
        list = list.filter(m => m.category === '内服薬' || m.category === '外用薬');
      } else if (targetCategory) {
        list = list.filter(m => m.category === targetCategory);
      }
      if (!qNorm) return list.slice(0, 30);

      const parts = qNorm.split(/\s+/).filter(Boolean);
      return list.filter(m => {
        const target = normText(`${m.name} ${m.kana} ${m.genericName} ${m.id} ${m.therapeuticCategoryMajor} ${m.therapeuticCategoryMiddle}`);
        return parts.every(p => target.includes(p));
      }).slice(0, 30);
    }

    function onMedicineInput(target, val) {
      const suggestBox = document.getElementById(`${target}MedicineSuggest`);
      if (!suggestBox) return;
      if (!val || val.trim().length === 0) {
        suggestBox.style.display = 'none';
        return;
      }
      const category = target === 'iv' ? '注射剤' : '内服・外用';
      const results = searchLocalMedicines(val, category);

      if (!results || results.length === 0) {
        suggestBox.innerHTML = `<div style="padding:0.5rem 0.7rem; color:#94a3b8; font-size:0.75rem;">一致する薬品が見つかりません（手動入力可）</div>`;
        suggestBox.style.display = 'block';
        return;
      }

      suggestBox.innerHTML = results.map(m => `
        <div class="med-suggest-item" onclick="selectMedicine('${target}', '${m.id}')">
          <div>
            <div class="med-suggest-main">${escapeHtml(m.name)}</div>
            <div class="med-suggest-sub">
              <span>[${escapeHtml(m.id)}]</span>
              <span style="margin-left:0.3rem;">成分: ${escapeHtml(m.genericName || '―')}</span>
              ${m.dosage ? `<span style="margin-left:0.4rem; color:#0369a1;">用法: ${escapeHtml(m.dosage)}</span>` : ''}
            </div>
          </div>
          <div class="med-suggest-badges">
            <span class="med-tag ${m.brandType === '先発' ? 'med-tag-brand-orig' : 'med-tag-brand-gen'}">${escapeHtml(m.brandType || '後発')}</span>
            <span class="med-tag" style="background:#f1f5f9; color:#475569;">${escapeHtml(m.category)}</span>
          </div>
        </div>
      `).join('');
      suggestBox.style.display = 'block';
    }

    function selectMedicine(target, medId) {
      const med = allMedicines.find(m => m.id === medId);
      if (!med) return;

      if (target.startsWith('rx_')) {
        const rowId = target.replace('rx_', '');
        const inp = document.getElementById(`rxMedicine_${rowId}`);
        if (inp) inp.value = med.name;
        const idInp = document.getElementById(`rxMedicineId_${rowId}`);
        if (idInp) idInp.value = med.id;
        const dosageInp = document.getElementById(`rxDosage_${rowId}`);
        if (dosageInp && med.dosage) dosageInp.value = med.dosage;
        const suggestBox = document.getElementById(`rxMedicineSuggest_${rowId}`);
        if (suggestBox) suggestBox.style.display = 'none';

        const item = rxItems.find(it => it.id === rowId);
        if (item) {
          item.medicine = med.name;
          item.medicineId = med.id;
          if (med.dosage) item.dosage = med.dosage;
        }

        const card = document.getElementById(`rxMedDetailCard_${rowId}`);
        if (card) {
          card.innerHTML = buildMedDetailCardHtml(med);
          card.style.display = 'block';
        }

        autoCalcQuantity(rowId);

        if (med.pharmacyComment) {
          const remarksInput = document.getElementById('rxRemarks');
          if (remarksInput && !remarksInput.value.includes(med.pharmacyComment)) {
            const rpNum = rxItems.findIndex(it => it.id === rowId) + 1;
            remarksInput.value = (remarksInput.value.trim() ? remarksInput.value.trim() + ' ' : '') + `[Rp.${rpNum}] ${med.pharmacyComment}`;
          }
        }
      } else if (target === 'iv') {
        const input = document.getElementById('ivMedicine');
        const suggestBox = document.getElementById('ivMedicineSuggest');
        if (input) input.value = med.name;
        if (suggestBox) suggestBox.style.display = 'none';

        const idInput = document.getElementById('ivMedicineId');
        if (idInput) idInput.value = med.id;

        if (med.dosage) {
          const rateInput = document.getElementById('ivRate');
          if (rateInput && !rateInput.value.includes(med.dosage)) {
            rateInput.value = med.dosage;
          }
        }
        if (med.pharmacyComment) {
          const remarksInput = document.getElementById('ivRemarks');
          if (remarksInput && !remarksInput.value.includes(med.pharmacyComment)) {
            remarksInput.value = (remarksInput.value.trim() ? remarksInput.value.trim() + ' ' : '') + med.pharmacyComment;
          }
        }
        renderMedDetailCard('iv', med);
      }

      showToast(`💊 薬品「${med.name}」を選択・自動補完しました`);
    }

    function renderMedDetailCard(target, med) {
      const card = document.getElementById(`${target}MedDetailCard`);
      if (!card) return;
      card.innerHTML = buildMedDetailCardHtml(med);
      card.style.display = 'block';
    }

    function openMedicineModal(target) {
      activeLookupTarget = target;
      document.getElementById('medModalTitle').textContent = target === 'iv' ? '💉 注射薬マスタ検索・選択' : '💊 薬品集マスタ検索・選択';
      modalCategoryFilter = target === 'iv' ? '注射剤' : 'ALL';
      document.querySelectorAll('#medModalCategoryFilters .filter-btn').forEach(btn => {
        const text = btn.textContent;
        if ((target === 'iv' && text.includes('注射剤')) || (!target.includes('iv') && text.includes('全部'))) {
          btn.classList.add('active');
        } else {
          btn.classList.remove('active');
