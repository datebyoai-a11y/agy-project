                <div style="display:flex; align-items:center; gap:0.25rem;">
                  <div id="rxTimesContainer_${item.id}" style="display:${isIrregular ? 'none' : 'flex'}; align-items:center; gap:0.25rem;">
                    <span style="font-size:0.78rem; color:#64748b; white-space:nowrap;">1日</span>
                    <input type="number" min="1" max="10" id="rxDailyTimes_${item.id}" class="form-control"
