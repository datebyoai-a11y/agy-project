          physicals.push(`牽引(頸${document.getElementById('phys_tract_c').value || 0}kg/腰${document.getElementById('phys_tract_l').value || 0}kg)`);
        }

        const remarks = document.getElementById('rehabRemarks').value.trim();

        details = {
          formName: 'リハビリテーション指示書',
          location: rehabLoc.join('、'),
          admitDate,
          orderDate,
          diagnoses: [
            { name: diag1, onsetDate: diagDate1 },
            { name: diag2, onsetDate: diagDate2 }
          ].filter(d => d.name),
          contraindications: contra,
          therapyTypes: therapyTypes.join('、'),
          goals: goals.join('、'),
          physicals: physicals.join('、'),
          remarks,
          scheduledAt
        };
        title = `🏃 リハビリ指示書: ${therapyTypes.join('、') || 'PT/OT'} [${goals.slice(0, 3).join('・')}] (${patientName})`;

      } else if (currentOrderType === 'MEAL') {
        const mealType = document.getElementById('mealType').value;
        const timing = document.getElementById('mealTiming').value;
        const allergies = document.getElementById('mealAllergies').value.trim();
        const remarks = document.getElementById('mealRemarks').value.trim();
        details = {
          mealType,
          timing,
          allergies,
          remarks,
          scheduledAt
        };
        title = `🍱 食事指示: ${mealType} [${timing}] (${patientName})`;
      }

      btn.disabled = true;
      btn.innerHTML = `<span>⏳ 送信中...</span>`;

      try {
        const res = await fetch('/api/orders/send', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            receiverUrl,
            orderType: currentOrderType,
            priority,
            orderDate,
            patientId,
            patientName,
            doctorName,
            title,
            details,
            patient: patientData
          })
        });

        const data = await res.json();
        if (res.ok && data.success) {
          const sentOrderId = data.order.orderId;
          const sentPatientId = patientId;
          const sentPatientName = patientName;

          // 1. 送信ボタンを完了状態にして連打・二重送信を防止
          btn.disabled = true;
          btn.style.background = '#059669';
          btn.innerHTML = `<span>✅ 送信完了（部門＆カルテへ送信済: ${sentOrderId}）</span>`;

          // 2. フォームの入力内容をクリア・初期化（消えずに何度も送信されるのを防止）
          resetOrderFormAfterSubmit(currentOrderType);

          // 3. 送信完了通知（ステータスバーおよびボタンで確認可能）
          setLastAction(`オーダー送信完了 [${sentOrderId}] (${currentOrderType})`);
          setLatestNotice(`✅ オーダー送信完了 [${sentOrderId}] 受信側部門および電子カルテへ反映されました`, 'success');


          // 4. 親ウィンドウ（電子カルテ等）へオーダー完了を通知
          try {
            if (window.parent && window.parent !== window) {
              window.parent.postMessage({
                type: 'ORDER_SUBMITTED',
                orderId: sentOrderId,
                patientId: sentPatientId,
                patientName: sentPatientName,
                orderType: currentOrderType
              }, '*');
            }
          } catch (pmErr) {}

          pollHistory();

          // 3.5秒後にボタンを元に戻す（新規オーダー受付可能に）
          setTimeout(() => {
            btn.disabled = false;
            btn.style.background = '';
            btn.innerHTML = `<span>🚀 受信側サーバーへ指示票を送信</span>`;
          }, 3500);

        } else {
          showToast(`❌ 送信エラー: ${data.error || '失敗'}`, true);
          pollHistory();
          btn.disabled = false;
          btn.innerHTML = `<span>🚀 受信側サーバーへ指示票を送信</span>`;
        }
      } catch (err) {
        showToast(`❌ 通信エラー: ${err.message}`, true);
        btn.disabled = false;
        btn.innerHTML = `<span>🚀 受信側サーバーへ指示票を送信</span>`;
      }
    }

    // 🧹 送信完了後のフォーム初期化（リセット）
