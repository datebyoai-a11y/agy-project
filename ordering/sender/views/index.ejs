  <script>
    let currentOrderType = 'PRESCRIPTION';
    let currentRadSubTab = 'CT';
    let currentLabSubTab = 'PHYSIO';

    // 初期予定日時（現在時刻から1時間後）
    (function initDefaultSchedule() {
      const d = new Date();
      d.setHours(d.getHours() + 1);
      d.setMinutes(0, 0, 0);
      const iso = new Date(d.getTime() - d.getTimezoneOffset() * 60000).toISOString().slice(0, 16);
      const el = document.getElementById('orderScheduleTime');
      if (el) el.value = iso;
    })();

    // 大タブ切替
    function switchOrderType(type, btn) {
      currentOrderType = type;
      document.querySelectorAll('.tabs-nav .tab-btn').forEach(b => b.classList.remove('active'));
      if (btn) btn.classList.add('active');

      document.querySelectorAll('.order-pane').forEach(p => p.style.display = 'none');
      const targetPane = document.getElementById(`pane-${type}`);
      if (targetPane) targetPane.style.display = 'block';
    }

    // 放射線サブタブ切替 (CT / 透視 / 一般撮影)
    function switchRadSubTab(sub, btn) {
      currentRadSubTab = sub;
      document.querySelectorAll('.subtabs-nav .subtab-btn').forEach(b => {
        if (b.closest('#pane-RADIOLOGY')) b.classList.remove('active');
      });
      if (btn) btn.classList.add('active');

      document.querySelectorAll('#pane-RADIOLOGY .rad-subpane').forEach(p => p.style.display = 'none');
      const target = document.getElementById(`rad-subpane-${sub}`);
      if (target) target.style.display = 'block';
    }

    // 検査サブタブ切替 (生理検査 / 検体検査)
    function switchLabSubTab(sub, btn) {
      currentLabSubTab = sub;
      document.querySelectorAll('.subtabs-nav .subtab-btn').forEach(b => {
        if (b.closest('#pane-LAB_EXAM')) b.classList.remove('active');
      });
      if (btn) btn.classList.add('active');

      document.querySelectorAll('#pane-LAB_EXAM .lab-subpane').forEach(p => p.style.display = 'none');
      const target = document.getElementById(`lab-subpane-${sub}`);
      if (target) target.style.display = 'block';
    }

    // 注射投与経路切替
    function setIvRoute(routeVal, pillEl) {
      document.getElementById('ivSelectedRoute').value = routeVal;
      document.querySelectorAll('.route-pill').forEach(p => p.classList.remove('active'));
      if (pillEl) pillEl.classList.add('active');
    }

    // 感染症詳細トグル
    function toggleInfectionDetail(val) {
      const det = document.getElementById('patientInfectionDetailInput');
      if (det) det.style.display = val === '有' ? 'block' : 'none';
    }

    // CT 造影Dynamic表示切替
    function toggleCtDynamic(show) {
      const box = document.getElementById('ctDynamicBox');
      if (box) box.style.display = show ? 'block' : 'none';
    }

    // Photo 6: 診療Ｘ線照射録 ポータブル病室トグル
    function toggleXrayPortable(checked) {
      const box = document.getElementById('xrayPortableRoomBox');
      if (box) box.style.display = checked ? 'flex' : 'none';
      if (checked) {
        const pRoom = document.getElementById('patientRoomInput')?.value || '';
        if (pRoom) {
          document.getElementById('xrayPortableRoom').value = pRoom.replace('号室', '');
        }
      }
    }

    // Photo 6: 撮影部位選択行ハイライト
    function toggleSiteRow(chk) {
      const row = chk.closest('.xray-site-row');
      if (row) {
        if (chk.checked) {
          row.style.borderColor = '#059669';
          row.style.background = '#f0fdf4';
        } else {
          row.style.borderColor = '#cbd5e1';
          row.style.background = '#ffffff';
        }
      }
    }

    // 患者生年月日から年齢 & 和暦自動算出
    function updateAgeAndEraFromBirthDate(birthDateStr) {
      if (!birthDateStr) return;
      const bDate = new Date(birthDateStr);
      if (isNaN(bDate.getTime())) return;

      const now = new Date();
      let age = now.getFullYear() - bDate.getFullYear();
      const m = now.getMonth() - bDate.getMonth();
      if (m < 0 || (m === 0 && now.getDate() < bDate.getDate())) {
        age--;
      }
      document.getElementById('patientAgeInput').value = age;

      // 和暦算出
      const year = bDate.getFullYear();
      const eraEl = document.getElementById('patientEraInput');
      const eraYearEl = document.getElementById('patientEraYearInput');
      if (year >= 2019) {
        eraEl.value = '令';
        eraYearEl.value = year === 2019 ? '元' : (year - 2018);
      } else if (year >= 1989) {
        eraEl.value = '平';
        eraYearEl.value = year === 1989 ? '元' : (year - 1988);
      } else if (year >= 1926) {
        eraEl.value = '昭';
        eraYearEl.value = year === 1926 ? '元' : (year - 1925);
      } else {
        eraEl.value = '大';
        eraYearEl.value = year - 1911;
      }
    }

    // 患者プリセット変更イベント (14項目全連動)
    function onPatientSelectChange(select) {
      const opt = select.options[select.selectedIndex];
      if (select.value === 'CUSTOM') {
        document.getElementById('patientIdInput').value = 'P' + Math.floor(100 + Math.random() * 900);
        document.getElementById('patientNameInput').value = '';
        document.getElementById('patientKanaInput').value = '';
        document.getElementById('patientBirthDateInput').value = '';
        document.getElementById('patientAgeInput').value = '';
        document.getElementById('patientHeightInput').value = '';
        document.getElementById('patientWeightInput').value = '';
        document.getElementById('patientRoomInput').value = '';
        document.getElementById('patientExamCategoryInput').value = '一般診療';
        document.getElementById('patientInfectionInput').value = '無';
        toggleInfectionDetail('無');
        document.getElementById('patientNameInput').focus();
      } else {
        document.getElementById('patientIdInput').value = opt.getAttribute('data-id') || select.value;
        document.getElementById('patientNameInput').value = opt.getAttribute('data-name') || '';
        document.getElementById('patientKanaInput').value = opt.getAttribute('data-kana') || '';
        document.getElementById('patientGenderInput').value = opt.getAttribute('data-gender') || '男';
        document.getElementById('patientAgeInput').value = opt.getAttribute('data-age') || '';
        document.getElementById('patientBirthDateInput').value = opt.getAttribute('data-birthdate') || '';
        document.getElementById('patientEraInput').value = opt.getAttribute('data-era') || '昭';
        updateAgeAndEraFromBirthDate(opt.getAttribute('data-birthdate'));
        document.getElementById('patientWardInput').value = opt.getAttribute('data-ward') || 'しおかぜ';
        document.getElementById('patientRoomInput').value = opt.getAttribute('data-room') || '';
        document.getElementById('patientExamCategoryInput').value = opt.getAttribute('data-examcategory') || '一般診療';
        document.getElementById('patientHeightInput').value = opt.getAttribute('data-height') || '';
        document.getElementById('patientWeightInput').value = opt.getAttribute('data-weight') || '';
        document.getElementById('patientMobilityInput').value = opt.getAttribute('data-mobility') || '徒歩';

        const pRoomVal = (opt.getAttribute('data-room') || '').replace('号室', '');
        if (pRoomVal && document.getElementById('xrayPortableRoom')) {
          document.getElementById('xrayPortableRoom').value = pRoomVal;
        }

        const inf = opt.getAttribute('data-infection') || '無';
        if (inf.startsWith('有')) {
          document.getElementById('patientInfectionInput').value = '有';
          document.getElementById('patientInfectionDetailInput').value = inf.replace('有', '').replace(/[()]/g, '');
          toggleInfectionDetail('有');
        } else {
          document.getElementById('patientInfectionInput').value = '無';
          document.getElementById('patientInfectionDetailInput').value = '';
          toggleInfectionDetail('無');
        }
      }
      showToast(`👤 患者「${document.getElementById('patientNameInput').value || '未設定'}」に切り替えました`);
    }

    function showToast(message, isError = false) {
      const toast = document.getElementById('toast');
      toast.textContent = message;
      toast.style.background = isError ? '#b91c1c' : '#0f172a';
      toast.style.display = 'flex';
      setTimeout(() => {
        toast.style.display = 'none';
      }, 3500);
    }

