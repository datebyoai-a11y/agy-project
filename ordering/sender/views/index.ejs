    // 💊 薬剤の用法用量文字列から「一日量(数字)」「1日回数(数字)」「服用時期」「単位」を分解
    function parseDosageDetails(dosageStr, med) {
      let unit = (med && med.unit) ? med.unit : '錠';
      if ((!med || !med.unit) && dosageStr) {
        if (dosageStr.includes('カプセル') || dosageStr.includes('Cap')) unit = 'Cap';
        else if (dosageStr.includes('包') || dosageStr.includes('散') || dosageStr.includes('顆粒')) unit = '包';
        else if (dosageStr.includes('枚')) unit = '枚';
        else if (dosageStr.includes('袋')) unit = '袋';
        else if (dosageStr.includes('本')) unit = '本';
        else if (dosageStr.includes('管')) unit = '管';
      }

      let dailyDose = 3;
      let dailyTimes = 3;
      let timing = '毎食後';

      if (dosageStr) {
        // 1日回数の抽出
        const dtMatch = dosageStr.match(/1日([0-9０-９]+)回/);
        if (dtMatch) {
          dailyTimes = parseInt(dtMatch[1], 10) || 1;
        } else if (dosageStr.includes('1日3回') || dosageStr.includes('毎食後')) {
          dailyTimes = 3;
        } else if (dosageStr.includes('1日2回') || dosageStr.includes('朝夕')) {
          dailyTimes = 2;
        } else if (dosageStr.includes('1日1回') || dosageStr.includes('就寝前')) {
          dailyTimes = 1;
        } else if (dosageStr.includes('1日4回')) {
          dailyTimes = 4;
        }

        // 不均等分割または服用時期の判定
        if (dosageStr.includes('不均等')) timing = '不均等分割';
        else if (dosageStr.includes('毎食後')) timing = '毎食後';
        else if (dosageStr.includes('朝夕食後') || dosageStr.includes('朝夕')) timing = '朝夕食後';
        else if (dosageStr.includes('朝食後')) timing = '朝食後';
        else if (dosageStr.includes('夕食後')) timing = '夕食後';
        else if (dosageStr.includes('就寝前')) timing = '就寝前';
        else if (dosageStr.includes('毎食前')) timing = '毎食前';
        else if (dosageStr.includes('食間')) timing = '食間';
        else if (dosageStr.includes('頓') || dosageStr.includes('疼痛時')) timing = '疼痛時(頓用)';
        else if (dosageStr.includes('発熱')) timing = '発熱時(頓用)';
        else if (dosageStr.includes('必要時')) timing = '必要時';

        // 一日量（dailyDose: 数字のみ）の判定
        // 1. 「1日○錠」「1日○Cap」「1日○包」の直接指定があるか
        const dailyMatch = dosageStr.match(/1日([0-9０-９.]+)\s*(?:錠|Cap|カプセル|包|袋|枚|本|管)/i);
        if (dailyMatch) {
          dailyDose = parseFloat(dailyMatch[1]) || 1;
        } else {
          // 2. 「1回○錠」がある場合: 一日量 ＝ 1回量 × 1日回数
          const udUnitMatch = dosageStr.match(/1回([0-9０-９.]+)\s*(?:錠|Cap|カプセル|包|袋|枚|本|管)/i);
          if (udUnitMatch) {
            const oneDose = parseFloat(udUnitMatch[1]) || 1;
            dailyDose = Math.round(oneDose * dailyTimes * 10) / 10;
          } else {
            // 3. 「1回○」がある場合
            const udAnyMatch = dosageStr.match(/1回([0-9０-９.]+)/);
            if (udAnyMatch) {
              const val = parseFloat(udAnyMatch[1]);
              if (val > 10 && med && (med.spec || med.name).includes(String(val))) {
                dailyDose = 1 * dailyTimes;
              } else if (val > 10 && !dosageStr.match(/(?:錠|Cap|カプセル|包)/)) {
                dailyDose = 1 * dailyTimes;
              } else {
                dailyDose = Math.round((val || 1) * dailyTimes * 10) / 10;
              }
            } else if (dosageStr.includes('1錠') || dosageStr.includes('1Cap') || dosageStr.includes('1包')) {
              dailyDose = 1 * dailyTimes;
            } else if (dosageStr.includes('2錠') || dosageStr.includes('2Cap') || dosageStr.includes('2包')) {
              dailyDose = 2 * dailyTimes;
            } else {
              dailyDose = dailyTimes;
            }
          }
        }
      }

      return { dailyDose, dailyTimes, timing, unit };
    }

    // 🔄 用量(一日量)・用法を結合して dosage テキスト（処方指示表記）を生成
    function syncRxItemDosage(id) {
      const item = rxItems.find(it => it.id === id);
      if (!item) return;

      const dailyDose = document.getElementById(`rxDailyDose_${id}`)?.value ?? item.dailyDose ?? 3;
      const unit = item.unit || '錠';
      const dailyTimes = document.getElementById(`rxDailyTimes_${id}`)?.value ?? item.dailyTimes ?? 3;
      const timing = document.getElementById(`rxTiming_${id}`)?.value ?? item.timing ?? '毎食後';
      const instruction = document.getElementById(`rxInstruction_${id}`)?.value.trim() ?? item.instruction ?? '';

      let text = '';
      if (dailyDose !== '') text += `1日${dailyDose}${unit} `;

      if (timing === '不均等分割') {
        text += '不均等分割';
        if (instruction) text += ` (${instruction})`;
      } else {
        if (dailyTimes !== '') text += `1日${dailyTimes}回 `;
        if (timing) text += timing;
      }
      text = text.trim();

      item.dosage = text;
      const dosageInp = document.getElementById(`rxDosage_${id}`);
      if (dosageInp) dosageInp.value = text;
      const displaySpan = document.getElementById(`rxDosageDisplay_${id}`);
      if (displaySpan) displaySpan.textContent = text;
    }

