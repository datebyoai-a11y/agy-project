                  <label class="chk-item" style="font-weight:bold; width:110px;">
                    <input type="checkbox" id="xray_site_abdo" onchange="toggleSiteRow(this)"> ② 腹部
                  </label>
                  <div style="display:flex; align-items:center; gap:0.35rem; font-size:0.78rem;">
                    <span style="color:#475569; font-weight:bold;">正:</span>
                    <label style="cursor:pointer;"><input type="checkbox" id="xray_abdo_stand" checked> 立位</label>
                    <label style="cursor:pointer;"><input type="checkbox" id="xray_abdo_sit"> 座位</label>
                    <label style="cursor:pointer;"><input type="checkbox" id="xray_abdo_supine"> 臥位</label>
                  </div>
