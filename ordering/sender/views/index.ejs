  <!-- トースト通知 -->
  <div id="toast"></div>

  <!-- 最下段固定ステータスバー (画面操作専用・最後の操作と通知を表示) -->
  <footer id="appStatusBar" class="app-status-bar no-print" role="status" aria-live="polite">
    <div class="status-bar-container">
      <!-- 左側: システム稼働状態 & 最後の操作 -->
      <div class="status-section status-left" id="statusActionSection">
        <span class="status-indicator-dot" title="オーダリングシステム正常稼働中"></span>
        <span class="status-label">最後の操作:</span>
        <span id="statusBarLastAction" class="status-value status-action-text" title="直近のユーザー操作">システム初期化完了</span>
        <span id="statusBarActionTime" class="status-time">--:--:--</span>
      </div>

      <!-- 中央: 最新の通知 -->
      <div class="status-section status-center" id="statusNoticeSection">
        <span id="statusBarNoticeIcon" style="font-size:0.85rem; flex-shrink:0;">📢</span>
        <span class="status-label">通知:</span>
        <span id="statusBarLatestNotice" class="status-value status-notice-text" title="最新のシステム通知・案内">準備完了（オーダー指示の発行・照会が可能です）</span>
        <span id="statusBarNoticeTime" class="status-time">--:--:--</span>
      </div>

      <!-- 右側: 連動状態 & 履歴ログ表示ボタン -->
      <div class="status-section status-right">
        <span class="status-badge-connection" title="電子カルテ(Port 3000) / 受信部門(Port 5000) リアルタイム連動中">🟢 連携稼働中</span>
        <button type="button" class="status-log-btn" onclick="toggleStatusHistoryModal()" title="直近の操作・通知履歴を表示">
          <span>📜</span> <span>履歴 (<span id="statusHistoryCount">0</span>)</span>
        </button>
      </div>
    </div>
  </footer>

  <!-- 操作・通知 履歴ポップアップモーダル -->
  <div id="statusHistoryModal" class="status-history-modal no-print" style="display:none;" onclick="closeStatusHistoryModal(event)">
    <div class="status-history-dialog" onclick="event.stopPropagation()">
      <div class="status-history-header">
        <div style="display:flex; align-items:center; gap:0.5rem;">
          <span style="font-size:1.1rem;">📜</span>
          <h4 style="margin:0; font-size:0.92rem; font-weight:bold; color:#f8fafc;">オーダリング操作＆通知 履歴ログ</h4>
          <span style="font-size:0.72rem; color:#94a3b8;">（直近30件）</span>
        </div>
        <button type="button" onclick="closeStatusHistoryModal()" class="status-history-close-btn" title="閉じる">✕</button>
      </div>
      <div class="status-history-body" id="statusHistoryList">
        <!-- JSで動的に追加 -->
      </div>
      <div class="status-history-footer">
        <button type="button" onclick="clearStatusHistory()" class="status-history-clear-btn">履歴消去</button>
        <button type="button" onclick="closeStatusHistoryModal()" class="status-history-ok-btn">閉じる</button>
      </div>
    </div>
  </div>

  <script>
    // =========================================================
    // 💡 最下段ステータスバー (最後の操作 & 通知) 管理システム
    // =========================================================
    const statusHistory = [];
    const MAX_STATUS_HISTORY = 30;

    function formatCurrentTime() {
      const d = new Date();
      const pad = n => String(n).padStart(2, '0');
      return `${pad(d.getHours())}:${pad(d.getMinutes())}:${pad(d.getSeconds())}`;
    }

    // 最後の操作を記録 & ステータスバー更新
    function setLastAction(actionText) {
      const timeStr = formatCurrentTime();
      const el = document.getElementById('statusBarLastAction');
      const elTime = document.getElementById('statusBarActionTime');
      const sec = document.getElementById('statusActionSection');
      if (el) {
        el.textContent = actionText;
        el.title = `[${timeStr}] ${actionText}`;
      }
      if (elTime) elTime.textContent = timeStr;
      if (sec) {
        sec.classList.remove('status-pulse-action');
        void sec.offsetWidth;
        sec.classList.add('status-pulse-action');
      }
      addStatusHistory('action', actionText, timeStr);
    }

    // 最新の通知を記録 & ステータスバー更新
    function setLatestNotice(noticeText, type = 'info') {
      const timeStr = formatCurrentTime();
      const el = document.getElementById('statusBarLatestNotice');
      const elTime = document.getElementById('statusBarNoticeTime');
      const elIcon = document.getElementById('statusBarNoticeIcon');
      const sec = document.getElementById('statusNoticeSection');

      let icon = '📢';
      let color = '#a7f3d0';
      if (type === 'success') {
        icon = '✅';
        color = '#4ade80';
      } else if (type === 'warning') {
        icon = '⚠️';
        color = '#fbbf24';
      } else if (type === 'error') {
        icon = '❌';
        color = '#f87171';
      } else if (type === 'info') {
        icon = 'ℹ️';
        color = '#38bdf8';
      }

      if (elIcon) elIcon.textContent = icon;
      if (el) {
        el.textContent = noticeText;
        el.style.color = color;
        el.title = `[${timeStr}] ${noticeText}`;
      }
      if (elTime) elTime.textContent = timeStr;
      if (sec) {
        sec.classList.remove('status-pulse-notice');
        void sec.offsetWidth;
        sec.classList.add('status-pulse-notice');
      }
      addStatusHistory(type, noticeText, timeStr);
    }

    // 操作と通知を両方一度に更新する
    function updateStatusBar(actionText, noticeText, type = 'info') {
      if (actionText) setLastAction(actionText);
      if (noticeText) setLatestNotice(noticeText, type);
    }

    function addStatusHistory(type, message, timeStr) {
      statusHistory.unshift({ type, message, time: timeStr });
      if (statusHistory.length > MAX_STATUS_HISTORY) {
        statusHistory.pop();
      }
      const countEl = document.getElementById('statusHistoryCount');
      if (countEl) countEl.textContent = statusHistory.length;
    }

    function toggleStatusHistoryModal() {
      const modal = document.getElementById('statusHistoryModal');
      if (!modal) return;
      if (modal.style.display === 'none' || !modal.style.display) {
        renderStatusHistoryList();
        modal.style.display = 'flex';
      } else {
        modal.style.display = 'none';
      }
    }

    function closeStatusHistoryModal(e) {
      if (!e || e.target === document.getElementById('statusHistoryModal') || 
          e.target.classList.contains('status-history-close-btn') || 
          e.target.classList.contains('status-history-ok-btn')) {
        const modal = document.getElementById('statusHistoryModal');
        if (modal) modal.style.display = 'none';
      }
    }

    function clearStatusHistory() {
      statusHistory.length = 0;
      const countEl = document.getElementById('statusHistoryCount');
      if (countEl) countEl.textContent = '0';
      renderStatusHistoryList();
    }

    function renderStatusHistoryList() {
      const container = document.getElementById('statusHistoryList');
      if (!container) return;
      if (statusHistory.length === 0) {
        container.innerHTML = '<div style="color:#64748b; text-align:center; padding:1.5rem 0; font-size:0.8rem;">操作・通知履歴はありません</div>';
        return;
      }
      let html = '';
      statusHistory.forEach(item => {
        let typeClass = 'type-action';
        let typeLabel = '操作';
        if (item.type === 'success') { typeClass = 'type-notice'; typeLabel = '成功'; }
        else if (item.type === 'notice' || item.type === 'info') { typeClass = 'type-notice'; typeLabel = '通知'; }
        else if (item.type === 'warning') { typeClass = 'type-warning'; typeLabel = '注意'; }
        else if (item.type === 'error') { typeClass = 'type-error'; typeLabel = 'エラー'; }

        html += `
          <div class="status-history-item">
            <span class="status-history-time">${escapeHtml(item.time)}</span>
            <span class="status-history-type ${typeClass}">${typeLabel}</span>
            <span class="status-history-msg">${escapeHtml(item.message)}</span>
          </div>
        `;
      });
      container.innerHTML = html;
    }

    let currentOrderType = 'PRESCRIPTION';
    let currentRadSubTab = 'CT';
    let currentLabSubTab = 'PHYSIO';

    // 初期オーダー指示日時（現在日時）および予定日時（現在時刻から1時間後）
    (function initDefaultTimes() {
      const now = new Date();
      const localNowIso = new Date(now.getTime() - now.getTimezoneOffset() * 60000).toISOString().slice(0, 16);
      const inputDateEl = document.getElementById('orderInputDate');
      if (inputDateEl && !inputDateEl.value) inputDateEl.value = localNowIso;

      const d = new Date();
      d.setHours(d.getHours() + 1);
      d.setMinutes(0, 0, 0);
      const iso = new Date(d.getTime() - d.getTimezoneOffset() * 60000).toISOString().slice(0, 16);
      const el = document.getElementById('orderScheduleTime');
      if (el) el.value = iso;
    })();

    // 大タブ切替
    function switchOrderType(type, btn) {
      currentOrderType = type;
      document.querySelectorAll('.tabs-nav .tab-btn').forEach(b => b.classList.remove('active'));
      if (btn) btn.classList.add('active');

      document.querySelectorAll('.order-pane').forEach(p => p.style.display = 'none');
      const targetPane = document.getElementById(`pane-${type}`);
      if (targetPane) targetPane.style.display = 'block';

      const typeLabels = {
        'PRESCRIPTION': '処方オーダー (内服・外用)',
        'IV': '注射指示オーダー (点滴・静注)',
        'RADIOLOGY': '放射線検査オーダー (CT・透視・一般撮影)',
        'LAB_EXAM': '検査オーダー (生理・検体)',
        'MEAL': '食事箋オーダー',
        'REHAB': 'リハビリテーション指示'
      };
      setLastAction(`指示種別タブを [${typeLabels[type] || type}] に切替`);
    }

    // 放射線サブタブ切替 (CT / 透視 / 一般撮影)
    function switchRadSubTab(sub, btn) {
      currentRadSubTab = sub;
      document.querySelectorAll('.subtabs-nav .subtab-btn').forEach(b => {
        if (b.closest('#pane-RADIOLOGY')) b.classList.remove('active');
      });
      if (btn) btn.classList.add('active');

      document.querySelectorAll('#pane-RADIOLOGY .rad-subpane').forEach(p => p.style.display = 'none');
      const target = document.getElementById(`rad-subpane-${sub}`);
      if (target) target.style.display = 'block';

      const radLabels = { 'CT': 'CT検査', 'FLUORO': '透視検査', 'XRAY': '一般撮影' };
      setLastAction(`放射線検査サブタブを [${radLabels[sub] || sub}] に切替`);
    }

    // 検査サブタブ切替 (生理検査 / 検体検査)
    function switchLabSubTab(sub, btn) {
      currentLabSubTab = sub;
      document.querySelectorAll('.subtabs-nav .subtab-btn').forEach(b => {
        if (b.closest('#pane-LAB_EXAM')) b.classList.remove('active');
      });
      if (btn) btn.classList.add('active');

      document.querySelectorAll('#pane-LAB_EXAM .lab-subpane').forEach(p => p.style.display = 'none');
      const target = document.getElementById(`lab-subpane-${sub}`);
      if (target) target.style.display = 'block';

      const labLabels = { 'PHYSIO': '生理検査 (心電図等)', 'SAMPLE': '検体検査 (血液・尿等)' };
      setLastAction(`検査サブタブを [${labLabels[sub] || sub}] に切替`);
    }

    // 注射投与経路切替
    function setIvRoute(routeVal, pillEl) {
      document.getElementById('ivSelectedRoute').value = routeVal;
      document.querySelectorAll('.route-pill').forEach(p => p.classList.remove('active'));
      if (pillEl) pillEl.classList.add('active');
      setLastAction(`注射投与経路を [${routeVal}] に選択`);
    }

    // 感染症詳細トグル
    function toggleInfectionDetail(val) {
      const det = document.getElementById('patientInfectionDetailInput');
      if (det) det.style.display = val === '有' ? 'block' : 'none';
    }

    // CT 造影Dynamic表示切替
    function toggleCtDynamic(show) {
      const box = document.getElementById('ctDynamicBox');
      if (box) box.style.display = show ? 'block' : 'none';
    }

    // Photo 6: 診療Ｘ線照射録 ポータブル病室トグル
    function toggleXrayPortable(checked) {
      const box = document.getElementById('xrayPortableRoomBox');
      if (box) box.style.display = checked ? 'flex' : 'none';
      if (checked) {
        const pRoom = document.getElementById('patientRoomInput')?.value || '';
