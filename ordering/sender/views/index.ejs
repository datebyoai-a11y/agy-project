            <button type="button" id="viewModeTableBtn" onclick="setHistoryViewMode('table')" class="history-mode-btn" title="一覧表テーブル形式で表示（列境界ドラッグ調整可能）">📊 一覧表</button>
          </div>

          <!-- 折り返し切替ボタン -->
          <button type="button" id="historyWrapToggleBtn" onclick="toggleHistoryWrapMode()" style="background:#f0fdf4; color:#166534; border:1px solid #86efac; padding:0.2rem 0.5rem; border-radius:4px; font-size:0.72rem; font-weight:bold; cursor:pointer;" title="画面横からはみ出す内容を折り返して表示 / 1行表示 を切替">
            ↩️ 折り返し: ON
          </button>

          <!-- 列幅リセットボタン (一覧表モード用) -->
          <button type="button" id="historyResetColBtn" onclick="resetHistoryColWidths()" style="background:#f1f5f9; color:#475569; border:1px solid #cbd5e1; padding:0.2rem 0.45rem; border-radius:4px; font-size:0.72rem; font-weight:bold; cursor:pointer; display:none;" title="一覧表の列幅を初期値にリセット">
            ↔️ 列幅リセット
          </button>

          <label style="font-size:0.75rem; color:#475569; display:flex; align-items:center; gap:0.25rem; cursor:pointer;">
            <input type="checkbox" id="autoSyncToggle" checked onchange="toggleAutoSync(this.checked)">
            <span>自動同期</span>
          </label>
          <button type="button" onclick="syncAllStatus()" style="background:#e0f2fe; color:#0369a1; border:1px solid #bae6fd; font-size:0.72rem; padding:0.2rem 0.5rem; border-radius:4px; cursor:pointer; font-weight:bold;">
            一括同期
          </button>
          <button type="button" onclick="pollHistory()" style="background:#f1f5f9; border:1px solid #cbd5e1; font-size:0.72rem; padding:0.2rem 0.45rem; border-radius:4px; cursor:pointer;">
            再読込
          </button>
