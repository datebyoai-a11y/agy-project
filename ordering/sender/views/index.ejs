    /* 左右分割スプリッター (Pane Resizer) */
    .pane-resizer {
      width: 12px;
      cursor: col-resize;
      user-select: none;
      touch-action: none;
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
