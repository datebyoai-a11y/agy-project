          medicineId: '',
          dosage: '',
          days: 7,
          quantity: '',
          instruction: ''
        }];
        const remarksEl = document.getElementById('rxRemarks');
        if (remarksEl) remarksEl.value = '';
        renderRxMedicinesList();
      } else if (orderType === 'IV') {
        const todayStr = getTodayYmd();
        ivItems = [{
          id: 'iv_' + Date.now() + '_1',
          medicine: '',
          medicineId: '',
          dosage: '1回1袋',
          route: 'DIV',
          frequency: '1日1回',
          startDate: todayStr,
          endDate: todayStr,
          days: 1,
          rate: '60mL/h',
          remarks: ''
        }];
        const remarksEl = document.getElementById('ivRemarks');
        if (remarksEl) remarksEl.value = '';
        renderIvOrdersList();
      } else if (orderType === 'RADIOLOGY') {
        document.querySelectorAll('#formRadiology input[type="checkbox"]').forEach(c => c.checked = false);
        const ctPurpose = document.getElementById('ctPurpose');
        if (ctPurpose) ctPurpose.value = '';
        const xrayRemarks = document.getElementById('xrayRemarks');
        if (xrayRemarks) xrayRemarks.value = '';
        const fluoroRemarks = document.getElementById('fluoroRemarks');
        if (fluoroRemarks) fluoroRemarks.value = '';
      } else if (orderType === 'LAB_EXAM') {
        document.querySelectorAll('#formLabExam input[type="checkbox"]').forEach(c => c.checked = false);
        const labItems = document.getElementById('labItems');
        if (labItems) labItems.value = '';
        const labRemarks = document.getElementById('labRemarks');
        if (labRemarks) labRemarks.value = '';
        const physioRemarks = document.getElementById('physioRemarks');
        if (physioRemarks) physioRemarks.value = '';
      } else if (orderType === 'MEAL') {
        const mealAllergies = document.getElementById('mealAllergies');
        if (mealAllergies) mealAllergies.value = '';
        const mealRemarks = document.getElementById('mealRemarks');
        if (mealRemarks) mealRemarks.value = '';
      } else if (orderType === 'REHAB') {
        document.querySelectorAll('#formRehab input[type="checkbox"]').forEach(c => c.checked = false);
        const rehabRemarks = document.getElementById('rehabRemarks');
        if (rehabRemarks) rehabRemarks.value = '';
      }

      if (typeof updateOrderPreview === 'function') {
        updateOrderPreview();
      }
    }

    // 📋 送信成功時のカルテジャンプ付きダイアログ（ポップアップ不要のため抑止）
    function showOrderSentSuccessDialog(orderId, patientId, patientName) {
      // ポップアップ不要化のため表示処理を抑止
    }

    function escapeHtml(str) {
      if (!str) return '';
      return String(str).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }

    // 履歴管理ステート & 描画
    const prevOrderStatuses = {};
    let latestHistoryOrders = <%- JSON.stringify(sentOrders || []) %>;
    let historyViewMode = localStorage.getItem('ordering_sender_history_view_mode') || 'card';
    let isHistoryWrap = localStorage.getItem('ordering_sender_history_wrap') !== 'false'; // デフォルト折り返しON

    const DEFAULT_HISTORY_COL_WIDTHS = [75, 85, 125, 85, 110, 'auto', 70];
    const MIN_HISTORY_COL_WIDTHS = [60, 70, 100, 65, 90, 140, 60];

    const DEFAULT_MED_COL_WIDTHS = [75, 65, 'auto', 160, 80, 65];
    const MIN_MED_COL_WIDTHS = [55, 50, 120, 110, 65, 55];

    function toggleHistoryWrapMode() {
      isHistoryWrap = !isHistoryWrap;
      localStorage.setItem('ordering_sender_history_wrap', isHistoryWrap ? 'true' : 'false');
      applyHistoryWrapUI();
      renderHistory(latestHistoryOrders);
      showToast(isHistoryWrap ? '↩️ 送信履歴の折り返し: ON にしました' : '➡️ 送信履歴の1行表示 にしました');
    }

    function applyHistoryWrapUI() {
      const btn = document.getElementById('historyWrapToggleBtn');
      const card = document.getElementById('historyCard');
      if (card) {
        if (isHistoryWrap) card.classList.add('wrap-mode');
        else card.classList.remove('wrap-mode');
      }
      if (btn) {
        if (isHistoryWrap) {
          btn.innerHTML = '↩️ 折り返し: ON';
          btn.style.background = '#f0fdf4';
          btn.style.color = '#166534';
          btn.style.borderColor = '#86efac';
        } else {
          btn.innerHTML = '➡️ 1行表示: ON';
          btn.style.background = '#f8fafc';
          btn.style.color = '#475569';
          btn.style.borderColor = '#cbd5e1';
        }
      }
    }

    function setHistoryViewMode(mode) {
      historyViewMode = mode;
      localStorage.setItem('ordering_sender_history_view_mode', mode);
      const cardBtn = document.getElementById('viewModeCardBtn');
      const tableBtn = document.getElementById('viewModeTableBtn');
      const resetBtn = document.getElementById('historyResetColBtn');

      if (cardBtn && tableBtn) {
        if (mode === 'card') {
          cardBtn.classList.add('active');
          tableBtn.classList.remove('active');
          if (resetBtn) resetBtn.style.display = 'none';
        } else {
          cardBtn.classList.remove('active');
          tableBtn.classList.add('active');
          if (resetBtn) resetBtn.style.display = 'inline-block';
        }
      }
      renderHistory(latestHistoryOrders);
    }

    function getStatusBadgeHtml(status) {
      switch (status) {
        case 'SENT': return '<span class="status-tag SENT">📤 送信済</span>';
        case 'RECEIVED': return '<span class="status-tag RECEIVED">📥 受信済</span>';
        case 'ACCEPTED': return '<span class="status-tag ACCEPTED">🟡 受付済</span>';
        case 'IN_PROGRESS': return '<span class="status-tag IN_PROGRESS">⚙️ 実施中</span>';
        case 'COMPLETED': return '<span class="status-tag COMPLETED">✅ 完了</span>';
        case 'FAILED': return '<span class="status-tag FAILED">❌ 失敗</span>';
        default: return `<span class="status-tag">${escapeHtml(status || 'UNKNOWN')}</span>`;
      }
    }

    let lastRenderedOrdersHash = '';

    function renderHistory(orders, force = false) {
      latestHistoryOrders = orders || [];
      const container = document.getElementById('historyContainer');
      if (!container) return;

      if (!latestHistoryOrders || latestHistoryOrders.length === 0) {
        container.innerHTML = `<div style="text-align:center; padding:3rem 1rem; color:#94a3b8; font-size:0.85rem;">送信履歴はまだありません。左のフォームからオーダーを送信してみてください。</div>`;
        lastRenderedOrdersHash = '';
        return;
      }

      // 差分チェック用の簡易ハッシュ（変更がなければDOMを再構築しない）
      const currentHash = historyViewMode + '_' + latestHistoryOrders.map(o => `${o.orderId}:${o.status}:${o.lastNote || ''}`).join('|');
      if (!force && currentHash === lastRenderedOrdersHash) {
        return;
      }
      lastRenderedOrdersHash = currentHash;

      // 現在のスクロール位置を保存
      const existingList = container.querySelector('#historyCardsList');
      const savedListScrollTop = existingList ? existingList.scrollTop : 0;
      const existingTableContainer = container.querySelector('#historyTableContainer');
      const savedTableScrollTop = existingTableContainer ? existingTableContainer.scrollTop : 0;
      const savedTableScrollLeft = existingTableContainer ? existingTableContainer.scrollLeft : 0;

      if (historyViewMode === 'table') {
        renderHistoryTable(latestHistoryOrders, container);
        const newTableContainer = container.querySelector('#historyTableContainer');
        if (newTableContainer) {
          newTableContainer.scrollTop = savedTableScrollTop;
          newTableContainer.scrollLeft = savedTableScrollLeft;
        }
      } else {
        renderHistoryCards(latestHistoryOrders, container);
        const newList = container.querySelector('#historyCardsList');
        if (newList) {
          newList.scrollTop = savedListScrollTop;
        }
      }
    }

    function renderHistoryCards(orders, container) {
      const itemsHtml = orders.map(item => {
        let actionNoteHtml = '';
        if (item.lastActor || item.lastNote) {
          actionNoteHtml = `
            <div class="history-action-note" style="margin-top:0.3rem; padding:0.25rem 0.5rem; background:rgba(0,0,0,0.03); border-radius:4px; font-size:0.72rem; color:#475569; border-left:2px solid #0284c7; word-break:break-word; overflow-wrap:anywhere;">
              🏢 最新対応: <strong>${escapeHtml(item.lastActor || '部門担当者')}</strong> ${item.lastNote ? `(${escapeHtml(item.lastNote)})` : ''}
            </div>
          `;
        }

        const isChanged = prevOrderStatuses[item.orderId] && prevOrderStatuses[item.orderId] !== item.status;
        prevOrderStatuses[item.orderId] = item.status;
        const animationClass = isChanged ? 'status-updated' : '';

        return `
          <div class="history-item status-${item.status} ${animationClass}" id="history-${item.orderId}">
            <div class="history-header">
              <strong style="color:#0f172a; font-family:monospace;">${escapeHtml(item.orderId)}</strong>
              <div style="display:flex; align-items:center; gap:0.25rem;">
                ${getStatusBadgeHtml(item.status)}
                ${(item.carteSync && item.carteSync.success) ? '<span title="電子カルテ記事として同時保存済み" style="background:#e0f2fe; color:#0369a1; border:1px solid #bae6fd; font-size:0.68rem; font-weight:bold; padding:0.1rem 0.35rem; border-radius:3px;">📋 カルテ済</span>' : ''}
              </div>
            </div>
            <div class="history-meta">
              <span>患者: <strong>${escapeHtml(item.patient ? item.patient.name : '')}</strong></span>
              <span style="margin-left:0.5rem;">種別: ${escapeHtml(item.orderType || '')}</span>
              ${item.elapsedMs ? `<span style="margin-left:0.5rem;">${item.elapsedMs}ms</span>` : ''}
            </div>
            <div class="history-title" style="font-size:0.78rem; color:#334155; line-height:1.45; word-break:break-word; overflow-wrap:anywhere;">
              ${escapeHtml(item.title || '')}
            </div>
            ${item.details && item.details.remarks ? `
              <div class="history-remarks" style="margin-top:0.25rem; font-size:0.72rem; color:#475569; background:#f1f5f9; padding:0.2rem 0.45rem; border-radius:3px; word-break:break-word; overflow-wrap:anywhere;">
                📝 自由記載: <strong>${escapeHtml(item.details.remarks)}</strong>
              </div>
            ` : ''}
            ${actionNoteHtml}
