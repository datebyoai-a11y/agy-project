    function addNewRxMedicineRow() {
      const commonDays = parseInt(document.getElementById('rxCommonDays')?.value || '7', 10) || 7;
      const newId = 'med_' + Date.now() + '_' + Math.floor(Math.random() * 1000);
      rxItems.push({
        id: newId,
        medicine: '',
        medicineId: '',
        dailyDose: 3,
        unit: '錠',
        dailyTimes: 3,
        timing: '毎食後',
        dosage: '1日3錠 1日3回 毎食後',
        days: commonDays,
        quantity: '',
        instruction: ''
      });
      renderRxMedicinesList();
      setTimeout(() => {
        const inp = document.getElementById(`rxMedicine_${newId}`);
        if (inp) inp.focus();
      }, 50);
      showToast(`➕ 処方薬剤 (Rp. ${rxItems.length}) を追加しました`);
    }

    function removeRxMedicineRow(id) {
      if (rxItems.length <= 1) return;
      rxItems = rxItems.filter(item => item.id !== id);
      renderRxMedicinesList();
      showToast('🗑️ 薬剤を削除しました');
    }

    function updateRxItemField(id, field, val) {
      const item = rxItems.find(it => it.id === id);
      if (item) item[field] = val;
    }

    function applyCommonDaysToAll(days) {
      const d = parseInt(days, 10) || 7;
      rxItems.forEach(it => {
        it.days = d;
        const el = document.getElementById(`rxDays_${it.id}`);
        if (el) el.value = d;
        autoCalcQuantity(it.id);
      });
      showToast(`全薬剤の処方日数を ${d} 日分に統一しました`);
    }

    function autoCalcQuantity(id) {
      const item = rxItems.find(it => it.id === id);
      if (!item) return;

      const dailyDoseInput = document.getElementById(`rxDailyDose_${id}`);
      const daysInput = document.getElementById(`rxDays_${id}`);

      const dailyDose = parseFloat(dailyDoseInput ? dailyDoseInput.value : item.dailyDose) || 0;
      const days = parseInt(daysInput ? daysInput.value : item.days, 10) || 0;

      // 単位は薬剤マスタに従う（未設定時は '錠'）
      const unit = item.unit || '錠';

      syncRxItemDosage(id);

      if (dailyDose > 0 && days > 0) {
        let total = dailyDose * days;
        if (total % 1 !== 0) {
          total = Math.round(total * 100) / 100;
        }
        const totalStr = `${total}${unit}`;
        const qEl = document.getElementById(`rxQuantity_${id}`);
        if (qEl) qEl.value = totalStr;
        item.quantity = totalStr;
      }
    }

    // 🔁 内服処方: Do処方実行（前回の処方内容を自動反映）
    function executeDoPrescription() {
      const pId = document.getElementById('patientSelect')?.value || document.getElementById('patientIdInput')?.value || '';
      const pName = document.getElementById('patientNameInput')?.value || '';

      // 1. この患者の前回処方オーダーを検索 (latestHistoryOrders から)
      let pastRxOrder = null;
      if (typeof latestHistoryOrders !== 'undefined' && Array.isArray(latestHistoryOrders)) {
        // 同一患者の直近の処方オーダーを優先検索
        pastRxOrder = latestHistoryOrders.find(o => 
          (o.orderType === 'PRESCRIPTION' || o.orderType === 'RX') &&
          ((pId && o.patient && o.patient.id === pId) || (pName && o.patient && o.patient.name === pName))
        );
        // 見つからなければ直近の処方オーダーをフォールバック
        if (!pastRxOrder) {
          pastRxOrder = latestHistoryOrders.find(o => o.orderType === 'PRESCRIPTION' || o.orderType === 'RX');
        }
      }

      if (pastRxOrder && pastRxOrder.details) {
        const details = pastRxOrder.details;
        let importedCount = 0;

        if (Array.isArray(details.medicines) && details.medicines.length > 0) {
          rxItems = details.medicines.map((m, idx) => {
            const med = allMedicines.find(x => (m.medicineId && x.id === m.medicineId) || x.name === (m.medicine || m.name));
            const parsed = parseDosageDetails(m.dosage, med);
            const unit = (med && med.unit) ? med.unit : (m.unit || parsed.unit || '錠');
            const dailyDose = m.dailyDose || parsed.dailyDose || (m.unitDose ? m.unitDose * (m.dailyTimes || 3) : 3);
            const dailyTimes = m.dailyTimes || parsed.dailyTimes || 3;
            const timing = m.timing || parsed.timing || '毎食後';
            const days = parseInt(m.days, 10) || 7;
            const calcTotal = Math.round(dailyDose * days * 100) / 100;
            const quantity = m.quantity || `${calcTotal}${unit}`;

            let dosageStr = m.dosage;
            if (!dosageStr) {
              dosageStr = (timing === '不均等分割') ? `1日${dailyDose}${unit} 不均等分割` : `1日${dailyDose}${unit} 1日${dailyTimes}回 ${timing}`;
            }

            return {
              id: 'med_' + Date.now() + '_' + (idx + 1),
              medicine: m.medicine || m.name || '',
              medicineId: m.medicineId || m.id || '',
              dailyDose,
              unit,
              dailyTimes,
              timing,
              dosage: dosageStr,
              days,
              quantity,
              instruction: m.instruction || m.remarks || ''
            };
          });
          importedCount = rxItems.length;
        } else if (details.medicine) {
          const med = allMedicines.find(x => (details.medicineId && x.id === details.medicineId) || x.name === details.medicine);
          const parsed = parseDosageDetails(details.dosage, med);
          const unit = (med && med.unit) ? med.unit : (parsed.unit || '錠');
          const dailyDose = details.dailyDose || parsed.dailyDose || 3;
          const dailyTimes = details.dailyTimes || parsed.dailyTimes || 3;
          const timing = details.timing || parsed.timing || '毎食後';
          const days = parseInt(details.days, 10) || 7;
          const calcTotal = Math.round(dailyDose * days * 100) / 100;

          let dosageStr = details.dosage;
          if (!dosageStr) {
            dosageStr = (timing === '不均等分割') ? `1日${dailyDose}${unit} 不均等分割` : `1日${dailyDose}${unit} 1日${dailyTimes}回 ${timing}`;
          }

          rxItems = [{
            id: 'med_' + Date.now() + '_1',
            medicine: details.medicine,
            medicineId: details.medicineId || '',
            dailyDose,
            unit,
            dailyTimes,
            timing,
            dosage: dosageStr,
            days,
            quantity: details.quantity || `${calcTotal}${unit}`,
            instruction: details.remarks || ''
          }];
          importedCount = 1;
        }

        if (details.prescriptionType) {
          const typeSelect = document.getElementById('rxPrescriptionType');
          if (typeSelect) typeSelect.value = details.prescriptionType;
        }
        if (details.remarks) {
          const remText = document.getElementById('rxRemarks');
          if (remText) remText.value = details.remarks;
        }

        renderRxMedicinesList();
        showToast(`🔁 [Do処方] ${pastRxOrder.patient ? pastRxOrder.patient.name : ''}様の前回処方 (${importedCount}品目) を反映しました！`);
      } else {
        // 過去処方がない場合は標準的な定期処方セットを提示
        if (confirm('この患者の処方履歴が見つかりませんでした。\n院内標準の定期処方セット（ユナシン＋カロナール）を初期反映しますか？')) {
          rxItems = [
            {
              id: 'med_' + Date.now() + '_1',
              medicine: 'ユナシン錠375ｍｇ',
              medicineId: 'DR0001',
              dailyDose: 3,
              unit: '錠',
              dailyTimes: 3,
              timing: '毎食後',
              dosage: '1日3錠 1日3回 毎食後',
              days: 7,
              quantity: '21錠',
              instruction: '食後服用'
            },
            {
              id: 'med_' + Date.now() + '_2',
              medicine: 'カロナール錠300 300ｍｇ',
              medicineId: 'DR0043',
              dailyDose: 1,
              unit: '錠',
              dailyTimes: 1,
              timing: '疼痛時(頓用)',
              dosage: '1日1錠 疼痛時頓用',
              days: 10,
              quantity: '10錠',
              instruction: '発熱・疼痛時 (頓服)'
            }
          ];
          renderRxMedicinesList();
          showToast('✅ 標準処方セットを反映しました');
        }
      }
    }

    // =========================================================
    // 💉 注射指示 (複数行 No. 1〜10) 管理ステート & レンダリング
    // =========================================================
    function getTodayYmd() {
      const now = new Date();
      return new Date(now.getTime() - now.getTimezoneOffset() * 60000).toISOString().slice(0, 10);
    }
    function calcDatePlusDays(startYmd, days) {
      if (!startYmd) return '';
      const d = new Date(startYmd);
      d.setDate(d.getDate() + (parseInt(days, 10) || 1) - 1);
      return new Date(d.getTime() - d.getTimezoneOffset() * 60000).toISOString().slice(0, 10);
    }

    const defaultTodayStr = getTodayYmd();
    let ivItems = [
      {
        id: 'iv_' + Date.now() + '_1',
        medicine: 'セフォセフ静注用1g + 大塚生食注100ｍL',
        medicineId: 'DR0010',
        dosage: '1回1袋',
        route: 'DIV',
        frequency: '1日2回 (朝・夕)',
        startDate: defaultTodayStr,
        endDate: calcDatePlusDays(defaultTodayStr, 3),
        days: 3,
        rate: '80mL/h (約1時間15分で点滴)',
        remarks: '側管注'
      }
    ];

    function renderIvOrdersList() {
      const container = document.getElementById('ivOrdersListContainer');
      if (!container) return;
      const countLabel = document.getElementById('ivTotalCountText');
      if (countLabel) countLabel.textContent = `登録指示: ${ivItems.length}件 (最大10件)`;

      const commonStartEl = document.getElementById('ivCommonStartDate');
      if (commonStartEl && !commonStartEl.value) commonStartEl.value = defaultTodayStr;

      container.innerHTML = ivItems.map((item, index) => {
        const med = allMedicines.find(m => m.id === item.medicineId) || allMedicines.find(m => m.name === item.medicine);
        let detailCardHtml = '';
        if (med) detailCardHtml = buildMedDetailCardHtml(med);

        return `
          <div class="rx-item-card" id="ivCard_${item.id}" style="border-left-color: #0284c7; background:#ffffff;">
            <div class="rx-item-header">
              <div style="display:flex; align-items:center; gap:0.4rem;">
                <span class="rx-rp-badge" style="background:#0284c7;">💉 No. ${index + 1}</span>
                <span style="font-size:0.73rem; color:#64748b;">(注射指示箋 No.${index + 1}行目)</span>
              </div>
              <div style="display:flex; gap:0.35rem; align-items:center;">
                <button type="button" class="btn-lookup" onclick="openMedicineModal('iv_${item.id}')">🔍 注射薬マスタ検索</button>
                ${ivItems.length > 1 ? `
                  <button type="button" onclick="removeIvRow('${item.id}')" class="btn-rx-delete" title="この注射指示を削除">✕ 削除</button>
                ` : ''}
              </div>
            </div>

            <!-- 注射薬名入力 & サジェスト -->
            <div class="form-group" style="position:relative; margin-top:0.3rem;">
              <div style="position:relative;">
                <input type="text" id="ivMedicine_${item.id}" class="form-control"
                       placeholder="注射薬名・輸液名を入力（例: セフォセフ、大塚生食注、ソルデム...）"
                       value="${escapeHtml(item.medicine)}"
                       autocomplete="off"
                       oninput="onIvItemInput('${item.id}', this.value)"
                       onfocus="onIvItemInput('${item.id}', this.value)"
                       onchange="updateIvItemField('${item.id}', 'medicine', this.value)">
                <div id="ivMedicineSuggest_${item.id}" class="med-suggest-dropdown" style="display:none;"></div>
              </div>
              <input type="hidden" id="ivMedicineId_${item.id}" value="${item.medicineId || ''}">
              <div id="ivMedDetailCard_${item.id}" class="med-detail-card" style="${detailCardHtml ? '' : 'display:none;'}">
                ${detailCardHtml}
              </div>
            </div>

            <!-- 投与経路 & 1日回数 & 用量 -->
            <div class="form-row" style="margin-top:0.35rem; gap:0.45rem;">
              <div class="form-group" style="flex:1.2;">
                <label class="form-label" style="font-size:0.73rem;">投与経路:</label>
                <select id="ivRoute_${item.id}" class="form-control" onchange="updateIvItemField('${item.id}', 'route', this.value)">
                  <option value="DIV" ${item.route === 'DIV' ? 'selected' : ''}>DIV (点滴静脈注射)</option>
                  <option value="iv" ${item.route === 'iv' ? 'selected' : ''}>iv (静脈内注射)</option>
                  <option value="im" ${item.route === 'im' ? 'selected' : ''}>im (筋肉内注射)</option>
                  <option value="is" ${item.route === 'is' ? 'selected' : ''}>is (皮下注射)</option>
                  <option value="IVH" ${item.route === 'IVH' ? 'selected' : ''}>IVH (中心静脈)</option>
                  <option value="その他" ${item.route === 'その他' ? 'selected' : ''}>その他</option>
                </select>
              </div>

              <div class="form-group" style="flex:1.4;">
                <label class="form-label" style="font-size:0.73rem;">1日の回数・頻度:</label>
                <input type="text" list="ivFreqList" id="ivFrequency_${item.id}" class="form-control"
                       value="${escapeHtml(item.frequency || '1日1回 (朝)')}"
                       placeholder="例: 1日2回 (朝・夕)"
                       onchange="updateIvItemField('${item.id}', 'frequency', this.value)">
              </div>

              <div class="form-group" style="flex:1;">
                <label class="form-label" style="font-size:0.73rem;">規格・用量:</label>
                <input type="text" id="ivDosage_${item.id}" class="form-control"
                       value="${escapeHtml(item.dosage || '')}"
                       placeholder="例: 1回1袋, 500mL"
                       onchange="updateIvItemField('${item.id}', 'dosage', this.value)">
              </div>
            </div>

            <!-- 日付連動: 開始日・終了日・指示日数 & 速度 & 備考 -->
            <div class="form-row" style="margin-top:0.35rem; gap:0.45rem; background:#f8fafc; padding:0.4rem 0.5rem; border-radius:4px; border:1px solid #e2e8f0; align-items:flex-end;">
              <div class="form-group" style="flex:1.1;">
                <label class="form-label" style="font-size:0.72rem; color:#0369a1; font-weight:bold;">開始日:</label>
                <input type="date" id="ivStartDate_${item.id}" class="form-control"
                       value="${item.startDate || ''}"
                       onchange="onIvStartDateChanged('${item.id}', this.value)">
              </div>

              <div class="form-group" style="flex:1.1;">
                <label class="form-label" style="font-size:0.72rem; color:#0369a1; font-weight:bold;">終了日:</label>
                <input type="date" id="ivEndDate_${item.id}" class="form-control"
                       value="${item.endDate || ''}"
                       onchange="onIvEndDateChanged('${item.id}', this.value)">
              </div>

              <div class="form-group" style="width:75px;">
                <label class="form-label" style="font-size:0.72rem; color:#0369a1; font-weight:bold;">指示日数:</label>
                <input type="number" id="ivDays_${item.id}" class="form-control"
                       value="${item.days || 3}" min="1" max="15"
                       onchange="onIvDaysChanged('${item.id}', this.value)">
              </div>

              <div class="form-group" style="flex:1.3;">
                <label class="form-label" style="font-size:0.72rem;">投与速度・時間:</label>
                <input type="text" id="ivRate_${item.id}" class="form-control"
                       value="${escapeHtml(item.rate || '')}"
                       placeholder="例: 80mL/h, 30分で点滴"
                       onchange="updateIvItemField('${item.id}', 'rate', this.value)">
              </div>

              <div class="form-group" style="flex:1.1;">
                <label class="form-label" style="font-size:0.72rem;">個別指示・備考:</label>
                <input type="text" id="ivRowRemarks_${item.id}" class="form-control"
                       value="${escapeHtml(item.remarks || '')}"
                       placeholder="例: 側管注, 遮光"
                       onchange="updateIvItemField('${item.id}', 'remarks', this.value)">
              </div>
            </div>
          </div>
        `;
      }).join('');
    }

    function addNewIvRow() {
      if (ivItems.length >= 10) {
        showToast('⚠️ 注射指示は用紙の都合上、最大10行までです', true);
        return;
      }
      const commonDays = parseInt(document.getElementById('ivCommonDays')?.value || '3', 10) || 3;
      const commonStart = document.getElementById('ivCommonStartDate')?.value || getTodayYmd();
      const commonFreq = document.getElementById('ivCommonFrequency')?.value || '1日1回 (朝)';
      const newId = 'iv_' + Date.now() + '_' + Math.floor(Math.random() * 1000);
      ivItems.push({
        id: newId,
        medicine: '',
        medicineId: '',
        dosage: '',
        route: 'DIV',
        frequency: commonFreq,
        startDate: commonStart,
        endDate: calcDatePlusDays(commonStart, commonDays),
        days: commonDays,
        rate: '60mL/h',
        remarks: ''
      });
      renderIvOrdersList();
      setTimeout(() => {
        const inp = document.getElementById(`ivMedicine_${newId}`);
        if (inp) inp.focus({ preventScroll: true });
      }, 50);
      showToast(`➕ 注射指示 (No. ${ivItems.length}) を追加しました`);
    }

    function removeIvRow(id) {
      if (ivItems.length <= 1) return;
      ivItems = ivItems.filter(item => item.id !== id);
      renderIvOrdersList();
      showToast('🗑️ 注射指示行を削除しました');
    }

    function updateIvItemField(id, field, val) {
      const item = ivItems.find(it => it.id === id);
      if (item) item[field] = val;
    }

    function onIvStartDateChanged(id, val) {
      const item = ivItems.find(it => it.id === id);
      if (!item) return;
      item.startDate = val;
      const days = parseInt(document.getElementById(`ivDays_${id}`)?.value || item.days || 1, 10);
      const newEnd = calcDatePlusDays(val, days);
      item.endDate = newEnd;
      const endEl = document.getElementById(`ivEndDate_${id}`);
      if (endEl) endEl.value = newEnd;
    }

    function onIvEndDateChanged(id, val) {
      const item = ivItems.find(it => it.id === id);
      if (!item) return;
      item.endDate = val;
      const start = document.getElementById(`ivStartDate_${id}`)?.value || item.startDate;
      if (start && val) {
        const diffDays = Math.max(1, Math.round((new Date(val) - new Date(start)) / (24 * 3600 * 1000)) + 1);
        item.days = diffDays;
        const daysEl = document.getElementById(`ivDays_${id}`);
        if (daysEl) daysEl.value = diffDays;
      }
    }

    function onIvDaysChanged(id, val) {
      const item = ivItems.find(it => it.id === id);
      if (!item) return;
      const days = Math.min(15, Math.max(1, parseInt(val, 10) || 1));
      item.days = days;
      const start = document.getElementById(`ivStartDate_${id}`)?.value || item.startDate;
      const newEnd = calcDatePlusDays(start, days);
      item.endDate = newEnd;
      const endEl = document.getElementById(`ivEndDate_${id}`);
      if (endEl) endEl.value = newEnd;
    }

    function applyCommonDatesToAllIv() {
      const start = document.getElementById('ivCommonStartDate')?.value || getTodayYmd();
      const days = parseInt(document.getElementById('ivCommonDays')?.value || '3', 10) || 3;
      ivItems.forEach(it => {
        it.startDate = start;
        it.days = days;
        it.endDate = calcDatePlusDays(start, days);
        const sEl = document.getElementById(`ivStartDate_${it.id}`);
        const eEl = document.getElementById(`ivEndDate_${it.id}`);
        const dEl = document.getElementById(`ivDays_${it.id}`);
        if (sEl) sEl.value = start;
        if (eEl) eEl.value = it.endDate;
        if (dEl) dEl.value = days;
      });
      showToast(`全注射指示の開始日を ${start}、指示日数を ${days} 日間に更新しました`);
    }

    function applyCommonFrequencyToAllIv(freq) {
      if (!freq) return;
      ivItems.forEach(it => {
        it.frequency = freq;
        const el = document.getElementById(`ivFrequency_${it.id}`);
        if (el) el.value = freq;
      });
      showToast(`全注射指示の頻度を「${freq}」に設定しました`);
    }

    function onIvItemInput(id, val) {
      const suggestBox = document.getElementById(`ivMedicineSuggest_${id}`);
      if (!suggestBox) return;
      if (!val || val.trim().length === 0) {
        suggestBox.style.display = 'none';
        return;
      }
      const results = searchLocalMedicines(val, '注射剤');
      if (!results || results.length === 0) {
        suggestBox.innerHTML = `<div style="padding:0.5rem 0.7rem; color:#94a3b8; font-size:0.75rem;">一致する注射薬が見つかりません（手動入力可）</div>`;
        suggestBox.style.display = 'block';
        return;
      }

      suggestBox.innerHTML = results.map(m => `
        <div class="med-suggest-item" onclick="selectMedicine('iv_${id}', '${m.id}')">
          <div>
            <div class="med-suggest-main">${escapeHtml(m.name)}</div>
            <div class="med-suggest-sub">
              <span>[${escapeHtml(m.id)}]</span>
              <span style="margin-left:0.3rem;">成分: ${escapeHtml(m.genericName || '―')}</span>
              ${m.dosage ? `<span style="margin-left:0.4rem; color:#0369a1;">規格/用法: ${escapeHtml(m.dosage)}</span>` : ''}
            </div>
          </div>
          <div class="med-suggest-badges">
            <span class="med-tag ${m.brandType === '先発' ? 'med-tag-brand-orig' : 'med-tag-brand-gen'}">${escapeHtml(m.brandType || '後発')}</span>
            <span class="med-tag" style="background:#e0f2fe; color:#0369a1;">${escapeHtml(m.category)}</span>
          </div>
        </div>
      `).join('');
      suggestBox.style.display = 'block';
    }

    function onRxItemInput(id, val) {
      const suggestBox = document.getElementById(`rxMedicineSuggest_${id}`);
      if (!suggestBox) return;
      if (!val || val.trim().length === 0) {
        suggestBox.style.display = 'none';
        return;
      }
      const results = searchLocalMedicines(val, '内服・外用');
      if (!results || results.length === 0) {
        suggestBox.innerHTML = `<div style="padding:0.5rem 0.7rem; color:#94a3b8; font-size:0.75rem;">一致する薬品が見つかりません（手動入力可）</div>`;
        suggestBox.style.display = 'block';
        return;
      }

      suggestBox.innerHTML = results.map(m => `
        <div class="med-suggest-item" onclick="selectMedicine('rx_${id}', '${m.id}')">
          <div>
            <div class="med-suggest-main">${escapeHtml(m.name)}</div>
            <div class="med-suggest-sub">
              <span>[${escapeHtml(m.id)}]</span>
              <span style="margin-left:0.3rem;">成分: ${escapeHtml(m.genericName || '―')}</span>
              ${m.dosage ? `<span style="margin-left:0.4rem; color:#0369a1;">用法: ${escapeHtml(m.dosage)}</span>` : ''}
            </div>
          </div>
          <div class="med-suggest-badges">
            <span class="med-tag ${m.brandType === '先発' ? 'med-tag-brand-orig' : 'med-tag-brand-gen'}">${escapeHtml(m.brandType || '後発')}</span>
            <span class="med-tag" style="background:#f1f5f9; color:#475569;">${escapeHtml(m.category)}</span>
            ${m.crushOk ? `<span class="med-tag ${m.crushOk === '〇' ? 'med-tag-ok' : (m.crushOk === '×' ? 'med-tag-ng' : 'med-tag-warn')}">粉砕:${escapeHtml(m.crushOk)}</span>` : ''}
          </div>
        </div>
      `).join('');
      suggestBox.style.display = 'block';
    }

    function hiraToKata(str) {
      if (!str) return '';
      return str.replace(/[\u3041-\u3096]/g, ch => String.fromCharCode(ch.charCodeAt(0) + 0x60));
    }
    function zenToHan(str) {
      if (!str) return '';
      return str.replace(/[！-～]/g, ch => String.fromCharCode(ch.charCodeAt(0) - 0xfee0)).replace(/　/g, ' ');
    }
    function normText(str) {
      if (!str) return '';
      return zenToHan(hiraToKata(String(str).toLowerCase().trim()));
    }

    function searchLocalMedicines(query, targetCategory) {
      const qNorm = normText(query);
      let list = allMedicines;
      if (targetCategory === '内服・外用') {
        list = list.filter(m => m.category === '内服薬' || m.category === '外用薬');
      } else if (targetCategory) {
        list = list.filter(m => m.category === targetCategory);
      }
      if (!qNorm) return list.slice(0, 30);

      const parts = qNorm.split(/\s+/).filter(Boolean);
      return list.filter(m => {
        const target = normText(`${m.name} ${m.kana} ${m.genericName} ${m.id} ${m.therapeuticCategoryMajor} ${m.therapeuticCategoryMiddle}`);
        return parts.every(p => target.includes(p));
      }).slice(0, 30);
    }

    function onMedicineInput(target, val) {
      const suggestBox = document.getElementById(`${target}MedicineSuggest`);
      if (!suggestBox) return;
      if (!val || val.trim().length === 0) {
        suggestBox.style.display = 'none';
        return;
      }
      const category = target === 'iv' ? '注射剤' : '内服・外用';
      const results = searchLocalMedicines(val, category);

      if (!results || results.length === 0) {
        suggestBox.innerHTML = `<div style="padding:0.5rem 0.7rem; color:#94a3b8; font-size:0.75rem;">一致する薬品が見つかりません（手動入力可）</div>`;
        suggestBox.style.display = 'block';
        return;
      }

      suggestBox.innerHTML = results.map(m => `
        <div class="med-suggest-item" onclick="selectMedicine('${target}', '${m.id}')">
          <div>
            <div class="med-suggest-main">${escapeHtml(m.name)}</div>
            <div class="med-suggest-sub">
              <span>[${escapeHtml(m.id)}]</span>
              <span style="margin-left:0.3rem;">成分: ${escapeHtml(m.genericName || '―')}</span>
              ${m.dosage ? `<span style="margin-left:0.4rem; color:#0369a1;">用法: ${escapeHtml(m.dosage)}</span>` : ''}
            </div>
          </div>
          <div class="med-suggest-badges">
            <span class="med-tag ${m.brandType === '先発' ? 'med-tag-brand-orig' : 'med-tag-brand-gen'}">${escapeHtml(m.brandType || '後発')}</span>
            <span class="med-tag" style="background:#f1f5f9; color:#475569;">${escapeHtml(m.category)}</span>
          </div>
        </div>
      `).join('');
      suggestBox.style.display = 'block';
    }

    function selectMedicine(target, medId) {
      const med = allMedicines.find(m => m.id === medId);
      if (!med) return;

      if (target.startsWith('rx_')) {
        const rowId = target.replace('rx_', '');
        const inp = document.getElementById(`rxMedicine_${rowId}`);
        if (inp) inp.value = med.name;
        const idInp = document.getElementById(`rxMedicineId_${rowId}`);
        if (idInp) idInp.value = med.id;

        const suggestBox = document.getElementById(`rxMedicineSuggest_${rowId}`);
        if (suggestBox) suggestBox.style.display = 'none';

        const parsed = parseDosageDetails(med.dosage, med);

        const item = rxItems.find(it => it.id === rowId);
        if (item) {
          item.medicine = med.name;
          item.medicineId = med.id;
          item.unit = med.unit || parsed.unit || '錠';
          item.dailyDose = parsed.dailyDose;
          item.dailyTimes = parsed.dailyTimes;
          item.timing = parsed.timing;
        }

        const ddInp = document.getElementById(`rxDailyDose_${rowId}`);
        if (ddInp) ddInp.value = parsed.dailyDose;
        const dtInp = document.getElementById(`rxDailyTimes_${rowId}`);
        if (dtInp) dtInp.value = parsed.dailyTimes;
        const tmInp = document.getElementById(`rxTiming_${rowId}`);
        if (tmInp) {
          tmInp.value = parsed.timing;
          onRxTimingChange(rowId, parsed.timing);
        }
        const unitLbl = document.getElementById(`rxUnitLabel_${rowId}`);
        if (unitLbl) unitLbl.textContent = item ? item.unit : '錠';

        const card = document.getElementById(`rxMedDetailCard_${rowId}`);
        if (card) {
          card.innerHTML = buildMedDetailCardHtml(med);
          card.style.display = 'block';
        }

        autoCalcQuantity(rowId);

        if (med.pharmacyComment) {
          const remarksInput = document.getElementById('rxRemarks');
          if (remarksInput && !remarksInput.value.includes(med.pharmacyComment)) {
            const rpNum = rxItems.findIndex(it => it.id === rowId) + 1;
            remarksInput.value = (remarksInput.value.trim() ? remarksInput.value.trim() + ' ' : '') + `[Rp.${rpNum}] ${med.pharmacyComment}`;
          }
        }
      } else if (target.startsWith('iv_')) {
        const rowId = target.replace('iv_', '');
        const item = ivItems.find(it => it.id === rowId);
        if (item) {
          item.medicine = med.name;
          item.medicineId = med.id;
          if (med.dosage && !item.dosage) item.dosage = med.dosage;
        }
        const input = document.getElementById(`ivMedicine_${rowId}`);
        const suggestBox = document.getElementById(`ivMedicineSuggest_${rowId}`);
        if (input) input.value = med.name;
        if (suggestBox) suggestBox.style.display = 'none';

        const idInput = document.getElementById(`ivMedicineId_${rowId}`);
        if (idInput) idInput.value = med.id;

        const card = document.getElementById(`ivMedDetailCard_${rowId}`);
        if (card) {
          card.innerHTML = buildMedDetailCardHtml(med);
          card.style.display = 'block';
        }
        if (med.pharmacyComment) {
          const remarksInput = document.getElementById('ivRemarks');
          if (remarksInput && !remarksInput.value.includes(med.pharmacyComment)) {
            const ivNum = ivItems.findIndex(it => it.id === rowId) + 1;
            remarksInput.value = (remarksInput.value.trim() ? remarksInput.value.trim() + ' ' : '') + `[No.${ivNum}] ${med.pharmacyComment}`;
          }
        }
      } else if (target === 'iv') {
        const input = document.getElementById('ivMedicine');
        const suggestBox = document.getElementById('ivMedicineSuggest');
        if (input) input.value = med.name;
        if (suggestBox) suggestBox.style.display = 'none';

        const idInput = document.getElementById('ivMedicineId');
        if (idInput) idInput.value = med.id;

        if (med.dosage) {
          const rateInput = document.getElementById('ivRate');
          if (rateInput && !rateInput.value.includes(med.dosage)) {
            rateInput.value = med.dosage;
          }
        }
        if (med.pharmacyComment) {
          const remarksInput = document.getElementById('ivRemarks');
          if (remarksInput && !remarksInput.value.includes(med.pharmacyComment)) {
            remarksInput.value = (remarksInput.value.trim() ? remarksInput.value.trim() + ' ' : '') + med.pharmacyComment;
          }
        }
        renderMedDetailCard('iv', med);
      }

      showToast(`💊 薬品「${med.name}」を選択・自動補完しました`);
    }

    function renderMedDetailCard(target, med) {
      const card = document.getElementById(`${target}MedDetailCard`);
      if (!card) return;
      card.innerHTML = buildMedDetailCardHtml(med);
      card.style.display = 'block';
    }

    function openMedicineModal(target) {
      activeLookupTarget = target;
      const isIv = target.startsWith('iv');
      document.getElementById('medModalTitle').textContent = isIv ? '💉 注射薬マスタ検索・選択' : '💊 薬品集マスタ検索・選択';
      modalCategoryFilter = isIv ? '注射剤' : 'ALL';
      document.querySelectorAll('#medModalCategoryFilters .filter-btn').forEach(btn => {
        const text = btn.textContent;
        if ((isIv && text.includes('注射剤')) || (!isIv && text.includes('全部'))) {
          btn.classList.add('active');
        } else {
          btn.classList.remove('active');
        }
      });
      document.getElementById('medModalSearchInput').value = '';
      renderModalTable();
      document.getElementById('medMasterModal').style.display = 'flex';
      setTimeout(() => document.getElementById('medModalSearchInput').focus(), 100);
    }

    function closeMedicineModal(event) {
      if (event && event.target !== event.currentTarget) return;
      document.getElementById('medMasterModal').style.display = 'none';
    }

    function filterModalCategory(cat, btn) {
      modalCategoryFilter = cat;
      document.querySelectorAll('#medModalCategoryFilters .filter-btn').forEach(b => b.classList.remove('active'));
      if (btn) btn.classList.add('active');
      renderModalTable();
    }

    function onModalSearchInput(val) {
      renderModalTable();
    }

    function renderModalTable() {
      const q = document.getElementById('medModalSearchInput').value.trim();
      const targetCat = modalCategoryFilter === 'ALL' ? (activeLookupTarget === 'iv' ? '注射剤' : '') : modalCategoryFilter;
      const results = searchLocalMedicines(q, targetCat);

      document.getElementById('medModalCountBadge').textContent = `${results.length}品目該当`;

      const tbody = document.getElementById('medModalTableBody');
      if (results.length === 0) {
        tbody.innerHTML = `<tr><td colspan="6" style="text-align:center; padding:2rem; color:#94a3b8;">条件に一致する薬品が見つかりませんでした</td></tr>`;
        return;
      }

      tbody.innerHTML = results.map(m => `
        <tr style="border-bottom:1px solid #e2e8f0; transition:background-color 0.12s;" onmouseover="this.style.backgroundColor='#f0fdf4'" onmouseout="this.style.backgroundColor=''">
          <td style="padding:0.45rem 0.6rem; font-family:monospace; font-weight:bold; color:#475569;">${escapeHtml(m.id)}</td>
          <td style="padding:0.45rem 0.6rem;">
            <span class="med-tag" style="background:#f1f5f9; color:#475569;">${escapeHtml(m.category)}</span>
          </td>
          <td style="padding:0.45rem 0.6rem;">
            <div style="font-weight:bold; color:#0f172a; font-size:0.84rem;">${escapeHtml(m.name)}</div>
            <div style="font-size:0.72rem; color:#64748b;">${escapeHtml(m.kana)} / 成分: ${escapeHtml(m.genericName || '―')}</div>
            ${m.pharmacyComment ? `<div style="font-size:0.7rem; color:#be123c; font-weight:bold;">⚠️ ${escapeHtml(m.pharmacyComment)}</div>` : ''}
          </td>
          <td style="padding:0.45rem 0.6rem; font-size:0.74rem; color:#334155; line-height:1.3;">
            ${escapeHtml(m.dosage || '規定量')}
          </td>
          <td style="padding:0.45rem 0.6rem; text-align:center;">
            <div style="display:flex; gap:0.2rem; justify-content:center; flex-wrap:wrap;">
              ${m.crushOk ? `<span class="med-tag ${m.crushOk === '〇' ? 'med-tag-ok' : (m.crushOk === '×' ? 'med-tag-ng' : 'med-tag-warn')}">粉砕:${escapeHtml(m.crushOk)}</span>` : ''}
              ${m.suspensionOk ? `<span class="med-tag ${m.suspensionOk === '〇' ? 'med-tag-ok' : (m.suspensionOk === '×' ? 'med-tag-ng' : 'med-tag-warn')}">懸濁:${escapeHtml(m.suspensionOk)}</span>` : ''}
            </div>
          </td>
          <td style="padding:0.45rem 0.6rem; text-align:center;">
            <button type="button" onclick="selectMedicine('${activeLookupTarget}', '${m.id}'); closeMedicineModal();" style="background:#0284c7; color:white; border:none; padding:0.25rem 0.55rem; border-radius:4px; font-size:0.72rem; font-weight:bold; cursor:pointer;">
              選択
            </button>
          </td>
        </tr>
      `).join('');
    }

    // 画面外クリックでサジェスト非表示
    document.addEventListener('click', (e) => {
      const ivSuggest = document.getElementById('ivMedicineSuggest');
      if (ivSuggest && !e.target.closest('#ivMedicine') && !e.target.closest('#ivMedicineSuggest')) {
        ivSuggest.style.display = 'none';
      }
    });

    // 左右ペインドラッグ調整の初期化
    function initPaneResizing() {
      const container = document.querySelector('.container');
      const leftPane = document.querySelector('.form-card');
      const resizer = document.getElementById('paneResizer');
      if (!container || !leftPane || !resizer) return;

      // 保存された幅比率の復元
      try {
        const savedPct = localStorage.getItem('ordering_sender_split_pct');
        if (savedPct) {
          const pct = parseFloat(savedPct);
          if (pct >= 25 && pct <= 80) {
            leftPane.style.flex = `0 0 ${pct}%`;
          }
        }
      } catch (e) {}

      resizer.addEventListener('dblclick', (e) => {
        e.preventDefault();
        leftPane.style.flex = '0 0 52%';
        localStorage.removeItem('ordering_sender_split_pct');
        showToast('↔️ 左右分割の境界幅を初期比率 (52% : 48%) にリセットしました');
      });

      function startResize(e) {
        e.preventDefault();
        resizer.classList.add('is-resizing');
        document.body.classList.add('is-col-resizing');

        const containerRect = container.getBoundingClientRect();

        function onMove(ev) {
          const clientX = ev.pageX || (ev.touches && ev.touches[0].pageX);
          if (!clientX) return;
          const offset = clientX - containerRect.left;
          let pct = (offset / containerRect.width) * 100;
          pct = Math.max(25, Math.min(80, pct));
          leftPane.style.flex = `0 0 ${pct}%`;
        }

        function onUp() {
          resizer.classList.remove('is-resizing');
          document.body.classList.remove('is-col-resizing');
          document.removeEventListener('pointermove', onMove);
          document.removeEventListener('pointerup', onUp);
          document.removeEventListener('mousemove', onMove);
          document.removeEventListener('mouseup', onUp);
          document.removeEventListener('touchmove', onMove);
          document.removeEventListener('touchend', onUp);

          const pctMatch = leftPane.style.flex.match(/0 0 ([\d.]+)%/);
          if (pctMatch) {
            localStorage.setItem('ordering_sender_split_pct', pctMatch[1]);
          }
        }

        document.addEventListener('pointermove', onMove);
        document.addEventListener('pointerup', onUp);
        document.addEventListener('mousemove', onMove);
        document.addEventListener('mouseup', onUp);
        document.addEventListener('touchmove', onMove, { passive: false });
        document.addEventListener('touchend', onUp);
      }

      resizer.addEventListener('pointerdown', startResize);
      resizer.addEventListener('mousedown', startResize);
    }

    // 薬品マスタモーダル 列幅ドラッグ調整の初期化
    function initMedModalColResizing() {
      const table = document.getElementById('medModalTable');
      const colgroup = document.getElementById('medModalColgroup');
      const guide = document.getElementById('medColResizeGuide');
      const container = document.getElementById('medModalTableContainer');
      if (!table || !colgroup) return;

      const ths = table.querySelectorAll('thead th');
      const cols = colgroup.querySelectorAll('col');

      // 保存された幅の復元
      try {
        const saved = JSON.parse(localStorage.getItem('ordering_sender_med_col_widths') || 'null');
        if (saved && Array.isArray(saved)) {
          saved.forEach((w, idx) => {
            if (cols[idx] && w !== null && w !== undefined) {
              cols[idx].style.width = (typeof w === 'number' || !isNaN(w)) ? (w + 'px') : w;
            }
          });
        }
      } catch (e) {}

      ths.forEach((th, idx) => {
        if (th.querySelector('.col-resizer')) return;

        const resizer = document.createElement('div');
        resizer.className = 'col-resizer';
        resizer.title = '境界をドラッグして列幅を調整 (ダブルクリックで初期値に戻す)';
        th.appendChild(resizer);

        resizer.addEventListener('dblclick', (e) => {
          e.stopPropagation();
          e.preventDefault();
          if (cols[idx]) {
            const def = DEFAULT_MED_COL_WIDTHS[idx];
            cols[idx].style.width = (def === 'auto') ? 'auto' : (def + 'px');
            saveMedModalColWidths();
          }
        });

        function startResize(e) {
          e.preventDefault();
          e.stopPropagation();
          const startX = e.pageX;
          const startWidth = th.offsetWidth;
          const minW = MIN_MED_COL_WIDTHS[idx] || 50;

          resizer.classList.add('is-resizing');
          document.body.classList.add('is-col-resizing');

          if (guide && container) {
            guide.style.display = 'block';
            guide.style.height = table.offsetHeight + 'px';
            const containerRect = container.getBoundingClientRect();
            guide.style.left = (e.pageX - containerRect.left + container.scrollLeft) + 'px';
          }

          function onPointerMove(ev) {
            const currentX = ev.pageX;
            const diff = currentX - startX;
            const newWidth = Math.max(minW, startWidth + diff);

            if (cols[idx]) {
              cols[idx].style.width = newWidth + 'px';
            }

            if (guide && container) {
              const containerRect = container.getBoundingClientRect();
              const targetX = (th.getBoundingClientRect().left + newWidth - containerRect.left + container.scrollLeft);
              guide.style.left = targetX + 'px';
              guide.style.height = table.offsetHeight + 'px';
            }
          }

          function onPointerUp() {
            resizer.classList.remove('is-resizing');
            document.body.classList.remove('is-col-resizing');
            if (guide) guide.style.display = 'none';

            document.removeEventListener('pointermove', onPointerMove);
            document.removeEventListener('pointerup', onPointerUp);
            document.removeEventListener('mousemove', onPointerMove);
            document.removeEventListener('mouseup', onPointerUp);

            saveMedModalColWidths();
          }

          document.addEventListener('pointermove', onPointerMove);
          document.addEventListener('pointerup', onPointerUp);
          document.addEventListener('mousemove', onPointerMove);
          document.addEventListener('mouseup', onPointerUp);
        }

        resizer.addEventListener('pointerdown', startResize);
        resizer.addEventListener('mousedown', startResize);
      });
    }

    function saveMedModalColWidths() {
      const colgroup = document.getElementById('medModalColgroup');
      if (!colgroup) return;
      const cols = colgroup.querySelectorAll('col');
      const widths = Array.from(cols).map(c => {
        const w = c.style.width;
        if (w === 'auto' || !w) return 'auto';
        return parseInt(w, 10) || 'auto';
      });
      localStorage.setItem('ordering_sender_med_col_widths', JSON.stringify(widths));
    }

    // 和暦変換ヘルパー (M, T, S, H, R)
    function parseJapaneseEraDate(dateStr) {
      if (!dateStr) return { era: '', year: '', month: '', day: '' };
      const d = new Date(dateStr);
      if (isNaN(d.getTime())) return { era: '', year: '', month: '', day: '' };

      const y = d.getFullYear();
      const m = d.getMonth() + 1;
      const day = d.getDate();

      let era = 'S';
      let eraYear = y - 1925;
      const ymNum = y * 10000 + m * 100 + day;
      if (ymNum >= 20190501) {
        era = 'R';
        eraYear = y - 2018;
      } else if (ymNum >= 19890108) {
        era = 'H';
        eraYear = y - 1988;
      } else if (ymNum >= 19261225) {
        era = 'S';
        eraYear = y - 1925;
      } else if (ymNum >= 19120730) {
        era = 'T';
        eraYear = y - 1911;
      } else {
        era = 'M';
        eraYear = y - 1867;
      }

      return {
        era,
        year: eraYear === 1 ? '元' : String(eraYear),
        month: String(m),
        day: String(day).padStart(2, '0')
      };
    }

    // =========================================================
    // 注射指示箋 (インクリメンタル検索機能完備) 呼び出し & 連携
    // =========================================================
    function openInjectionSheetWithCurrentPatient(e) {
      if (e && e.preventDefault) e.preventDefault();
      const currentPId = document.getElementById('patientIdInput')?.value || (SamplePatients[0] && SamplePatients[0].id) || '';
      const currentPName = document.getElementById('patientNameInput')?.value || '';
      const currentDept = document.getElementById('patientWardInput')?.value || '';
      let query = '';
      if (currentPId) query += `patientId=${encodeURIComponent(currentPId)}`;
      if (currentPName) query += `${query ? '&' : ''}patientName=${encodeURIComponent(currentPName)}`;
      if (currentDept) query += `${query ? '&' : ''}patientDept=${encodeURIComponent(currentDept)}`;
      const url = `/injection-sheet-form${query ? `?${query}` : ''}`;
      window.open(url, 'app_injection_sheet');
      return false;
    }

    function openInjectionSheetForOrder(orderId) {
      let pId = '';
      let pName = '';
      if (orderId && typeof latestHistoryOrders !== 'undefined') {
        const order = latestHistoryOrders.find(o => o.orderId === orderId);
        if (order && order.patient) {
          pId = order.patient.id || '';
          pName = order.patient.name || '';
        }
      }
      let query = `orderId=${encodeURIComponent(orderId || '')}`;
      if (pId) query += `&patientId=${encodeURIComponent(pId)}`;
      if (pName) query += `&patientName=${encodeURIComponent(pName)}`;
      const url = `/injection-sheet-form?${query}`;
      window.open(url, 'app_injection_sheet');
      return false;
    }

    function openSenderInjectionModal(orderId) {
      if (orderId) {
        return openInjectionSheetForOrder(orderId);
      } else {
        return openInjectionSheetWithCurrentPatient();
      }
    }

    function openPaperInjectionForm() {
      openInjectionSheetWithCurrentPatient();
    }

    function closeInjectionSheetModal() {}
    function printInjectionSheet() { window.print(); }

    // 🌐 URLクエリパラメータによる患者・オーダー種別初期化連動
    function applyUrlParams() {
      const params = new URLSearchParams(window.location.search);
      const pId = params.get('patientId') || params.get('targetId') || params.get('id');
      const pName = params.get('patientName') || params.get('name');
      const pDept = params.get('patientDept') || params.get('dept');
      const oType = params.get('orderType') || params.get('order');

      if (pId || pName) {
        const select = document.getElementById('patientSelect');
        if (select) {
          let matched = false;
          for (let i = 0; i < select.options.length; i++) {
            const opt = select.options[i];
            const optId = opt.getAttribute('data-id') || opt.value;
            const optName = opt.getAttribute('data-name');
            if ((pId && (optId === pId || opt.value === pId)) || (pName && optName === pName)) {
              select.selectedIndex = i;
              onPatientSelectChange(select);
              matched = true;
              break;
            }
          }
          if (!matched) {
            select.value = 'CUSTOM';
            onPatientSelectChange(select);
            if (pId) document.getElementById('patientIdInput').value = pId;
            if (pName) document.getElementById('patientNameInput').value = pName;
            if (pDept && document.getElementById('patientDeptInput')) document.getElementById('patientDeptInput').value = pDept;
            updateHeaderCarteLink();
            if (typeof updateOrderPreview === 'function') updateOrderPreview();
          }
        }
      }

      if (oType) {
        const upper = oType.toUpperCase();
        if (upper === 'IV' || upper === 'INJECTION') {
          const btn = document.querySelector('.tab-iv');
          if (btn) switchOrderType('IV', btn);
        } else if (upper === 'PRESCRIPTION' || upper === 'RX') {
          const btn = document.querySelector('.tab-rx');
          if (btn) switchOrderType('PRESCRIPTION', btn);
        } else if (upper === 'RADIOLOGY' || upper === 'RAD') {
          const btn = document.querySelector('.tab-rad');
          if (btn) switchOrderType('RADIOLOGY', btn);
        } else if (upper === 'LAB_EXAM' || upper === 'LAB') {
          const btn = document.querySelector('.tab-lab');
          if (btn) switchOrderType('LAB_EXAM', btn);
        } else if (upper === 'MEAL') {
          const btn = document.querySelector('.tab-meal');
          if (btn) switchOrderType('MEAL', btn);
        } else if (upper === 'REHAB') {
          const btn = document.querySelector('.tab-rehab');
          if (btn) switchOrderType('REHAB', btn);
        }
      }

      updateHeaderCarteLink();
      syncPatientCompactDisplay();
    }

    // 初期化実行
    connectSSE();
    startAutoSync();
    initMedicineMaster();
    initPaneResizing();
    applyHistoryWrapUI();
    setHistoryViewMode(historyViewMode);
    initMedModalColResizing();
    applyUrlParams();
    syncPatientCompactDisplay();
  </script>
