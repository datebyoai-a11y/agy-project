        const physicals = [];
        if (document.getElementById('phys_massage').checked) physicals.push(`マッサージ(${document.getElementById('phys_massage_part').value.trim() || '指定'})`);
        if (document.getElementById('phys_hotpack').checked) physicals.push(`ホットパック(${document.getElementById('phys_hotpack_part').value.trim() || '指定'})`);
        if (document.getElementById('phys_ssp').checked) physicals.push(`SSP(${document.getElementById('phys_ssp_part').value.trim() || '指定'})`);
        if (document.getElementById('phys_micro').checked) physicals.push(`マイクロ波(${document.getElementById('phys_micro_part').value.trim() || '指定'})`);
