                  <span style="color:#475569;">DVD作成:</span>
                  <label style="margin-left:0.15rem; cursor:pointer;"><input type="radio" name="xrayDvd" value="未" checked> 未</label>
                  <label style="margin-left:0.15rem; cursor:pointer;"><input type="radio" name="xrayDvd" value="済"> 済</label>
                </div>
                <div>
                  <span style="color:#475569;">画像取込:</span>
                  <label style="margin-left:0.15rem; cursor:pointer;"><input type="radio" name="xrayImgImport" value="未" checked> 未</label>
                  <label style="margin-left:0.15rem; cursor:pointer;"><input type="radio" name="xrayImgImport" value="済"> 済</label>
                </div>
              </div>
            </div>
          </div>

          <!-- 部位・方向 (①～⑩ 写真様式忠実再現) -->
          <div class="form-group" style="margin-bottom:0.6rem;">
            <label class="form-label" style="font-weight:bold; color:#065f46; display:flex; justify-content:space-between;">
              <span>🎯 照射部位・撮影方向 (写真様式 ①～⑩ 項目):</span>
              <span style="font-size:0.72rem; color:#64748b; font-weight:normal;">※ 複数部位の指示可能</span>
            </label>

            <div style="display:flex; flex-direction:column; gap:0.4rem;">
