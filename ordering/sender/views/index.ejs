      });
      document.getElementById('medModalSearchInput').value = '';
      renderModalTable();
      document.getElementById('medMasterModal').style.display = 'flex';
      setTimeout(() => document.getElementById('medModalSearchInput').focus(), 100);
    }

    function closeMedicineModal(event) {
      if (event && event.target !== event.currentTarget) return;
      document.getElementById('medMasterModal').style.display = 'none';
