            </div>
          </div>

          <!-- 撮影部位 (写真の9箇所チェックボックス + 部位詳細) -->
          <div class="form-group" style="margin-bottom:0.5rem;">
            <label class="form-label">🎯 撮影部位 (用紙記載の9項目):</label>
            <div class="chk-grid" style="grid-template-columns: repeat(3, 1fr);">
              <label class="chk-item"><input type="checkbox" id="ctPart_head" value="頭部"> 頭部 <input type="text" id="ctPartDetail_head" placeholder="詳細" style="width:50px; font-size:0.7rem; border:1px solid #cbd5e1; border-radius:3px; padding:1px 3px;"></label>
              <label class="chk-item"><input type="checkbox" id="ctPart_neck" value="頸部"> 頸部 <input type="text" id="ctPartDetail_neck" placeholder="詳細" style="width:50px; font-size:0.7rem; border:1px solid #cbd5e1; border-radius:3px; padding:1px 3px;"></label>
              <label class="chk-item"><input type="checkbox" id="ctPart_chest" value="胸部" checked> 胸部 (肺・横隔) <input type="text" id="ctPartDetail_chest" placeholder="詳細" style="width:50px; font-size:0.7rem; border:1px solid #cbd5e1; border-radius:3px; padding:1px 3px;"></label>
              <label class="chk-item"><input type="checkbox" id="ctPart_abdomen" value="腹部"> 腹部 (肝・胆・膵・腎) <input type="text" id="ctPartDetail_abdomen" placeholder="詳細" style="width:50px; font-size:0.7rem; border:1px solid #cbd5e1; border-radius:3px; padding:1px 3px;"></label>
              <label class="chk-item"><input type="checkbox" id="ctPart_pelvis" value="骨盤腔"> 骨盤腔 <input type="text" id="ctPartDetail_pelvis" placeholder="詳細" style="width:50px; font-size:0.7rem; border:1px solid #cbd5e1; border-radius:3px; padding:1px 3px;"></label>
              <label class="chk-item"><input type="checkbox" id="ctPart_spine" value="脊椎"> 脊椎 <input type="text" id="ctPartDetail_spine" placeholder="詳細" style="width:50px; font-size:0.7rem; border:1px solid #cbd5e1; border-radius:3px; padding:1px 3px;"></label>
              <label class="chk-item"><input type="checkbox" id="ctPart_upperLimb" value="上肢"> 上肢 <input type="text" id="ctPartDetail_upperLimb" placeholder="詳細" style="width:50px; font-size:0.7rem; border:1px solid #cbd5e1; border-radius:3px; padding:1px 3px;"></label>
              <label class="chk-item"><input type="checkbox" id="ctPart_lowerLimb" value="下肢"> 下肢 <input type="text" id="ctPartDetail_lowerLimb" placeholder="詳細" style="width:50px; font-size:0.7rem; border:1px solid #cbd5e1; border-radius:3px; padding:1px 3px;"></label>
              <label class="chk-item"><input type="checkbox" id="ctPart_other" value="その他"> その他 <input type="text" id="ctPartDetail_other" placeholder="部位記入" style="width:70px; font-size:0.7rem; border:1px solid #cbd5e1; border-radius:3px; padding:1px 3px;"></label>
            </div>
          </div>

          <!-- 使用薬剤 & 撮影条件 (kV / mA / sec) -->
          <div class="form-row" style="margin-bottom:0.5rem;">
            <div class="form-group" style="flex:2;">
              <label class="form-label" for="ctMedication">使用薬剤 (造影剤・生食等):</label>
              <input type="text" id="ctMedication" class="form-control" placeholder="例: イオパミロン注300 (100mL)、生食" value="">
            </div>
            <div class="form-group" style="flex:1;">
              <label class="form-label">撮影条件 (kV/mA/sec):</label>
              <div style="display:flex; gap:0.2rem; align-items:center;">
                <input type="text" id="ctKv" class="form-control" placeholder="kV" value="120" style="font-size:0.75rem;">
                <input type="text" id="ctMa" class="form-control" placeholder="mA" value="200" style="font-size:0.75rem;">
                <input type="text" id="ctSec" class="form-control" placeholder="sec" value="0.5" style="font-size:0.75rem;">
              </div>
            </div>
          </div>

          <!-- 検査目的 (臨床所見・疑い病名) 自由記載欄 -->
          <div class="form-group">
            <label class="form-label" for="ctPurpose">📝 検査目的 (臨床所見・疑い病名・自由記載欄):</label>
            <textarea id="ctPurpose" class="form-control" rows="2" placeholder="例: 肺炎疑い、発熱・咳嗽の精査、経過観察など">発熱・咳嗽持続のため肺炎疑い、胸部精査</textarea>
          </div>
        </div>

        <!-- サブペイン 3-B: 透視検査依頼書 (Photo 2 準拠, 青色ヘッダー) -->
        <div id="rad-subpane-FLUORO" class="rad-subpane" style="display:none;">
          <div class="photo-form-banner banner-fluoro">
            <div class="photo-form-title">
              <span>🩻 透視検査依頼書 (医療法人 交雄会 だて病院)</span>
            </div>
            <span class="photo-form-badge">写真2準拠</span>
          </div>

          <!-- 検査項目 (PEG交換 / VF検査 / 消化管造影 / 単純透視 / その他) -->
          <div class="form-group" style="margin-bottom:0.5rem;">
            <label class="form-label">📋 検査項目 (用紙記載項目):</label>
            <div class="chk-grid" style="grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));">
              <label class="chk-item"><input type="checkbox" id="fluoro_peg" value="PEG交換" checked> PEG交換 (胃瘻交換)</label>
              <label class="chk-item"><input type="checkbox" id="fluoro_vf" value="VF検査"> VF検査 (嚥下造影)</label>
              <label class="chk-item"><input type="checkbox" id="fluoro_gi" value="消化管造影検査"> 消化管造影検査</label>
              <label class="chk-item"><input type="checkbox" id="fluoro_plain" value="単純透視"> 単純透視</label>
              <label class="chk-item"><input type="checkbox" id="fluoro_other" value="その他"> その他 <input type="text" id="fluoro_other_detail" placeholder="詳細" style="width:60px; font-size:0.7rem; border:1px solid #cbd5e1; border-radius:3px; padding:1px 3px;"></label>
            </div>
          </div>

          <!-- 使用薬剤 (だて病院のチェック式薬品リスト + 数量) -->
          <div class="form-group" style="background:#f8fafc; padding:0.5rem 0.65rem; border:1px solid #e2e8f0; border-radius:6px; margin-bottom:0.5rem;">
            <label class="form-label">💊 使用薬剤 (だて病院 常備薬品リスト):</label>
            <div class="chk-grid" style="grid-template-columns: 1fr 1fr;">
              <label class="chk-item" style="justify-content:space-between;">
                <span><input type="checkbox" id="fluoro_med_gastro"> ガストログラフィン</span>
                <span><input type="number" id="fluoro_med_gastro_val" placeholder="ml" value="20" style="width:50px; font-size:0.72rem;"> ml</span>
              </label>
              <label class="chk-item" style="justify-content:space-between;">
                <span><input type="checkbox" id="fluoro_med_xylo" checked> キシロカインゼリー2%</span>
                <span><input type="number" id="fluoro_med_xylo_val" placeholder="ml" value="10" style="width:50px; font-size:0.72rem;"> ml</span>
              </label>
              <label class="chk-item" style="justify-content:space-between;">
                <span><input type="checkbox" id="fluoro_med_saline" checked> 生理食塩水</span>
                <span><input type="number" id="fluoro_med_saline_val" placeholder="ml" value="20" style="width:50px; font-size:0.72rem;"> ml</span>
              </label>
              <label class="chk-item" style="justify-content:space-between;">
                <span><input type="checkbox" id="fluoro_med_barium"> 硫酸バリウム散98.8%ホリイ 300g</span>
                <span><input type="number" id="fluoro_med_barium_val" placeholder="本" style="width:45px; font-size:0.72rem;"> 本</span>
              </label>
              <label class="chk-item" style="justify-content:space-between;">
                <span><input type="checkbox" id="fluoro_med_baricon"> バリコンミール 300g</span>
                <span><input type="number" id="fluoro_med_baricon_val" placeholder="本" style="width:45px; font-size:0.72rem;"> 本</span>
              </label>
              <label class="chk-item" style="justify-content:space-between;">
                <span><input type="checkbox" id="fluoro_med_baros"> バロス発泡顆粒-S 3.5g×2</span>
                <span><input type="number" id="fluoro_med_baros_val" placeholder="包" style="width:45px; font-size:0.72rem;"> 包</span>
              </label>
            </div>
            <div style="margin-top:0.35rem; display:flex; gap:0.4rem; align-items:center;">
              <span style="font-size:0.75rem; color:#475569;">その他薬品:</span>
              <input type="text" id="fluoro_med_custom" class="form-control" placeholder="追加の薬剤名や量" style="flex:1; font-size:0.75rem;">
            </div>
          </div>

          <!-- 医療材料欄 -->
          <div class="form-group" style="margin-bottom:0.5rem;">
            <label class="form-label" for="fluoroMaterials">💉 医療材料欄 (カテーテル型番・バルーン等):</label>
            <input type="text" id="fluoroMaterials" class="form-control" placeholder="例: ガストロボタン 24Fr 3.5cm、交換用シリンジ、滅菌ガーゼ等" value="ガストロボタン 24Fr 3.5cm">
          </div>

          <!-- 検査目的・臨床情報 自由記載欄 -->
          <div class="form-group">
            <label class="form-label" for="fluoroRemarks">📝 自由記載欄（検査目的・臨床情報・胃瘻状態等）:</label>
            <textarea id="fluoroRemarks" class="form-control" rows="2" placeholder="例: 定期PEGチューブ交換、瘻孔状態良好、造影確認希望など">定期PEGチューブ交換、瘻孔部および胃内留置位置の造影確認</textarea>
          </div>
        </div>

        <!-- サブペイン 3-C: 診療Ｘ線照射録 (Photo 6 準拠, だて病院様式) -->
        <div id="rad-subpane-XRAY" class="rad-subpane" style="display:none;">
          <div class="photo-form-banner banner-xray">
            <div class="photo-form-title">
              <span>🩻 診療Ｘ線照射録 (医療法人 交雄会 だて病院)</span>
            </div>
            <span class="photo-form-badge">写真6準拠 (一般撮影・ポータブル・撮影条件)</span>
          </div>

          <!-- ヘッダーメタ情報: 技師・ポータブル・媒体連携 -->
          <div class="form-row" style="background:#f0fdf4; padding:0.5rem 0.65rem; border:1px solid #bbf7d0; border-radius:6px; margin-bottom:0.6rem; align-items:center;">
            <div class="form-group" style="flex:1;">
              <label class="form-label" for="xrayTechnician">🧑‍🔬 担当技師 (技師印):</label>
              <input type="text" id="xrayTechnician" class="form-control" value="放射線技師" placeholder="技師名">
            </div>
            <div class="form-group" style="flex:1.2;">
              <label class="form-label">🛏️ 撮影場所・ポータブル:</label>
              <div style="display:flex; align-items:center; gap:0.4rem; font-size:0.8rem;">
                <label style="cursor:pointer; display:flex; align-items:center; gap:0.25rem; font-weight:bold;">
                  <input type="checkbox" id="xrayPortableCheck" onchange="toggleXrayPortable(this.checked)">
                  ポータブル
                </label>
                <div id="xrayPortableRoomBox" style="display:none; align-items:center; gap:0.2rem;">
                  <span>(</span>
                  <input type="text" id="xrayPortableRoom" class="form-control" style="width:75px; padding:0.2rem 0.4rem; font-size:0.75rem;" placeholder="病室" value="<%= patients[0].room ? patients[0].room.replace('号室','') : '302' %>">
                  <span>) 号室</span>
                </div>
              </div>
            </div>
            <div class="form-group" style="flex:1.3;">
              <label class="form-label">💿 他院紹介用DVD作成・画像取込:</label>
              <div style="display:flex; gap:0.6rem; font-size:0.76rem;">
                <div>
                  <span style="color:#475569;">DVD作成:</span>
                  <label style="margin-left:0.15rem; cursor:pointer;"><input type="radio" name="xrayDvd" value="未" checked> 未</label>
                  <label style="margin-left:0.15rem; cursor:pointer;"><input type="radio" name="xrayDvd" value="済"> 済</label>
                </div>
                <div>
                  <span style="color:#475569;">画像取込:</span>
                  <label style="margin-left:0.15rem; cursor:pointer;"><input type="radio" name="xrayImgImport" value="未" checked> 未</label>
                  <label style="margin-left:0.15rem; cursor:pointer;"><input type="radio" name="xrayImgImport" value="済"> 済</label>
                </div>
              </div>
            </div>
          </div>

          <!-- 部位・方向 (①～⑩ 写真様式忠実再現) -->
          <div class="form-group" style="margin-bottom:0.6rem;">
            <label class="form-label" style="font-weight:bold; color:#065f46; display:flex; justify-content:space-between;">
              <span>🎯 照射部位・撮影方向 (写真様式 ①～⑩ 項目):</span>
              <span style="font-size:0.72rem; color:#64748b; font-weight:normal;">※ 複数部位の指示可能</span>
            </label>

            <div style="display:flex; flex-direction:column; gap:0.4rem;">
              <!-- ① 胸部 -->
              <div class="xray-site-row" style="background:#f0fdf4; border:1px solid #059669; border-radius:6px; padding:0.4rem 0.6rem;">
                <div style="display:flex; align-items:center; flex-wrap:wrap; gap:0.6rem;">
                  <label class="chk-item" style="font-weight:bold; border-color:#059669; background:#dcfce7; width:110px;">
                    <input type="checkbox" id="xray_site_chest" checked onchange="toggleSiteRow(this)"> ① 胸部
                  </label>
                  <div style="display:flex; align-items:center; gap:0.35rem; font-size:0.78rem;">
                    <span style="color:#475569; font-weight:bold;">正:</span>
                    <label style="cursor:pointer;"><input type="checkbox" id="xray_chest_ap_stand" checked> 立位</label>
                    <label style="cursor:pointer;"><input type="checkbox" id="xray_chest_ap_sit"> 座位</label>
                    <label style="cursor:pointer;"><input type="checkbox" id="xray_chest_ap_supine"> 臥位</label>
                  </div>
                  <div style="display:flex; align-items:center; gap:0.35rem; font-size:0.78rem; border-left:1px solid #cbd5e1; padding-left:0.5rem;">
                    <span style="color:#475569; font-weight:bold;">側面:</span>
                    <label style="cursor:pointer;"><input type="checkbox" id="xray_chest_lat_rl" checked> R-L</label>
                    <label style="cursor:pointer;"><input type="checkbox" id="xray_chest_lat_lr"> L-R</label>
                  </div>
                </div>
              </div>

              <!-- ② 腹部 -->
              <div class="xray-site-row" style="background:#ffffff; border:1px solid #cbd5e1; border-radius:6px; padding:0.4rem 0.6rem;">
                <div style="display:flex; align-items:center; flex-wrap:wrap; gap:0.6rem;">
                  <label class="chk-item" style="font-weight:bold; width:110px;">
                    <input type="checkbox" id="xray_site_abdo" onchange="toggleSiteRow(this)"> ② 腹部
                  </label>
                  <div style="display:flex; align-items:center; gap:0.35rem; font-size:0.78rem;">
                    <span style="color:#475569; font-weight:bold;">正:</span>
                    <label style="cursor:pointer;"><input type="checkbox" id="xray_abdo_stand" checked> 立位</label>
                    <label style="cursor:pointer;"><input type="checkbox" id="xray_abdo_sit"> 座位</label>
                    <label style="cursor:pointer;"><input type="checkbox" id="xray_abdo_supine"> 臥位</label>
                  </div>
                </div>
              </div>

              <!-- ③ 腰椎 -->
              <div class="xray-site-row" style="background:#ffffff; border:1px solid #cbd5e1; border-radius:6px; padding:0.4rem 0.6rem;">
                <div style="display:flex; align-items:center; flex-wrap:wrap; gap:0.6rem;">
                  <label class="chk-item" style="font-weight:bold; width:110px;">
                    <input type="checkbox" id="xray_site_lumbar" onchange="toggleSiteRow(this)"> ③ 腰椎
                  </label>
                  <div style="display:flex; align-items:center; gap:0.35rem; font-size:0.78rem;">
                    <span style="color:#475569; font-weight:bold;">方向:</span>
                    <label style="cursor:pointer;"><input type="checkbox" id="xray_lumbar_ap" checked> 正</label>
                    <label style="cursor:pointer;"><input type="checkbox" id="xray_lumbar_lat" checked> 側</label>
                  </div>
                </div>
              </div>

              <!-- ④ 膝関節 & ⑤ 股関節 (2カラム) -->
              <div style="display:grid; grid-template-columns: 1fr 1fr; gap:0.4rem;">
                <!-- ④ 膝関節 -->
                <div class="xray-site-row" style="background:#ffffff; border:1px solid #cbd5e1; border-radius:6px; padding:0.4rem 0.6rem;">
                  <div style="display:flex; align-items:center; flex-wrap:wrap; gap:0.4rem;">
                    <label class="chk-item" style="font-weight:bold; width:95px;">
                      <input type="checkbox" id="xray_site_knee" onchange="toggleSiteRow(this)"> ④ 膝関節
                    </label>
                    <div style="display:flex; align-items:center; gap:0.25rem; font-size:0.76rem;">
                      <span style="color:#475569; font-weight:bold;">左右:</span>
                      <label style="cursor:pointer;"><input type="checkbox" id="xray_knee_r" checked> R</label>
                      <label style="cursor:pointer;"><input type="checkbox" id="xray_knee_l" checked> L</label>
                    </div>
                    <div style="display:flex; align-items:center; gap:0.25rem; font-size:0.76rem; border-left:1px solid #cbd5e1; padding-left:0.35rem;">
                      <span style="color:#475569; font-weight:bold;">方向:</span>
                      <label style="cursor:pointer;"><input type="checkbox" id="xray_knee_ap" checked> 正</label>
                      <label style="cursor:pointer;"><input type="checkbox" id="xray_knee_lat" checked> 側</label>
                    </div>
                  </div>
                </div>

                <!-- ⑤ 股関節 -->
                <div class="xray-site-row" style="background:#ffffff; border:1px solid #cbd5e1; border-radius:6px; padding:0.4rem 0.6rem;">
                  <div style="display:flex; align-items:center; flex-wrap:wrap; gap:0.4rem;">
                    <label class="chk-item" style="font-weight:bold; width:95px;">
                      <input type="checkbox" id="xray_site_hip" onchange="toggleSiteRow(this)"> ⑤ 股関節
                    </label>
                    <div style="display:flex; align-items:center; gap:0.25rem; font-size:0.76rem;">
                      <span style="color:#475569; font-weight:bold;">左右:</span>
                      <label style="cursor:pointer;"><input type="checkbox" id="xray_hip_r" checked> R</label>
                      <label style="cursor:pointer;"><input type="checkbox" id="xray_hip_l"> L</label>
                    </div>
                    <div style="display:flex; align-items:center; gap:0.25rem; font-size:0.76rem; border-left:1px solid #cbd5e1; padding-left:0.35rem;">
                      <span style="color:#475569; font-weight:bold;">方向:</span>
                      <label style="cursor:pointer;"><input type="checkbox" id="xray_hip_ap" checked> 正</label>
                      <label style="cursor:pointer;"><input type="checkbox" id="xray_hip_lat" checked> 側</label>
                    </div>
                  </div>
                </div>
              </div>

              <!-- ⑥ 骨盤 & ⑦ 手(リウマチ) (2カラム) -->
              <div style="display:grid; grid-template-columns: 1fr 1fr; gap:0.4rem;">
                <!-- ⑥ 骨盤 -->
                <div class="xray-site-row" style="background:#ffffff; border:1px solid #cbd5e1; border-radius:6px; padding:0.4rem 0.6rem;">
                  <div style="display:flex; align-items:center; flex-wrap:wrap; gap:0.4rem;">
                    <label class="chk-item" style="font-weight:bold; width:95px;">
                      <input type="checkbox" id="xray_site_pelvis" onchange="toggleSiteRow(this)"> ⑥ 骨盤
                    </label>
                    <div style="display:flex; align-items:center; gap:0.35rem; font-size:0.76rem;">
                      <span style="color:#475569; font-weight:bold;">方向:</span>
                      <label style="cursor:pointer;"><input type="checkbox" id="xray_pelvis_ap" checked> 正</label>
                      <label style="cursor:pointer;"><input type="checkbox" id="xray_pelvis_obl"> 斜</label>
                    </div>
                  </div>
                </div>

                <!-- ⑦ 手 (リウマチ) -->
                <div class="xray-site-row" style="background:#ffffff; border:1px solid #cbd5e1; border-radius:6px; padding:0.4rem 0.6rem;">
                  <div style="display:flex; align-items:center; flex-wrap:wrap; gap:0.4rem;">
                    <label class="chk-item" style="font-weight:bold; width:130px;">
                      <input type="checkbox" id="xray_site_hand" onchange="toggleSiteRow(this)"> ⑦ 手(リウマチ) 2R
                    </label>
                    <div style="display:flex; align-items:center; gap:0.35rem; font-size:0.76rem;">
                      <label style="cursor:pointer;"><input type="radio" name="xray_hand_which" value="両" checked> 両</label>
                      <label style="cursor:pointer;"><input type="radio" name="xray_hand_which" value="右"> 右</label>
                      <label style="cursor:pointer;"><input type="radio" name="xray_hand_which" value="左"> 左</label>
                    </div>
                  </div>
                </div>
              </div>

              <!-- ⑧, ⑨, ⑩ 自由記入行 (3カラム) -->
              <div style="display:grid; grid-template-columns: 1fr 1fr 1fr; gap:0.4rem;">
                <!-- ⑧ 自由部位 -->
                <div class="xray-site-row" style="background:#ffffff; border:1px solid #cbd5e1; border-radius:6px; padding:0.35rem 0.5rem;">
                  <div style="display:flex; align-items:center; gap:0.25rem; margin-bottom:0.25rem;">
                    <label class="chk-item" style="padding:0.15rem 0.35rem; font-size:0.74rem; width:100%;">
                      <input type="checkbox" id="xray_site_free8" onchange="toggleSiteRow(this)"> ⑧ 自由入力
