    <div id="paneResizer" class="pane-resizer" title="左右の境界線をドラッグして幅を調整 (ダブルクリックで初期比率 52%:48% にリセット)"></div>

    <!-- 右列: 送信履歴・ステータス画面 (縦2列の右側) -->
    <div class="history-card wrap-mode" id="historyCard">
      <div class="section-title" style="justify-content:space-between; flex-wrap:wrap; gap:0.4rem; padding-bottom:0.4rem; border-bottom:2px solid #059669;">
        <div style="display:flex; align-items:center; gap:0.4rem;">
          <span style="font-weight:900; font-size:0.92rem; color:#065f46;">📋 送信履歴・ステータス</span>
          <span style="font-size:0.75rem; color:#64748b; font-weight:normal;">(状況追跡画面)</span>
          <span id="sseStatusBadge" style="font-size:0.68rem; padding:0.15rem 0.45rem; border-radius:9999px; background:#dcfce7; color:#15803d; font-weight:bold; border:1px solid #bbf7d0;">
            ⚡ リアルタイム接続中
