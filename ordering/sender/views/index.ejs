              <label class="form-label" for="xrayTechnician">🧑‍🔬 担当技師 (技師印):</label>
              <input type="text" id="xrayTechnician" class="form-control" value="放射線技師" placeholder="技師名">
            </div>
            <div class="form-group" style="flex:1.2;">
              <label class="form-label">🛏️ 撮影場所・ポータブル:</label>
              <div style="display:flex; align-items:center; gap:0.4rem; font-size:0.8rem;">
                <label style="cursor:pointer; display:flex; align-items:center; gap:0.25rem; font-weight:bold;">
                  <input type="checkbox" id="xrayPortableCheck" onchange="toggleXrayPortable(this.checked)">
                  ポータブル
                </label>
                <div id="xrayPortableRoomBox" style="display:none; align-items:center; gap:0.2rem;">
                  <span>(</span>
                  <input type="text" id="xrayPortableRoom" class="form-control" style="width:75px; padding:0.2rem 0.4rem; font-size:0.75rem;" placeholder="病室" value="<%= patients[0].room ? patients[0].room.replace('号室','') : '302' %>">
                  <span>) 号室</span>
                </div>
              </div>
            </div>
            <div class="form-group" style="flex:1.3;">
              <label class="form-label">💿 他院紹介用DVD作成・画像取込:</label>
              <div style="display:flex; gap:0.6rem; font-size:0.76rem;">
