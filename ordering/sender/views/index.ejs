    function initHistoryTableColResizing() {
      const table = document.getElementById('historyOrdersTable');
      const colgroup = document.getElementById('historyColgroup');
      const guide = document.getElementById('historyColResizeGuide');
      const container = document.getElementById('historyTableContainer');
      if (!table || !colgroup) return;

      const ths = table.querySelectorAll('thead th');
      const cols = colgroup.querySelectorAll('col');

      // 幅復元
      try {
        const saved = JSON.parse(localStorage.getItem('ordering_sender_history_col_widths') || 'null');
        if (saved && Array.isArray(saved)) {
          saved.forEach((w, idx) => {
            if (cols[idx] && w !== null && w !== undefined) {
              cols[idx].style.width = (typeof w === 'number' || !isNaN(w)) ? (w + 'px') : w;
            }
          });
        }
      } catch (e) {}

      ths.forEach((th, idx) => {
        if (th.querySelector('.col-resizer')) return;

        const resizer = document.createElement('div');
        resizer.className = 'col-resizer';
        resizer.title = '境界をドラッグして列幅を調整 (ダブルクリックでリセット)';
        th.appendChild(resizer);

        resizer.addEventListener('dblclick', (e) => {
          e.stopPropagation();
          e.preventDefault();
          resetSingleHistoryColWidth(idx);
        });

        function startResize(e) {
          e.preventDefault();
          e.stopPropagation();
          const startX = e.pageX;
          const startWidth = th.offsetWidth;
          const minW = MIN_HISTORY_COL_WIDTHS[idx] || 50;

          resizer.classList.add('is-resizing');
          document.body.classList.add('is-col-resizing');

          if (guide && container) {
            guide.style.display = 'block';
            guide.style.height = table.offsetHeight + 'px';
            const containerRect = container.getBoundingClientRect();
            guide.style.left = (e.pageX - containerRect.left + container.scrollLeft) + 'px';
          }

          function onPointerMove(ev) {
            const currentX = ev.pageX;
            const diff = currentX - startX;
            const newWidth = Math.max(minW, startWidth + diff);

            if (cols[idx]) {
              cols[idx].style.width = newWidth + 'px';
            }

            if (guide && container) {
              const containerRect = container.getBoundingClientRect();
              const targetX = (th.getBoundingClientRect().left + newWidth - containerRect.left + container.scrollLeft);
              guide.style.left = targetX + 'px';
              guide.style.height = table.offsetHeight + 'px';
            }
          }

          function onPointerUp() {
            resizer.classList.remove('is-resizing');
            document.body.classList.remove('is-col-resizing');
            if (guide) guide.style.display = 'none';

            document.removeEventListener('pointermove', onPointerMove);
            document.removeEventListener('pointerup', onPointerUp);
            document.removeEventListener('mousemove', onPointerMove);
            document.removeEventListener('mouseup', onPointerUp);

            saveHistoryColWidths();
          }

          document.addEventListener('pointermove', onPointerMove);
          document.addEventListener('pointerup', onPointerUp);
          document.addEventListener('mousemove', onPointerMove);
          document.addEventListener('mouseup', onPointerUp);
        }

        resizer.addEventListener('pointerdown', startResize);
        resizer.addEventListener('mousedown', startResize);
      });
    }

    function saveHistoryColWidths() {
      const colgroup = document.getElementById('historyColgroup');
      if (!colgroup) return;
      const cols = colgroup.querySelectorAll('col');
      const widths = Array.from(cols).map(c => {
        const w = c.style.width;
        if (w === 'auto' || !w) return 'auto';
        return parseInt(w, 10) || 'auto';
      });
      localStorage.setItem('ordering_sender_history_col_widths', JSON.stringify(widths));
    }

    function resetSingleHistoryColWidth(idx) {
      const colgroup = document.getElementById('historyColgroup');
      if (!colgroup) return;
      const cols = colgroup.querySelectorAll('col');
      if (cols[idx]) {
        const def = DEFAULT_HISTORY_COL_WIDTHS[idx];
        cols[idx].style.width = (def === 'auto') ? 'auto' : (def + 'px');
        saveHistoryColWidths();
        const thText = document.querySelectorAll('#historyOrdersTable th')[idx]?.textContent?.trim() || '';
        showToast(`↔️ 列「${thText}」の幅を初期値に戻しました`);
      }
    }

    function resetHistoryColWidths() {
      localStorage.removeItem('ordering_sender_history_col_widths');
      const colgroup = document.getElementById('historyColgroup');
      if (!colgroup) return;
      const cols = colgroup.querySelectorAll('col');
      cols.forEach((col, idx) => {
        const def = DEFAULT_HISTORY_COL_WIDTHS[idx];
        col.style.width = (def === 'auto') ? 'auto' : (def + 'px');
      });
      showToast('↔️ 履歴一覧表の全列幅を初期設定にリセットしました');
    }

    async function pollHistory() {
      try {
        const res = await fetch('/api/orders/history?_t=' + Date.now(), { cache: 'no-store' });
        const data = await res.json();
        if (data.success && data.orders) {
          renderHistory(data.orders);
        }
      } catch (e) {
        console.error('History poll failed:', e);
      }
    }

    async function syncAllStatus() {
      try {
        const res = await fetch('/api/orders/sync-all?_t=' + Date.now(), { cache: 'no-store' });
        const data = await res.json();
        if (data.success) {
          renderHistory(data.orders);
          showToast(`🔄 受信側の最新状況を同期しました (${data.updatedCount}件更新)`);
        }
      } catch (e) {
        showToast('❌ 同期エラー: ' + e.message, true);
      }
    }

    // SSE 接続
    let sseSource = null;
    function connectSSE() {
      const badge = document.getElementById('sseStatusBadge');
      try {
        if (sseSource) sseSource.close();
        sseSource = new EventSource('/api/orders/events');

        sseSource.addEventListener('connected', () => {
          if (badge) {
            badge.innerHTML = '⚡ リアルタイム接続中';
            badge.style.background = '#dcfce7';
            badge.style.color = '#15803d';
            badge.style.borderColor = '#bbf7d0';
          }
        });

        sseSource.addEventListener('status-update', (e) => {
          try {
            const payload = JSON.parse(e.data);
            if (payload.orders) {
              renderHistory(payload.orders);
            } else {
              pollHistory();
            }
            showToast(`🔔 [${payload.orderId || 'オーダー'}] ステータス更新: ${payload.status || ''} (${payload.lastActor || ''})`);
          } catch (err) {
            pollHistory();
          }
        });

        sseSource.addEventListener('order-sent', (e) => {
          try {
            const payload = JSON.parse(e.data);
            if (payload.orders) renderHistory(payload.orders);
          } catch (err) {
            pollHistory();
          }
        });

        sseSource.onerror = () => {
          if (badge) {
            badge.innerHTML = '🔄 自動同期中 (再接続待機)';
            badge.style.background = '#fef3c7';
            badge.style.color = '#b45309';
            badge.style.borderColor = '#fde68a';
          }
        };
      } catch (err) {
        console.warn('SSE connection failed, falling back to polling:', err);
      }
    }

    async function syncAllStatusSilently() {
      try {
        const res = await fetch('/api/orders/sync-all?_t=' + Date.now(), { cache: 'no-store' });
        const data = await res.json();
        if (data.success) {
          renderHistory(data.orders);
          if (data.updatedCount > 0) {
            showToast(`🔄 受信側の更新を同期しました (${data.updatedCount}件更新)`);
          }
        }
      } catch (e) {
        // バックグラウンドポーリング失敗時は静かにフォールバック
        pollHistory();
      }
    }

    let autoSyncTimer = null;
    function startAutoSync() {
      if (autoSyncTimer) clearInterval(autoSyncTimer);
      // 受信側の最新ステータス（受付・完了）を定期的に自動同期
      autoSyncTimer = setInterval(syncAllStatusSilently, 2500);
    }
    function stopAutoSync() {
      if (autoSyncTimer) {
        clearInterval(autoSyncTimer);
        autoSyncTimer = null;
      }
    }
    function toggleAutoSync(enabled) {
      if (enabled) {
        startAutoSync();
        syncAllStatusSilently();
        showToast('🔄 自動同期を有効にしました');
      } else {
        stopAutoSync();
        showToast('⏸️ 自動同期を一時停止しました');
