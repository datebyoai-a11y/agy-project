        const remarks = document.getElementById('mealRemarks').value.trim();
        details = {
          mealType,
          timing,
          allergies,
          remarks,
          scheduledAt
        };
        title = `🍱 食事指示: ${mealType} [${timing}] (${patientName})`;
      }

      btn.disabled = true;
      btn.innerHTML = `<span>⏳ 送信中...</span>`;

      try {
        const res = await fetch('/api/orders/send', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            receiverUrl,
            orderType: currentOrderType,
            priority,
            patientId,
            patientName,
            doctorName,
            title,
            details,
            patient: patientData
          })
        });

        const data = await res.json();
        if (res.ok && data.success) {
          showToast(`✅ [${data.order.orderId}] 送信成功！ (${data.order.elapsedMs}ms)`);
          pollHistory();
        } else {
          showToast(`❌ 送信エラー: ${data.error || '失敗'}`, true);
          pollHistory();
        }
      } catch (err) {
        showToast(`❌ 通信エラー: ${err.message}`, true);
      } finally {
        btn.disabled = false;
        btn.innerHTML = `<span>🚀 受信側サーバーへ指示票を送信</span>`;
      }
    }

    function escapeHtml(str) {
      if (!str) return '';
      return String(str).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }

    // 履歴管理ステート & 描画
    const prevOrderStatuses = {};
    let latestHistoryOrders = <%- JSON.stringify(sentOrders || []) %>;
    let historyViewMode = localStorage.getItem('ordering_sender_history_view_mode') || 'card';
    let isHistoryWrap = localStorage.getItem('ordering_sender_history_wrap') !== 'false'; // デフォルト折り返しON

    const DEFAULT_HISTORY_COL_WIDTHS = [75, 85, 125, 85, 110, 'auto', 70];
    const MIN_HISTORY_COL_WIDTHS = [60, 70, 100, 65, 90, 140, 60];

    const DEFAULT_MED_COL_WIDTHS = [75, 65, 'auto', 160, 80, 65];
    const MIN_MED_COL_WIDTHS = [55, 50, 120, 110, 65, 55];

    function toggleHistoryWrapMode() {
      isHistoryWrap = !isHistoryWrap;
      localStorage.setItem('ordering_sender_history_wrap', isHistoryWrap ? 'true' : 'false');
      applyHistoryWrapUI();
      renderHistory(latestHistoryOrders);
      showToast(isHistoryWrap ? '↩️ 送信履歴の折り返し: ON にしました' : '➡️ 送信履歴の1行表示 にしました');
    }

    function applyHistoryWrapUI() {
      const btn = document.getElementById('historyWrapToggleBtn');
      const card = document.getElementById('historyCard');
      if (card) {
        if (isHistoryWrap) card.classList.add('wrap-mode');
        else card.classList.remove('wrap-mode');
      }
      if (btn) {
        if (isHistoryWrap) {
          btn.innerHTML = '↩️ 折り返し: ON';
          btn.style.background = '#f0fdf4';
          btn.style.color = '#166534';
          btn.style.borderColor = '#86efac';
        } else {
          btn.innerHTML = '➡️ 1行表示: ON';
          btn.style.background = '#f8fafc';
          btn.style.color = '#475569';
          btn.style.borderColor = '#cbd5e1';
        }
      }
    }

    function setHistoryViewMode(mode) {
      historyViewMode = mode;
      localStorage.setItem('ordering_sender_history_view_mode', mode);
      const cardBtn = document.getElementById('viewModeCardBtn');
      const tableBtn = document.getElementById('viewModeTableBtn');
      const resetBtn = document.getElementById('historyResetColBtn');

      if (cardBtn && tableBtn) {
        if (mode === 'card') {
          cardBtn.classList.add('active');
          tableBtn.classList.remove('active');
          if (resetBtn) resetBtn.style.display = 'none';
        } else {
          cardBtn.classList.remove('active');
          tableBtn.classList.add('active');
          if (resetBtn) resetBtn.style.display = 'inline-block';
        }
      }
      renderHistory(latestHistoryOrders);
    }

    function getStatusBadgeHtml(status) {
      switch (status) {
        case 'SENT': return '<span class="status-tag SENT">📤 送信済</span>';
        case 'RECEIVED': return '<span class="status-tag RECEIVED">📥 受信済</span>';
        case 'ACCEPTED': return '<span class="status-tag ACCEPTED">🟡 受付済</span>';
        case 'IN_PROGRESS': return '<span class="status-tag IN_PROGRESS">⚙️ 実施中</span>';
        case 'COMPLETED': return '<span class="status-tag COMPLETED">✅ 完了</span>';
        case 'FAILED': return '<span class="status-tag FAILED">❌ 失敗</span>';
        default: return `<span class="status-tag">${escapeHtml(status || 'UNKNOWN')}</span>`;
      }
    }

    function renderHistory(orders) {
      latestHistoryOrders = orders || [];
      const container = document.getElementById('historyContainer');
      if (!container) return;

      if (!latestHistoryOrders || latestHistoryOrders.length === 0) {
        container.innerHTML = `<div style="text-align:center; padding:3rem 1rem; color:#94a3b8; font-size:0.85rem;">送信履歴はまだありません。左のフォームからオーダーを送信してみてください。</div>`;
        return;
      }

      if (historyViewMode === 'table') {
        renderHistoryTable(latestHistoryOrders, container);
      } else {
        renderHistoryCards(latestHistoryOrders, container);
      }
    }

    function renderHistoryCards(orders, container) {
      const itemsHtml = orders.map(item => {
        let actionNoteHtml = '';
        if (item.lastActor || item.lastNote) {
          actionNoteHtml = `
            <div class="history-action-note" style="margin-top:0.3rem; padding:0.25rem 0.5rem; background:rgba(0,0,0,0.03); border-radius:4px; font-size:0.72rem; color:#475569; border-left:2px solid #0284c7; word-break:break-word; overflow-wrap:anywhere;">
              🏢 最新対応: <strong>${escapeHtml(item.lastActor || '部門担当者')}</strong> ${item.lastNote ? `(${escapeHtml(item.lastNote)})` : ''}
            </div>
          `;
        }

        const isChanged = prevOrderStatuses[item.orderId] && prevOrderStatuses[item.orderId] !== item.status;
        prevOrderStatuses[item.orderId] = item.status;
        const animationClass = isChanged ? 'status-updated' : '';

        return `
          <div class="history-item status-${item.status} ${animationClass}" id="history-${item.orderId}">
            <div class="history-header">
              <strong style="color:#0f172a; font-family:monospace;">${escapeHtml(item.orderId)}</strong>
              ${getStatusBadgeHtml(item.status)}
            </div>
            <div class="history-meta">
              <span>患者: <strong>${escapeHtml(item.patient ? item.patient.name : '')}</strong></span>
              <span style="margin-left:0.5rem;">種別: ${escapeHtml(item.orderType || '')}</span>
              ${item.elapsedMs ? `<span style="margin-left:0.5rem;">${item.elapsedMs}ms</span>` : ''}
            </div>
            <div class="history-title" style="font-size:0.78rem; color:#334155; line-height:1.45; word-break:break-word; overflow-wrap:anywhere;">
              ${escapeHtml(item.title || '')}
            </div>
            ${item.details && item.details.remarks ? `
              <div class="history-remarks" style="margin-top:0.25rem; font-size:0.72rem; color:#475569; background:#f1f5f9; padding:0.2rem 0.45rem; border-radius:3px; word-break:break-word; overflow-wrap:anywhere;">
                📝 自由記載: <strong>${escapeHtml(item.details.remarks)}</strong>
              </div>
            ` : ''}
            ${actionNoteHtml}
            <div style="margin-top:0.35rem; display:flex; justify-content:space-between; align-items:center; font-size:0.7rem; color:#64748b;">
              <span>送信: ${new Date(item.sentAt).toLocaleTimeString('ja-JP')}</span>
              <button type="button" onclick="checkRemoteStatus('${item.orderId}')" style="background:#ffffff; border:1px solid #cbd5e1; padding:0.15rem 0.45rem; border-radius:3px; cursor:pointer; font-size:0.7rem;">
                🔍 状況照会
              </button>
            </div>
          </div>
        `;
      }).join('');

      container.innerHTML = `<div class="history-list ${isHistoryWrap ? 'wrap-mode' : ''}" id="historyCardsList">${itemsHtml}</div>`;
    }

    function renderHistoryTable(orders, container) {
      const rowsHtml = orders.map(item => {
        const timeStr = item.sentAt ? new Date(item.sentAt).toLocaleTimeString('ja-JP', { hour: '2-digit', minute: '2-digit', second: '2-digit' }) : '--:--:--';
        const patientName = escapeHtml(item.patient ? item.patient.name : '患者未指定');
        const orderType = escapeHtml(item.orderType || '');
        const title = escapeHtml(item.title || '');
        const remarks = item.details && item.details.remarks ? escapeHtml(item.details.remarks) : '';
        const actorNote = item.lastActor || item.lastNote ? ` [${escapeHtml(item.lastActor || '')}: ${escapeHtml(item.lastNote || '')}]` : '';

        return `
          <tr class="history-row" id="row-${item.orderId}">
            <td style="text-align:center;">${getStatusBadgeHtml(item.status)}</td>
            <td style="font-size:0.74rem; color:#64748b; white-space:nowrap;">${timeStr}</td>
            <td style="font-family:monospace; font-weight:bold; font-size:0.75rem; white-space:nowrap;">${escapeHtml(item.orderId)}</td>
            <td><span class="status-tag" style="background:#f1f5f9; color:#475569;">${orderType}</span></td>
            <td style="font-weight:bold; color:#0f172a;">${patientName}</td>
            <td class="details-cell" title="${title} ${remarks ? `\n📝自由記載: ` + remarks : ''}${actorNote}">
              <span>${title}</span>
              ${remarks ? `<div style="font-size:0.7rem; color:#64748b; margin-top:2px;">📝 ${remarks}</div>` : ''}
              ${actorNote ? `<div style="font-size:0.7rem; color:#0284c7; margin-top:1px;">🏢 ${actorNote}</div>` : ''}
            </td>
            <td style="text-align:center;">
              <button type="button" onclick="checkRemoteStatus('${item.orderId}')" style="background:#ffffff; border:1px solid #cbd5e1; padding:0.15rem 0.4rem; border-radius:3px; cursor:pointer; font-size:0.7rem; white-space:nowrap;">
                🔍 照会
              </button>
            </td>
          </tr>
        `;
      }).join('');

      container.innerHTML = `
        <div class="history-table-container" id="historyTableContainer">
          <div id="historyColResizeGuide" class="col-resize-guide"></div>
          <table class="history-table ${isHistoryWrap ? 'wrap-mode' : ''}" id="historyOrdersTable">
            <colgroup id="historyColgroup">
              <col style="width: 75px;">
              <col style="width: 85px;">
              <col style="width: 125px;">
              <col style="width: 85px;">
              <col style="width: 110px;">
              <col id="colHistoryDetails" style="width: auto;">
              <col style="width: 70px;">
            </colgroup>
            <thead>
              <tr>
                <th data-col-index="0" style="text-align:center;">状態</th>
                <th data-col-index="1">送信日時</th>
                <th data-col-index="2">オーダーID</th>
                <th data-col-index="3">種別</th>
                <th data-col-index="4">患者名</th>
                <th data-col-index="5">指示・オーダー内容 (ホバーで全文)</th>
                <th data-col-index="6" style="text-align:center;">操作</th>
              </tr>
            </thead>
            <tbody>
              ${rowsHtml}
            </tbody>
          </table>
        </div>
      `;

      initHistoryTableColResizing();
    }

    function initHistoryTableColResizing() {
      const table = document.getElementById('historyOrdersTable');
      const colgroup = document.getElementById('historyColgroup');
      const guide = document.getElementById('historyColResizeGuide');
      const container = document.getElementById('historyTableContainer');
      if (!table || !colgroup) return;

      const ths = table.querySelectorAll('thead th');
      const cols = colgroup.querySelectorAll('col');

      // 幅復元
      try {
        const saved = JSON.parse(localStorage.getItem('ordering_sender_history_col_widths') || 'null');
        if (saved && Array.isArray(saved)) {
          saved.forEach((w, idx) => {
            if (cols[idx] && w !== null && w !== undefined) {
              cols[idx].style.width = (typeof w === 'number' || !isNaN(w)) ? (w + 'px') : w;
            }
          });
        }
      } catch (e) {}

      ths.forEach((th, idx) => {
        if (th.querySelector('.col-resizer')) return;

        const resizer = document.createElement('div');
        resizer.className = 'col-resizer';
        resizer.title = '境界をドラッグして列幅を調整 (ダブルクリックでリセット)';
        th.appendChild(resizer);

        resizer.addEventListener('dblclick', (e) => {
          e.stopPropagation();
          e.preventDefault();
          resetSingleHistoryColWidth(idx);
        });

        function startResize(e) {
          e.preventDefault();
          e.stopPropagation();
          const startX = e.pageX;
          const startWidth = th.offsetWidth;
          const minW = MIN_HISTORY_COL_WIDTHS[idx] || 50;

          resizer.classList.add('is-resizing');
          document.body.classList.add('is-col-resizing');

          if (guide && container) {
            guide.style.display = 'block';
            guide.style.height = table.offsetHeight + 'px';
            const containerRect = container.getBoundingClientRect();
            guide.style.left = (e.pageX - containerRect.left + container.scrollLeft) + 'px';
          }

          function onPointerMove(ev) {
            const currentX = ev.pageX;
            const diff = currentX - startX;
            const newWidth = Math.max(minW, startWidth + diff);

            if (cols[idx]) {
              cols[idx].style.width = newWidth + 'px';
            }

            if (guide && container) {
              const containerRect = container.getBoundingClientRect();
              const targetX = (th.getBoundingClientRect().left + newWidth - containerRect.left + container.scrollLeft);
              guide.style.left = targetX + 'px';
              guide.style.height = table.offsetHeight + 'px';
            }
          }

          function onPointerUp() {
            resizer.classList.remove('is-resizing');
            document.body.classList.remove('is-col-resizing');
            if (guide) guide.style.display = 'none';

            document.removeEventListener('pointermove', onPointerMove);
            document.removeEventListener('pointerup', onPointerUp);
            document.removeEventListener('mousemove', onPointerMove);
            document.removeEventListener('mouseup', onPointerUp);

            saveHistoryColWidths();
          }

          document.addEventListener('pointermove', onPointerMove);
          document.addEventListener('pointerup', onPointerUp);
          document.addEventListener('mousemove', onPointerMove);
          document.addEventListener('mouseup', onPointerUp);
        }

        resizer.addEventListener('pointerdown', startResize);
        resizer.addEventListener('mousedown', startResize);
      });
    }

    function saveHistoryColWidths() {
      const colgroup = document.getElementById('historyColgroup');
      if (!colgroup) return;
      const cols = colgroup.querySelectorAll('col');
      const widths = Array.from(cols).map(c => {
        const w = c.style.width;
        if (w === 'auto' || !w) return 'auto';
        return parseInt(w, 10) || 'auto';
      });
      localStorage.setItem('ordering_sender_history_col_widths', JSON.stringify(widths));
    }

    function resetSingleHistoryColWidth(idx) {
      const colgroup = document.getElementById('historyColgroup');
      if (!colgroup) return;
      const cols = colgroup.querySelectorAll('col');
      if (cols[idx]) {
        const def = DEFAULT_HISTORY_COL_WIDTHS[idx];
        cols[idx].style.width = (def === 'auto') ? 'auto' : (def + 'px');
        saveHistoryColWidths();
        const thText = document.querySelectorAll('#historyOrdersTable th')[idx]?.textContent?.trim() || '';
        showToast(`↔️ 列「${thText}」の幅を初期値に戻しました`);
      }
    }

    function resetHistoryColWidths() {
      localStorage.removeItem('ordering_sender_history_col_widths');
      const colgroup = document.getElementById('historyColgroup');
      if (!colgroup) return;
      const cols = colgroup.querySelectorAll('col');
      cols.forEach((col, idx) => {
        const def = DEFAULT_HISTORY_COL_WIDTHS[idx];
        col.style.width = (def === 'auto') ? 'auto' : (def + 'px');
      });
      showToast('↔️ 履歴一覧表の全列幅を初期設定にリセットしました');
    }

    async function pollHistory() {
      try {
        const res = await fetch('/api/orders/history?_t=' + Date.now(), { cache: 'no-store' });
        const data = await res.json();
        if (data.success && data.orders) {
          renderHistory(data.orders);
        }
      } catch (e) {
        console.error('History poll failed:', e);
      }
    }

    async function syncAllStatus() {
      try {
        const res = await fetch('/api/orders/sync-all?_t=' + Date.now(), { cache: 'no-store' });
        const data = await res.json();
        if (data.success) {
          renderHistory(data.orders);
          showToast(`🔄 受信側の最新状況を同期しました (${data.updatedCount}件更新)`);
        }
      } catch (e) {
        showToast('❌ 同期エラー: ' + e.message, true);
      }
    }

    // SSE 接続
    let sseSource = null;
    function connectSSE() {
      const badge = document.getElementById('sseStatusBadge');
      try {
        if (sseSource) sseSource.close();
        sseSource = new EventSource('/api/orders/events');

        sseSource.addEventListener('connected', () => {
          if (badge) {
            badge.innerHTML = '⚡ リアルタイム接続中';
            badge.style.background = '#dcfce7';
            badge.style.color = '#15803d';
            badge.style.borderColor = '#bbf7d0';
          }
        });

        sseSource.addEventListener('status-update', (e) => {
          try {
            const payload = JSON.parse(e.data);
            if (payload.orders) {
              renderHistory(payload.orders);
            } else {
              pollHistory();
            }
            showToast(`🔔 [${payload.orderId || 'オーダー'}] ステータス更新: ${payload.status || ''} (${payload.lastActor || ''})`);
          } catch (err) {
            pollHistory();
          }
        });

        sseSource.addEventListener('order-sent', (e) => {
          try {
            const payload = JSON.parse(e.data);
            if (payload.orders) renderHistory(payload.orders);
          } catch (err) {
            pollHistory();
          }
        });

        sseSource.onerror = () => {
          if (badge) {
            badge.innerHTML = '🔄 自動同期中 (再接続待機)';
            badge.style.background = '#fef3c7';
            badge.style.color = '#b45309';
            badge.style.borderColor = '#fde68a';
          }
        };
      } catch (err) {
        console.warn('SSE connection failed, falling back to polling:', err);
      }
    }

    async function syncAllStatusSilently() {
      try {
        const res = await fetch('/api/orders/sync-all?_t=' + Date.now(), { cache: 'no-store' });
        const data = await res.json();
        if (data.success) {
          renderHistory(data.orders);
          if (data.updatedCount > 0) {
            showToast(`🔄 受信側の更新を同期しました (${data.updatedCount}件更新)`);
          }
        }
      } catch (e) {
        // バックグラウンドポーリング失敗時は静かにフォールバック
        pollHistory();
      }
    }

    let autoSyncTimer = null;
    function startAutoSync() {
      if (autoSyncTimer) clearInterval(autoSyncTimer);
      // 受信側の最新ステータス（受付・完了）を定期的に自動同期
      autoSyncTimer = setInterval(syncAllStatusSilently, 2500);
    }
    function stopAutoSync() {
      if (autoSyncTimer) {
        clearInterval(autoSyncTimer);
        autoSyncTimer = null;
      }
    }
    function toggleAutoSync(enabled) {
      if (enabled) {
        startAutoSync();
        syncAllStatusSilently();
        showToast('🔄 自動同期を有効にしました');
      } else {
        stopAutoSync();
        showToast('⏸️ 自動同期を一時停止しました');
      }
    }

    async function checkRemoteStatus(orderId) {
      try {
        const res = await fetch(`/api/orders/${orderId}/check-status?_t=` + Date.now(), { cache: 'no-store' });
        const data = await res.json();
        if (data.success) {
          showToast(`ℹ️ [${orderId}] 受信側の最新ステータス: ${data.status}`);
          pollHistory();
        } else {
          showToast(`⚠️ ステータス照会: ${data.message || data.error}`, true);
        }
      } catch (e) {
        showToast(`❌ 照会エラー: ${e.message}`, true);
      }
    }

    async function clearHistory() {
      if (!confirm('送信履歴をクリアしますか？')) return;
      try {
        const res = await fetch('/api/orders/clear-history', { method: 'POST' });
        if (res.ok) pollHistory();
      } catch (e) {
        alert('クリアエラー: ' + e.message);
      }
    }

    // =================================================================
    // 💊 薬品集マスタ連動 (オートコンプリート・複数Rp管理・モーダル)
