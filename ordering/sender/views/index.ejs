          <span id="medModalCountBadge" style="font-size:0.75rem; background:#e0f2fe; color:#0369a1; padding:0.15rem 0.5rem; border-radius:9999px; font-weight:bold;">
            607品目採用
          </span>
        </div>
        <button type="button" onclick="closeMedicineModal()" style="background:none; border:none; font-size:1.25rem; cursor:pointer; color:#64748b;">✕</button>
