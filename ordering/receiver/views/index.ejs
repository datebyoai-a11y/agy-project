      <% if (typeof isHttps !== 'undefined' && isHttps) { %>
        <span class="header-badge" style="background:#10b981; color:white;">🔒 HTTPS 暗号化</span>
      <% } else { %>
        <span class="header-badge" style="background:#64748b; color:white;">🔓 HTTP 平文</span>
      <% } %>
    </div>
    <div class="header-links">
      <a href="<%= typeof protocol !== 'undefined' ? protocol : 'http' %>://<%= typeof serverHostname !== 'undefined' ? serverHostname : 'localhost' %>:<%= typeof protocol !== 'undefined' && protocol === 'https' ? 4443 : 4000 %>" target="_blank">🚀 送信側を開く</a>
      <a href="http://<%= typeof serverHostname !== 'undefined' ? serverHostname : 'localhost' %>:3000/articles" target="_blank">📋 電子カルテ(Port 3000)</a>
