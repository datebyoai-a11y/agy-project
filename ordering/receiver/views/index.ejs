        } else {
          document.getElementById('injPrintBirthYear').textContent = '-';
          document.getElementById('injPrintBirthMonth').textContent = '-';
          document.getElementById('injPrintBirthDay').textContent = '-';
        }

        // 15日間カレンダーヘッダー
        for (let i = 0; i < 15; i++) {
          const cd = new Date(issueDate);
          cd.setDate(cd.getDate() + i);
          const th = document.getElementById(`injDayTh${i}`);
          if (th) {
            th.innerHTML = `
              <div style="font-size:11px; font-weight:bold; line-height:1.1;">${cd.getDate()}</div>
              <div style="font-size:8px; color:#64748b; font-weight:normal;">${cd.getMonth() + 1}/${cd.getDate()}</div>
            `;
          }
        }

        // 処方薬剤リストの取得 (複数薬品にも対応)
        const medList = (details.medicines && Array.isArray(details.medicines) && details.medicines.length > 0)
          ? details.medicines
          : [{
              medicine: details.medicine || '注射指示あり',
              dosage: details.dosage || details.dose || '',
              route: details.route || 'DIV',
              frequency: details.frequency || details.scheduleDays || '',
              startDate: details.startDate || '',
              endDate: details.endDate || '',
              days: details.days || details.scheduleDays || '',
              rate: details.rate || '',
              remarks: details.remarks || ''
            }];

        // 10行テーブルの構築
        const tbody = document.getElementById('injGridTbody');
        let gridHtml = '';

        for (let rowIdx = 1; rowIdx <= 10; rowIdx++) {
          const mItem = medList[rowIdx - 1];
          const savedRow = savedSheetState.find(r => r.no === rowIdx);

          let rowRoute = (savedRow && savedRow.route) ? savedRow.route : (mItem ? (mItem.route || details.route || 'DIV') : 'DIV');
          let normRoute = 'DIV';
          let otherRouteText = '';
          if (/DIV|点滴/i.test(rowRoute)) normRoute = 'DIV';
          else if (/IVH|中心静脈|CV/i.test(rowRoute)) normRoute = 'IVH';
          else if (/IS|皮下/i.test(rowRoute)) normRoute = 'is';
          else if (/IM|筋/i.test(rowRoute)) normRoute = 'im';
          else if (/IV|静注|静脈/i.test(rowRoute)) normRoute = 'iv';
          else { normRoute = 'OTHER'; otherRouteText = rowRoute; }

          const isSelected = (r) => normRoute.toUpperCase() === r.toUpperCase() ? 'inj-route-circle' : '';
          const otherText = normRoute === 'OTHER' ? `( ${escapeHtml(otherRouteText)} )` : '( &nbsp; )';

          let rxTextHtml = '';
          if (savedRow && savedRow.rxText) {
            rxTextHtml = escapeHtml(savedRow.rxText);
          } else if (mItem && mItem.medicine) {
            rxTextHtml = `<div style="font-weight:bold; font-size:11.5px; color:#0f172a; margin-bottom:2px;">${escapeHtml(mItem.medicine)}</div>`;
            const subInfos = [];
            if (mItem.dosage) subInfos.push(`用量: ${mItem.dosage}`);
            if (mItem.frequency) subInfos.push(`頻度: ${mItem.frequency}`);
            if (mItem.rate) subInfos.push(`速度: ${mItem.rate}`);
            if (mItem.days) subInfos.push(`${mItem.days}日間`);
            if (subInfos.length > 0) {
              rxTextHtml += `<div style="font-size:9.5px; color:#0369a1; font-weight:bold;">${escapeHtml(subInfos.join(' / '))}</div>`;
            }
            if (mItem.startDate && mItem.endDate) {
              rxTextHtml += `<div style="font-size:8.5px; color:#64748b;">期間: ${escapeHtml(mItem.startDate)}〜${escapeHtml(mItem.endDate)}</div>`;
            }
            if (mItem.remarks) {
              rxTextHtml += `<div style="font-size:8.5px; color:#b45309;">注: ${escapeHtml(mItem.remarks)}</div>`;
            }
          }

          let daysCellsHtml = '';
          const rowDaysCount = mItem ? (parseInt(mItem.days, 10) || 1) : 0;
          let startOffset = 0;
          if (mItem && mItem.startDate) {
            const diff = Math.floor((new Date(mItem.startDate) - issueDate) / (24 * 3600 * 1000));
            startOffset = isNaN(diff) ? 0 : Math.max(0, diff);
          }

          for (let d = 0; d < 15; d++) {
            let topContent = '';
            let bottomContent = '';

            if (savedRow && savedRow.days && savedRow.days[d]) {
              topContent = savedRow.days[d].top || '';
              bottomContent = savedRow.days[d].bottom || '';
            } else if (mItem && mItem.medicine && d >= startOffset && d < startOffset + rowDaysCount) {
              if (rowDaysCount === 1) {
                topContent = `<div class="inj-day-arrow" style="font-size:12px;">✔</div>`;
              } else if (d === startOffset + rowDaysCount - 1) {
                topContent = `<div class="inj-day-arrow" style="font-size:11px;">▶</div>`;
              } else {
                topContent = `<div class="inj-day-arrow" style="letter-spacing:-2px;">───</div>`;
              }
            }

            daysCellsHtml += `
              <td style="height:46px;">
                <div class="inj-day-cell">
                  <div class="inj-day-top" onclick="toggleInjDayTop(this, ${rowIdx}, ${d})" data-row="${rowIdx}" data-day="${d}" title="クリックで指示(有効/中止/空欄)を切替">${topContent}</div>
                  <div class="inj-day-bottom" onclick="toggleInjDayBottom(this, ${rowIdx}, ${d})" data-row="${rowIdx}" data-day="${d}" title="クリックで実施確認(✔/看/時刻/空欄)を切替">${bottomContent}</div>
                </div>
              </td>
            `;
          }

          gridHtml += `
            <tr data-row="${rowIdx}">
              <td class="inj-col-no" style="text-align:center; font-weight:bold; color:#64748b; background:#f8fafc; font-size:10px;">${rowIdx}</td>
              <td class="inj-rx-cell" contenteditable="true" spellcheck="false" data-row="${rowIdx}" title="直接編集可能">${rxTextHtml}</td>
              <td class="inj-col-route" data-row="${rowIdx}">
                <div class="inj-route-grid">
                  <div class="inj-route-item" onclick="toggleInjPreviewRoute(this, ${rowIdx}, 'is')"><span class="${isSelected('is')}">is</span></div>
                  <div class="inj-route-item" onclick="toggleInjPreviewRoute(this, ${rowIdx}, 'DIV')"><span class="${isSelected('DIV')}">DIV</span></div>
                  <div class="inj-route-item" onclick="toggleInjPreviewRoute(this, ${rowIdx}, 'im')"><span class="${isSelected('im')}">im</span></div>
                  <div class="inj-route-item" onclick="toggleInjPreviewRoute(this, ${rowIdx}, 'IVH')"><span class="${isSelected('IVH')}">IVH</span></div>
                  <div class="inj-route-item" onclick="toggleInjPreviewRoute(this, ${rowIdx}, 'iv')"><span class="${isSelected('iv')}">iv</span></div>
                  <div class="inj-route-item" onclick="toggleInjPreviewRoute(this, ${rowIdx}, 'OTHER')"><span class="${normRoute === 'OTHER' ? 'inj-route-circle' : ''}">${otherText}</span></div>
                </div>
              </td>
              <td class="inj-col-date-label">
                <div class="inj-day-cell">
                  <div class="inj-day-top" style="font-size:10px; font-weight:bold;">指示</div>
                  <div class="inj-day-bottom" style="font-size:10px; font-weight:bold;">実施</div>
                </div>
              </td>
              ${daysCellsHtml}
            </tr>
          `;
        }
        tbody.innerHTML = gridHtml;

        // 薬剤師鑑査印
        const stampEl = document.getElementById('injPharmacistStamp');
        const defaultTextEl = document.getElementById('injPharmacistDefaultText');
        if (details.pharmacistChecked) {
          stampEl.style.display = 'flex';
          defaultTextEl.style.display = 'none';
        } else {
          stampEl.style.display = 'none';
          defaultTextEl.style.display = 'block';
        }

        // 印刷モードのクラス設定
        document.body.classList.add('printing-injection');
        document.body.classList.remove('printing-rx');

        // モーダル表示
        document.getElementById('injectionSheetModal').style.display = 'flex';
      } catch (e) {
        alert('注射指示箋データ表示エラー: ' + e.message);
      }
    }

    function toggleInjDayTop(el, rowIdx, dayIdx) {
      const current = el.innerHTML.trim();
      if (!current) {
        el.innerHTML = `<div class="inj-day-arrow" style="font-size:11px; font-weight:bold; color:#0284c7;">───▶</div>`;
      } else if (current.includes('arrow') || current.includes('───') || current.includes('▶') || current.includes('✔')) {
        el.innerHTML = `<div class="inj-day-cancel"><span style="font-size:12px; font-weight:bold; color:#dc2626;">✕</span><span style="font-size:7.5px; color:#dc2626; display:block; line-height:1; font-weight:bold;">中止</span></div>`;
      } else {
        el.innerHTML = '';
      }
    }

    function toggleInjDayBottom(el, rowIdx, dayIdx) {
      const current = el.innerHTML.trim();
      if (!current) {
        el.innerHTML = `<div class="inj-exec-check"><span style="font-size:12px; font-weight:bold; color:#16a34a;">✔</span><span style="font-size:7.5px; color:#16a34a; display:block; line-height:1; font-weight:bold;">済</span></div>`;
      } else if (current.includes('✔') || current.includes('済')) {
        el.innerHTML = `<div class="inj-exec-stamp">看</div>`;
      } else if (current.includes('看')) {
        el.innerHTML = `<div style="font-size:8.5px; font-weight:bold; color:#2563eb; line-height:1.1;">10:00</div>`;
      } else {
        el.innerHTML = '';
      }
    }

    function toggleInjPreviewRoute(el, rowIdx, routeName) {
      const parentGrid = el.closest('.inj-route-grid');
      if (!parentGrid) return;
      parentGrid.querySelectorAll('.inj-route-circle').forEach(c => c.classList.remove('inj-route-circle'));
      const span = el.querySelector('span') || el;
      span.classList.add('inj-route-circle');
      if (routeName === 'OTHER') {
        const custom = prompt('投与経路を入力してください（例: 経管、吸入など）:', 'その他');
        if (custom) span.textContent = `(${custom})`;
      }
    }

    function toggleInjGender(gender) {
      const maleEl = document.getElementById('injGenderMale');
      const femaleEl = document.getElementById('injGenderFemale');
      maleEl.classList.remove('gender-circle');
      femaleEl.classList.remove('gender-circle');
      if (gender === '男') maleEl.classList.add('gender-circle');
      else if (gender === '女') femaleEl.classList.add('gender-circle');
    }

    function toggleInjPharmacistStamp() {
      const stampEl = document.getElementById('injPharmacistStamp');
      const defaultTextEl = document.getElementById('injPharmacistDefaultText');
      if (stampEl.style.display === 'none' || !stampEl.style.display) {
        stampEl.style.display = 'flex';
        defaultTextEl.style.display = 'none';
      } else {
        stampEl.style.display = 'none';
        defaultTextEl.style.display = 'block';
      }
    }

    function toggleInjWardStamp() {
      const wardEl = document.getElementById('injWardStamp') || document.querySelector('.inj-ward-stamp');
      if (!wardEl) return;
      if (wardEl.classList.contains('stamped')) {
        wardEl.classList.remove('stamped');
        wardEl.style.color = '#000000';
        wardEl.style.borderColor = '#000000';
        wardEl.innerHTML = '病　棟';
      } else {
        wardEl.classList.add('stamped');
        wardEl.style.color = '#dc2626';
        wardEl.style.borderColor = '#dc2626';
        wardEl.innerHTML = '病棟 受領済 ✔';
      }
    }

    function toggleInjDoctorStamp() {
      const stamp = document.getElementById('injPrintDoctorStamp');
      if (!stamp) return;
      if (stamp.style.opacity === '0.3') {
        stamp.style.opacity = '1';
      } else {
        stamp.style.opacity = '0.3';
      }
    }

    async function saveReceiverInjectionSheet() {
      const rowsData = [];
      const tbody = document.getElementById('injGridTbody');
      if (!tbody) return;

      const rows = tbody.querySelectorAll('tr');
      rows.forEach((tr, rowIdx) => {
        const no = rowIdx + 1;
        const rxCell = tr.querySelector('.inj-rx-cell');
        const rxText = rxCell ? rxCell.innerText.trim() : '';
        const selectedRouteEl = tr.querySelector('.inj-route-circle');
        const route = selectedRouteEl ? selectedRouteEl.innerText.trim().replace(/[()]/g, '') : 'DIV';

        const days = [];
        tr.querySelectorAll('.inj-day-cell').forEach((dc, dayIdx) => {
          const topEl = dc.querySelector('.inj-day-top');
          const botEl = dc.querySelector('.inj-day-bottom');
          days.push({
            top: topEl ? topEl.innerHTML : '',
            bottom: botEl ? botEl.innerHTML : ''
          });
        });

        rowsData.push({ no, rxText, route, days });
      });

      const pharmacistChecked = document.getElementById('injPharmacistStamp')?.style.display === 'flex';

      if (currentPreviewOrderId) {
        try {
          const res = await fetch(`/api/orders/${currentPreviewOrderId}/injection-sheet`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              sheetState: rowsData,
              pharmacistChecked
            })
          });
          const data = await res.json();
          if (data.success) {
            showToast('✅ 注射指示箋の編集・実施確認を保存しました');
            const o = currentOrders.find(it => it.orderId === currentPreviewOrderId);
            if (o) {
              o.details = o.details || {};
              o.details.injectionSheetState = rowsData;
              o.details.pharmacistChecked = pharmacistChecked;
              if (selectedOrderId === currentPreviewOrderId) {
                renderRightPane(o);
              }
            }
          } else {
            showToast('❌ 保存エラー: ' + (data.error || '失敗'), true);
          }
        } catch (err) {
          showToast('❌ 通信エラー: ' + err.message, true);
        }
      } else {
        showToast('✅ プレビュー上の入力・実施確認を反映しました（印刷に反映されます）');
      }
    }

    function printInjectionSheet() {
      let styleEl = document.getElementById('dynamicPrintPageStyle');
      if (!styleEl) {
        styleEl = document.createElement('style');
        styleEl.id = 'dynamicPrintPageStyle';
        document.head.appendChild(styleEl);
      }
      styleEl.textContent = '@media print { @page { size: A4 landscape; margin: 6mm 8mm; } }';
      document.body.classList.add('printing-injection');
      document.body.classList.remove('printing-rx');
      window.print();
    }

    function closeInjectionSheetModal(event) {
      if (!event || event.target === document.getElementById('injectionSheetModal') || event.type === 'click') {
        document.getElementById('injectionSheetModal').style.display = 'none';
        document.body.classList.remove('printing-injection');
      }
    }

    function escapeHtml(str) {
      if (!str) return '';
      return String(str).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }

    // 自動ポーリング設定
    const toggle = document.getElementById('autoPollToggle');
    function setupPolling() {
      if (toggle && toggle.checked) {
        if (!pollInterval) {
          pollInterval = setInterval(loadOrdersList, 3000);
        }
      } else {
        if (pollInterval) {
          clearInterval(pollInterval);
          pollInterval = null;
        }
      }
    }
    if (toggle) toggle.addEventListener('change', setupPolling);
    setupPolling();

    // =========================================================
    // 左右境界線スプリッターのドラッグ調整
    // =========================================================
    function initSplitResizer() {
      const splitLayout = document.getElementById('splitLayout');
      const leftCol = document.getElementById('leftColumn');
      const resizer = document.getElementById('splitResizer');
      if (!splitLayout || !leftCol || !resizer) return;

      const STORAGE_KEY = 'ordering_receiver_split_ratio';
      const DEFAULT_RATIO = 0.54; // デフォルト 54%

      // 保存された幅比率の復元
      try {
        const savedRatio = parseFloat(localStorage.getItem(STORAGE_KEY));
        if (!isNaN(savedRatio) && savedRatio >= 0.2 && savedRatio <= 0.8) {
          applyRatio(savedRatio);
        } else {
          applyRatio(DEFAULT_RATIO);
        }
      } catch (e) {
        applyRatio(DEFAULT_RATIO);
      }

      function applyRatio(ratio) {
        leftCol.style.flex = `0 0 ${ratio * 100}%`;
      }

      // ダブルクリックで初期比率（54%）にリセット
      resizer.addEventListener('dblclick', () => {
        applyRatio(DEFAULT_RATIO);
        localStorage.setItem(STORAGE_KEY, DEFAULT_RATIO.toString());
      });

      // ドラッグ処理 (PointerEvents)
      resizer.addEventListener('pointerdown', (e) => {
        e.preventDefault();
        resizer.classList.add('is-resizing');
        document.body.classList.add('is-resizing-split');

        const layoutRect = splitLayout.getBoundingClientRect();
        const minLeftPx = 280;
        const maxLeftPx = layoutRect.width - 280;

        function onPointerMove(ev) {
          const currentX = ev.clientX - layoutRect.left;
          const clampedX = Math.max(minLeftPx, Math.min(maxLeftPx, currentX));
          const newRatio = clampedX / layoutRect.width;

          applyRatio(newRatio);
          localStorage.setItem(STORAGE_KEY, newRatio.toFixed(4));
        }

        function onPointerUp() {
          resizer.classList.remove('is-resizing');
          document.body.classList.remove('is-resizing-split');
          document.removeEventListener('pointermove', onPointerMove);
          document.removeEventListener('pointerup', onPointerUp);
        }

        document.addEventListener('pointermove', onPointerMove);
        document.addEventListener('pointerup', onPointerUp);
      });
    }

    // 初回初期化
    document.addEventListener('DOMContentLoaded', () => {
      renderOrdersTable(currentOrders);
      initSplitResizer();
    });
    renderOrdersTable(currentOrders);
    initSplitResizer();
  </script>
</body>
</html>
