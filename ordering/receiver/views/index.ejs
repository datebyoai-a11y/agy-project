  <script>
    // サーバーから渡された初期データ
    let currentOrders = <%- JSON.stringify(orders) %>;
    let currentFilterType = 'ALL';
    let selectedOrderId = null;
    let pollInterval = null;

    // ヘルパー: 1行要約テキスト作成
    function getOrderSummaryJs(order) {
      const details = order.details || {};
      const type = order.orderType;
      if (type === 'PRESCRIPTION') {
        const parts = [];
        if (details.prescriptionType) parts.push('[' + details.prescriptionType + ']');
        if (details.deptType) parts.push('[' + details.deptType + ']');
        if (details.medicines && Array.isArray(details.medicines) && details.medicines.length > 0) {
          const medParts = details.medicines.map(m => {
            let s = 'Rp' + (m.rp || '') + ': ' + (m.medicine || '薬剤未定');
            if (m.dosage) s += ' ' + m.dosage;
            if (m.days) s += ' ×' + m.days + '日分';
            if (m.quantity) s += ' [' + m.quantity + ']';
            if (m.instruction) s += ' (' + m.instruction + ')';
            return s;
          });
          parts.push(medParts.join(' / '));
        } else {
          if (details.medicine) parts.push(details.medicine);
          if (details.dosage || details.dose) parts.push(details.dosage || details.dose);
          if (details.days) parts.push(details.days + '日分');
        }
        if (details.remarks) parts.push('📝' + details.remarks);
        return parts.join(' | ') || '処方指示';
      } else if (type === 'IV') {
        const parts = [];
        if (details.route) parts.push('[' + details.route + ']');
        if (details.medicine) parts.push(details.medicine);
        if (details.rate) parts.push('速度:' + details.rate);
        if (details.scheduleDays) parts.push('期間:' + details.scheduleDays);
        if (details.pharmacistChecked) parts.push('鑑査済');
        if (details.remarks) parts.push('📝' + details.remarks);
        return parts.join(' | ') || '注射指示';
      } else if (type === 'RADIOLOGY') {
        const parts = [];
        if (details.formName) parts.push(details.formName);
        if (details.subType === 'XRAY' || details.formName === '診療Ｘ線照射録') {
          if (details.xraySites) parts.push(details.xraySites);
          else if (details.examType) parts.push(details.examType);
          if (details.isPortable) parts.push('ポータブル:' + (details.portable || '病室'));
          if (details.technician) parts.push('技師:' + details.technician);
        } else {
          if (details.examType) parts.push(details.examType);
          if (details.contrast) parts.push('[' + details.contrast + ']');
          if (details.dynamic) parts.push('(' + details.dynamic + ')');
          if (details.items) parts.push(details.items);
        }
        if (details.purpose) parts.push('目的:' + details.purpose);
        if (details.remarks && details.remarks !== details.purpose) parts.push('📝' + details.remarks);
        return parts.join(' | ') || '放射線検査指示';
      } else if (type === 'LAB_EXAM') {
        const parts = [];
        if (details.formName) parts.push(details.formName);
        if (details.items || details.testName || details.category) parts.push(details.items || details.testName || details.category);
        if (details.sample || details.sampleType) parts.push('検体:' + (details.sample || details.sampleType));
        if (details.purpose) parts.push('目的:' + details.purpose);
        if (details.remarks && details.remarks !== details.purpose) parts.push('📝' + details.remarks);
        return parts.join(' | ') || '検査指示';
      } else if (type === 'REHAB') {
        const parts = [];
        if (details.therapyTypes) parts.push(details.therapyTypes);
        if (details.goals) parts.push('目標:' + details.goals);
        if (details.diagnoses && details.diagnoses.length > 0) {
          parts.push('診断:' + details.diagnoses.map(d => d.name).join('、'));
        }
        if (details.contraindications) parts.push('⚠️禁忌:' + details.contraindications);
        return parts.join(' | ') || 'リハビリテーション指示';
      } else if (type === 'MEAL') {
        const parts = [];
        if (details.mealType) parts.push(details.mealType);
        if (details.timing) parts.push('(' + details.timing + ')');
        if (details.stapleFood || details.sideDish) parts.push('主副:' + (details.stapleFood || '米飯') + '/' + (details.sideDish || '常菜'));
        if (details.allergies) parts.push('アレルギー:' + details.allergies);
        return parts.join(' | ') || '食事指示';
      }
      if (typeof details === 'object' && details !== null) {
        return Object.entries(details).map(([k, v]) => `${k}: ${v}`).join(' | ');
      }
      return String(details || '');
    }

    // ヘルパー: ホバー用ツールチップ全文テキスト作成
    function getOrderTooltipJs(order) {
      const details = order.details || {};
      const type = order.orderType;
      let text = '';
      if (type === 'IV') {
        text = `【💉 注射指示書】\n投与経路: ${details.route || 'DIV'}\n薬剤名: ${details.medicine || '未設定'}\n速度・滴下: ${details.rate || '指示通り'}\n期間・頻度: ${details.scheduleDays || '指示通り'}\n薬剤師鑑査: ${details.pharmacistChecked ? '確認済' : '未'}\n自由記載: ${details.remarks || '特記なし'}`;
      } else if (type === 'RADIOLOGY') {
        if (details.subType === 'XRAY' || details.formName === '診療Ｘ線照射録') {
          text = `【🩻 ${details.formName || '診療Ｘ線照射録'}】\n部位・方向: ${details.xraySites || details.examType || '-'}\n撮影場所: ${details.portable || '一般撮影室'}\n担当技師: ${details.technician || '技師'}\n撮影条件: ${details.conditions || '-'}\n媒体/取込: ${details.media || '-'}\n目的・特記: ${details.remarks || '特記なし'}`;
        } else {
          text = `【🩻 ${details.formName || '放射線科検査'}】\n検査種別: ${details.examType || '一般撮影'}\n区分: ${details.contrast || '単純'} ${details.dynamic ? '(' + details.dynamic + ')' : ''}\n部位: ${details.parts || details.examType || '-'}\n使用薬剤: ${details.medications || details.medication || 'なし'}\n撮影条件: ${details.conditions || '-'}\n目的・臨床所見: ${details.purpose || '精査'}\n自由記載: ${details.remarks || '特記なし'}`;
        }
      } else if (type === 'LAB_EXAM') {
        text = `【🔬 ${details.formName || '検査部指示'}】\n検査項目: ${details.items || details.testName || '検体検査'}\n検体: ${details.sample || details.sampleType || '血液'}\n予定: ${details.schedule || '指示通り'}\n目的・臨床情報: ${details.purpose || '精査'}\n自由記載: ${details.remarks || '特記なし'}`;
      } else if (type === 'REHAB') {
        const diagStr = details.diagnoses ? details.diagnoses.map(d => d.name + (d.onsetDate ? ' (発症:' + d.onsetDate + ')' : '')).join(' / ') : '';
        text = `【🏃 リハビリテーション指示書】\n場所: ${details.location || '病室/リハ室'}\n指示区分: ${details.therapyTypes || 'PT/OT'}\n診断名: ${diagStr || '未記入'}\n治療目的: ${details.goals || '運動機能改善'}\n物理療法: ${details.physicals || 'なし'}\n⚠️禁忌・注意事項: ${details.contraindications || '特記なし'}\n自由記載: ${details.remarks || '特記なし'}`;
      } else if (type === 'MEAL') {
        text = `【🍱 栄養管理室 食事指示】\n食種: ${details.mealType || '常食'}\n区分: ${details.timing || '毎食'}\n主食/副食: ${details.stapleFood || '米飯'} / ${details.sideDish || '常菜'}\nアレルギー: ${details.allergies || 'なし'}\n自由記載: ${details.remarks || '特記なし'}`;
      } else if (type === 'PRESCRIPTION') {
        let medLines = '';
        if (details.medicines && Array.isArray(details.medicines) && details.medicines.length > 0) {
          medLines = details.medicines.map(m => {
            let line = `【Rp ${m.rp}】 ${m.medicine || ''}\n  用法用量: ${m.dosage || ''}\n  日数/数量: ${m.days ? m.days + '日分' : ''} / ${m.quantity || ''}\n  指示: ${m.instruction || 'なし'}`;
            if (m.medicineMaster) {
              line += `\n  マスタ情報: 粉砕[${m.medicineMaster.crushOk || '-'}] 懸濁[${m.medicineMaster.suspensionOk || '-'}] ${m.medicineMaster.pharmacyComment ? '⚠️' + m.medicineMaster.pharmacyComment : ''}`;
            }
            return line;
          }).join('\n');
        } else {
          medLines = `処方薬: ${details.medicine || '処方箋指示'}\n用法用量: ${details.dosage || details.dose || '指示通り'}\n日数: ${details.days || '7'}日分`;
        }
        text = `【💊 処方指示】\n処方区分: ${details.prescriptionType || '定期'} (${details.deptType || '院内'})\n${medLines}\n自由記載: ${details.remarks || '特記なし'}`;
      } else {
        text = JSON.stringify(details, null, 2);
      }

      if (order.medicineMaster) {
        const m = order.medicineMaster;
        text += `\n\n【💊 代表薬品マスタ情報】\n・薬品名: ${m.name}\n・一般名: ${m.genericName || '-'}\n・薬効: ${m.therapeuticCategoryMajor || ''}\n・粉砕: ${m.crushOk || '-'} / 懸濁: ${m.suspensionOk || '-'}`;
        if (m.pharmacyComment) {
          text += `\n・⚠️調剤注意: ${m.pharmacyComment}`;
        }
      }
      return text;
    }

    // 薬剤バッジ作成 (コンパクト)
    function getMedBadgesJs(order) {
      if (order.orderType === 'PRESCRIPTION' && order.details && order.details.medicines && order.details.medicines.length > 0) {
        const meds = order.details.medicines;
        let hasCrushNg = false;
        let hasWarn = false;
        meds.forEach(m => {
          if (m.medicineMaster) {
            if (m.medicineMaster.crushOk === '×') hasCrushNg = true;
            if (m.medicineMaster.pharmacyComment) hasWarn = true;
          }
        });
        let html = '<span class="med-inline-badges">';
        html += `<span class="med-tag med-tag-blue">${meds.length}剤</span>`;
        if (hasCrushNg) html += '<span class="med-tag med-tag-ng">粉砕不可</span>';
        if (hasWarn) html += '<span class="med-tag med-tag-warn">注意</span>';
        html += '</span>';
        return html;
      }
      if (!order.medicineMaster) return '';
      const m = order.medicineMaster;
      let html = '<span class="med-inline-badges">';
      if (m.crushOk === '×') html += '<span class="med-tag med-tag-ng">粉砕不可</span>';
      if (m.pharmacyComment) html += '<span class="med-tag med-tag-warn">注意</span>';
      html += '</span>';
      return html;
    }

    function getPriorityBadgeJs(priority) {
      if (priority === 'STAT') return '<span class="priority-badge STAT">🚨至急</span>';
      if (priority === 'URGENT') return '<span class="priority-badge URGENT">⚡早急</span>';
      return '<span class="priority-badge ROUTINE">通常</span>';
    }

    function getTypeBadgeJs(type) {
      const labels = {
        PRESCRIPTION: '💊処方',
        IV: '💉注射',
        RADIOLOGY: '🩻放射線',
        LAB_EXAM: '🔬検査',
        REHAB: '🏃リハビリ',
        MEAL: '🍱食事'
      };
      return `<span class="badge-type ${type}">${labels[type] || type}</span>`;
    }

    function getStatusBadgeJs(status) {
      if (status === 'RECEIVED') return '<span class="status-badge RECEIVED">📥受信</span>';
      if (status === 'ACCEPTED') return '<span class="status-badge ACCEPTED">🟡受付</span>';
      if (status === 'IN_PROGRESS') return '<span class="status-badge IN_PROGRESS">🔵実施中</span>';
      if (status === 'COMPLETED') return '<span class="status-badge COMPLETED">✅完了</span>';
      return `<span class="status-badge">${status}</span>`;
    }

    function formatTimeJs(isoStr) {
      if (!isoStr) return '--:--';
      const d = new Date(isoStr);
      const now = new Date();
      const isSameDay = d.toDateString() === now.toDateString();
      const time = d.toLocaleTimeString('ja-JP', { hour: '2-digit', minute: '2-digit' });
      if (isSameDay) return time;
      const month = (d.getMonth() + 1).toString().padStart(2, '0');
      const day = d.getDate().toString().padStart(2, '0');
      return `${month}/${day} ${time}`;
    }

