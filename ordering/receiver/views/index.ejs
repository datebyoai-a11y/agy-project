    // 薬剤バッジ作成 (コンパクト)
    function getMedBadgesJs(order) {
      if (order.orderType === 'PRESCRIPTION' && order.details && order.details.medicines && order.details.medicines.length > 0) {
        const meds = order.details.medicines;
        let hasCrushNg = false;
        let hasWarn = false;
        meds.forEach(m => {
          if (m.medicineMaster) {
            if (m.medicineMaster.crushOk === '×') hasCrushNg = true;
            if (m.medicineMaster.pharmacyComment) hasWarn = true;
          }
        });
        let html = '<span class="med-inline-badges">';
        html += `<span class="med-tag med-tag-blue">${meds.length}剤</span>`;
        if (hasCrushNg) html += '<span class="med-tag med-tag-ng">粉砕不可</span>';
        if (hasWarn) html += '<span class="med-tag med-tag-warn">注意</span>';
        html += '</span>';
        return html;
      }
      if (order.orderType === 'IV' && order.details && order.details.medicines && order.details.medicines.length > 0) {
        const meds = order.details.medicines;
        let html = '<span class="med-inline-badges">';
        html += `<span class="med-tag" style="background:#0284c7; color:white;">💉 ${meds.length}品目</span>`;
        if (order.details.route) html += `<span class="med-tag med-tag-blue">${escapeHtml(order.details.route)}</span>`;
        html += '</span>';
        return html;
      }
      if (!order.medicineMaster) return '';
      const m = order.medicineMaster;
      let html = '<span class="med-inline-badges">';
      if (m.crushOk === '×') html += '<span class="med-tag med-tag-ng">粉砕不可</span>';
      if (m.pharmacyComment) html += '<span class="med-tag med-tag-warn">注意</span>';
      html += '</span>';
      return html;
    }

    function getPriorityBadgeJs(priority) {
      if (priority === 'STAT') return '<span class="priority-badge STAT">🚨至急</span>';
      if (priority === 'URGENT') return '<span class="priority-badge URGENT">⚡早急</span>';
      return '<span class="priority-badge ROUTINE">通常</span>';
    }

    function getTypeBadgeJs(type) {
      const labels = {
        PRESCRIPTION: '💊処方',
        IV: '💉注射',
        RADIOLOGY: '🩻放射線',
        LAB_EXAM: '🔬検査',
        REHAB: '🏃リハビリ',
        MEAL: '🍱食事'
      };
      return `<span class="badge-type ${type}">${labels[type] || type}</span>`;
    }

    function getStatusBadgeJs(status) {
      if (status === 'RECEIVED') return '<span class="status-badge RECEIVED">📥受信</span>';
      if (status === 'ACCEPTED') return '<span class="status-badge ACCEPTED">🟡受付</span>';
      if (status === 'IN_PROGRESS') return '<span class="status-badge IN_PROGRESS">🔵実施中</span>';
      if (status === 'COMPLETED') return '<span class="status-badge COMPLETED">✅完了</span>';
      return `<span class="status-badge">${status}</span>`;
    }

    function formatTimeJs(isoStr) {
      if (!isoStr) return '--:--';
      const d = new Date(isoStr);
      const now = new Date();
      const isSameDay = d.toDateString() === now.toDateString();
      const time = d.toLocaleTimeString('ja-JP', { hour: '2-digit', minute: '2-digit' });
      if (isSameDay) return time;
      const month = (d.getMonth() + 1).toString().padStart(2, '0');
      const day = d.getDate().toString().padStart(2, '0');
      return `${month}/${day} ${time}`;
    }

