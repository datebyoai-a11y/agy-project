        // 生年月日・元号
        ['M', 'T', 'S', 'H', 'R'].forEach(e => {
          const el = document.getElementById('injEra' + e);
          if (el) el.classList.remove('era-circle');
        });

        const jDate = parseJapaneseEraDate(patient.birthDate);
