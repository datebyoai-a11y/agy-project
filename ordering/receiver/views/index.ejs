      });

      if (countSummary) {
        countSummary.textContent = `表示: ${filtered.length}件 / 全${orders.length}件`;
      }

      if (filtered.length === 0) {
        tbody.innerHTML = `
          <tr>
            <td colspan="8" style="text-align:center; padding:3rem 1rem; color:#64748b;">
              <div style="font-size:1.8rem; margin-bottom:0.3rem;">📭</div>
              <strong>オーダーはありません</strong>
            </td>
          </tr>
        `;
        renderRightPane(null);
        return;
      }

      const rowsHtml = filtered.map(order => {
        const isSelected = (order.orderId === selectedOrderId);
        const timeStr = formatTimeJs(order.receivedAt);
        const summary = getOrderSummaryJs(order);
        const tooltip = getOrderTooltipJs(order);
        const medBadges = getMedBadgesJs(order);
        const priorityBadge = getPriorityBadgeJs(order.priority);
        const typeBadge = getTypeBadgeJs(order.orderType);
        const statusBadge = getStatusBadgeJs(order.status);
        const patientName = escapeHtml(order.patient ? order.patient.name : '未指定');
        const patientId = escapeHtml(order.patient ? order.patient.id : '');
        const doctorName = escapeHtml(order.doctor ? order.doctor.name : '医師');

        return `
          <tr class="order-row priority-${order.priority || 'ROUTINE'} status-${order.status || 'RECEIVED'} ${isSelected ? 'selected-row' : ''}"
              data-order-id="${order.orderId}"
              data-type="${order.orderType}"
              data-status="${order.status}"
              onclick="selectOrder('${order.orderId}')">
            <td style="text-align: center;">${priorityBadge}</td>
            <td class="time-cell">${timeStr}</td>
            <td class="order-id-cell">${order.orderId}</td>
            <td>${typeBadge}</td>
            <td class="patient-cell" title="${patientName} [${patientId}]">
              <span class="patient-name">${patientName}</span>
              ${patientId ? `<span class="patient-meta">[${patientId}]</span>` : ''}
            </td>
            <td class="doctor-cell">${doctorName}</td>
            <td class="details-hover-cell"
                data-tooltip="${escapeHtml(tooltip)}"
                title="${escapeHtml(tooltip)}">
              <span class="summary-text">${escapeHtml(summary)}</span>
              ${medBadges}
            </td>
            <td style="text-align: center;">${statusBadge}</td>
          </tr>
        `;
      }).join('');

      tbody.innerHTML = rowsHtml;

      // ツールチップイベントを再登録
      attachTooltipEvents();

      // 選択中オーダーが現在も存在するか確認。なければ1件目を自動選択
      if (!selectedOrderId || !filtered.some(o => o.orderId === selectedOrderId)) {
        if (filtered.length > 0) {
          selectOrder(filtered[0].orderId);
        } else {
          renderRightPane(null);
        }
      } else {
        // 現在選択中のオーダーの最新情報を右ペインに反映
        const currentSelected = filtered.find(o => o.orderId === selectedOrderId);
        renderRightPane(currentSelected);
      }
    }

    // =========================================================
    // ホバーツールチップのイベント処理
    // =========================================================
    const hoverTooltip = document.getElementById('customHoverTooltip');

    function attachTooltipEvents() {
      const hoverCells = document.querySelectorAll('.details-hover-cell');
      hoverCells.forEach(cell => {
        cell.addEventListener('mouseenter', (e) => {
          const text = cell.getAttribute('data-tooltip');
          if (!text) return;
          hoverTooltip.textContent = text;
          hoverTooltip.style.display = 'block';
          positionTooltip(e);
        });

        cell.addEventListener('mousemove', (e) => {
          positionTooltip(e);
        });

        cell.addEventListener('mouseleave', () => {
          hoverTooltip.style.display = 'none';
        });
      });
    }

    function positionTooltip(e) {
      const padding = 14;
      let left = e.clientX + padding;
      let top = e.clientY + padding;

      // 画面右端からはみ出る場合の補正
      const tooltipRect = hoverTooltip.getBoundingClientRect();
      if (left + tooltipRect.width > window.innerWidth - 10) {
        left = e.clientX - tooltipRect.width - padding;
      }
      // 画面下端からはみ出る場合の補正
      if (top + tooltipRect.height > window.innerHeight - 10) {
        top = e.clientY - tooltipRect.height - padding;
      }

      hoverTooltip.style.left = left + 'px';
      hoverTooltip.style.top = top + 'px';
    }

    // =========================================================
    // 部門フィルター切り替え
    // =========================================================
    function filterType(type, btn) {
      currentFilterType = type;
      document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
      if (btn) btn.classList.add('active');
      renderOrdersTable(currentOrders);
    }

    // =========================================================
    // ステータス更新 (受付 / 完了)
    // =========================================================
    async function updateOrderStatus(orderId, status, note) {
      try {
        const res = await fetch(`/api/orders/${orderId}/status`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            status,
            actor: '部門モニター操作者',
            note: note || ''
          })
        });
        if (res.ok) {
          await loadOrdersList();
        }
      } catch (e) {
        alert('ステータス更新エラー: ' + e.message);
      }
    }

    // =========================================================
    // ポーリング再取得
    // =========================================================
    async function loadOrdersList() {
      try {
        const res = await fetch('/api/orders?_t=' + Date.now(), { cache: 'no-store' });
        const data = await res.json();
        if (data.success && data.orders) {
          currentOrders = data.orders;
          renderOrdersTable(currentOrders);
        }
      } catch (e) {
        console.error('Failed to load orders:', e);
      }
    }

    // =========================================================
    // 履歴クリア
    // =========================================================
    async function clearAllOrders() {
      if (!confirm('受信したすべてのオーダー履歴をクリアしますか？')) return;
      try {
        const res = await fetch('/api/orders/clear', { method: 'POST' });
        if (res.ok) {
          selectedOrderId = null;
          await loadOrdersList();
        }
      } catch (e) {
        alert('クリアエラー: ' + e.message);
      }
    }

    // =========================================================
    // A4 処方箋プレビュー & 印刷モーダル
    // =========================================================
    async function openPrescriptionPrintModal(orderId) {
      try {
        const order = currentOrders.find(o => o.orderId === orderId);
        if (!order) {
          alert('処方箋データが見つかりません');
          return;
        }

        const details = order.details || {};
        const patient = order.patient || {};
        const doctor = order.doctor || {};

        const rxTypeStr = `(${details.deptType || '院内処方'} / ${details.prescriptionType || '定期処方'})`;
        document.getElementById('printRxTypeSub').textContent = rxTypeStr;

        const issueDate = order.receivedAt ? new Date(order.receivedAt) : new Date();
        const validDate = new Date(issueDate);
        validDate.setDate(validDate.getDate() + 3);

        const fmtDate = d => `${d.getFullYear()}年 ${(d.getMonth() + 1).toString().padStart(2, '0')}月 ${d.getDate().toString().padStart(2, '0')}日`;
        document.getElementById('printIssueDate').textContent = fmtDate(issueDate);
        document.getElementById('printValidDate').innerHTML = `交付の日を含め4日以内<br>(${fmtDate(validDate)}まで)`;

        document.getElementById('printPatientId').textContent = patient.id || 'PT-XXXX';
        document.getElementById('printPatientDept').textContent = (patient.department || '') + (patient.ward ? ' / ' + patient.ward : '');
        document.getElementById('printPatientKana').textContent = patient.kana || '';
        document.getElementById('printPatientName').textContent = (patient.name || '患者未指定') + ' 殿';
        document.getElementById('printPatientGender').textContent = patient.gender || '不詳';
        document.getElementById('printPatientAge').textContent = patient.age ? `${patient.age}歳` : '-';
        document.getElementById('printPatientBirthDate').textContent = patient.birthDate ? `${patient.birthDate} 生` : '-';
        document.getElementById('printPatientInsurance').textContent = patient.insurance || '社保 (本人)';

        document.getElementById('printDoctorName').textContent = doctor.name || '担当医';
        document.getElementById('printDoctorDept').textContent = doctor.department || '診療科';
        const docLastName = (doctor.name || '医師').split(/\s+/)[0] || '印';
        document.getElementById('printDoctorStampName').textContent = docLastName;
        document.getElementById('printOrderId').textContent = order.orderId;

        const medicines = (details.medicines && Array.isArray(details.medicines) && details.medicines.length > 0)
          ? details.medicines
          : (details.medicine ? [{
              rp: 1,
              medicine: details.medicine,
              medicineId: details.medicineId || '',
              dosage: details.dosage || details.dose || '',
              days: details.days || '',
              quantity: details.quantity || '',
              instruction: details.instruction || '',
              medicineMaster: order.medicineMaster || null
            }] : []);

        const tbody = document.getElementById('printMedicinesTbody');
        if (medicines.length === 0) {
          tbody.innerHTML = `<tr><td colspan="6" style="text-align:center; padding:1.5rem; color:#64748b;">処方薬の指定がありません</td></tr>`;
        } else {
          let rowsHtml = medicines.map((m, idx) => {
            const mm = m.medicineMaster;
            const rpNum = m.rp || (idx + 1);

            let medNameHtml = `<div style="font-weight:bold; font-size:0.92rem; color:#0f172a;">${escapeHtml(m.medicine || '薬剤未定')}</div>`;
            if (mm && mm.genericName) {
              medNameHtml += `<div style="font-size:0.72rem; color:#475569;">一般名: ${escapeHtml(mm.genericName)}</div>`;
            }
            if (m.medicineId) {
              medNameHtml += `<div style="font-size:0.68rem; color:#64748b; font-family:monospace;">[${escapeHtml(m.medicineId)}]</div>`;
            }

            let instructHtml = '';
            if (m.instruction) {
              instructHtml += `<div style="font-weight:bold; color:#0369a1;">${escapeHtml(m.instruction)}</div>`;
            }
            if (mm) {
              let tags = [];
              if (mm.crushOk) tags.push(`粉砕:${mm.crushOk}`);
              if (mm.suspensionOk) tags.push(`懸濁:${mm.suspensionOk}`);
              if (tags.length > 0) {
                instructHtml += `<div style="font-size:0.7rem; color:#475569;">${tags.join(' / ')}</div>`;
              }
              if (mm.pharmacyComment) {
                instructHtml += `<div style="font-size:0.7rem; color:#b91c1c; font-weight:bold;">⚠️${escapeHtml(mm.pharmacyComment)}</div>`;
              }
            }
            if (!instructHtml) instructHtml = '<span style="color:#94a3b8;">-</span>';

            return `
              <tr class="rx-row">
                <td style="text-align:center; font-weight:bold; font-size:1rem; color:#0f172a; background:#f8fafc;">${rpNum}</td>
                <td>${medNameHtml}</td>
                <td style="font-weight:bold; color:#1e293b;">${escapeHtml(m.dosage || '指示通り')}</td>
                <td style="text-align:center; font-weight:bold;">${m.days ? escapeHtml(m.days) + '日分' : '-'}</td>
                <td style="text-align:right; font-weight:bold; font-family:monospace; font-size:0.95rem;">${escapeHtml(m.quantity || '-')}</td>
                <td style="font-size:0.75rem;">${instructHtml}</td>
              </tr>
            `;
          }).join('');

          rowsHtml += `
            <tr>
              <td colspan="6" style="text-align:center; padding:0.5rem; font-weight:bold; letter-spacing:6px; color:#64748b; background:#fcfcfc; border-top:1px solid #cbd5e1;">
                ＊＊＊＊＊ 以　下　余　白 ＊＊＊＊＊
              </td>
            </tr>
          `;
          tbody.innerHTML = rowsHtml;
        }

        const remarksEl = document.getElementById('printRemarksBody');
        if (details.remarks && details.remarks.trim()) {
          remarksEl.innerHTML = `<span style="font-weight:bold; color:#1e293b;">${escapeHtml(details.remarks)}</span>`;
        } else {
          remarksEl.innerHTML = `<span style="color:#94a3b8;">特記なし</span>`;
        }

        document.getElementById('prescriptionModal').style.display = 'flex';
      } catch (e) {
        alert('処方箋データ表示エラー: ' + e.message);
      }
    }

    function printPrescriptionSheet() {
      window.print();
    }

    function closePrescriptionModal(event) {
      if (!event || event.target === document.getElementById('prescriptionModal') || event.type === 'click') {
        document.getElementById('prescriptionModal').style.display = 'none';
      }
    }

    function escapeHtml(str) {
      if (!str) return '';
      return String(str).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }

    // 自動ポーリング設定
    const toggle = document.getElementById('autoPollToggle');
    function setupPolling() {
      if (toggle && toggle.checked) {
        if (!pollInterval) {
          pollInterval = setInterval(loadOrdersList, 3000);
        }
      } else {
        if (pollInterval) {
          clearInterval(pollInterval);
          pollInterval = null;
        }
      }
    }
    if (toggle) toggle.addEventListener('change', setupPolling);
    setupPolling();

    // =========================================================
    // 左右境界線スプリッターのドラッグ調整
    // =========================================================
    function initSplitResizer() {
      const splitLayout = document.getElementById('splitLayout');
      const leftCol = document.getElementById('leftColumn');
      const resizer = document.getElementById('splitResizer');
      if (!splitLayout || !leftCol || !resizer) return;

      const STORAGE_KEY = 'ordering_receiver_split_ratio';
      const DEFAULT_RATIO = 0.54; // デフォルト 54%

      // 保存された幅比率の復元
      try {
        const savedRatio = parseFloat(localStorage.getItem(STORAGE_KEY));
        if (!isNaN(savedRatio) && savedRatio >= 0.2 && savedRatio <= 0.8) {
          applyRatio(savedRatio);
        } else {
          applyRatio(DEFAULT_RATIO);
        }
      } catch (e) {
        applyRatio(DEFAULT_RATIO);
      }

      function applyRatio(ratio) {
        leftCol.style.flex = `0 0 ${ratio * 100}%`;
      }

      // ダブルクリックで初期比率（54%）にリセット
      resizer.addEventListener('dblclick', () => {
        applyRatio(DEFAULT_RATIO);
        localStorage.setItem(STORAGE_KEY, DEFAULT_RATIO.toString());
      });

      // ドラッグ処理 (PointerEvents)
      resizer.addEventListener('pointerdown', (e) => {
        e.preventDefault();
        resizer.classList.add('is-resizing');
        document.body.classList.add('is-resizing-split');

        const layoutRect = splitLayout.getBoundingClientRect();
        const minLeftPx = 280;
        const maxLeftPx = layoutRect.width - 280;

        function onPointerMove(ev) {
          const currentX = ev.clientX - layoutRect.left;
          const clampedX = Math.max(minLeftPx, Math.min(maxLeftPx, currentX));
          const newRatio = clampedX / layoutRect.width;

          applyRatio(newRatio);
          localStorage.setItem(STORAGE_KEY, newRatio.toFixed(4));
        }

        function onPointerUp() {
          resizer.classList.remove('is-resizing');
          document.body.classList.remove('is-resizing-split');
          document.removeEventListener('pointermove', onPointerMove);
          document.removeEventListener('pointerup', onPointerUp);
        }

        document.addEventListener('pointermove', onPointerMove);
        document.addEventListener('pointerup', onPointerUp);
      });
    }

    // 初回初期化
    document.addEventListener('DOMContentLoaded', () => {
      renderOrdersTable(currentOrders);
      initSplitResizer();
    });
    renderOrdersTable(currentOrders);
    initSplitResizer();
  </script>
</body>
