
[req]
default_bits = 2048
prompt = no
default_md = sha256
distinguished_name = dn
x509_extensions = v3_req

[dn]
C = JP
ST = Tokyo
L = Hospital
O = Medical Ordering System
OU = IT Department
CN = localhost

[v3_req]
subjectAltName = @alt_names
basicConstraints = CA:FALSE
keyUsage = nonRepudiation, digitalSignature, keyEncipherment

[alt_names]
DNS.1 = localhost
DNS.2 = *.local
DNS.3 = *.hospital.local
IP.1 = 127.0.0.1
IP.2 = 192.168.0.5
IP.3 = 10.144.20.3
