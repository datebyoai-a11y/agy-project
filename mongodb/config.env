# ==============================================================================
# MongoDB 環境・パス設定ファイル (Linux Mint / Windows 共通)
# ==============================================================================
# 異なるシステム（Linux Mint / Windows / 他PC）で起動する前に、
# 必要に応じてパスを指定してください。
# 未指定（空欄）の場合は、スクリプトが自動検出・デフォルト値を使用します。
# ==============================================================================

# 【1】mongod 実行ファイルのパス
# ・Linux Mint: 未指定の場合は PATH (/usr/bin/mongod 等) を自動探索します
#   例: /usr/bin/mongod
# ・Windows: 未指定の場合は PATH や Program Files 配下の mongod.exe を自動探索します
#   例: C:\Program Files\MongoDB\Server\7.0\bin\mongod.exe
#   例: C:\Program Files\MongoDB\Server\8.0\bin\mongod.exe
MONGOD_PATH=

# 【2】データベース保存先ディレクトリ (dbPath)
# ・未指定の場合は、この mongodb フォルダ内の "data" フォルダが使用されます
# ・絶対パスまたは相対パス（./data など）を指定できます
#   Linux Mint例: /home/user/Desktop/ai/mongodb/data
#   Windows例:   C:\ai\mongodb\data
DATA_PATH=

# 【3】ログファイル出力先 (logpath)
# ・未指定の場合は、データベース保存先内の "mongod.log" が使用されます
#   Linux Mint例: /home/user/Desktop/ai/mongodb/data/mongod.log
#   Windows例:   C:\ai\mongodb\data\mongod.log
LOG_PATH=

# 【4】ポート番号・接続バインドIP
PORT=27017
BIND_IP=127.0.0.1
